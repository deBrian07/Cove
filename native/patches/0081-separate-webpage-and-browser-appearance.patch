+class CoveDefaultWebAppearanceTest : public InProcessBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    os_settings_provider_.SetPreferredColorScheme(
+        ui::NativeTheme::PreferredColorScheme::kLight);
+  }
+
+ protected:
+  content::WebContents* contents() {
+    return browser()->tab_strip_model()->GetActiveWebContents();
+  }
+
+  ThemeService* theme_service() {
+    return ThemeServiceFactory::GetForProfile(browser()->GetProfile());
+  }
+
+  void ExpectPageScheme(blink::mojom::PreferredColorScheme scheme) {
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      const auto& preferences = contents()->GetOrCreateWebPreferences();
+      return preferences.preferred_color_scheme == scheme &&
+             preferences.preferred_root_scrollbar_color_scheme == scheme;
+    }));
+    EXPECT_EQ(scheme == blink::mojom::PreferredColorScheme::kDark,
+              EvalJs(contents(),
+                     "matchMedia('(prefers-color-scheme: dark)').matches"));
+  }
+
+  void ChangeSystemAppearance(ui::NativeTheme::PreferredColorScheme scheme) {
+    // Observe an actual renderer media-query change, not just cached browser
+    // preferences. No reload or explicit preference refresh should be needed.
+    ASSERT_TRUE(ExecJs(contents(), R"(
+      window.coveAppearanceChanged = new Promise(resolve => {
+        matchMedia('(prefers-color-scheme: dark)').addEventListener(
+            'change', event => resolve(event.matches), {once: true});
+      });
+    )"));
+    os_settings_provider_.SetPreferredColorScheme(scheme);
+    EXPECT_EQ(scheme == ui::NativeTheme::PreferredColorScheme::kDark,
+              EvalJs(contents(), "window.coveAppearanceChanged"));
+  }
+
+ private:
+  ui::MockOsSettingsProvider os_settings_provider_;
+};
+
+IN_PROC_BROWSER_TEST_F(CoveDefaultWebAppearanceTest,
+                       DefaultPagesFollowLiveSystemAppearance) {
+  const PrefService* prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_TRUE(
+      prefs->FindPreference(prefs::kBrowserColorScheme)->IsDefaultValue());
+  ASSERT_TRUE(prefs->FindPreference(prefs::kUserColor)->IsDefaultValue());
+  ASSERT_TRUE(theme_service()->UsingDefaultTheme());
+  ASSERT_EQ(ThemeService::BrowserColorScheme::kDark,
+            theme_service()->GetBrowserColorScheme());
+  ASSERT_TRUE(content::NavigateToURL(
+      contents(), chrome_test_utils::GetTestUrl(
+                      base::FilePath(base::FilePath::kCurrentDirectory),
+                      base::FilePath(FILE_PATH_LITERAL(
+                          "prefers-color-scheme.html")))));
+  ExpectPageScheme(blink::mojom::PreferredColorScheme::kLight);
+
+  ChangeSystemAppearance(ui::NativeTheme::PreferredColorScheme::kDark);
+  ExpectPageScheme(blink::mojom::PreferredColorScheme::kDark);
+  ChangeSystemAppearance(ui::NativeTheme::PreferredColorScheme::kLight);
+  ExpectPageScheme(blink::mojom::PreferredColorScheme::kLight);
+  EXPECT_EQ(ThemeService::BrowserColorScheme::kDark,
+            theme_service()->GetBrowserColorScheme());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveDefaultWebAppearanceTest,
+                       WebUIRetainsDarkBrowserAppearance) {
+  ASSERT_TRUE(content::NavigateToURL(
+      contents(), GURL(chrome::kChromeUIDownloadsURL)));
+  ASSERT_TRUE(contents()->GetPrimaryMainFrame()
+                  ->GetSiteInstance()
+                  ->GetSecurityPrincipal()
+                  .IsWebUI());
+  ExpectPageScheme(blink::mojom::PreferredColorScheme::kDark);
+}
+
+IN_PROC_BROWSER_TEST_F(CoveDefaultWebAppearanceTest,
+                       ExplicitDarkChoiceOverridesLightSystem) {
+  theme_service()->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kDark);
+  // Selecting dark is explicit even though it equals Cove's registered default.
+  ASSERT_FALSE(browser()->GetProfile()->GetPrefs()
+                   ->FindPreference(prefs::kBrowserColorScheme)
+                   ->IsDefaultValue());
+  ASSERT_TRUE(content::NavigateToURL(
+      contents(), chrome_test_utils::GetTestUrl(
+                      base::FilePath(base::FilePath::kCurrentDirectory),
+                      base::FilePath(FILE_PATH_LITERAL(
+                          "prefers-color-scheme.html")))));
+  ExpectPageScheme(blink::mojom::PreferredColorScheme::kDark);
+}
 
