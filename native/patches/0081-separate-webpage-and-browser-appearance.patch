+bool ShouldDefaultCovePagesFollowSystemAppearance(Profile* profile) {
+  const PrefService* prefs = profile->GetPrefs();
+  // Cove's default dark chrome is independent of the ambient website theme.
+  // Explicit user or managed appearance choices retain Chromium's behavior.
+  for (const char* pref_name :
+       {prefs::kBrowserColorScheme, prefs::kUserColor,
+        prefs::kBrowserColorVariant, prefs::kGrayscaleThemeEnabled}) {
+    const auto* preference = prefs->FindPreference(pref_name);
+    if (!preference || !preference->IsDefaultValue()) {
+      return false;
+    }
+  }
+  const ThemeService* theme_service =
+      ThemeServiceFactory::GetForProfile(profile);
+  return theme_service && theme_service->UsingDefaultTheme() &&
+         !theme_service->UsingExtensionTheme() &&
+         !theme_service->UsingPolicyTheme() &&
+         theme_service->GetBrowserColorScheme() ==
+             ThemeService::BrowserColorScheme::kDark &&
+         theme_service->GetUserColor() == SkColorSetRGB(0x7E, 0x6C, 0xA8);
+}
