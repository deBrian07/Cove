 // BrowserFrameViewMac, BrowserFrameView implementation:
 
 void BrowserFrameViewMac::OnFullscreenStateChanged() {
+  // Undo only Cove's windowed hiding before AppKit/immersive takes ownership.
+  UpdateCoveCaptionButtonsVisibility();
   if (GetBrowserView()->IsFullscreen()) {
     PictureInPictureWindowManager::GetInstance()
         ->OnAnyBrowserEnteredFullscreen();
@@ -458,6 +460,7 @@
 BrowserFrameViewMac::BoundsAndMargins
 BrowserFrameViewMac::GetCaptionButtonBounds() const {
   BoundsAndMargins result;
+  if (!GetBrowserView()->ShouldShowCoveCaptionButtons()) return result;
 
   // In popups, the titlebar is system-drawn and the caption buttons aren't part
   // of the client area.
@@ -516,7 +519,20 @@
   }
 }
 
+void BrowserFrameViewMac::UpdateCoveCaptionButtonsVisibility() {
+  NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  if (!window) return;
+  const bool hide = !GetBrowserView()->ShouldShowCoveCaptionButtons();
+  if (hide == cove_hid_caption_buttons_) return;
+  for (NSWindowButton button : {NSWindowCloseButton, NSWindowMiniaturizeButton,
+                                NSWindowZoomButton}) {
+    [[window standardWindowButton:button] setHidden:hide];
+  }
+  cove_hid_caption_buttons_ = hide;
+}
+
 void BrowserFrameViewMac::Layout(PassKey) {
+  UpdateCoveCaptionButtonsVisibility();
   if (GetBrowserView()->IsWindowControlsOverlayEnabled()) {
     LayoutWindowControlsOverlay();
   }
