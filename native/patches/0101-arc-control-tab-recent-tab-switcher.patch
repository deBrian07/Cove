+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       ControlTabWalksTabsInRecentlyUsedOrder) {
+  Seed();
+  auto* model = browser()->GetTabStripModel();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Zero</title>")));
+  auto* zero = model->GetActiveWebContents();
+  auto* one = chrome::AddAndReturnTabAt(
+      browser(), GURL("data:text/html,<title>One</title>"), -1, true);
+  auto* two = chrome::AddAndReturnTabAt(
+      browser(), GURL("data:text/html,<title>Two</title>"), -1, true);
+  ASSERT_TRUE(content::WaitForLoadStop(two));
+  model->ActivateTabAt(model->GetIndexOfWebContents(zero));
+  ASSERT_EQ(zero, model->GetActiveWebContents());
+  ASSERT_TRUE(content::ExecJs(zero, "window.draft='zero'"));
+
+  bool held = true;
+  library()->SetControlKeyProbeForTesting(
+      base::BindLambdaForTesting([&] { return held; }));
+  // Recently used order is zero, two, one, not strip order.
+  EXPECT_TRUE(chrome::ExecuteCommand(browser(), IDC_COVE_RECENT_TAB));
+  ASSERT_TRUE(library()->IsRecentTabSwitcherOpenForTesting());
+  EXPECT_TRUE(library()->RecentTabSwitcherForTesting()->IsVisible());
+  EXPECT_EQ(two, library()->RecentTabSwitcherSelectionForTesting());
+  EXPECT_EQ(zero, model->GetActiveWebContents());
+  chrome::ExecuteCommand(browser(), IDC_COVE_RECENT_TAB);
+  EXPECT_EQ(one, library()->RecentTabSwitcherSelectionForTesting());
+  chrome::ExecuteCommand(browser(), IDC_COVE_RECENT_TAB);
+  EXPECT_EQ(zero, library()->RecentTabSwitcherSelectionForTesting());
+  chrome::ExecuteCommand(browser(), IDC_COVE_RECENT_TAB_BACK);
+  chrome::ExecuteCommand(browser(), IDC_COVE_RECENT_TAB_BACK);
+  EXPECT_EQ(two, library()->RecentTabSwitcherSelectionForTesting());
+  library()->TickRecentTabSwitcherForTesting();
+  EXPECT_TRUE(library()->IsRecentTabSwitcherOpenForTesting());
+  Layout();
+
+  held = false;
+  library()->TickRecentTabSwitcherForTesting();
+  EXPECT_FALSE(library()->IsRecentTabSwitcherOpenForTesting());
+  EXPECT_EQ(two, model->GetActiveWebContents());
+
+  // A quick tap returns to the previous tab.
+  chrome::ExecuteCommand(browser(), IDC_COVE_RECENT_TAB);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !library()->IsRecentTabSwitcherOpenForTesting(); }));
+  EXPECT_EQ(zero, model->GetActiveWebContents());
+  EXPECT_EQ("zero", content::EvalJs(zero, "window.draft"));
+
+  // Shift goes to the least recently used tab first; clicking a tab ends the
+  // switch there.
+  held = true;
+  chrome::ExecuteCommand(browser(), IDC_COVE_RECENT_TAB_BACK);
+  EXPECT_EQ(one, library()->RecentTabSwitcherSelectionForTesting());
+  model->ActivateTabAt(model->GetIndexOfWebContents(two));
+  EXPECT_FALSE(library()->IsRecentTabSwitcherOpenForTesting());
+  EXPECT_EQ(two, model->GetActiveWebContents());
 }
