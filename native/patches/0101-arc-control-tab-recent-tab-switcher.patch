+namespace {
+constexpr size_t kRecentSwitcherRows = 8;
+constexpr int kRecentSwitcherWidth = 340;
+constexpr int kRecentSwitcherRowHeight = 34;
+constexpr base::TimeDelta kRecentSwitcherPoll = base::Milliseconds(16);
+}  // namespace
+
+void CoveSidebarLibraryView::NoteActiveTab() {
+  auto* tab = browser_ ? browser_->GetTabStripModel()->GetActiveTab() : nullptr;
+  if (!tab) {
+    return;
+  }
+  const auto handle = tab->GetHandle();
+  std::erase_if(recent_tabs_, [&](const tabs::TabHandle& item) {
+    return item == handle || !item.Get();
+  });
+  recent_tabs_.insert(recent_tabs_.begin(), handle);
+}
+
+std::vector<tabs::TabHandle> CoveSidebarLibraryView::RecentTabOrder() const {
+  TabStripModel* model = browser_->GetTabStripModel();
+  std::vector<tabs::TabHandle> order;
+  const auto add = [&](tabs::TabInterface* tab) {
+    if (tab && model->GetIndexOfTab(tab) != TabStripModel::kNoTab &&
+        !std::ranges::contains(order, tab->GetHandle())) {
+      order.push_back(tab->GetHandle());
+    }
+  };
+  // The shown tab leads even if it became active during a Space switch.
+  add(model->GetActiveTab());
+  for (const auto& handle : recent_tabs_) {
+    add(handle.Get());
+  }
+  for (auto* tab : *model) {
+    add(tab);
+  }
+  return order;
+}
+
+void CoveSidebarLibraryView::StepRecentTab(bool forward) {
+  if (!browser_ || switching_space_ || restoring_session_ ||
+      closing_active_space_) {
+    return;
+  }
+  if (!recent_switcher_) {
+    switcher_tabs_ = RecentTabOrder();
+    if (switcher_tabs_.size() < 2) {
+      return;
+    }
+    switcher_index_ = forward ? 1 : switcher_tabs_.size() - 1;
+    ShowRecentTabSwitcher();
+    return;
+  }
+  const size_t count = switcher_tabs_.size();
+  switcher_index_ = forward ? (switcher_index_ + 1) % count
+                            : (switcher_index_ + count - 1) % count;
+  UpdateRecentTabSwitcher();
+}
+
+content::WebContents*
+CoveSidebarLibraryView::RecentTabSwitcherSelectionForTesting() const {
+  if (!recent_switcher_ || switcher_index_ >= switcher_tabs_.size()) {
+    return nullptr;
+  }
+  auto* tab = switcher_tabs_.at(switcher_index_).Get();
+  return tab ? tab->GetContents() : nullptr;
+}
+
+void CoveSidebarLibraryView::ShowRecentTabSwitcher() {
+  views::Widget* parent = GetWidget() ? GetWidget()->GetTopLevelWidget()
+                                      : nullptr;
+  if (!parent) {
+    CommitRecentTab();
+    return;
+  }
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.parent = parent->GetNativeView();
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+  params.name = "CoveRecentTabSwitcher";
+  recent_switcher_ = std::make_unique<views::Widget>(std::move(params));
+  recent_switcher_->SetContentsView(std::make_unique<views::View>());
+  UpdateRecentTabSwitcher();
+  recent_switcher_->ShowInactive();
+  // A quick Control-Tab tap is released before the first poll and switches
+  // straight to the previous tab, as in Arc.
+  switcher_release_timer_.Start(
+      FROM_HERE, kRecentSwitcherPoll,
+      base::BindRepeating(&CoveSidebarLibraryView::OnRecentTabSwitcherTick,
+                          base::Unretained(this)));
+}
+
+void CoveSidebarLibraryView::UpdateRecentTabSwitcher() {
+  if (!recent_switcher_) {
+    return;
   }
+  auto* contents = recent_switcher_->GetContentsView();
+  contents->RemoveAllChildViews();
+  auto* layout = contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(8), 2));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  const SkColor panel = MixColors(active_sidebar_, SK_ColorBLACK, 0.15f);
+  const SkColor text = color_utils::GetColorWithMaxContrast(panel);
+  contents->SetBackground(views::CreateRoundedRectBackground(panel, 12));
+
+  const size_t count = switcher_tabs_.size();
+  const size_t rows = std::min(count, kRecentSwitcherRows);
+  const size_t first =
+      switcher_index_ < rows ? 0 : switcher_index_ + 1 - rows;
+  for (size_t i = first; i < first + rows; ++i) {
+    auto* tab = switcher_tabs_.at(i).Get();
+    auto* row = contents->AddChildView(std::make_unique<views::View>());
+    auto* row_layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 10),
+        10));
+    row_layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    row->SetPreferredSize(
+        gfx::Size(kRecentSwitcherWidth - 16, kRecentSwitcherRowHeight));
+    if (i == switcher_index_) {
+      row->SetBackground(
+          views::CreateRoundedRectBackground(active_highlight_, 8));
+    }
+    auto* icon = row->AddChildView(std::make_unique<views::ImageView>());
+    icon->SetImageSize(gfx::Size(16, 16));
+    auto* driver = tab ? favicon::ContentFaviconDriver::FromWebContents(
+                             tab->GetContents())
+                       : nullptr;
+    if (driver && driver->FaviconIsValid() && !driver->GetFavicon().IsEmpty()) {
+      icon->SetImage(ui::ImageModel::FromImage(driver->GetFavicon()));
+    } else {
+      icon->SetImage(ui::ImageModel::FromVectorIcon(vector_icons::kGlobeIcon,
+                                                    text, 16));
+    }
+    std::u16string title = tab ? tab->GetContents()->GetTitle() : u"";
+    if (title.empty() && tab) {
+      title = base::UTF8ToUTF16(tab->GetContents()->GetVisibleURL().spec());
+    }
+    auto* label = row->AddChildView(std::make_unique<views::Label>(title));
+    // The panel is translucent, so text must use grayscale antialiasing.
+    label->SetSubpixelRenderingEnabled(false);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetElideBehavior(gfx::ELIDE_TAIL);
+    label->SetEnabledColor(text);
+    label->SetAutoColorReadabilityEnabled(false);
+    row_layout->SetFlexForView(label, 1);
+  }
+
+  views::Widget* parent = recent_switcher_->parent();
+  const gfx::Rect window =
+      parent ? parent->GetWindowBoundsInScreen() : gfx::Rect();
+  const gfx::Size size(kRecentSwitcherWidth,
+                       contents->GetPreferredSize().height());
+  gfx::Rect bounds(size);
+  bounds.set_origin(gfx::Point(window.CenterPoint().x() - size.width() / 2,
+                               window.CenterPoint().y() - size.height() / 2));
+  recent_switcher_->SetBounds(bounds);
+  contents->InvalidateLayout();
+  contents->SchedulePaint();
 }
+
+void CoveSidebarLibraryView::OnRecentTabSwitcherTick() {
+  const bool held =
+      control_key_probe_ ? control_key_probe_.Run() : CoveIsControlKeyDown();
+  if (!held) {
+    CommitRecentTab();
+  }
+}
+
+void CoveSidebarLibraryView::CommitRecentTab() {
+  tabs::TabInterface* tab = switcher_index_ < switcher_tabs_.size()
+                                ? switcher_tabs_.at(switcher_index_).Get()
+                                : nullptr;
+  CloseRecentTabSwitcher();
+  if (!tab || !browser_) {
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  const int index = model->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab) {
+    model->ActivateTabAt(index);
+  }
+}
+
+void CoveSidebarLibraryView::CloseRecentTabSwitcher() {
+  switcher_release_timer_.Stop();
+  switcher_tabs_.clear();
+  switcher_index_ = 0;
+  if (recent_switcher_) {
+    recent_switcher_->CloseNow();
+    recent_switcher_.reset();
+  }
+}
