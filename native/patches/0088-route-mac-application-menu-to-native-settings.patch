+IN_PROC_BROWSER_TEST_F(CoveSettingsBrowserTest,
+                       MacApplicationMenuOpensNativeSettingsWithoutNavigation) {
+  auto* model = browser()->GetTabStripModel();
+  const int tab_count = model->count();
+  const GURL original_url = model->GetActiveWebContents()->GetVisibleURL();
+  NSMenu* application_menu = [[NSApp.mainMenu itemAtIndex:0] submenu];
+  ASSERT_TRUE(application_menu);
+  NSMenuItem* item = [application_menu itemWithTag:IDC_OPTIONS];
+  ASSERT_TRUE(item);
+  EXPECT_EQ(@selector(showPreferences:), item.action);
+  views::NamedWidgetShownWaiter opened(views::test::AnyWidgetTestPasskey{},
+                                       "CoveSettings");
+  ASSERT_TRUE([NSApp sendAction:item.action to:item.target from:item]);
+  auto* window = opened.WaitIfNeededAndGet();
+  ASSERT_TRUE(window);
+  EXPECT_TRUE(window->IsVisible());
+  EXPECT_TRUE(SettingsButton(window->GetContentsView(), u"Profiles"));
+  EXPECT_EQ(tab_count, model->count());
+  EXPECT_EQ(original_url, model->GetActiveWebContents()->GetVisibleURL());
+  window->CloseNow();
+}
