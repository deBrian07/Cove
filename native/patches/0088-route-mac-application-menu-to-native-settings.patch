+  CloseBrowserSynchronously(browser());
+  EXPECT_FALSE(
+      ProfileBrowserCollection::GetForProfile(profile)->GetLastActiveBrowser());
+  views::NamedWidgetShownWaiter opened(views::test::AnyWidgetTestPasskey{},
+                                       "CoveSettings");
