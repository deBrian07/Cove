+bool HasButtonLabeled(views::View* root, std::u16string_view text) {
+  if (auto* button = views::AsViewClass<views::LabelButton>(root);
+      button && button->GetText() == text) {
+    return true;
+  }
+  for (const auto& child : root->children()) {
+    if (HasButtonLabeled(child.get(), text)) {
+      return true;
+    }
+  }
+  return false;
+}
