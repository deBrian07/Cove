+void CoveSidebarLibraryView::UpdatePinRowAppearance() {
+  TabStripModel* model = browser_->GetTabStripModel();
+  std::map<std::string, content::WebContents*> bound_contents;
+  std::string active_pin_id;
+  for (int index = 0; index < model->count(); ++index) {
+    const auto* tab = model->GetTabAtIndex(index);
+    if (!tab) {
+      continue;
+    }
+    const auto binding = tab_pin_ids_.find(tab->GetHandle().raw_value());
+    if (binding == tab_pin_ids_.end() ||
+        binding->second.first != active_space_id_) {
+      continue;
+    }
+    bound_contents[binding->second.second] = tab->GetContents();
+    if (index == model->active_index()) {
+      active_pin_id = binding->second.second;
+    }
+  }
+
+  // Mutate existing rows only: their callbacks, focus and native menu ownership
+  // remain intact while selection changes or a bound tab navigates away.
+  for (const auto& [view, pin_id] : row_pin_ids_) {
+    auto* row = views::AsViewClass<views::LabelButton>(view);
+    if (!row) {
+      continue;
+    }
+    const bool selected = !active_pin_id.empty() && pin_id == active_pin_id;
+    row->SetBackground(
+        selected ? views::CreateRoundedRectBackground(
+                       kColorTabBackgroundActiveFrameActive, 8)
+                 : nullptr);
+    if (selected) {
+      row->SetEnabledTextColors(kColorTabForegroundActiveFrameActive);
+    } else {
+      row->SetEnabledTextColors(ui::kColorLabelForeground);
+    }
+    row->GetViewAccessibility().SetIsSelected(selected);
+    row->SetFocusRingCornerRadius(8);
+    row->SetImageLabelSpacing(8);
+    ui::ImageModel icon = ui::ImageModel::FromVectorIcon(
+        vector_icons::kGlobeIcon, ui::kColorIcon, 16);
+    const auto contents = bound_contents.find(pin_id);
+    if (contents != bound_contents.end() && contents->second) {
+      auto* driver =
+          favicon::ContentFaviconDriver::FromWebContents(contents->second);
+      if (driver && driver->FaviconIsValid()) {
+        const gfx::Image favicon = driver->GetFavicon();
+        if (!favicon.IsEmpty()) {
+          icon = ui::ImageModel::FromImage(favicon);
+        }
+      }
+    }
+    row->SetImageModel(views::Button::STATE_NORMAL, icon);
   }
 }
 
