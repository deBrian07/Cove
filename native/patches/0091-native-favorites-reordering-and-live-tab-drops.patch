+
+TabDragContext* CoveFavoritesView::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  OnTabDragEnded();
+  const auto* attached = controller.GetAttachedContext();
+  if (!attached || attached->GetWidget() != GetWidget()) return nullptr;
+  auto* context = const_cast<TabDragContext*>(attached);
+  if (!GetTabDragTarget(point_in_screen)) return context;
+  const auto& data = controller.GetSessionData();
+  if (data.num_dragging_tabs() != 1 || !data.dragging_groups.empty() ||
+      data.group_header_drag_data_) return context;
+  content::WebContents* contents = nullptr;
+  for (const auto& entry : data.tab_drag_data_) {
+    if (entry.contents) contents = entry.contents;
+  }
+  auto* tab = contents ? tabs::TabInterface::GetFromContents(contents) : nullptr;
+  if (!tab || tab->GetBrowserWindowInterface() != browser_ || tab->GetGroup() ||
+      tab->GetSplit() || !IsFavoriteUrl(contents->GetVisibleURL())) return context;
+  FavoriteDrop drop;
+  drop.url = contents->GetVisibleURL().spec();
+  drop.title = contents->GetTitle();
+  if (drop.url.size() > 8192) return context;
+  if (drop.title.size() > 4096) drop.title.resize(4096);
+  drop.before_url = BeforeUrlAt(
+      views::View::ConvertPointFromScreen(this, point_in_screen));
+  if (!BuildDropList(drop)) return context;
+  live_drag_handle_ = tab->GetHandle();
+  live_drop_ = std::move(drop);
+  if (row_urls_.empty()) {
+    if (!children().empty()) children().front()->SetBackground(
+        views::CreateRoundedRectBackground(ui::kColorSysPrimaryContainer, 12));
+    drop_indicator_ = GetLocalBounds();
+    drop_indicator_.Inset(2);
+    SchedulePaint();
+  } else {
+    SetDropIndicator(live_drop_->before_url);
+  }
+  return context;
+}
