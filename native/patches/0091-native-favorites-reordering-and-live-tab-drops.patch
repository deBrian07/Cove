+namespace {
+constexpr char kPref[] = "cove.sidebar";
+
+CoveFavoritesView* FindFavorites(views::View* root) {
+  if (auto* favorites = views::AsViewClass<CoveFavoritesView>(root)) {
+    return favorites;
+  }
+  for (const auto& child : root->children()) {
+    if (auto* favorites = FindFavorites(child.get())) {
+      return favorites;
+    }
+  }
+  return nullptr;
+}
+
+base::DictValue Favorite(const char* url, const char* title) {
+  return base::DictValue()
+      .Set("url", url)
+      .Set("title", title)
+      .Set("kept", title);
+}
+}  // namespace
+
+class CoveFavoritesDragBrowserTest : public InProcessBrowserTest {
+ protected:
+  CoveFavoritesView* Favorites(BrowserWindowInterface* window = nullptr) {
+    return FindFavorites(
+        BrowserView::GetBrowserViewForBrowser(window ? window : browser()));
+  }
+  void Seed(BrowserWindowInterface* window = nullptr) {
+    auto* target = window ? window : browser();
+    {
+      ScopedDictPrefUpdate update(target->GetProfile()->GetPrefs(), kPref);
+      base::ListValue favorites;
+      favorites.Append(base::Value());
+      favorites.Append(Favorite("https://a.example/", "A"));
+      favorites.Append(Favorite("https://b.example/", "B"));
+      favorites.Append(Favorite("https://c.example/", "C"));
+      update->Set("favorites", std::move(favorites));
+    }
+    BrowserView::GetBrowserViewForBrowser(target)
+        ->GetWidget()
+        ->LayoutRootViewIfNecessary();
+  }
+  const base::ListValue& Saved() {
+    return *browser()->GetProfile()->GetPrefs()->GetDict(kPref).FindList(
+        "favorites");
+  }
+  gfx::PointF AppendPoint(CoveFavoritesView* view) {
+    const auto bounds = view->children().back()->GetMirroredBounds();
+    return gfx::PointF(bounds.right() - 1, bounds.CenterPoint().y());
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(CoveFavoritesDragBrowserTest,
+                       NativeMovePreservesDataAndLivePage) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Drag page</title>")));
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(contents, "window.favoriteDropIdentity = 73"));
+  const int tabs = browser()->GetTabStripModel()->count();
+  const GURL page = contents->GetVisibleURL();
+  Seed();
+  auto* favorites = Favorites();
+  ASSERT_TRUE(favorites);
+  ASSERT_EQ(3u, favorites->children().size());
+  auto* source = favorites->children().front().get();
+  ui::OSExchangeData data;
+  favorites->WriteDragDataForView(source, gfx::Point(), &data);
+  ui::DropTargetEvent event(data, AppendPoint(favorites),
+                            AppendPoint(favorites),
+                            ui::DragDropTypes::DRAG_MOVE);
+  ASSERT_TRUE(favorites->CanDrop(data));
+  EXPECT_EQ(ui::DragDropTypes::DRAG_MOVE, favorites->OnDragUpdated(event));
+  const auto unchanged = Saved().Clone();
+  favorites->OnDragExited();
+  EXPECT_EQ(unchanged, Saved());
+  favorites->OnWillStartDragForView(source);
+  auto callback = favorites->GetDropCallback(event);
+  ASSERT_TRUE(callback);
+  auto operation = ui::mojom::DragOperation::kNone;
+  std::move(callback).Run(event, operation, nullptr);
+  EXPECT_EQ(ui::mojom::DragOperation::kMove, operation);
+  EXPECT_EQ(source, favorites->children().front().get());
+  EXPECT_TRUE(Saved()[0].is_none());
+  EXPECT_EQ("B", *Saved()[1].GetDict().FindString("kept"));
+  EXPECT_EQ("C", *Saved()[2].GetDict().FindString("kept"));
+  EXPECT_EQ("A", *Saved()[3].GetDict().FindString("kept"));
+  source->OnDragDone();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(contents, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(tabs, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(page, contents->GetVisibleURL());
+  EXPECT_EQ(73, content::EvalJs(contents, "window.favoriteDropIdentity"));
+}
+
+IN_PROC_BROWSER_TEST_F(CoveFavoritesDragBrowserTest,
+                       DropRevalidatesRemovedSourceAndDestination) {
+  Seed();
+  auto* favorites = Favorites();
+  ASSERT_TRUE(favorites);
+  ui::OSExchangeData data;
+  favorites->WriteDragDataForView(favorites->children().front().get(),
+                                  gfx::Point(), &data);
+  ui::DropTargetEvent event(data, AppendPoint(favorites),
+                            AppendPoint(favorites),
+                            ui::DragDropTypes::DRAG_MOVE);
+  auto callback = favorites->GetDropCallback(event);
+  ASSERT_TRUE(callback);
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kPref);
+    update->FindList("favorites")
+        ->erase(update->FindList("favorites")->begin() + 1);
+  }
+  const auto after_removal = Saved().Clone();
+  auto operation = ui::mojom::DragOperation::kMove;
+  std::move(callback).Run(event, operation, nullptr);
+  EXPECT_EQ(ui::mojom::DragOperation::kNone, operation);
+  EXPECT_EQ(after_removal, Saved());
+
+  Seed();
+  favorites = Favorites();
+  ui::OSExchangeData external;
+  external.SetURL(GURL("https://new.example/"), u"New");
+  const gfx::Rect target = favorites->children()[1]->GetMirroredBounds();
+  const gfx::PointF point(target.x(), target.CenterPoint().y());
+  ui::DropTargetEvent copy_event(external, point, point,
+                                 ui::DragDropTypes::DRAG_COPY);
+  auto copy = favorites->GetDropCallback(copy_event);
+  ASSERT_TRUE(copy);
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kPref);
+    update->FindList("favorites")
+        ->erase(update->FindList("favorites")->begin() + 2);
+  }
+  const auto after_target_removal = Saved().Clone();
+  operation = ui::mojom::DragOperation::kCopy;
+  std::move(copy).Run(copy_event, operation, nullptr);
+  EXPECT_EQ(ui::mojom::DragOperation::kNone, operation);
+  EXPECT_EQ(after_target_removal, Saved());
+}
+
+IN_PROC_BROWSER_TEST_F(
+    CoveFavoritesDragBrowserTest,
+    UrlCopyRejectsDuplicatesInvalidSchemesAndForeignProfile) {
+  Seed();
+  auto* favorites = Favorites();
+  ASSERT_TRUE(favorites);
+  ui::OSExchangeData external;
+  external.SetURL(GURL("https://new.example/"), u"New title");
+  ui::DropTargetEvent event(external, AppendPoint(favorites),
+                            AppendPoint(favorites),
+                            ui::DragDropTypes::DRAG_COPY);
+  auto callback = favorites->GetDropCallback(event);
+  ASSERT_TRUE(callback);
+  auto operation = ui::mojom::DragOperation::kNone;
+  std::move(callback).Run(event, operation, nullptr);
+  EXPECT_EQ(ui::mojom::DragOperation::kCopy, operation);
+  ASSERT_EQ(5u, Saved().size());
+  EXPECT_EQ("New title", *Saved().back().GetDict().FindString("title"));
+  EXPECT_FALSE(favorites->CanDrop(external));
+  ui::OSExchangeData invalid;
+  invalid.SetURL(GURL("javascript:alert(1)"), u"Invalid");
+  EXPECT_FALSE(favorites->CanDrop(invalid));
+  ui::OSExchangeData own;
+  favorites->WriteDragDataForView(favorites->children().front().get(),
+                                  gfx::Point(), &own);
+  auto* private_browser = CreateIncognitoBrowser(browser()->GetProfile());
+  Seed(private_browser);
+  auto* private_favorites = Favorites(private_browser);
+  ASSERT_TRUE(private_favorites);
+  EXPECT_FALSE(private_favorites->CanDrop(own));
+}
+
+IN_PROC_BROWSER_TEST_F(CoveFavoritesDragBrowserTest,
+                       ClosedDropOwnerAndAmbiguousSourceDoNotMutateFavorites) {
+  Seed();
+  auto* second = CreateBrowser(browser()->GetProfile());
+  auto* favorites = Favorites(second);
+  ASSERT_TRUE(favorites);
+  favorites->GetWidget()->LayoutRootViewIfNecessary();
+  ui::OSExchangeData data;
+  favorites->WriteDragDataForView(favorites->children().front().get(),
+                                  gfx::Point(), &data);
+  ui::DropTargetEvent event(data, AppendPoint(favorites),
+                            AppendPoint(favorites),
+                            ui::DragDropTypes::DRAG_MOVE);
+  auto callback = favorites->GetDropCallback(event);
+  ASSERT_TRUE(callback);
+  const auto saved = Saved().Clone();
+  CloseBrowserSynchronously(second);
+  auto operation = ui::mojom::DragOperation::kMove;
+  std::move(callback).Run(event, operation, nullptr);
+  EXPECT_EQ(ui::mojom::DragOperation::kNone, operation);
+  EXPECT_EQ(saved, Saved());
+
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kPref);
+    update->FindList("favorites")
+        ->Append(Favorite("https://a.example/", "Duplicate A"));
+  }
+  favorites = Favorites();
+  ASSERT_TRUE(favorites);
+  EXPECT_EQ(ui::DragDropTypes::DRAG_NONE,
+            favorites->GetDragOperationsForView(
+                favorites->children().front().get(), gfx::Point()));
+  EXPECT_FALSE(favorites->CanDrop(data));
+}
