+bool CoveFavoritesView::CanStartDragForView(views::View* sender,
+                                           const gfx::Point& press_pt,
+                                           const gfx::Point& point) {
+  return GetDragOperationsForView(sender, point) != ui::DragDropTypes::DRAG_NONE &&
+         views::View::ExceededDragThreshold(point - press_pt);
+}
