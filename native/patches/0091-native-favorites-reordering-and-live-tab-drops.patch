+
+std::string FavoriteProfileToken(Profile* profile) {
+  static const int key = 0;
+  auto* identity = static_cast<FavoriteProfileIdentity*>(profile->GetUserData(&key));
+  if (!identity) {
+    auto owned = std::make_unique<FavoriteProfileIdentity>();
+    identity = owned.get();
+    profile->SetUserData(&key, std::move(owned));
+  }
+  return identity->token.ToString();
+}
+
+const ui::ClipboardFormatType& FavoriteDragFormat() {
+  static const base::NoDestructor<ui::ClipboardFormatType> format(
+      ui::ClipboardFormatType::CustomPlatformType("CoveFavorites.v1"));
+  return *format;
+}
+
+std::optional<size_t> UniqueFavoriteIndex(const base::ListValue& favorites,
+                                          const std::string& url) {
+  std::optional<size_t> result;
+  for (size_t i = 0; i < favorites.size(); ++i) {
+    const auto* favorite = favorites[i].GetIfDict();
+    const auto* existing = favorite ? favorite->FindString("url") : nullptr;
+    if (existing && *existing == url) {
+      if (result) return std::nullopt;
+      result = i;
+    }
+  }
+  return result;
+}
+
 bool IsFavoriteUrl(const GURL& url) {
