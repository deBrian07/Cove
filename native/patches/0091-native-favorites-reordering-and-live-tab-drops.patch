+
+std::optional<CoveFavoritesView::FavoriteDrop> CoveFavoritesView::ReadDrop(
+    const ui::OSExchangeData& data) const {
+  if (collapsed_) return std::nullopt;
+  FavoriteDrop drop;
+  // Never reinterpret a malformed, stale or foreign-profile MOVE as a URL COPY.
+  if (data.HasCustomFormat(FavoriteDragFormat())) {
+    auto pickle = data.GetPickledData(FavoriteDragFormat());
+    if (!pickle || pickle->AsBytes().size() > 16384) return std::nullopt;
+    base::PickleIterator reader(*pickle);
+    std::string profile;
+    std::string otr;
+    if (!reader.ReadString(&profile) || !reader.ReadString(&otr) ||
+        !reader.ReadString(&drop.url) || !reader.ReachedEnd() ||
+        profile != FavoriteProfileToken(browser_->GetProfile()) ||
+        !otr.empty()) {
+      return std::nullopt;
+    }
+    drop.move = true;
+  } else {
+    const auto urls = data.GetURLs(ui::FilenameToURLPolicy::DO_NOT_CONVERT_FILENAMES);
+    if (urls.size() != 1) return std::nullopt;
+    drop.url = urls[0].url.spec();
+    drop.title = urls[0].title;
+    if (drop.title.size() > 4096) drop.title.resize(4096);
+  }
+  if (drop.url.size() > 8192 || !IsFavoriteUrl(GURL(drop.url))) return std::nullopt;
+  return drop;
+}
+
+std::optional<base::ListValue> CoveFavoritesView::BuildDropList(
+    const FavoriteDrop& drop) const {
+  const auto* saved = browser_->GetProfile()->GetPrefs()
+                          ->GetDict(kCoveSidebarPref).FindList("favorites");
+  base::ListValue next = saved ? saved->Clone() : base::ListValue();
+  base::Value value;
+  if (drop.move) {
+    const auto source = UniqueFavoriteIndex(next, drop.url);
+    if (!source || drop.before_url == drop.url) return std::nullopt;
+    value = next[*source].Clone();
+    next.erase(next.begin() + *source);
+  } else {
+    for (const auto& entry : next) {
+      const auto* dict = entry.GetIfDict();
+      const auto* url = dict ? dict->FindString("url") : nullptr;
+      if (url && GURL(*url) == GURL(drop.url)) return std::nullopt;
+    }
+    base::DictValue favorite;
+    favorite.Set("url", drop.url);
+    favorite.Set("title", base::UTF16ToUTF8(drop.title));
+    value = base::Value(std::move(favorite));
+  }
+  size_t index = next.size();
+  if (!drop.before_url.empty()) {
+    const auto before = UniqueFavoriteIndex(next, drop.before_url);
+    if (!before) return std::nullopt;
+    index = *before;
+  }
+  next.Insert(next.begin() + index, std::move(value));
+  if (saved && *saved == next) return std::nullopt;
+  return next;
+}
+
+bool CoveFavoritesView::CanDrop(const ui::OSExchangeData& data) {
+  const auto drop = ReadDrop(data);
+  if (!drop) return false;
+  // A valid existing Favorite can be moved even if appending would be a no-op.
+  if (drop->move) {
+    const auto* favorites = browser_->GetProfile()->GetPrefs()
+                                ->GetDict(kCoveSidebarPref).FindList("favorites");
+    return favorites && UniqueFavoriteIndex(*favorites, drop->url).has_value();
+  }
+  return BuildDropList(*drop).has_value();
+}
+
+std::string CoveFavoritesView::BeforeUrlAt(const gfx::Point& point) const {
+  for (const auto& child : children()) {
+    const auto found = row_urls_.find(child.get());
+    if (found == row_urls_.end()) continue;
+    const gfx::Rect bounds = child->GetMirroredBounds();
+    if (point.y() < bounds.y() ||
+        (point.y() < bounds.bottom() &&
+         (base::i18n::IsRTL() ? point.x() > bounds.CenterPoint().x()
+                              : point.x() < bounds.CenterPoint().x()))) {
+      return found->second;
+    }
+  }
+  return {};
+}
+
+void CoveFavoritesView::ClearDropIndicator() {
+  if (drop_indicator_.IsEmpty()) return;
+  if (row_urls_.empty() && !children().empty()) {
+    children().front()->SetBackground(views::CreateRoundedRectBackground(
+        kColorLocationBarBackground, 12));
+  }
+  drop_indicator_ = gfx::Rect();
+  SchedulePaint();
+}
+
+void CoveFavoritesView::SetDropIndicator(const std::string& before_url) {
+  ClearDropIndicator();
+  const views::View* target = nullptr;
+  for (const auto& child : children()) {
+    const auto row = row_urls_.find(child.get());
+    if (row == row_urls_.end()) continue;
+    target = child.get();
+    if (row->second == before_url) break;
+  }
+  if (!target) return;
+  const gfx::Rect bounds = target->GetMirroredBounds();
+  const bool leading = !before_url.empty();
+  const bool left = leading != base::i18n::IsRTL();
+  drop_indicator_ = gfx::Rect(left ? bounds.x() - 2 : bounds.right(),
+                              bounds.y(), 2, bounds.height());
+  SchedulePaint();
+}
+
+void CoveFavoritesView::OnDragEntered(const ui::DropTargetEvent& event) {
+  OnDragUpdated(event);
+}
+
+int CoveFavoritesView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  auto drop = ReadDrop(event.data());
+  if (!drop) { ClearDropIndicator(); return ui::DragDropTypes::DRAG_NONE; }
+  const int operation = drop->move ? ui::DragDropTypes::DRAG_MOVE
+                                    : ui::DragDropTypes::DRAG_COPY;
+  drop->before_url = BeforeUrlAt(event.location());
+  if (!(event.source_operations() & operation) || !BuildDropList(*drop)) {
+    ClearDropIndicator();
+    return ui::DragDropTypes::DRAG_NONE;
+  }
+  SetDropIndicator(drop->before_url);
+  return operation;
+}
+
+void CoveFavoritesView::OnDragExited() {
+  ClearDropIndicator();
+}
+
+views::View::DropCallback CoveFavoritesView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  if (OnDragUpdated(event) == ui::DragDropTypes::DRAG_NONE) return base::NullCallback();
+  auto drop = *ReadDrop(event.data());
+  drop.before_url = BeforeUrlAt(event.location());
+  ClearDropIndicator();
+  return base::BindOnce(
+      [](base::WeakPtr<CoveFavoritesView> owner, FavoriteDrop captured,
+          const ui::DropTargetEvent& event, ui::mojom::DragOperation& output,
+          std::unique_ptr<ui::LayerTreeOwner> image) {
+        output = ui::mojom::DragOperation::kNone;
+        if (owner) owner->PerformDrop(std::move(captured), event, output,
+                                      std::move(image));
+      }, weak_factory_.GetWeakPtr(), std::move(drop));
+}
+
+void CoveFavoritesView::PerformDrop(
+    FavoriteDrop drop, const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer) {
+  output = ui::mojom::DragOperation::kNone;
+  if (collapsed_) return;
+  auto favorites = BuildDropList(drop);
+  if (!favorites) return;
+  output = drop.move ? ui::mojom::DragOperation::kMove
+                      : ui::mojom::DragOperation::kCopy;
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(), kCoveSidebarPref);
+  update->Set("favorites", std::move(*favorites));
+}
+
