+}
+
+void CoveFavoritesView::WriteDragDataForView(views::View* sender,
+                                            const gfx::Point& press_pt,
+                                            ui::OSExchangeData* data) {
+  const auto row = row_urls_.find(sender);
+  if (row == row_urls_.end() ||
+      GetDragOperationsForView(sender, press_pt) == ui::DragDropTypes::DRAG_NONE) {
+    return;
+  }
+  base::Pickle pickle;
+  pickle.WriteString(FavoriteProfileToken(browser_->GetProfile()));
+  pickle.WriteString(std::string());
+  pickle.WriteString(row->second);
+  data->SetPickledData(FavoriteDragFormat(), pickle);
+  const auto* favorites = browser_->GetProfile()->GetPrefs()
+                              ->GetDict(kCoveSidebarPref).FindList("favorites");
+  const auto source = favorites ? UniqueFavoriteIndex(*favorites, row->second)
+                                : std::nullopt;
+  data->SetURL(GURL(row->second),
+               source ? FavoriteTitle((*favorites)[*source].GetDict())
+                      : base::UTF8ToUTF16(GURL(row->second).host()));
+}
+
+int CoveFavoritesView::GetDragOperationsForView(views::View* sender,
+                                               const gfx::Point& point) {
+  const auto row = row_urls_.find(sender);
+  const auto* favorites = browser_->GetProfile()->GetPrefs()
+                              ->GetDict(kCoveSidebarPref).FindList("favorites");
+  if (collapsed_ || row == row_urls_.end() || !favorites ||
+      row->second.size() > 8192 ||
+      !UniqueFavoriteIndex(*favorites, row->second)) {
+    return ui::DragDropTypes::DRAG_NONE;
+  }
+  return ui::DragDropTypes::DRAG_MOVE | ui::DragDropTypes::DRAG_COPY;
+}
