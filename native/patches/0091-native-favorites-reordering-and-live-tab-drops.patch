+bool CoveFavoritesView::CanDropTab() {
+  auto* tab = live_drag_handle_ ? live_drag_handle_->Get() : nullptr;
+  return tab && live_drop_ && tab->GetBrowserWindowInterface() == browser_ &&
+         !tab->GetGroup() && !tab->GetSplit() &&
+         tab->GetContents()->GetVisibleURL().spec() == live_drop_->url &&
+         BuildDropList(*live_drop_).has_value();
+}
+
+void CoveFavoritesView::HandleTabDrop(
+    TabDragTarget::DragController& controller) {
+  if (CanDropTab()) {
+    // Chromium retains the source tab and completes its native drag before a
+    // pref observer can rebuild the saved tiles. This is a saved URL copy,
+    // never a tab detach, navigation, pin or native selection mutation.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CoveFavoritesView::CommitLiveFavorite,
+                                  weak_factory_.GetWeakPtr(),
+                                  *live_drag_handle_, *live_drop_));
+  }
+  OnTabDragEnded();
+}
+
+void CoveFavoritesView::CommitLiveFavorite(tabs::TabHandle handle,
+                                          FavoriteDrop drop) {
+  auto* tab = handle.Get();
+  if (!tab || tab->GetBrowserWindowInterface() != browser_ || tab->GetGroup() ||
+      tab->GetSplit() ||
+      tab->GetContents()->GetVisibleURL().spec() != drop.url ||
+      !IsFavoriteUrl(GURL(drop.url))) return;
+  auto favorites = BuildDropList(drop);
+  if (!favorites) return;
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(), kCoveSidebarPref);
+  update->Set("favorites", std::move(*favorites));
+}
