+  EXPECT_FALSE(model->GetActiveTab()->IsPinned());
+  EXPECT_EQ(1, model->count());
+  EXPECT_EQ(entries, contents->GetController().GetEntryCount());
+  EXPECT_EQ(url, contents->GetVisibleURL());
+  EXPECT_EQ("unsent live drag draft",
+            content::EvalJs(contents, "window.coveLiveDragDraft"));
+  EXPECT_EQ(bounds, widget->GetWindowBoundsInScreen());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveLiveTabDragBrowserTest,
+                       CanceledFirstFavoriteDropHidesAffordanceAndKeepsPage) {
+  ASSERT_NO_FATAL_FAILURE(PreparePageAndFolder());
+  auto* model = browser()->GetTabStripModel();
+  auto* contents = model->GetActiveWebContents();
+  const auto before =
+      browser()->GetProfile()->GetPrefs()->GetDict("cove.sidebar").Clone();
+  auto* favorites = FindFavoritesView(browser_view());
+  ASSERT_TRUE(favorites);
+  EXPECT_FALSE(favorites->GetVisible());
+  auto* context = browser_view()->tab_strip_view()->GetDragContext();
+  auto* source = context->GetTabForContents(contents);
+  ASSERT_TRUE(source);
+  const auto bounds = browser_view()->GetWidget()->GetWindowBoundsInScreen();
+  ASSERT_NO_FATAL_FAILURE(BeginRealDrag(
+      context, source,
+      FindFolderRow(library())->GetBoundsInScreen().CenterPoint()));
+  browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+  ASSERT_TRUE(favorites->GetVisible());
+  const auto point = favorites->GetBoundsInScreen().CenterPoint();
+  ASSERT_EQ(TabDragController::Liveness::kAlive,
+            context->GetDragController()->Drag(point));
+  ASSERT_TRUE(favorites->CanDropTab());
+  context->GetDragController()->EndDrag(EndDragReason::kCancel);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(favorites->GetVisible());
+  EXPECT_EQ(before,
+            browser()->GetProfile()->GetPrefs()->GetDict("cove.sidebar"));
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_EQ(1, model->count());
+  EXPECT_FALSE(model->GetActiveTab()->IsPinned());
+  EXPECT_EQ(bounds, browser_view()->GetWidget()->GetWindowBoundsInScreen());
+  EXPECT_EQ("unsent live drag draft",
+            content::EvalJs(contents, "window.coveLiveDragDraft"));
+}
+
+IN_PROC_BROWSER_TEST_F(CoveLiveTabDragBrowserTest,
+                       SameUrlPagesKeepSeparateSavedPinsAndDrafts) {
+  ASSERT_NO_FATAL_FAILURE(PreparePageAndFolder());
+  auto* model = browser()->GetTabStripModel();
+  auto* first = model->GetActiveWebContents();
+  const GURL url = first->GetVisibleURL();
+  model->SetTabPinned(model->active_index(), true);
+  auto* second = chrome::AddAndReturnTabAt(browser(), url, -1, true);
+  ASSERT_TRUE(second);
+  ASSERT_TRUE(content::WaitForLoadStop(second));
+  ASSERT_TRUE(
+      content::ExecJs(second,
+                      "window.secondPinnedDraft = 'separate unsent draft';"
+                      "history.pushState({}, '', location.href);"));
+  ASSERT_EQ(url, second->GetVisibleURL());
+  const int first_history = first->GetController().GetEntryCount();
+  const int second_history = second->GetController().GetEntryCount();
+  const auto source_handle = model->GetActiveTab()->GetHandle();
+  browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+  auto* context = browser_view()->tab_strip_view()->GetDragContext();
+  auto* source = context->GetTabForContents(second);
+  ASSERT_TRUE(source);
+  ASSERT_NO_FATAL_FAILURE(BeginRealDrag(
+      context, source,
+      FindFolderRow(library())->GetBoundsInScreen().CenterPoint()));
+  browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+  ASSERT_EQ(TabDragController::Liveness::kAlive,
+            context->GetDragController()->Drag(
+                FindFolderRow(library())->GetBoundsInScreen().CenterPoint()));
+  ASSERT_TRUE(library()->CanDropTab());
+  context->GetDragController()->EndDrag(EndDragReason::kComplete);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(2, model->count());
+  EXPECT_EQ(2, model->IndexOfFirstNonPinnedTab());
+  ASSERT_TRUE(source_handle.Get());
+  EXPECT_EQ(second, source_handle.Get()->GetContents());
+  EXPECT_EQ(first_history, first->GetController().GetEntryCount());
+  EXPECT_EQ(second_history, second->GetController().GetEntryCount());
+  EXPECT_EQ("unsent live drag draft",
+            content::EvalJs(first, "window.coveLiveDragDraft"));
+  EXPECT_EQ("separate unsent draft",
+            content::EvalJs(second, "window.secondPinnedDraft"));
+  const auto* space = PersonalSpace(browser()->GetProfile());
+  ASSERT_TRUE(space);
+  ASSERT_TRUE(space->FindList("pins"));
+  ASSERT_EQ(2u, space->FindList("pins")->size());
+  const auto& pins = *space->FindList("pins");
+  EXPECT_NE(*pins.front().GetDict().FindString("id"),
+            *pins.back().GetDict().FindString("id"));
+  EXPECT_EQ(url.spec(), *pins.front().GetDict().FindString("url"));
+  EXPECT_EQ(url.spec(), *pins.back().GetDict().FindString("url"));
+  EXPECT_EQ(kFolderId, *pins.back().GetDict().FindString("folder"));
+}
