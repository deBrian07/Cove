+void CoveSidebarLibraryView::SelectAdjacentSpace(bool forward) {
+  const auto* spaces = browser_->GetProfile()->GetPrefs()
+                           ->GetDict(kCoveSidebarPref).FindList("spaces");
+  if (!spaces) return;
+  std::vector<std::string> ids;
+  for (const auto& value : *spaces) {
+    const auto* item = value.GetIfDict();
+    if (item && item->FindString("id")) ids.push_back(*item->FindString("id"));
+  }
+  const auto current = std::ranges::find(ids, active_space_id_);
+  if (current == ids.end()) return;
+  const int index = static_cast<int>(current - ids.begin());
+  const int next = std::clamp(index + (forward ? 1 : -1), 0,
+                              static_cast<int>(ids.size()) - 1);
+  if (next != index) SwitchSpace(ids[next]);
+}
