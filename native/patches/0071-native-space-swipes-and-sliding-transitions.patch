+void VerticalTabStripFocusSwipeController::ProcessSpaceSwipe(
+    float dx, float dy, cove::SpaceSwipeState::Phase phase, ui::Event* event) {
+  if (region_view_->IsDragging()) {
+    space_swipe_.Reset();
+    return;
+  }
+  if (!space_swipe_.horizontal() && !region_view_->IsSpaceSwipeTarget(*event)) {
+    space_swipe_.Reset();
+    return;
+  }
+  using Result = cove::SpaceSwipeState::Result;
+  const auto result = space_swipe_.Update(dx, dy, phase, base::TimeTicks::Now());
+  if (result == Result::kPass) return;
+  event->SetHandled();
+  event->StopPropagation();
+  if (result == Result::kNext || result == Result::kPrevious) {
+    bool forward = result == Result::kNext;
+    if (base::i18n::IsRTL()) forward = !forward;
+    space_navigation_.Run(forward);
+  }
+}
