@@ -0,0 +1,59 @@
+// Copyright 2026 The Cove Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_COVE_SPACE_SWIPE_STATE_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_COVE_SPACE_SWIPE_STATE_H_
+#include <cmath>
+#include "base/time/time.h"
+
+namespace cove {
+// One decision per physical touch. Momentum never changes the selected Space.
+class SpaceSwipeState {
+ public:
+  enum class Phase { kNone, kBegin, kUpdate, kEnd, kMomentum, kMomentumEnd };
+  enum class Result { kPass, kConsume, kNext, kPrevious };
+  bool horizontal() const { return axis_ == Axis::kHorizontal; }
+  void Reset() { axis_ = Axis::kNone; x_ = y_ = 0; triggered_ = false; last_ = {}; }
+  Result Update(float dx, float dy, Phase phase, base::TimeTicks now) {
+    if (phase == Phase::kBegin ||
+        (phase == Phase::kNone && !last_.is_null() &&
+         now - last_ > base::Milliseconds(300))) {
+      Reset();
+    }
+    last_ = now;
+    if (phase == Phase::kMomentum || phase == Phase::kMomentumEnd) {
+      const auto result = horizontal() ? Result::kConsume : Result::kPass;
+      if (phase == Phase::kMomentumEnd) Reset();
+      return result;
+    }
+    if (phase == Phase::kEnd) {
+      const auto result = horizontal() ? Result::kConsume : Result::kPass;
+      Reset();
+      return result;
+    }
+    if (axis_ == Axis::kVertical) return Result::kPass;
+    x_ += dx; y_ += dy;
+    if (axis_ == Axis::kNone) {
+      if (std::abs(y_) >= 15 && std::abs(y_) > 1.2f * std::abs(x_)) {
+        axis_ = Axis::kVertical;
+        return Result::kPass;
+      }
+      if (std::abs(x_) >= 15 && std::abs(x_) > 1.2f * std::abs(y_))
+        axis_ = Axis::kHorizontal;
+    }
+    if (!horizontal()) return Result::kPass;
+    if (!triggered_ && std::abs(x_) >= 75) {
+      triggered_ = true;
+      return x_ < 0 ? Result::kNext : Result::kPrevious;
+    }
+    return Result::kConsume;
+  }
+ private:
+  enum class Axis { kNone, kHorizontal, kVertical };
+  Axis axis_ = Axis::kNone;
+  float x_ = 0, y_ = 0;
+  bool triggered_ = false;
+  base::TimeTicks last_;
+};
+}  // namespace cove
+#endif
