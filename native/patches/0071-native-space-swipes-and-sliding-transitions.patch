+// Copyright 2026 The Cove Authors
+#include "chrome/browser/ui/views/tabs/vertical/cove_space_swipe_state.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace cove {
+using Phase = SpaceSwipeState::Phase;
+using Result = SpaceSwipeState::Result;
+TEST(CoveSpaceSwipe, AccumulatesAndSwitchesOnce) {
+  SpaceSwipeState s; const auto t = base::TimeTicks::Now();
+  EXPECT_EQ(Result::kConsume, s.Update(-30, 0, Phase::kBegin, t));
+  EXPECT_EQ(Result::kNext, s.Update(-50, 0, Phase::kUpdate, t));
+  EXPECT_EQ(Result::kConsume, s.Update(-400, 0, Phase::kUpdate, t));
+  EXPECT_EQ(Result::kConsume, s.Update(800, 0, Phase::kUpdate, t));
+}
+TEST(CoveSpaceSwipe, VerticalGestureKeepsScrolling) {
+  SpaceSwipeState s; const auto t = base::TimeTicks::Now();
+  EXPECT_EQ(Result::kPass, s.Update(1, 30, Phase::kBegin, t));
+  EXPECT_EQ(Result::kPass, s.Update(-200, 0, Phase::kUpdate, t));
+}
+TEST(CoveSpaceSwipe, MomentumNeverSwitches) {
+  SpaceSwipeState s; const auto t = base::TimeTicks::Now();
+  EXPECT_EQ(Result::kPass, s.Update(-200, 0, Phase::kMomentum, t));
+  EXPECT_EQ(Result::kPass, s.Update(200, 0, Phase::kMomentumEnd, t));
+}
+TEST(CoveSpaceSwipe, FingersLiftAllowsOppositeGesture) {
+  SpaceSwipeState s; const auto t = base::TimeTicks::Now();
+  EXPECT_EQ(Result::kNext, s.Update(-90, 0, Phase::kBegin, t));
+  EXPECT_EQ(Result::kConsume, s.Update(0, 0, Phase::kEnd, t));
+  EXPECT_EQ(Result::kPrevious, s.Update(90, 0, Phase::kBegin, t));
+}
+TEST(CoveSpaceSwipe, TouchPauseDoesNotSwitchTwice) {
+  SpaceSwipeState s; const auto t = base::TimeTicks::Now();
+  EXPECT_EQ(Result::kNext, s.Update(-90, 0, Phase::kBegin, t));
+  EXPECT_EQ(Result::kConsume, s.Update(-200, 0, Phase::kUpdate, t + base::Seconds(3)));
+}
+TEST(CoveSpaceSwipe, WheelBurstResetsAfterPause) {
+  SpaceSwipeState s; const auto t = base::TimeTicks::Now();
+  EXPECT_EQ(Result::kNext, s.Update(-90, 0, Phase::kNone, t));
+  EXPECT_EQ(Result::kConsume, s.Update(-90, 0, Phase::kNone, t + base::Milliseconds(20)));
+  EXPECT_EQ(Result::kNext, s.Update(-90, 0, Phase::kNone, t + base::Seconds(1)));
+}
+TEST(CoveSpaceSwipe, DiagonalAndTinyJitterDoNotSwitch) {
+  SpaceSwipeState s; const auto t = base::TimeTicks::Now();
+  EXPECT_EQ(Result::kPass, s.Update(5, 5, Phase::kBegin, t));
+  EXPECT_EQ(Result::kPass, s.Update(-100, -100, Phase::kBegin, t));
+}
+TEST(CoveSpaceSwipe, MomentumAfterTouchCannotAddAnotherStep) {
+  SpaceSwipeState s; const auto t = base::TimeTicks::Now();
+  EXPECT_EQ(Result::kNext, s.Update(-90, 0, Phase::kBegin, t));
+  s.Update(0, 0, Phase::kEnd, t);
+  EXPECT_EQ(Result::kPass, s.Update(-900, 0, Phase::kMomentum, t));
+}
+}  // namespace cove
