+bool VerticalTabStripRegionView::IsSpaceSwipeTarget(const ui::Event& event) const {
+  if (!event.target()) return true;
+  const auto* target = static_cast<const views::View*>(event.target());
+  return (!location_view_ || !location_view_->Contains(target)) &&
+         (!top_button_container_ || !top_button_container_->Contains(target));
+}
+
+void VerticalTabStripRegionView::ClearSpaceTransition() {
+  ++space_transition_generation_;
+  space_animation_.reset();
+  space_snapshot_.reset();
+  if (space_rows_view_ && space_rows_view_->layer())
+    space_rows_view_->layer()->SetTransform(gfx::Transform());
+}
+
+void VerticalTabStripRegionView::BeginSpaceTransition(int direction) {
+  ClearSpaceTransition();
+  if (!gfx::Animation::ShouldRenderRichAnimation() || !GetWidget() ||
+      !GetWidget()->IsVisible() || width() < kUncollapsedMinWidth ||
+      !space_rows_view_->layer() || space_clip_view_->width() <= 0) return;
+  space_direction_ = base::i18n::IsRTL() ? -direction : direction;
+  auto old = space_rows_view_->RecreateLayer();
+  space_rows_view_->SchedulePaint();
+  SnapshotChildLayers(space_rows_view_, old.get());
+  space_snapshot_ = std::make_unique<ui::LayerTreeOwner>(std::move(old));
+}
+
+void VerticalTabStripRegionView::FinishSpaceTransition() {
+  if (!space_snapshot_ || !GetWidget()) return;
+  GetWidget()->LayoutRootViewIfNecessary();
+  const int distance = space_clip_view_->width() * space_direction_;
+  gfx::Transform incoming;
+  incoming.Translate(distance, 0);
+  space_rows_view_->layer()->SetTransform(incoming);
+  gfx::Transform outgoing;
+  outgoing.Translate(-distance, 0);
+  views::AnimationBuilder animation;
+  animation.OnEnded(base::BindOnce(
+      [](base::WeakPtr<VerticalTabStripRegionView> region, int generation) {
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(
+                [](base::WeakPtr<VerticalTabStripRegionView> view, int expected) {
+                  if (view && view->space_transition_generation_ == expected)
+                    view->ClearSpaceTransition();
+                }, region, generation));
+      }, weak_factory_.GetWeakPtr(), space_transition_generation_));
+  space_animation_ = animation.GetAbortHandle();
+  animation.Once().SetDuration(base::Milliseconds(240))
+      .SetTransform(space_rows_view_->layer(), gfx::Transform(), gfx::Tween::EASE_OUT)
+      .SetTransform(space_snapshot_->root(), outgoing, gfx::Tween::EASE_OUT);
+}
