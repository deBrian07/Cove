+    ui::Layer* old_child_parent = old_parent;
+    if (child->layer()) {
+      auto old = child->RecreateLayer();
+      child->SchedulePaint();
+      if (old->parent()) old->parent()->Remove(old.get());
+      old_parent->Add(old.get());
+      old_child_parent = old.release();
+    }
+    SnapshotChildLayers(child, old_child_parent);
+  }
+}
 
