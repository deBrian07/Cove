+
+IN_PROC_BROWSER_TEST_F(CoveSessionBrowserTest,
+                       ImmediateJournalResetRetainsNewMarkedBlankCanvas) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Existing personal page</title>")));
+  // Do not pump the event loop after creating Work: an initial empty history
+  // entry with a pending about:blank must be saved as well as a committed one.
+  Library(browser())->FocusSpace("work");
+  auto* canvas = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(canvas);
+  ASSERT_TRUE(IsCoveEmptyCanvas(canvas));
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  ReadRebuild(windows);
+  ASSERT_EQ(1u, windows.size());
+  ASSERT_EQ(2u, windows[0]->tabs.size());
+  bool found_canvas = false;
+  for (const auto& tab : windows[0]->tabs) {
+    const auto state =
+        DecodeCoveTabSessionState(tab->extra_data.at(kCoveTabSessionKey));
+    ASSERT_TRUE(state);
+    if (state->space != "work") continue;
+    found_canvas = true;
+    EXPECT_TRUE(state->canvas);
+    ASSERT_EQ(1u, tab->navigations.size());
+    EXPECT_EQ(GURL("about:blank"), tab->navigations[0].virtual_url());
+  }
+  EXPECT_TRUE(found_canvas);
+}
