+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       NativeFallbackPinsRemainReachableInUnifiedSidebar) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+      GURL("data:text/html,<title>Today remains reachable</title>")));
+  Seed();
+  auto* model = browser()->GetTabStripModel();
+  auto* today_contents = model->GetActiveWebContents();
+  content::WebContents* last_pin = nullptr;
+  for (int i = 0; i < 12; ++i) {
+    // Unsupported saved-pin URLs retain Chromium's native pinned grid.
+    // Its preferred height must not be capped inside a non-scrolling viewport.
+    last_pin = chrome::AddAndReturnTabAt(browser(), GURL("chrome://version/"), -1, false);
+    ASSERT_TRUE(last_pin);
+    ASSERT_TRUE(content::WaitForLoadStop(last_pin));
+    model->SetTabPinned(model->GetIndexOfWebContents(last_pin), true);
+  }
+  Layout();
+  ASSERT_EQ(13, model->count());
+  ASSERT_EQ(12, model->IndexOfFirstNonPinnedTab());
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* pin = RenderedTab(view, last_pin);
+  ASSERT_TRUE(pin);
+  pin->ScrollViewToVisible();
+  Layout();
+  EXPECT_GT(pin->height(), 0);
+  EXPECT_EQ(pin->height(), pin->GetVisibleBounds().height());
+  auto* today = RenderedTab(view, today_contents);
+  ASSERT_TRUE(today);
+  today->ScrollViewToVisible();
+  Layout();
+  EXPECT_EQ(today->height(), today->GetVisibleBounds().height());
+  EXPECT_EQ(13, model->count());
+  EXPECT_EQ(today_contents, model->GetActiveWebContents());
+}
