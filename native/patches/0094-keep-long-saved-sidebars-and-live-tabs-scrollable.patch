+IN_PROC_BROWSER_TEST_F(CoveLiveTabDragBrowserTest,
+                       ScrolledFolderDropKeepsLivePageAndHistory) {
+  ASSERT_NO_FATAL_FAILURE(PreparePageAndFolder());
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), "cove.sidebar");
+    for (auto& value : *update->FindList("spaces")) {
+      auto& space = value.GetDict();
+      if (*space.FindString("id") != "personal") continue;
+      auto target = space.FindList("folders")->front().Clone();
+      base::ListValue folders;
+      for (int i = 0; i < 60; ++i)
+        folders.Append(base::DictValue().Set("id", "scroll-folder-" + std::to_string(i))
+            .Set("name", "Scroll folder " + std::to_string(i))
+            .Set("parent", "").Set("collapsed", false));
+      folders.Append(std::move(target));
+      space.Set("folders", std::move(folders));
+    }
+  }
+  auto* model = browser()->GetTabStripModel();
+  auto* contents = model->GetActiveWebContents();
+  const auto handle = model->GetActiveTab()->GetHandle();
+  const auto bounds = browser_view()->GetWidget()->GetWindowBoundsInScreen();
+  const int entries = contents->GetController().GetEntryCount();
+  browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+  auto* context = browser_view()->tab_strip_view()->GetDragContext();
+  auto* source = context->GetTabForContents(contents);
+  ASSERT_TRUE(source);
+  // The drag adapter is an intentionally hidden child of the rendered row.
+  // Assert visibility and scroll using the displayed row, while keeping the
+  // adapter only for the controller's required compatibility interface.
+  auto* displayed_source = DisplayedTabView(contents);
+  ASSERT_TRUE(displayed_source);
+  displayed_source->ScrollViewToVisible();
+  browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+  ASSERT_EQ(displayed_source->height(), displayed_source->GetVisibleBounds().height());
+  ASSERT_NO_FATAL_FAILURE(BeginRealDrag(
+      context, source, displayed_source->GetBoundsInScreen().CenterPoint()));
+  browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+  displayed_source->ScrollViewToVisible();
+  browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+  auto* folder = FindFolderRow(library());
+  ASSERT_TRUE(folder);
+  ASSERT_EQ(folder->height(), folder->GetVisibleBounds().height());
+  ASSERT_NO_FATAL_FAILURE(WalkDrag(context, displayed_source->GetBoundsInScreen().CenterPoint(),
+                                   folder->GetBoundsInScreen().CenterPoint()));
+  ASSERT_TRUE(library()->CanDropTab());
+  context->GetDragController()->EndDrag(EndDragReason::kComplete);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(handle.Get());
+  EXPECT_TRUE(handle.Get()->IsPinned());
+  EXPECT_EQ(contents, handle.Get()->GetContents());
+  EXPECT_EQ(1, model->count());
+  EXPECT_EQ(bounds, browser_view()->GetWidget()->GetWindowBoundsInScreen());
+  EXPECT_EQ(entries, contents->GetController().GetEntryCount());
+  EXPECT_EQ("unsent live drag draft", content::EvalJs(contents, "window.coveLiveDragDraft"));
+  const auto& pins = *PersonalSpace(browser()->GetProfile())->FindList("pins");
+  ASSERT_EQ(1u, pins.size());
+  EXPECT_EQ(kFolderId, *pins.front().GetDict().FindString("folder"));
+}
+
 }  // namespace
