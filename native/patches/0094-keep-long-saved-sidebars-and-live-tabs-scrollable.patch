+          .Set("name", "Selection folder " + std::to_string(i))
+          .Set("parent", "").Set("collapsed", false));
+  }
+  Layout();
+  auto* first = FindRow(library(), u"Folder A");
+  ASSERT_TRUE(first);
+  first->ScrollViewToVisible();
+  Layout();
+  auto* added = chrome::AddAndReturnTabAt(browser(),
+      GURL("data:text/html,<title>Opened Today</title>"), -1, true);
+  ASSERT_TRUE(added);
+  ASSERT_TRUE(content::WaitForLoadStop(added));
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  const auto visible = [&](content::WebContents* contents) {
+    view->GetWidget()->LayoutRootViewIfNecessary();
