+void TabStripView::SetCoveUnifiedScrolling(bool unified) {
+  if (cove_unified_scrolling_ == unified) return;
+  cove_unified_scrolling_ = unified;
+  for (views::ScrollView* scroll : {pinned_tabs_scroll_view_, unpinned_tabs_scroll_view_}) {
+    scroll->SetHorizontalScrollBarMode(views::ScrollView::ScrollBarMode::kDisabled);
+    scroll->SetVerticalScrollBarMode(unified
