+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       ExportParkedSpaceMovesItsTabsIntoShownSpace) {
+  Seed();
+  auto* model = browser()->GetTabStripModel();
+  library()->FocusSpace("work");
+  Layout();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Work page</title>")));
+  auto* work_contents = model->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(work_contents, "window.draft='work'"));
+  library()->FocusSpace("personal");
+  Layout();
+  ASSERT_TRUE(library()->HasParkedSpaceForTesting("work"));
+  ASSERT_EQ(TabStripModel::kNoTab, model->GetIndexOfWebContents(work_contents));
+
+  ASSERT_TRUE(library()->ExportSpaceForTesting("work", "personal"));
+  Layout();
+  EXPECT_EQ("personal", library()->ActiveSpaceIdForTesting());
+  EXPECT_FALSE(library()->HasParkedSpaceForTesting("work"));
+  EXPECT_NE(TabStripModel::kNoTab, model->GetIndexOfWebContents(work_contents));
+  EXPECT_EQ("work", content::EvalJs(work_contents, "window.draft"));
+  EXPECT_TRUE(FolderNamed(SavedSpace(), "Work"));
+  EXPECT_FALSE(library()->ExportSpaceForTesting("personal", "personal"));
+  auto* menu = library()->BuildSpaceMenuForTesting("personal");
+  for (size_t i = 0; i < menu->GetItemCount(); ++i) {
+    if (menu->GetTypeAt(i) == ui::MenuModel::TYPE_SUBMENU) {
+      EXPECT_FALSE(menu->IsEnabledAt(i));
+    }
+  }
+}
