+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       ExportShownSpaceKeepsTabsAndNestsRows) {
+  const GURL home("data:text/html,<title>Exported pin</title>");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  auto* model = browser()->GetTabStripModel();
+  Seed();
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(),
+                                kSidebarPref);
+    FindSpace(*update, "personal")->FindList("pins")->front().GetDict().Set(
+        "url", home.spec());
+    base::ListValue pins;
+    pins.Append(Pin("p", "Work P", "https://work-p.example/"));
+    FindSpace(*update, "work")->Set("pins", std::move(pins));
+  }
+  model->SetTabPinned(model->active_index(), true);
+  auto* pinned = model->GetActiveWebContents();
+  ASSERT_EQ("p", library()->ActivePinIdForTesting());
+  auto* loose = chrome::AddAndReturnTabAt(
+      browser(), GURL("data:text/html,<title>Loose</title>"), -1, true);
+  ASSERT_TRUE(content::WaitForLoadStop(loose));
+  ASSERT_TRUE(content::ExecJs(loose, "window.draft='loose'"));
+  Layout();
+
+  ASSERT_TRUE(library()->ExportSpaceForTesting("personal", "work"));
+  Layout();
+  EXPECT_EQ("work", library()->ActiveSpaceIdForTesting());
+  const auto& root =
+      browser()->GetProfile()->GetPrefs()->GetDict(kSidebarPref);
+  EXPECT_EQ(1u, root.FindList("spaces")->size());
+  const auto* work = root.FindList("spaces")->front().GetIfDict();
+  ASSERT_TRUE(work);
+  EXPECT_EQ("work", *work->FindString("id"));
+
+  const auto* wrapper = FolderNamed(*work, "Personal");
+  ASSERT_TRUE(wrapper);
+  const std::string wrapper_id = *wrapper->FindString("id");
+  EXPECT_EQ("", *wrapper->FindString("parent"));
+  EXPECT_EQ(wrapper_id, *FindSaved(*work, "folders", "a")->FindString("parent"));
+  EXPECT_EQ(wrapper_id, *FindSaved(*work, "folders", "b")->FindString("parent"));
+  EXPECT_EQ("a", *FindSaved(*work, "folders", "child")->FindString("parent"));
+  EXPECT_EQ(wrapper_id, *FindSaved(*work, "pins", "q")->FindString("folder"));
+  // The target already had a pin "p", so the exported one was renamed.
+  EXPECT_EQ("", *FindSaved(*work, "pins", "p")->FindString("folder"));
+  EXPECT_EQ(3u, work->FindList("pins")->size());
+  std::string exported_p;
+  for (const auto& value : *work->FindList("pins")) {
+    const auto& pin = value.GetDict();
+    if (*pin.FindString("url") == home.spec()) exported_p = *pin.FindString("id");
+  }
+  ASSERT_FALSE(exported_p.empty());
+  EXPECT_NE("p", exported_p);
+  EXPECT_EQ(wrapper_id,
+            *FindSaved(*work, "pins", exported_p)->FindString("folder"));
+  const auto rows = cove::SidebarOrder::Rows(*work, true);
+  ASSERT_FALSE(rows.empty());
+  EXPECT_EQ("p", rows.front().item.id);
+
+  EXPECT_NE(TabStripModel::kNoTab, model->GetIndexOfWebContents(loose));
+  EXPECT_EQ("loose", content::EvalJs(loose, "window.draft"));
+  const int pinned_index = model->GetIndexOfWebContents(pinned);
+  ASSERT_NE(TabStripModel::kNoTab, pinned_index);
+  EXPECT_TRUE(model->IsTabPinned(pinned_index));
+  model->ActivateTabAt(pinned_index);
+  EXPECT_EQ(exported_p, library()->ActivePinIdForTesting());
+}
