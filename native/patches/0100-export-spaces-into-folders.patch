+std::string CoveSidebarLibraryView::ExportedSpaceTarget(
+    const std::string& space_id) const {
+  const auto& root =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+  const auto* redirects = root.FindDict("space_redirects");
+  std::string current = space_id;
+  for (size_t hops = 0; redirects && hops < kMaxSpaceRedirects; ++hops) {
+    if (FindSpace(root, current)) {
+      return current == space_id ? std::string() : current;
+    }
+    const auto* entry = redirects->FindDict(current);
+    const auto* next = entry ? entry->FindString("space") : nullptr;
+    if (!next) {
+      break;
+    }
+    current = *next;
+  }
+  return FindSpace(root, current) && current != space_id ? current
+                                                         : std::string();
+}
