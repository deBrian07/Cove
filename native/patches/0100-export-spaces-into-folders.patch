+bool CoveSidebarLibraryView::CommitExportSpace(std::string source,
+                                               std::string target) {
+  if (!browser_ || browser_->GetProfile()->IsOffTheRecord() ||
+      switching_space_ || closing_active_space_ || restoring_session_ ||
+      source == target) {
+    return false;
+  }
+  {
+    const auto& root =
+        browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+    if (!FindSpace(root, source) || !FindSpace(root, target)) {
+      return false;
+    }
+  }
+  if (active_space_id_ != target) {
+    SwitchSpace(target);
+    if (active_space_id_ != target) {
+      return false;
+    }
+  }
+  std::map<std::string, std::string> pin_ids;
+  {
+    ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                                kCoveSidebarPref);
+    auto* from = FindSpace(*update, source);
+    if (!from) {
+      return false;
+    }
+    base::DictValue moved = from->Clone();
+    auto* into = FindSpace(*update, target);
+    if (!into) {
+      return false;
+    }
+    const auto ids_in = [](const base::DictValue& space, const char* key) {
+      std::set<std::string> ids;
+      if (const auto* list = space.FindList(key)) {
+        for (const auto& value : *list) {
+          const auto* item = value.GetIfDict();
+          if (const auto* id = item ? item->FindString("id") : nullptr) {
+            ids.insert(*id);
+          }
+        }
+      }
+      return ids;
+    };
+    const auto taken_pins = ids_in(*into, "pins");
+    const auto taken_folders = ids_in(*into, "folders");
+    const auto fresh = [](const std::set<std::string>& taken,
+                          const std::string& id) {
+      return taken.contains(id) ? base::Uuid::GenerateRandomV4()
+                                      .AsLowercaseString()
+                                : id;
+    };
+    const cove::FolderTree source_tree(moved.FindList("folders"));
+    std::map<std::string, std::string> folder_ids;
+    for (const auto& row : source_tree.Rows(true)) {
+      folder_ids.emplace(row.id, fresh(taken_folders, row.id));
+    }
+    std::string wrapper = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    const auto* source_name = moved.FindString("name");
+    base::DictValue folder;
+    folder.Set("id", wrapper);
+    folder.Set("name", source_name ? *source_name : "Space");
+    folder.Set("parent", "");
+    auto* folders = into->EnsureList("folders");
+    folders->Append(std::move(folder));
+    for (const auto& row : source_tree.Rows(true)) {
+      base::DictValue copy;
+      copy.Set("id", folder_ids.at(row.id));
+      copy.Set("name", base::UTF16ToUTF8(row.name));
+      copy.Set("parent",
+               row.parent.empty() ? wrapper : folder_ids.at(row.parent));
+      copy.Set("collapsed", row.collapsed);
+      folders->Append(std::move(copy));
+    }
+    auto* pins = into->EnsureList("pins");
+    if (auto* source_pins = moved.FindList("pins")) {
+      for (auto& value : *source_pins) {
+        auto* pin = value.GetIfDict();
+        const auto* id = pin ? pin->FindString("id") : nullptr;
+        if (!id || id->empty()) {
+          continue;
+        }
+        const std::string new_id = fresh(taken_pins, *id);
+        pin_ids.emplace(*id, new_id);
+        const auto* parent = pin->FindString("folder");
+        const auto folder_id =
+            parent ? folder_ids.find(*parent) : folder_ids.end();
+        base::DictValue copy = pin->Clone();
+        copy.Set("id", new_id);
+        copy.Set("folder", folder_id == folder_ids.end() ? wrapper
+                                                         : folder_id->second);
+        pins->Append(std::move(copy));
+      }
+    }
+    // Existing target rows keep their positions; the exported folder and its
+    // contents follow in their saved order.
+    base::ListValue order;
+    for (const auto& row : cove::SidebarOrder::Rows(*into, true)) {
+      const bool exported =
+          row.item.id == wrapper ||
+          (row.item.kind == cove::SidebarItemKind::kPin
+               ? std::ranges::any_of(pin_ids,
+                                     [&](const auto& entry) {
+                                       return entry.second == row.item.id;
+                                     })
+               : std::ranges::any_of(folder_ids, [&](const auto& entry) {
+                   return entry.second == row.item.id;
+                 }));
+      if (!exported) {
+        order.Append((row.item.kind == cove::SidebarItemKind::kPin ? "pin:"
+                                                                   : "folder:") +
+                     row.item.id);
+      }
+    }
+    order.Append("folder:" + wrapper);
+    for (const auto& row : cove::SidebarOrder::Rows(moved, true)) {
+      if (row.item.kind == cove::SidebarItemKind::kPin) {
+        if (const auto found = pin_ids.find(row.item.id);
+            found != pin_ids.end()) {
+          order.Append("pin:" + found->second);
+        }
+      } else if (const auto found = folder_ids.find(row.item.id);
+                 found != folder_ids.end()) {
+        order.Append("folder:" + found->second);
+      }
+    }
+    into->Set("sidebar_order", std::move(order));
+
+    base::DictValue redirect;
+    redirect.Set("space", target);
+    base::DictValue renamed;
+    for (const auto& [old_id, new_id] : pin_ids) {
+      if (old_id != new_id) {
+        renamed.Set(old_id, new_id);
+      }
+    }
+    redirect.Set("pins", std::move(renamed));
+    auto* redirects = update->EnsureDict("space_redirects");
+    redirects->Set(source, std::move(redirect));
+    while (redirects->size() > kMaxSpaceRedirects) {
+      std::string oldest;
+      for (const auto [id, entry] : *redirects) {
+        if (id != source) {
+          oldest = id;
+          break;
+        }
+      }
+      redirects->Remove(oldest);
+    }
+    if (auto* list = update->FindList("spaces")) {
+      list->EraseIf([&](const base::Value& value) {
+        const auto* item = value.GetIfDict();
+        const auto* id = item ? item->FindString("id") : nullptr;
+        return id && *id == source;
+      });
+    }
+  }
+  ReconcileDeletedSpaces();
+  return true;
 }
 
