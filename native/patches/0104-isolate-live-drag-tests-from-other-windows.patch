+class BrowserOnlyWindowFinder : public WindowFinder {
+ public:
+  explicit BrowserOnlyWindowFinder(views::Widget* widget) : widget_(widget) {}
+
+  gfx::NativeWindow GetLocalProcessWindowAtPoint(
+      const gfx::Point& screen_point,
+      const std::set<gfx::NativeWindow>& ignore) override {
+    const gfx::NativeWindow window = widget_->GetNativeWindow();
+    return !ignore.contains(window) &&
+                   widget_->GetWindowBoundsInScreen().Contains(screen_point)
+               ? window
+               : gfx::NativeWindow();
+  }
+
+ private:
+  raw_ptr<views::Widget> widget_;
+};
