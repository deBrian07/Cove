+  controller->SetExpandOnHoverEnabled(true);
+  controller->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&] { return controller->IsCollapsed(); }));
+  Layout();
+  const auto pins = SavedSpace().FindList("pins")->Clone();
+  const auto folders = SavedSpace().FindList("folders")->Clone();
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* region = view->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(region);
+  EXPECT_FALSE(library()->GetVisible());
+  library()->OnWillStartDragForView(nullptr);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    return region->is_expanded_on_hover() && library()->IsDrawn();
+  }));
+  EXPECT_TRUE(controller->IsCollapsed());
+  library()->FinishSavedDragHoverForTesting();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    return !region->is_expanded_on_hover() && !library()->GetVisible();
+  }));
+  EXPECT_TRUE(controller->IsCollapsed());
+  EXPECT_EQ(pins, *SavedSpace().FindList("pins"));
+  EXPECT_EQ(folders, *SavedSpace().FindList("folders"));
+  library()->OnWillStartDragForView(nullptr);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    return region->is_expanded_on_hover();
+  }));
+}
