+IN_PROC_BROWSER_TEST_F(CoveFavoritesDragBrowserTest,
+                       SourceDragKeepsHoverRevealUntilRelease) {
+  Seed();
+  auto* controller = tabs::VerticalTabStripStateController::From(browser());
+  controller->SetExpandOnHoverEnabled(true);
+  controller->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&] { return controller->IsCollapsed(); }));
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* region = view->vertical_tab_strip_region_view_for_testing();
+  auto* favorites = Favorites();
+  ASSERT_TRUE(region);
+  ASSERT_TRUE(favorites);
+  const auto saved = Saved().Clone();
+  auto reveal =
+      region->GetExpandOnHoverLock(ExpandOnHoverLockType::kKeepExpanded);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    return !favorites->children().empty();
+  }));
+  favorites->OnWillStartDragForView(favorites->children().front().get());
+  reveal.reset();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    return region->is_expanded_on_hover() && favorites->IsDrawn();
+  }));
+  EXPECT_TRUE(controller->IsCollapsed());
+  favorites->FinishSavedDragHoverForTesting();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    view->GetWidget()->LayoutRootViewIfNecessary();
+    return !region->is_expanded_on_hover();
+  }));
+  EXPECT_TRUE(controller->IsCollapsed());
+  EXPECT_EQ(saved, Saved());
+}
