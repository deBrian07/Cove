+void CoveFavoritesView::AcquireSavedDragHoverLock() {
+  if (saved_drag_hover_lock_ || !browser_) {
+    return;
+  }
+  const auto* state = tabs::VerticalTabStripStateController::From(browser_);
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  if (!state || !state->IsExpandOnHoverEnabled() || !browser_view ||
+      !browser_view->tab_strip_view()) {
+    return;
+  }
+  saved_drag_hover_lock_ = browser_view->tab_strip_view()->GetExpandOnHoverLock(
+      ExpandOnHoverLockType::kKeepExpanded);
+}
+
 void CoveFavoritesView::OnWillStartDragForView(views::View* sender) {
   source_drag_active_ = row_urls_.contains(sender);
