+void CoveMiniMediaView::ScheduleRefresh() {
+  if (refresh_scheduled_) return;
+  refresh_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<CoveMiniMediaView> view) {
+                       if (!view) return;
+                       view->refresh_scheduled_ = false;
+                       view->Refresh();
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+void CoveMiniMediaView::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed() ||
+      change.type() != TabStripModelChange::kSelectionOnly) {
+    ScheduleRefresh();
+  }
+}
+void CoveMiniMediaView::OnFocusGained(
