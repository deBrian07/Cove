+// Exercise command dispatch rather than calling the model mutators directly:
+// action adapters and native keyboard/menu commands must reach the same model.
+IN_PROC_BROWSER_TEST_F(BrowserCommandControllerBrowserTest,
+                       CoveSplitCommandsPreserveTabs) {
+  auto* model = browser()->tab_strip_model();
+  ASSERT_EQ(1, model->count());
+  const GURL left_url("data:text/html,<title>Cove left</title>left");
+  const GURL right_url("data:text/html,<title>Cove right</title>right");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), left_url));
+
+  for (int command : {IDC_COVE_REMOVE_SPLIT, IDC_COVE_FOCUS_SPLIT_LEFT,
+                       IDC_COVE_FOCUS_SPLIT_RIGHT}) {
+    EXPECT_FALSE(chrome::IsCommandEnabled(browser(), command));
+    EXPECT_FALSE(chrome::ExecuteCommand(browser(), command));
+  }
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_NEW_SPLIT_TAB));
+  ASSERT_EQ(2, model->count());
+  ASSERT_TRUE(model->GetSplitForTab(0).has_value());
+  ASSERT_EQ(model->GetSplitForTab(0), model->GetSplitForTab(1));
+  ASSERT_EQ(2U,
+            model->GetSplitData(*model->GetSplitForTab(0))->ListTabs().size());
+  ASSERT_EQ(1, model->active_index());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), right_url));
+
+  auto* const left_contents = model->GetWebContentsAt(0);
+  auto* const right_contents = model->GetWebContentsAt(1);
+  EXPECT_TRUE(chrome::IsCommandEnabled(browser(), IDC_COVE_REMOVE_SPLIT));
+  EXPECT_TRUE(chrome::IsCommandEnabled(browser(), IDC_COVE_FOCUS_SPLIT_LEFT));
+  EXPECT_TRUE(chrome::IsCommandEnabled(browser(), IDC_COVE_FOCUS_SPLIT_RIGHT));
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_COVE_FOCUS_SPLIT_LEFT));
+  EXPECT_EQ(0, model->active_index());
+  EXPECT_EQ(left_contents, model->GetActiveWebContents());
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_COVE_FOCUS_SPLIT_RIGHT));
+  EXPECT_EQ(1, model->active_index());
+  EXPECT_EQ(right_contents, model->GetActiveWebContents());
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_COVE_REMOVE_SPLIT));
+  ASSERT_EQ(2, model->count());
+  EXPECT_FALSE(model->GetSplitForTab(0).has_value());
+  EXPECT_FALSE(model->GetSplitForTab(1).has_value());
+  EXPECT_EQ(left_contents, model->GetWebContentsAt(0));
+  EXPECT_EQ(right_contents, model->GetWebContentsAt(1));
+  EXPECT_EQ(left_url, left_contents->GetLastCommittedURL());
+  EXPECT_EQ(right_url, right_contents->GetLastCommittedURL());
+  EXPECT_FALSE(chrome::IsCommandEnabled(browser(), IDC_COVE_REMOVE_SPLIT));
+  EXPECT_FALSE(chrome::IsCommandEnabled(browser(), IDC_COVE_FOCUS_SPLIT_LEFT));
+  EXPECT_FALSE(chrome::IsCommandEnabled(browser(), IDC_COVE_FOCUS_SPLIT_RIGHT));
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserCommandControllerBrowserTest,
+                       CovePinCommandPreservesCurrentTab) {
+  auto* model = browser()->tab_strip_model();
+  ASSERT_EQ(1, model->count());
+  const GURL url("data:text/html,<title>Cove pinned tab</title>pinned");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* const contents = model->GetActiveWebContents();
+  EXPECT_FALSE(model->IsTabPinned(model->active_index()));
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_WINDOW_PIN_TAB));
+  ASSERT_EQ(1, model->count());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_TRUE(model->IsTabPinned(model->active_index()));
+  EXPECT_EQ(url, contents->GetLastCommittedURL());
+
+  // Activating another tab must not silently undo the pin or replace its page.
+  chrome::NewTab(browser(), NewTabTypes::kNoUserAction);
+  ASSERT_EQ(2, model->count());
+  EXPECT_TRUE(model->IsTabPinned(model->GetIndexOfWebContents(contents)));
+  model->ActivateTabAt(model->GetIndexOfWebContents(contents));
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_WINDOW_PIN_TAB));
+  EXPECT_EQ(2, model->count());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_FALSE(model->IsTabPinned(model->active_index()));
+  EXPECT_EQ(url, contents->GetLastCommittedURL());
+}
