+// Cocoa conflates touch and momentum phases. A phase-less mouse wheel is END
+// with displacement; END following a touch/inertia stream terminates that stream.
+class MacSpaceSwipePhaseMapper {
+ public:
+  enum class NativePhase { kTouchBegin, kTouchUpdate, kInertia, kEnd };
+  SpaceSwipeState::Phase Convert(NativePhase native, bool has_displacement) {
+    using Phase = SpaceSwipeState::Phase;
+    switch (native) {
+      case NativePhase::kTouchBegin:
+        stream_active_ = true;
+        return Phase::kBegin;
+      case NativePhase::kTouchUpdate:
+        stream_active_ = true;
+        return Phase::kUpdate;
+      case NativePhase::kInertia:
+        stream_active_ = true;
+        return Phase::kMomentum;
+      case NativePhase::kEnd:
+        if (stream_active_ || !has_displacement) {
+          stream_active_ = false;
+          return Phase::kEnd;
+        }
+        return Phase::kNone;
+    }
+  }
+ private:
+  bool stream_active_ = false;
+};
 }  // namespace cove
 #endif
diff --git a/chrome/browser/ui/views/tabs/vertical/cove_space_swipe_state_unittest.cc b/chrome/browser/ui/views/tabs/vertical/cove_space_swipe_state_unittest.cc
--- a/chrome/browser/ui/views/tabs/vertical/cove_space_swipe_state_unittest.cc
+++ b/chrome/browser/ui/views/tabs/vertical/cove_space_swipe_state_unittest.cc
@@ -49,4 +49,33 @@
   s.Update(0, 0, Phase::kEnd, t);
   EXPECT_EQ(Result::kPass, s.Update(-900, 0, Phase::kMomentum, t));
 }
+TEST(CoveSpaceSwipe, CocoaStandaloneWheelHasDisplacement) {
+  MacSpaceSwipePhaseMapper mapper;
+  using Native = MacSpaceSwipePhaseMapper::NativePhase;
+  EXPECT_EQ(Phase::kNone, mapper.Convert(Native::kEnd, true));
+  EXPECT_EQ(Phase::kNone, mapper.Convert(Native::kEnd, true));
+}
+TEST(CoveSpaceSwipe, CocoaTouchEndNeverStartsAnotherSwipe) {
+  MacSpaceSwipePhaseMapper mapper;
+  using Native = MacSpaceSwipePhaseMapper::NativePhase;
+  EXPECT_EQ(Phase::kBegin, mapper.Convert(Native::kTouchBegin, false));
+  EXPECT_EQ(Phase::kUpdate, mapper.Convert(Native::kTouchUpdate, true));
+  EXPECT_EQ(Phase::kEnd, mapper.Convert(Native::kEnd, true));
+  EXPECT_EQ(Phase::kNone, mapper.Convert(Native::kEnd, true));
+}
+TEST(CoveSpaceSwipe, CocoaFinalMomentumDeltaCannotBecomeWheel) {
+  MacSpaceSwipePhaseMapper mapper;
+  using Native = MacSpaceSwipePhaseMapper::NativePhase;
+  EXPECT_EQ(Phase::kMomentum, mapper.Convert(Native::kInertia, true));
+  EXPECT_EQ(Phase::kEnd, mapper.Convert(Native::kEnd, true));
+}
+TEST(CoveSpaceSwipe, CocoaTouchUpdatesDoNotTimeoutAsWheelBursts) {
+  MacSpaceSwipePhaseMapper mapper;
+  SpaceSwipeState state;
+  using Native = MacSpaceSwipePhaseMapper::NativePhase;
+  const auto time = base::TimeTicks::Now();
+  state.Update(-90, 0, mapper.Convert(Native::kTouchBegin, true), time);
+  EXPECT_EQ(Result::kConsume, state.Update(-90, 0,
+      mapper.Convert(Native::kTouchUpdate, true), time + base::Seconds(2)));
+}
 }  // namespace cove
