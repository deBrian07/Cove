+void CoveSidebarLibraryView::StampCurrentSessionTabs() const {
+  if (restoring_session_ || switching_space_ || closing_active_space_) return;
+  auto* model = browser_->GetTabStripModel();
+  if (auto* sync = tab_groups::TabGroupSyncServiceFactory::GetForProfile(browser_->GetProfile())) {
+    for (auto* tab : *model) {
+      if (auto id = tab->GetGroup()) {
+        if (auto group = sync->GetGroup(*id))
+          saved_group_ids_[*id] = group->saved_guid().AsLowercaseString();
+      }
+    }
+  }
+  const auto& selection = model->selection_model().GetListSelectionModel();
+  for (int i = 0; i < model->count(); ++i) {
+    auto* tab = model->GetTabAtIndex(i);
+    if (HasRestoredCoveTabSessionState(tab->GetContents())) continue;
+    CoveTabSessionState state;
+    state.space = active_space_id_;
+    state.order = i;
+    state.active = selection.active() == static_cast<size_t>(i);
+    state.anchor = selection.anchor() == static_cast<size_t>(i);
+    state.selected = selection.IsSelected(i);
+    state.canvas = IsCoveEmptyCanvas(tab->GetContents());
+    state.focused_group = tab->GetGroup().has_value() && tab->GetGroup() == model->GetFocusedGroup();
+    const auto pin = tab_pin_ids_.find(tab->GetHandle().raw_value());
+    if (tab->IsPinned() && pin != tab_pin_ids_.end() &&
+        pin->second.first == active_space_id_) state.pin = pin->second.second;
+    SetCoveTabSessionState(tab->GetContents(), std::move(state));
+  }
+}
+
+std::optional<CoveSessionSnapshot> CoveSidebarLibraryView::GetSessionSnapshot() const {
+  if (browser_->GetProfile()->IsOffTheRecord()) return std::nullopt;
+  StampCurrentSessionTabs();
+  CoveSessionSnapshot snapshot;
+  snapshot.active_space = active_space_id_;
+  snapshot.selected_index = browser_->GetTabStripModel()->active_index();
+  std::set<int> seen;
+  const auto add = [&](tabs::TabInterface* tab, bool pinned) {
+    if (!tab || !seen.insert(tab->GetHandle().raw_value()).second) return;
+    snapshot.tabs.push_back({tab, pinned});
+    for (auto* parent = tab->GetParentCollection(); parent;
+         parent = parent->GetParentCollection()) {
+      if (parent->type() == tabs::TabCollection::Type::GROUP) {
+        const auto* group = static_cast<const tabs::TabGroupTabCollection*>(parent);
+        snapshot.groups.emplace(group->GetTabGroupId(),
+                                 *group->GetTabGroup()->visual_data());
+      } else if (parent->type() == tabs::TabCollection::Type::SPLIT) {
+        const auto* split = static_cast<const tabs::SplitTabCollection*>(parent);
+        snapshot.splits.emplace(split->GetSplitTabId(),
+                                 *split->data()->visual_data());
+      }
+    }
+  };
+  for (auto* tab : *browser_->GetTabStripModel()) add(tab, tab->IsPinned());
+  for (const auto& [id, space] : inactive_spaces_) {
+    for (const auto& item : space->items) {
+      if (const auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&item)) {
+        if (*tab) add((*tab)->tab.get(), (*tab)->was_pinned_at_time_of_removal);
+      } else {
+        const auto& owned = std::get<std::unique_ptr<DetachedTabCollection>>(item);
+        if (!owned) continue;
+        const auto& collection = *owned;
+        std::visit([&](const auto& root) {
+          for (auto* tab : *root) add(tab, collection.pinned_);
+        }, collection.collection_);
+      }
+    }
+  }
+  snapshot.saved_groups = saved_group_ids_;
+  return snapshot;
+}
+
+bool CoveSidebarLibraryView::IsSessionMutationInProgress() const {
+  return switching_space_ || restoring_session_;
+}
+
+void CoveSidebarLibraryView::QueueSessionSync() {
+  if (session_sync_posted_) return;
+  session_sync_posted_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&CoveSidebarLibraryView::SyncSession, weak_factory_.GetWeakPtr()));
+}
+
+void CoveSidebarLibraryView::SyncSession() {
+  session_sync_posted_ = false;
+  if (IsSessionMutationInProgress() || closing_active_space_ ||
+      browser_->GetProfile()->IsOffTheRecord()) return;
+  auto* service = SessionServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!service) return;
+  auto snapshot = GetSessionSnapshot();
+  if (!snapshot) return;
+  const auto window = browser_->GetSessionID();
+  for (size_t i = 0; i < snapshot->tabs.size(); ++i) {
+    const auto& entry = snapshot->tabs[i];
+    auto* contents = entry.tab->GetContents();
+    const auto id = sessions::SessionTabHelper::IdForTab(contents);
+    service->SetTabIndexInWindow(window, id, static_cast<int>(i));
+    service->SetPinnedState(window, id, entry.pinned);
+    service->SetTabGroup(window, id, entry.tab->GetGroup());
+    service->SetSplitTab(window, id, entry.tab->GetSplit());
+    if (const auto* state = GetCoveTabSessionState(contents))
+      service->AddTabExtraData(window, id, kCoveTabSessionKey,
+                               EncodeCoveTabSessionState(*state));
+  }
+  for (const auto& [id, visual] : snapshot->groups) {
+    auto guid = snapshot->saved_groups.find(id);
+    if (guid != snapshot->saved_groups.end())
+      service->SetTabGroupMetadata(window, id, &visual, guid->second);
+    else service->SetTabGroupMetadata(window, id, &visual);
+  }
+  for (const auto& [id, visual] : snapshot->splits)
+    service->SetSplitTabData(window, id, &visual);
+  service->AddWindowExtraData(window, kCoveWindowSessionKey, active_space_id_);
+  service->SetSelectedTabInWindow(window, snapshot->selected_index);
+}
+
+void CoveSidebarLibraryView::RememberSavedGroup(
+    const tab_groups::TabGroupId& id, const std::string& guid) {
+  if (!guid.empty()) saved_group_ids_[id] = guid;
+}
+
+void CoveSidebarLibraryView::BeginSessionRestore(const std::string& active_space) {
+  if (browser_->GetProfile()->IsOffTheRecord()) return;
+  StampCurrentSessionTabs();
+  restoring_session_ = true;
+  restore_window_space_ = true;
+  if (FindSpace(browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref), active_space)) {
+    active_space_id_ = active_space;
+    restored_session_ownership_ = true;
+  }
+  InvalidateEmptyCanvasCleanup();
+}
+
+void CoveSidebarLibraryView::FinishSessionRestore() {
+  if (!restoring_session_ || restore_posted_) return;
+  restore_posted_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&CoveSidebarLibraryView::PartitionRestoredTabs,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void CoveSidebarLibraryView::PartitionRestoredTabs() {
+  restore_posted_ = false;
+  if (!restoring_session_ || closing_active_space_) return;
+  const auto& prefs = browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+  auto* model = browser_->GetTabStripModel();
+  // Reopening an entry into a live window honors Chromium's new foreground
+  // selection, rather than whether that tab happened to be active when closed.
+  // Full-window restoration still uses each Space's historical selection.
+  std::optional<tabs::TabHandle> foreground_restored;
+  const auto foreground_selection =
+      model->selection_model().GetListSelectionModel();
+  if (!restore_window_space_ && model->GetActiveTab()) {
+    foreground_restored = model->GetActiveTab()->GetHandle();
+    if (const auto* state =
+            GetCoveTabSessionState(model->GetActiveWebContents());
+        state && HasRestoredCoveTabSessionState(model->GetActiveWebContents()) &&
+        FindSpace(prefs, state->space)) {
+      active_space_id_ = state->space;
+    }
+  }
+  // Resolve each intact native collection to one owner. Corrupt mixed ownership
+  // falls back together rather than splitting a group or dropping a page.
+  std::map<tab_groups::TabGroupId, std::string> groups;
+  std::map<split_tabs::SplitTabId, std::string> splits;
+  std::map<int, CoveTabSessionState> states;
+  for (auto* tab : *model) {
+    CoveTabSessionState state;
+    if (const auto* saved = GetCoveTabSessionState(tab->GetContents())) {
+      state = *saved;
+    } else {
+      const int index = model->GetIndexOfTab(tab);
+      state.order = index;
+      state.active = tab == model->GetActiveTab();
+      state.selected = model->selection_model().GetListSelectionModel().IsSelected(index);
+      state.anchor = model->selection_model().GetListSelectionModel().anchor() == static_cast<size_t>(index);
+    }
+    if (HasRestoredCoveTabSessionState(tab->GetContents())) restored_session_ownership_ = true;
+    if (!FindSpace(prefs, state.space)) state.space = active_space_id_;
+    const auto merge = [&](auto& owners, auto id) {
+      auto [found, inserted] = owners.emplace(id, state.space);
+      if (!inserted && found->second != state.space) found->second = active_space_id_;
+    };
+    if (tab->GetGroup()) merge(groups, *tab->GetGroup());
+    else if (tab->GetSplit()) merge(splits, *tab->GetSplit());
+    states.emplace(tab->GetHandle().raw_value(), std::move(state));
+  }
+  std::map<std::string, std::unique_ptr<SpaceTabs>> restored;
+  for (auto* tab : *model) {
+    auto& state = states.at(tab->GetHandle().raw_value());
+    if (tab->GetGroup()) state.space = groups.at(*tab->GetGroup());
+    else if (tab->GetSplit()) state.space = splits.at(*tab->GetSplit());
+    if (foreground_restored && state.space == active_space_id_) {
+      const int index = model->GetIndexOfTab(tab);
+      state.active = tab == foreground_restored->Get();
+      state.selected = foreground_selection.IsSelected(index);
+      state.anchor =
+          foreground_selection.anchor() == static_cast<size_t>(index);
+    }
+    auto& space = restored[state.space];
+    if (!space) space = std::make_unique<SpaceTabs>();
+    const size_t index = space->handles.size();
+    space->handles.push_back(tab->GetHandle());
+    if (state.selected) space->selection.AddIndexToSelection(index);
+    if (state.active) {
+      space->selection.set_active(index);
+      space->selection.AddIndexToSelection(index);
+    }
+    if (state.anchor) space->selection.set_anchor(index);
+    if (state.focused_group && tab->GetGroup()) space->focused_group = tab->GetGroup();
+    if (state.canvas) MarkCoveEmptyCanvas(tab->GetContents());
+    if (!state.pin.empty() && tab->IsPinned())
+      tab_pin_ids_[tab->GetHandle().raw_value()] = {state.space, state.pin};
+    SetCoveTabSessionState(tab->GetContents(), state);
+  }
+  base::AutoReset<bool> switching(&switching_space_, true);
+  // Keep a real attached tab throughout detachment. This is never historical
+  // user data and is cleaned up only after the selected Space is attached.
+  NavigateParams params(browser_, GURL("about:blank"), ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  Navigate(&params);
+  auto* canvas = params.navigated_or_inserted_contents.get();
+  if (!canvas) { restoring_session_ = false; QueueSessionSync(); return; }
+  MarkCoveEmptyCanvas(canvas);
+  for (auto& [id, space] : restored) {
+    DetachSpaceTabs(*space);
+    // Sort whole detached units by saved per-Space order. Their native group
+    // and split membership remains intact.
+    const auto order = [](const auto& item) {
+      int result = 1000001;
+      const auto inspect = [&](tabs::TabInterface* tab) {
+        if (const auto* state = GetCoveTabSessionState(tab->GetContents()))
+          result = std::min(result, state->order);
+      };
+      if (const auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&item)) inspect((*tab)->tab.get());
+      else std::visit([&](const auto& root) { for (auto* tab : *root) inspect(tab); },
+                     std::get<std::unique_ptr<DetachedTabCollection>>(item)->collection_);
+      return result;
+    };
+    std::stable_sort(space->items.begin(), space->items.end(),
+        [&](const auto& a, const auto& b) { return order(a) < order(b); });
+  }
+  // Existing parked ownership is retained when reopening an entry into a live window.
+  for (auto& [id, space] : restored) {
+    auto existing = inactive_spaces_.find(id);
+    if (existing != inactive_spaces_.end()) {
+      for (auto& item : existing->second->items) space->items.push_back(std::move(item));
+      for (const auto& handle : existing->second->handles) space->handles.push_back(handle);
+    }
+    inactive_spaces_[id] = std::move(space);
+  }
+  if (auto active = inactive_spaces_.find(active_space_id_); active != inactive_spaces_.end()) {
+    auto space = std::move(active->second);
+    inactive_spaces_.erase(active);
+    InsertSpaceTabs(*space);
+    RestoreSelection(*space);
+  }
+  restoring_session_ = false;
+  restore_window_space_ = false;
+  Rebuild();
+  QueueEmptyCanvasCleanup();
+  QueueSessionSync();
+}
