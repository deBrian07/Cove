+IN_PROC_BROWSER_TEST_F(CoveSessionBrowserTest,
+                       DiskJournalRetainsRepeatedSpaceSwitchHistory) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Disk personal</title>")));
+  auto* personal = browser()->GetTabStripModel()->GetActiveWebContents();
+  Switch("work");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Disk work</title>")));
+  auto* work = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_NE(personal, work);
+  for (int i = 0; i < 3; ++i) {
+    Switch("personal");
+    ASSERT_EQ(personal, browser()->GetTabStripModel()->GetActiveWebContents());
+    ASSERT_TRUE(content::ExecJs(personal, content::JsReplace(
+        "history.pushState({}, '', $1)", "#personal-" + std::to_string(i))));
+    Switch("work");
+    ASSERT_EQ(work, browser()->GetTabStripModel()->GetActiveWebContents());
+    ASSERT_TRUE(content::ExecJs(work, content::JsReplace(
+        "history.pushState({}, '', $1)", "#work-" + std::to_string(i))));
+  }
+  const std::map<std::string, int> expected_history = {
+      {"personal", personal->GetController().GetEntryCount()},
+      {"work", work->GetController().GetEntryCount()}};
+  auto* service = SessionServiceFactory::GetForProfile(browser()->GetProfile());
+  service->ResetFromCurrentBrowsers();
+  SessionServiceTestHelper helper(service);
+  helper.SaveNow();
+  auto* manager = helper.command_storage_manager();
+  manager->MoveCurrentSessionToLastSession();
+  std::vector<std::unique_ptr<sessions::SessionCommand>> disk_commands;
+  bool read_error = true;
+  base::RunLoop read_loop;
+  manager->GetLastSessionCommands(base::BindLambdaForTesting(
+      [&](std::vector<std::unique_ptr<sessions::SessionCommand>> commands,
+          sessions::CommandStorageReadStatus status) {
+        read_error = sessions::IsCommandStorageReadError(status);
+        disk_commands = std::move(commands);
+        read_loop.Quit();
+      }));
+  read_loop.Run();
+  ASSERT_FALSE(read_error);
+  ASSERT_FALSE(disk_commands.empty());
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active = SessionID::InvalidValue();
+  std::string platform;
+  std::set<SessionID> discarded;
+  sessions::RestoreSessionFromCommands(disk_commands, &windows, &active,
+                                       &platform, &discarded);
+  EXPECT_TRUE(discarded.empty());
+  ASSERT_EQ(1u, windows.size());
+  ASSERT_EQ(2u, windows[0]->tabs.size());
+  EXPECT_EQ("work", windows[0]->extra_data.at(kCoveWindowSessionKey));
+  std::set<int> indices;
+  std::set<std::string> owners;
+  for (const auto& tab : windows[0]->tabs) {
+    indices.insert(tab->tab_visual_index);
+    auto state = DecodeCoveTabSessionState(tab->extra_data.at(kCoveTabSessionKey));
+    ASSERT_TRUE(state);
+    ASSERT_TRUE(expected_history.contains(state->space));
+    owners.insert(state->space);
+    EXPECT_EQ(expected_history.at(state->space),
+              static_cast<int>(tab->navigations.size()));
+    ASSERT_GE(tab->current_navigation_index, 0);
+    ASSERT_LT(static_cast<size_t>(tab->current_navigation_index),
+              tab->navigations.size());
+    EXPECT_EQ(state->space + "-2",
+              tab->navigations[tab->current_navigation_index].virtual_url().ref());
+  }
+  EXPECT_EQ((std::set<int>{0, 1}), indices);
+  EXPECT_EQ((std::set<std::string>{"personal", "work"}), owners);
+  EXPECT_EQ(work, browser()->GetTabStripModel()->GetActiveWebContents());
+  Switch("personal");
+  EXPECT_EQ(personal, browser()->GetTabStripModel()->GetActiveWebContents());
+}
