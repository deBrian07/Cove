@@ -0,0 +1,50 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/cove/cove_session_metadata.h"
+#include <utility>
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+
+bool IsValidCoveSessionId(std::string_view id) {
+  return !id.empty() && id.size() <= 512 && id.find('\0') == std::string_view::npos;
+}
+std::string EncodeCoveTabSessionState(const CoveTabSessionState& state) {
+  base::DictValue dict;
+  dict.Set("version", 1);
+  dict.Set("space", state.space);
+  dict.Set("pin", state.pin);
+  dict.Set("order", state.order);
+  dict.Set("active", state.active);
+  dict.Set("selected", state.selected);
+  dict.Set("anchor", state.anchor);
+  dict.Set("canvas", state.canvas);
+  dict.Set("focused_group", state.focused_group);
+  return base::WriteJson(dict).value_or("");
+}
+std::optional<CoveTabSessionState> DecodeCoveTabSessionState(std::string_view data) {
+  if (data.size() > 8192) return std::nullopt;
+  auto dict = base::JSONReader::ReadDict(data, base::JSON_PARSE_RFC);
+  if (!dict || dict->FindInt("version") != 1) return std::nullopt;
+  const auto* space = dict->FindString("space");
+  const auto* pin = dict->FindString("pin");
+  const auto order = dict->FindInt("order");
+  if (!space || !IsValidCoveSessionId(*space) || !pin ||
+      (!pin->empty() && !IsValidCoveSessionId(*pin)) || !order ||
+      *order < 0 || *order > 1000000) return std::nullopt;
+  CoveTabSessionState state;
+  state.space = *space;
+  state.pin = *pin;
+  state.order = *order;
+  for (auto [name, target] : {std::pair{"active", &state.active},
+                            {"selected", &state.selected},
+                            {"anchor", &state.anchor},
+                            {"canvas", &state.canvas},
+                            {"focused_group", &state.focused_group}}) {
+    auto value = dict->FindBool(name);
+    if (!value) return std::nullopt;
+    *target = *value;
+  }
+  return state;
+}
