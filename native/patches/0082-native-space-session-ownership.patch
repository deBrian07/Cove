+class CoveSessionBrowserTest : public InProcessBrowserTest {
+ protected:
+  CoveSpaceCloseHandler* Library(BrowserWindowInterface* window) {
+    return CoveSpaceCloseHandler::Get(window->GetUnownedUserDataHost());
+  }
+  void Switch(const std::string& id) {
+    Library(browser())->FocusSpace(id);
+    base::RunLoop().RunUntilIdle();
+  }
+  void ReadRebuild(std::vector<std::unique_ptr<sessions::SessionWindow>>& windows) {
+    auto* service = SessionServiceFactory::GetForProfile(browser()->GetProfile());
+    service->ResetFromCurrentBrowsers();
+    SessionServiceTestHelper helper(service);
+    SessionID active = SessionID::InvalidValue();
+    std::string platform;
+    std::set<SessionID> discarded;
+    sessions::RestoreSessionFromCommands(helper.command_storage_manager()->pending_commands(),
+                                         &windows, &active, &platform, &discarded);
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(CoveSessionBrowserTest, JournalResetRetainsParkedHistoryAndOwnership) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("data:text/html,<title>Personal</title>")));
+  auto* personal = browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(personal, "history.pushState({}, '', '#kept')"));
+  const int entries = personal->GetController().GetEntryCount();
+  Switch("work");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("data:text/html,<title>Work</title>")));
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  ReadRebuild(windows);
+  ASSERT_EQ(1u, windows.size());
+  ASSERT_EQ(2u, windows[0]->tabs.size());
+  EXPECT_EQ("work", windows[0]->extra_data.at(kCoveWindowSessionKey));
+  std::set<int> indices;
+  std::set<std::string> owners;
+  for (const auto& tab : windows[0]->tabs) {
+    indices.insert(tab->tab_visual_index);
+    auto state = DecodeCoveTabSessionState(tab->extra_data.at(kCoveTabSessionKey));
+    ASSERT_TRUE(state);
+    owners.insert(state->space);
+    if (state->space == "personal") EXPECT_EQ(entries, static_cast<int>(tab->navigations.size()));
+  }
+  EXPECT_EQ((std::set<int>{0, 1}), indices);
+  EXPECT_EQ((std::set<std::string>{"personal", "work"}), owners);
+  Switch("personal");
+  EXPECT_EQ(personal, browser()->tab_strip_model()->GetActiveWebContents());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSessionBrowserTest, ResetIncludesParkedSplitAndMarkedBlankPane) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  auto* model = browser()->tab_strip_model();
+  MarkCoveEmptyCanvas(model->GetActiveWebContents());
+  auto* right = chrome::AddAndReturnTabAt(browser(), GURL("data:text/html,<title>Right</title>"), -1, true);
+  ASSERT_TRUE(right);
+  const auto group = model->AddToNewGroup({0, 1});
+  const auto split = model->AddToNewSplit({0, 1},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kStacked, 0.37),
+      split_tabs::SplitTabCreatedSource::kExtensionsApi);
+  Switch("work");
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  ReadRebuild(windows);
+  ASSERT_EQ(1u, windows.size());
+  EXPECT_EQ(3u, windows[0]->tabs.size());
+  ASSERT_EQ(1u, windows[0]->tab_groups.size());
+  EXPECT_EQ(group, windows[0]->tab_groups[0]->id);
+  ASSERT_EQ(1u, windows[0]->split_tabs.size());
+  EXPECT_EQ(split, windows[0]->split_tabs[0]->id_);
+  EXPECT_EQ(split_tabs::SplitTabLayout::kStacked, windows[0]->split_tabs[0]->split_visual_data_.split_layout());
+  EXPECT_DOUBLE_EQ(0.37, windows[0]->split_tabs[0]->split_visual_data_.split_ratio());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSessionBrowserTest, WindowMetadataIsIndependent) {
+  auto* second = CreateBrowser(browser()->GetProfile());
+  Library(second)->FocusSpace("work");
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ("personal", BrowserLiveTabContext::From(browser())->GetExtraDataForWindow().at(kCoveWindowSessionKey));
+  EXPECT_EQ("work", BrowserLiveTabContext::From(second)->GetExtraDataForWindow().at(kCoveWindowSessionKey));
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSessionBrowserTest, MalformedOwnershipKeepsIntactSplitAndAllPages) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("data:text/html,<title>One</title>")));
+  auto* model = browser()->tab_strip_model();
+  ASSERT_TRUE(chrome::AddAndReturnTabAt(browser(), GURL("data:text/html,<title>Two</title>"), -1, true));
+  auto* library = Library(browser());
+  library->BeginSessionRestore("work");
+  RestoreCoveTabSessionState(model->GetWebContentsAt(0),
+      {{kCoveTabSessionKey, EncodeCoveTabSessionState(CoveTabSessionState{"personal", "", 0, true, true})}});
+  RestoreCoveTabSessionState(model->GetWebContentsAt(1),
+      {{kCoveTabSessionKey, EncodeCoveTabSessionState(CoveTabSessionState{"missing", "", 1})}});
+  const auto split = model->AddToNewSplit({0, 1}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kExtensionsApi);
+  library->FinishSessionRestore();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(2, model->count());
+  EXPECT_EQ(split, model->GetTabAtIndex(0)->GetSplit());
+  EXPECT_EQ(split, model->GetTabAtIndex(1)->GetSplit());
+  EXPECT_EQ("work", GetCoveTabSessionState(model->GetWebContentsAt(0))->space);
+  EXPECT_EQ("work", GetCoveTabSessionState(model->GetWebContentsAt(1))->space);
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSessionBrowserTest, ReconstructedHistoryReturnsToOriginalSpace) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("data:text/html,<title>Kept</title>")));
+  auto* original = browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(original, "history.pushState({}, '', '#kept')"));
+  const int history_count = original->GetController().GetEntryCount();
+  Switch("work");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("data:text/html,<title>Work</title>")));
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  ReadRebuild(windows);
+  ASSERT_EQ(1u, windows.size());
+  auto* restored = CreateBrowser(browser()->GetProfile());
