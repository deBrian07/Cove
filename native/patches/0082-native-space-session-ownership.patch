+  CoveTabSessionState state{"work/研究", "", 0, false, true, false, false};
+  EXPECT_EQ(state, DecodeCoveTabSessionState(EncodeCoveTabSessionState(state)));
+}
+TEST(CoveSessionMetadataTest, RejectsInvalidSchemaAndMissingFields) {
+  for (const char* input : {"", "null", "[]", "{}", "{\"version\":2}",
+                            "{\"version\":1,\"space\":\"work\"}"})
+    EXPECT_FALSE(DecodeCoveTabSessionState(input));
+}
+TEST(CoveSessionMetadataTest, RejectsInvalidIdsAndOrder) {
+  CoveTabSessionState state{"work"};
+  state.order = -1;
+  EXPECT_FALSE(DecodeCoveTabSessionState(EncodeCoveTabSessionState(state)));
+  state.order = 1000001;
+  EXPECT_FALSE(DecodeCoveTabSessionState(EncodeCoveTabSessionState(state)));
+  state.order = 0;
+  state.space.clear();
+  EXPECT_FALSE(DecodeCoveTabSessionState(EncodeCoveTabSessionState(state)));
+  state.space = std::string(513, 'x');
+  EXPECT_FALSE(DecodeCoveTabSessionState(EncodeCoveTabSessionState(state)));
+  state.space = std::string("wo\0rk", 5);
+  EXPECT_FALSE(DecodeCoveTabSessionState(EncodeCoveTabSessionState(state)));
+}
+TEST(CoveSessionMetadataTest, RejectsWrongFieldTypesAndOversizeInput) {
+  auto encoded = EncodeCoveTabSessionState(CoveTabSessionState{"work"});
+  auto start = encoded.find("\"canvas\":false");
+  ASSERT_NE(std::string::npos, start);
+  encoded.replace(start, 14, "\"canvas\":\"no\"");
+  EXPECT_FALSE(DecodeCoveTabSessionState(encoded));
+  EXPECT_FALSE(DecodeCoveTabSessionState(std::string(8193, ' ')));
+}
+TEST(CoveSessionMetadataTest, IgnoresUnknownFieldsWithoutRepairingInput) {
+  auto encoded = EncodeCoveTabSessionState(CoveTabSessionState{"work"});
+  encoded.insert(1, "\"future\":{\"data\":17},");
+  EXPECT_EQ("work", DecodeCoveTabSessionState(encoded)->space);
+}
