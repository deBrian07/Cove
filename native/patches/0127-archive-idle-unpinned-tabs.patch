+
+// Like Arc, unpinned pages left idle past the chosen time are archived into
+// recently closed history; the current, pinned and playing pages stay.
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       IdleUnpinnedTabsAreArchivedIntoHistory) {
+  auto* model = browser()->GetTabStripModel();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Pinned</title>")));
+  model->SetTabPinned(model->active_index(), true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("data:text/html,<title>Idle</title>"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("data:text/html,<title>Current</title>"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_EQ(3, model->count());
+  auto* current = model->GetActiveWebContents();
+  PrefService* prefs = browser()->GetProfile()->GetPrefs();
+  EXPECT_EQ(12, prefs->GetInteger("cove.archive_after_hours"));
+
+  // Nothing is idle yet.
+  EXPECT_EQ(0u, ArchiveIdle(base::TimeTicks::Now()));
+  EXPECT_EQ(3, model->count());
+
+  // "Never" keeps everything.
+  prefs->SetInteger("cove.archive_after_hours", 0);
+  EXPECT_EQ(0u,
+            ArchiveIdle(base::TimeTicks::Now() + base::Days(40)));
+  EXPECT_EQ(3, model->count());
+
+  // Past 12 hours, only the unpinned background page goes.
+  prefs->SetInteger("cove.archive_after_hours", 12);
+  EXPECT_EQ(1u,
+            ArchiveIdle(base::TimeTicks::Now() + base::Hours(13)));
+  ASSERT_TRUE(base::test::RunUntil([&] { return model->count() == 2; }));
+  EXPECT_EQ(current, model->GetActiveWebContents());
+  EXPECT_TRUE(model->IsTabPinned(0));
+  auto* service =
+      TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  ASSERT_TRUE(base::test::RunUntil([&] { return !service->entries().empty(); }));
+}
