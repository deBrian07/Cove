+size_t CoveSidebarLibraryView::ArchiveIdleTabs(base::TimeTicks now) {
+  if (!browser_ || browser_->GetProfile()->IsOffTheRecord() ||
+      switching_space_ || restoring_session_ || closing_active_space_) {
+    return 0;
+  }
+  const PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  const auto* pref = prefs->FindPreference("cove.archive_after_hours");
+  const int hours = pref ? prefs->GetInteger("cove.archive_after_hours") : 0;
+  if (hours <= 0) {
+    return 0;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  const tabs::TabInterface* active = model->GetActiveTab();
+  std::vector<tabs::TabHandle> idle;
+  for (const tabs::TabHandle& handle : GetArchivableTabHandles(model)) {
+    tabs::TabInterface* tab = handle.Get();
+    content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+    // Keep what the person is using or hearing, and split layouts they built.
+    if (!contents || tab == active || tab->IsSplit() ||
+        contents->IsCurrentlyAudible() || contents->HasPictureInPictureVideo() ||
+        now - contents->GetLastActiveTimeTicks() < base::Hours(hours)) {
+      continue;
+    }
+    idle.push_back(handle);
+  }
+  size_t archived = 0;
+  for (const tabs::TabHandle& handle : idle) {
+    tabs::TabInterface* tab = handle.Get();
+    const int index = tab ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    if (index == TabStripModel::kNoTab || tab->IsPinned() ||
+        model->count() <= 1) {
+      continue;
+    }
+    model->CloseWebContentsAt(index,
+                              TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    ++archived;
+  }
+  return archived;
 }
 
