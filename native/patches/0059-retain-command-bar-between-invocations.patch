diff --git a/chrome/browser/ui/views/bubble/webui_bubble_manager.cc b/chrome/browser/ui/views/bubble/webui_bubble_manager.cc
--- a/chrome/browser/ui/views/bubble/webui_bubble_manager.cc
+++ b/chrome/browser/ui/views/bubble/webui_bubble_manager.cc
@@ -8,6 +8,7 @@
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
 #include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/webui_url_constants.h"
 #include "chrome/browser/ui/webui/top_chrome/webui_contents_warmup_level_recorder.h"
 #include "content/public/browser/render_process_host.h"
 #include "ui/base/interaction/element_identifier.h"
@@ -109,7 +110,18 @@
   DCHECK(bubble_widget_observation_.IsObserving());
   bubble_widget_observation_.Reset();
   close_bubble_helper_.reset();
-  cache_timer_->Reset();
+  if (cached_contents_wrapper_ &&
+      cached_contents_wrapper_->web_contents()->GetVisibleURL().host() ==
+          chrome::kChromeUITabSearchHost) {
+    // Cove opens this primary input surface throughout a browsing session.
+    // Avoid a cold renderer reload after every ordinary thirty-second pause.
+    cache_timer_->Start(FROM_HERE, base::Minutes(10),
+                        base::BindRepeating(
+                            &WebUIBubbleManager::ResetContentsWrapper,
+                            base::Unretained(this)));
+  } else {
+    cache_timer_->Reset();
+  }
   bubble_using_cached_web_contents_ = false;
 }
 
