+CoveLocationView::~CoveLocationView() {
+  // The caption row can outlive this view. Its callbacks are weak, and these
+  // pointers must not outlive the separately owned buttons either.
+  navigation_controls_.SetView(nullptr);
+  back_ = nullptr;
+  forward_ = nullptr;
+}
+std::unique_ptr<views::View> CoveLocationView::TakeNavigationControls() {
+  auto* navigation = navigation_controls_.view();
+  if (!navigation || navigation->parent() != this) {
+    return nullptr;
+  }
+  auto controls = RemoveChildViewT(navigation);
+  PreferredSizeChanged();
+  return controls;
+}
+void CoveLocationView::OnNavigationControlsDestroyed() {
+  back_ = nullptr;
+  forward_ = nullptr;
+}
