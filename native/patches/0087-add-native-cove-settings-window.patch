+namespace {
+// Copy only this test window's compositor. This includes layered Views without
+// reading the desktop or depending on macOS screen-recording permission.
+SkBitmap RenderWidget(views::Widget* widget) {
+  widget->LayoutRootViewIfNecessary();
+  base::test::TestFuture<std::unique_ptr<viz::CopyOutputResult>> captured;
+  auto request = std::make_unique<viz::CopyOutputRequest>(
+      viz::CopyOutputRequest::ResultFormat::RGBA,
+      viz::CopyOutputRequest::ResultDestination::kSystemMemory,
+      captured.GetCallback());
+  request->set_result_task_runner(
+      base::SequencedTaskRunner::GetCurrentDefault());
+  auto* compositor = widget->GetCompositor();
+  compositor->root_layer()->RequestCopyOfOutput(std::move(request));
+  compositor->ScheduleDraw();
+  auto result = captured.Take();
+  if (!result) {
+    return SkBitmap();
+  }
+  auto bitmap = result->ScopedAccessSkBitmap();
+  return bitmap.GetOutScopedBitmap();
+}
