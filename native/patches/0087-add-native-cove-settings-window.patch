+class CoveSettingsBrowserTest : public InProcessBrowserTest {};
+
+IN_PROC_BROWSER_TEST_F(CoveSettingsBrowserTest,
+                       StartupTogglePreservesCustomURLs) {
+  SessionStartupPref original(SessionStartupPref::URLS);
+  original.urls = {GURL("https://example.test/one"),
+                   GURL("https://example.test/two")};
+  SessionStartupPref::SetStartupPref(browser()->GetProfile(), original);
+  auto* window = ShowCoveSettings(browser());
+  ASSERT_TRUE(window);
+  EXPECT_EQ(window, ShowCoveSettings(browser()));
+  auto* toggle = SettingsToggle(window->GetContentsView(),
+                                u"Restore windows from the previous session");
+  ASSERT_TRUE(toggle);
+  EXPECT_FALSE(toggle->GetIsOn());
+  views::test::ButtonTestApi(toggle).NotifyDefaultMouseClick();
+  auto enabled = SessionStartupPref::GetStartupPref(browser()->GetProfile());
+  EXPECT_EQ(SessionStartupPref::LAST_AND_URLS, enabled.type);
+  EXPECT_EQ(original.urls, enabled.urls);
+  views::test::ButtonTestApi(toggle).NotifyDefaultMouseClick();
+  auto disabled = SessionStartupPref::GetStartupPref(browser()->GetProfile());
+  EXPECT_EQ(SessionStartupPref::URLS, disabled.type);
+  EXPECT_EQ(original.urls, disabled.urls);
+  window->CloseNow();
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSettingsBrowserTest,
+                       NativeSectionsAndProfilePreference) {
+  auto* window = ShowCoveSettings(browser());
+  ASSERT_TRUE(window);
+  auto* prefs = browser()->GetProfile()->GetPrefs();
+  const bool old_prompt = prefs->GetBoolean(prefs::kPromptForDownload);
+  auto* prompt = SettingsToggle(window->GetContentsView(),
+                                u"Ask where to save each download");
+  ASSERT_TRUE(prompt);
+  EXPECT_TRUE(prompt->IsDrawn());
+  EXPECT_GT(prompt->height(), 0);
+  views::test::ButtonTestApi(prompt).NotifyDefaultMouseClick();
+  EXPECT_EQ(!old_prompt, prefs->GetBoolean(prefs::kPromptForDownload));
+
+  const auto folder =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          "cove-settings-snapshots");
+  if (!folder.empty()) {
+    base::ScopedAllowBlockingForTesting allow_artifact_write;
+    ASSERT_TRUE(base::CreateDirectory(folder));
+  }
+  for (const auto* tab : {u"General", u"Profiles", u"Appearance", u"Links",
+                          u"Shortcuts", u"Advanced"}) {
+    auto* button = SettingsButton(window->GetContentsView(), tab);
+    ASSERT_TRUE(button);
+    views::test::ButtonTestApi(button).NotifyDefaultMouseClick();
+    window->LayoutRootViewIfNecessary();
+    if (std::u16string_view(tab) == u"Profiles") {
+      EXPECT_TRUE(
+          SettingsButton(window->GetContentsView(), u"Open Google account…"));
+      EXPECT_TRUE(
+          SettingsButton(window->GetContentsView(), u"Manage profiles…"));
+    }
+    if (!folder.empty()) {
+      base::ScopedAllowBlockingForTesting allow_artifact_write;
+      auto image =
+          gfx::PNGCodec::EncodeBGRASkBitmap(RenderWidget(window), false);
+      ASSERT_TRUE(image);
+      ASSERT_TRUE(base::WriteFile(
+          folder.Append(base::UTF16ToUTF8(tab) + ".png"), *image));
+    }
+  }
+  window->CloseNow();
+  auto* reopened = ShowCoveSettings(browser());
+  ASSERT_TRUE(reopened);
+  prompt = SettingsToggle(reopened->GetContentsView(),
+                          u"Ask where to save each download");
+  ASSERT_TRUE(prompt);
+  EXPECT_EQ(!old_prompt, prompt->GetIsOn());
+  reopened->CloseNow();
+}
