+class CoveSettingsView : public views::View, public views::TextfieldController {
+  METADATA_HEADER(CoveSettingsView, views::View)
+ public:
+  explicit CoveSettingsView(BrowserWindowInterface* browser)
+      : browser_(browser->GetWeakPtr()) {
+    SetBackground(views::CreateSolidBackground(kSurface));
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(20, 24)));
+    auto* layout = Column(this, 18);
+    auto* navigation = AddChildView(std::make_unique<views::View>());
+    navigation->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 6));
+    for (size_t i = 0; i < std::size(kPages); ++i) {
+      tabs_.push_back(Button(navigation, base::ASCIIToUTF16(kPages[i]),
+                             base::BindRepeating(&CoveSettingsView::ShowPage,
+                                                 base::Unretained(this), i)));
+    }
+    auto* scroll = AddChildView(std::make_unique<views::ScrollView>());
+    scroll->SetBackgroundColor(kSurface);
+    scroll->ClipHeightTo(320, 520);
+    auto body = std::make_unique<views::View>();
+    body_ = body.get();
+    Column(body_, 16);
+    scroll->SetContents(std::move(body));
+    layout->SetFlexForView(scroll, 1);
+    SetPreferredSize(gfx::Size(720, 640));
+    ShowPage(0);
+  }
+  ~CoveSettingsView() override = default;
+
+ private:
+  PrefService* Prefs() const {
+    return browser_ ? browser_->GetProfile()->GetPrefs() : nullptr;
+  }
+  views::View* Card(std::u16string title) {
+    auto* card = body_->AddChildView(std::make_unique<views::View>());
+    card->SetBackground(views::CreateRoundedRectBackground(kCard, 8));
+    card->SetBorder(views::CreateRoundedRectBorder(1, 8, kLine));
+    auto* contents = card->AddChildView(std::make_unique<views::View>());
+    card->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(14), 0));
+    Column(contents, 8);
+    auto* heading = Label(contents, std::move(title), kMuted);
+    heading->SetFontList(gfx::FontList().DeriveWithSizeDelta(-1));
+    return contents;
+  }
+  views::View* Row(views::View* card, std::u16string title) {
+    auto* row = card->AddChildView(std::make_unique<views::View>());
+    auto* layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(5, 0), 12));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    layout->SetFlexForView(Label(row, std::move(title)), 1);
+    return row;
+  }
+  void Description(std::u16string text) {
+    auto* label = Label(body_, std::move(text), kMuted);
+    label->SetMultiLine(true);
+  }
+  void Action(views::View* card,
+              std::u16string title,
+              std::u16string action,
+              base::RepeatingClosure callback) {
+    Button(Row(card, std::move(title)), std::move(action),
+           base::BindRepeating(&CoveSettingsView::RunAction,
+                               base::Unretained(this), std::move(callback)));
+  }
+  void RunAction(base::RepeatingClosure callback) {
+    // Closing can destroy this View. Keep the action on the stack and access
+    // no members after Close(), so the destination opens unobscured.
+    if (auto* window = GetWidget()) {
+      window->Close();
+    }
+    callback.Run();
+  }
+  base::RepeatingClosure Settings(std::string page) {
+    return base::BindRepeating(
+        [](base::WeakPtr<BrowserWindowInterface> browser, std::string page) {
+          if (browser) {
+            chrome::ShowSettingsSubPage(browser.get(), page);
+          }
+        },
+        browser_, std::move(page));
+  }
+  views::ToggleButton* Toggle(views::View* card,
+                              std::u16string title,
+                              bool value,
+                              base::RepeatingClosure callback,
+                              bool enabled = true) {
+    auto name = title;
+    auto* toggle = Row(card, std::move(title))
+                       ->AddChildView(std::make_unique<views::ToggleButton>(
+                           std::move(callback)));
+    toggle->SetIsOn(value);
+    toggle->SetEnabled(enabled);
+    toggle->SetTrackOnColor(kBlue);
+    toggle->GetViewAccessibility().SetName(name);
+    return toggle;
+  }
+  void PrefToggle(views::View* card,
+                  std::u16string title,
+                  const char* name,
+                  bool local = false) {
+    auto* prefs = local ? g_browser_process->local_state() : Prefs();
+    const auto* pref = prefs ? prefs->FindPreference(name) : nullptr;
+    if (!pref) {
+      return;
+    }
+    Toggle(
+        card, std::move(title), prefs->GetBoolean(name),
+        base::BindRepeating(
+            [](base::WeakPtr<BrowserWindowInterface> browser,
+               const char* pref_name, bool local_state) {
+              if (!browser) {
+                return;
+              }
+              auto* service = local_state ? g_browser_process->local_state()
+                                          : browser->GetProfile()->GetPrefs();
+              const auto* preference = service->FindPreference(pref_name);
+              if (preference && preference->IsUserModifiable()) {
+                service->SetBoolean(pref_name, !service->GetBoolean(pref_name));
+              }
+            },
+            browser_, name, local),
+        pref->IsUserModifiable());
+  }
+  void ShowPage(size_t page) {
+    if (!browser_) {
+      return;
+    }
+    shortcut_rows_ = nullptr;
+    search_ = nullptr;
+    theme_buttons_.clear();
+    body_->RemoveAllChildViews();
+    for (size_t i = 0; i < tabs_.size(); ++i) {
+      tabs_[i]->SetBackground(views::CreateRoundedRectBackground(
+          i == page ? kSelected : kSurface, 7));
+      tabs_[i]->SetEnabledTextColors(i == page ? kBlue : kMuted);
+    }
+    switch (page) {
+      case 0:
+        General();
+        break;
+      case 1:
+        Profiles();
+        break;
+      case 2:
+        Appearance();
+        break;
+      case 3:
+        Links();
+        break;
+      case 4:
+        Shortcuts();
+        break;
+      case 5:
+        Advanced();
+        break;
+    }
+    InvalidateLayout();
+  }
+  void General() {
+    Description(u"Make Cove feel at home.");
+    auto* startup = Card(u"STARTUP");
+    auto pref = SessionStartupPref::GetStartupPref(browser_->GetProfile());
+    Toggle(startup, u"Restore windows from the previous session",
+           pref.type == SessionStartupPref::LAST ||
+               pref.type == SessionStartupPref::LAST_AND_URLS,
+           base::BindRepeating(
+               [](base::WeakPtr<BrowserWindowInterface> browser) {
+                 if (!browser) {
+                   return;
+                 }
+                 auto* profile = browser->GetProfile();
+                 if (SessionStartupPref::TypeIsManaged(profile->GetPrefs())) {
+                   return;
+                 }
+                 auto pref = SessionStartupPref::GetStartupPref(profile);
+                 switch (pref.type) {
+                   case SessionStartupPref::LAST:
+                     pref.type = SessionStartupPref::DEFAULT;
+                     break;
+                   case SessionStartupPref::LAST_AND_URLS:
+                     pref.type = SessionStartupPref::URLS;
+                     break;
+                   case SessionStartupPref::URLS:
+                     pref.type = SessionStartupPref::LAST_AND_URLS;
+                     break;
+                   default:
+                     pref.type = SessionStartupPref::LAST;
+                     break;
+                 }
+                 SessionStartupPref::SetStartupPref(profile, pref);
+               },
+               browser_),
+           !SessionStartupPref::TypeIsManaged(Prefs()));
+#if BUILDFLAG(IS_MAC)
+    PrefToggle(startup, u"Ask before quitting", prefs::kConfirmToQuitEnabled,
+               true);
+#endif
+    auto* browsing = Card(u"BROWSING");
+    Action(browsing, u"Default search engine", u"Search settings…",
+           Settings("search"));
+    Action(browsing, u"Default browser", u"Manage…",
+           Settings("defaultBrowser"));
+    auto* downloads = Card(u"DOWNLOADS");
+    PrefToggle(downloads, u"Ask where to save each download",
+               prefs::kPromptForDownload);
+    Action(downloads, u"Download location", u"Choose…", Settings("downloads"));
+  }
+  void Profiles() {
+    Description(
+        u"Profiles keep history, cookies, passwords and extensions separate.");
+    auto* account = Card(u"CURRENT PROFILE");
+    auto name = base::UTF8ToUTF16(Prefs()->GetString(prefs::kProfileName));
+    // Present the upstream automatic placeholder using Cove's vocabulary.
+    // Never rename the stored profile or mask a name chosen by the user.
+    if (Prefs()->GetBoolean(prefs::kProfileUsingDefaultName) &&
+        name == u"Your Chromium") {
+      name = u"Personal";
+    }
+    Label(account, name)->SetFontList(gfx::FontList().DeriveWithSizeDelta(4));
+    Action(account, u"Google account", u"Open Google account…",
+           base::BindRepeating(
+               [](base::WeakPtr<BrowserWindowInterface> browser) {
+                 if (!browser) {
+                   return;
+                 }
+                 NavigateParams params(browser.get(),
+                                       GURL("https://myaccount.google.com/"),
+                                       ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+                 params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+                 Navigate(&params);
+               },
+               browser_));
+    Action(account, u"Browser profiles", u"Manage profiles…",
+           base::BindRepeating([] {
+             ProfilePicker::Show(ProfilePicker::Params::FromEntryPoint(
+                 ProfilePicker::EntryPoint::kProfileMenuManageProfiles));
+           }));
+    auto* data = Card(u"YOUR DATA");
+    Action(data, u"Passwords", u"Open…",
+           base::BindRepeating(
+               [](base::WeakPtr<BrowserWindowInterface> browser) {
+                 if (browser) {
+                   chrome::ShowPasswordManager(browser.get());
+                 }
+               },
+               browser_));
+    Action(data, u"Payment methods", u"Manage…", Settings("payments"));
+    Action(data, u"Privacy and security", u"Open…", Settings("privacy"));
+  }
+  void SetScheme(ThemeService::BrowserColorScheme scheme) {
+    if (!browser_ || !Prefs()
+                          ->FindPreference(prefs::kBrowserColorScheme)
+                          ->IsUserModifiable()) {
+      return;
+    }
+    ThemeServiceFactory::GetForProfile(browser_->GetProfile())
+        ->SetBrowserColorScheme(scheme);
+    RefreshThemeButtons();
+  }
+  void RefreshThemeButtons() {
+    if (!browser_) {
+      return;
+    }
+    auto scheme = ThemeServiceFactory::GetForProfile(browser_->GetProfile())
+                      ->GetBrowserColorScheme();
+    for (size_t i = 0; i < theme_buttons_.size(); ++i) {
+      theme_buttons_[i]->SetBackground(views::CreateRoundedRectBackground(
+          static_cast<size_t>(scheme) == i ? kSelected : kLine, 6));
+    }
+  }
+  void Appearance() {
+    Description(
+        u"Choose your browser appearance and how the sidebar reveals itself.");
+    auto* theme = Card(u"APPEARANCE");
+    auto* row = Row(theme, u"Color scheme");
+    const std::array<const char*, 3> names = {"System", "Light", "Dark"};
+    for (size_t i = 0; i < std::size(names); ++i) {
+      theme_buttons_.push_back(
+          Button(row, base::ASCIIToUTF16(names[i]),
+                 base::BindRepeating(
+                     &CoveSettingsView::SetScheme, base::Unretained(this),
+                     static_cast<ThemeService::BrowserColorScheme>(i))));
+    }
+    RefreshThemeButtons();
+    Action(theme, u"Colors, fonts and page zoom", u"Customize…",
+           Settings("appearance"));
+    if (auto* state =
+            tabs::VerticalTabStripStateController::From(browser_.get())) {
+      auto* sidebar = Card(u"SIDEBAR");
+      Toggle(
+          sidebar, u"Reveal the hidden sidebar on hover",
+          state->IsExpandOnHoverEnabled(),
+          base::BindRepeating(
+              [](base::WeakPtr<BrowserWindowInterface> browser) {
+                if (browser) {
+                  if (auto* state = tabs::VerticalTabStripStateController::From(
+                          browser.get())) {
+                    state->SetExpandOnHoverEnabled(
+                        !state->IsExpandOnHoverEnabled());
+                  }
+                }
+              },
+              browser_));
+    }
+  }
+  void Links() {
+    Description(
+        u"Control how websites open new windows and handle external links.");
+    auto* links = Card(u"LINKS AND WINDOWS");
+    Action(links, u"Pop-ups and redirects", u"Manage…",
+           Settings("content/popups"));
+    Action(links, u"Protocol handlers", u"Manage…", Settings("handlers"));
+    Action(links, u"Default browser", u"Manage…", Settings("defaultBrowser"));
+    Action(links, u"Site permissions", u"Open…", Settings("content"));
+  }
+  void Shortcuts() {
+    Description(u"Find the shortcuts currently assigned to Cove commands.");
+    search_ = body_->AddChildView(std::make_unique<views::Textfield>());
+    search_->SetPlaceholderText(u"Search commands or shortcuts");
+    search_->GetViewAccessibility().SetName(u"Search shortcuts");
+    search_->set_controller(this);
+    search_->SetBackgroundColor(kCard);
+    search_->SetColor(kText);
+    search_->SetBorder(views::CreatePaddedBorder(
+        views::CreateRoundedRectBorder(1, 6, kLine), gfx::Insets::VH(10, 12)));
+    shortcut_rows_ = Card(u"KEYBOARD SHORTCUTS");
+    RebuildShortcuts();
+  }
+  void RebuildShortcuts() {
+    if (!browser_ || !shortcut_rows_ || !search_) {
+      return;
+    }
+    shortcut_rows_->RemoveAllChildViews();
+    struct Shortcut {
+      int id;
+      const char* name;
+    };
+    constexpr Shortcut entries[] = {
+        {IDC_NEW_TAB, "New tab / command bar"},
+        {IDC_FOCUS_LOCATION, "Address and search"},
+        {IDC_TOGGLE_VERTICAL_TABS_COLLAPSE, "Show or hide sidebar"},
+        {IDC_NEW_WINDOW, "New window"},
+        {IDC_NEW_INCOGNITO_WINDOW, "New incognito window"},
+        {IDC_CLOSE_TAB, "Close tab"},
+        {IDC_RESTORE_TAB, "Reopen closed tab"},
+        {IDC_COVE_NEW_SPACE, "New Space"},
+        {IDC_COVE_NEXT_SPACE, "Next Space"},
+        {IDC_COVE_PREVIOUS_SPACE, "Previous Space"},
+        {IDC_COVE_NEW_FOLDER, "New folder"},
+        {IDC_COVE_TOGGLE_FAVORITE, "Favorite tab"},
+        {IDC_COVE_CLEAR_TODAY, "Clear Today"},
+        {IDC_COVE_RESET_PIN, "Reset tab to saved URL"},
+        {IDC_COVE_RESET_SPACE, "Reset Space"},
+        {IDC_COVE_FOCUS_SPLIT_LEFT, "Focus first split pane"},
+        {IDC_COVE_FOCUS_SPLIT_RIGHT, "Focus second split pane"},
+        {IDC_BACK, "Back"},
+        {IDC_FORWARD, "Forward"},
+        {IDC_RELOAD, "Reload"},
+        {IDC_FIND, "Find in page"},
+        {IDC_FULLSCREEN, "Full screen"},
+        {IDC_OPTIONS, "Settings"},
+        {IDC_PRINT, "Print"},
+        {IDC_SHOW_DOWNLOADS, "Downloads"},
+        {IDC_SHOW_HISTORY, "History"},
+    };
+    const auto query = base::ToLowerASCII(search_->GetText());
+    size_t matches = 0;
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser_.get());
+    for (const auto& entry : entries) {
+      const auto title = base::ASCIIToUTF16(entry.name);
+      ui::Accelerator accelerator;
+      const auto key = view && view->GetAccelerator(entry.id, &accelerator)
+                           ? accelerator.GetShortcutText()
+                           : u"Unassigned";
+      if (!query.empty() &&
+          base::ToLowerASCII(title + u" " + key).find(query) ==
+              std::u16string::npos) {
+        continue;
+      }
+      Label(Row(shortcut_rows_, title), key, kMuted);
+      ++matches;
+    }
+    if (!matches) {
+      Label(shortcut_rows_, u"No matching shortcuts", kMuted);
+    }
+  }
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string&) override {
+    if (sender == search_) {
+      RebuildShortcuts();
+    }
+  }
+  void Advanced() {
+    Description(u"Review privacy, performance and browser data controls.");
+    auto* privacy = Card(u"PRIVACY");
+    PrefToggle(privacy, u"Send a Do Not Track request",
+               prefs::kEnableDoNotTrack);
+    Action(privacy, u"Security", u"Manage…", Settings("security"));
+    Action(privacy, u"Cookies and site data", u"Manage…", Settings("cookies"));
+    auto* browser = Card(u"BROWSER");
+    Action(browser, u"Performance", u"Open…", Settings("performance"));
+    Action(browser, u"Accessibility", u"Open…", Settings("accessibility"));
+    Action(browser, u"All browser settings", u"More settings…", Settings(""));
+    Action(browser, u"Import browser data", u"Import…",
+           base::BindRepeating(
+               [](base::WeakPtr<BrowserWindowInterface> browser) {
+                 if (browser) {
+                   chrome::ShowImportDialog(browser.get());
+                 }
+               },
+               browser_));
+  }
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<views::View> body_ = nullptr;
+  raw_ptr<views::View> shortcut_rows_ = nullptr;
+  raw_ptr<views::Textfield> search_ = nullptr;
+  std::vector<raw_ptr<views::LabelButton>> tabs_;
+  std::vector<raw_ptr<views::LabelButton>> theme_buttons_;
+};
