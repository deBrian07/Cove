+namespace {
+constexpr SkColor kSurface = SkColorSetRGB(24, 25, 28);
+constexpr SkColor kCard = SkColorSetRGB(30, 31, 35);
+constexpr SkColor kLine = SkColorSetRGB(53, 54, 59);
+constexpr SkColor kText = SkColorSetRGB(230, 231, 236);
+constexpr SkColor kMuted = SkColorSetRGB(151, 153, 165);
+constexpr SkColor kBlue = SkColorSetRGB(92, 125, 245);
+constexpr SkColor kSelected = SkColorSetRGB(43, 54, 86);
+constexpr std::array<const char*, 6> kPages = {
+    "General", "Profiles", "Appearance", "Links", "Shortcuts", "Advanced"};
+
+views::BoxLayout* Column(views::View* view, int gap = 12) {
+  auto* layout = view->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), gap));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  return layout;
+}
+views::Label* Label(views::View* parent,
+                    std::u16string text,
+                    SkColor color = kText) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetEnabledColor(color);
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  return label;
+}
+views::LabelButton* Button(views::View* parent,
+                           std::u16string text,
+                           views::Button::PressedCallback callback) {
+  auto* button = parent->AddChildView(
+      std::make_unique<views::LabelButton>(std::move(callback), text));
+  button->SetEnabledTextColors(kText);
+  button->SetBackground(views::CreateRoundedRectBackground(kLine, 6));
+  button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(7, 12)));
+  button->GetViewAccessibility().SetName(text);
+  return button;
+}
