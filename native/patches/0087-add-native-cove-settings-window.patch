+// The native window owns no profile data. Its callbacks use the originating
+// browser's weak pointer, and the Widget is destroyed before its delegate.
+class CoveSettingsWindow {
+ public:
+  views::Widget* Show(BrowserWindowInterface* browser) {
+    if (widget_ && !widget_->IsClosed() && browser_.get() == browser) {
+      widget_->Show();
+      widget_->Activate();
+      return widget_.get();
+    }
+    Reset();
+    browser_ = browser->GetWeakPtr();
+    delegate_ = std::make_unique<views::DialogDelegate>();
+    delegate_->SetTitle(u"Cove Settings");
+    delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    delegate_->SetCanResize(true);
+    delegate_->set_margins(gfx::Insets());
+    delegate_->SetContentsView(std::make_unique<CoveSettingsView>(browser));
+    widget_ = std::make_unique<views::Widget>();
+    widget_->set_frame_type(views::Widget::FrameType::kForceNative);
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    params.delegate = delegate_.get();
+    params.name = "CoveSettings";
+    params.parent = BrowserView::GetBrowserViewForBrowser(browser)
+                        ->GetWidget()
+                        ->GetNativeView();
+    widget_->Init(std::move(params));
+    widget_->MakeCloseSynchronous(
+        base::BindOnce([](CoveSettingsWindow* owner,
+                          views::Widget::ClosedReason) { owner->Reset(); },
+                       base::Unretained(this)));
+    widget_->CenterWindow(gfx::Size(720, 640));
+    widget_->Show();
+    return widget_.get();
+  }
+
+ private:
+  void Reset() {
+    // Disarm the close callback before deletion to avoid reentering Reset when
+    // a parent window or a different profile replaces this native window.
+    if (widget_) {
+      widget_->MakeCloseSynchronous({});
+    }
+    widget_.reset();
+    delegate_.reset();
+    browser_.reset();
+  }
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  std::unique_ptr<views::DialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+};
+}  // namespace
+
+views::Widget* ShowCoveSettings(BrowserWindowInterface* browser) {
+  if (!browser || !BrowserView::GetBrowserViewForBrowser(browser)) {
+    return nullptr;
+  }
+  static base::NoDestructor<CoveSettingsWindow> window;
+  return window->Show(browser);
+}
