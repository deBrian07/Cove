+// Saved pins and folders share a sibling order without replacing either saved
+// collection. IDs are scoped by kind; no URL, title or live-tab ownership is
+// rewritten when a row moves.
+enum class SidebarItemKind { kPin, kFolder };
+struct SidebarItem {
+  SidebarItemKind kind = SidebarItemKind::kPin;
+  std::string id;
+  bool operator==(const SidebarItem&) const = default;
+};
+struct SidebarRow {
+  SidebarItem item;
+  std::string parent;
+  std::u16string name;
+  bool collapsed = false;
+  size_t depth = 0;
+};
+class SidebarOrder {
+ public:
+  static std::vector<SidebarRow> Rows(const base::DictValue& space,
+                                      bool include_collapsed = false);
+  static std::optional<std::string> Parent(const base::DictValue& space,
+                                           const SidebarItem& item);
+  // No before item means append to the destination's children. All identities
+  // are revalidated on commit, including target removal during a native drag.
+  static bool CanMove(const base::DictValue& space,
+                      const SidebarItem& item,
+                      std::string_view parent,
+                      const std::optional<SidebarItem>& before = std::nullopt);
+  static bool Move(base::DictValue& space,
+                   const SidebarItem& item,
+                   std::string_view parent,
+                   const std::optional<SidebarItem>& before = std::nullopt);
+};
+
 }  // namespace cove
 
