+std::vector<std::string> SidebarKeys(const base::DictValue& space,
+                                     bool all = false) {
+  std::vector<std::string> result;
+  for (const auto& row : SidebarOrder::Rows(space, all))
+    result.push_back((row.item.kind == SidebarItemKind::kPin ? "p:" : "f:") +
+                     row.item.id);
+  return result;
+}
+SidebarItem Pin(std::string id) {
+  return {SidebarItemKind::kPin, std::move(id)};
+}
+SidebarItem Folder(std::string id) {
+  return {SidebarItemKind::kFolder, std::move(id)};
+}
+
+TEST(CoveSidebarOrderTest, MixedRowsReparentAndRoundTripWithoutLosingPageData) {
+  auto space = Space(R"({"folders":[{"id":"a","name":"A"},
+      {"id":"b","name":"B","parent":"a"}],
+    "pins":[{"id":"p0","url":"https://zero.test/","home":"kept"},
+            {"id":"p1","folder":"a","url":"https://one.test/"},
+            {"id":"p2","url":"https://two.test/","history":[1,2,3]}],
+    "tabs":[{"draft":"unsent","history":["one","two"]}],"extension":{"keep":true}})");
+  const auto pages = space.Find("tabs")->Clone();
+  const auto extra = space.Find("extension")->Clone();
+  EXPECT_EQ((std::vector<std::string>{"p:p0", "p:p2", "f:a", "p:p1", "f:b"}),
+            SidebarKeys(space));
+  ASSERT_TRUE(SidebarOrder::Move(space, Folder("a"), "", Pin("p0")));
+  EXPECT_EQ((std::vector<std::string>{"f:a", "p:p1", "f:b", "p:p0", "p:p2"}),
+            SidebarKeys(space));
+  ASSERT_TRUE(SidebarOrder::Move(space, Pin("p2"), "a", Folder("b")));
+  EXPECT_EQ((std::vector<std::string>{"f:a", "p:p1", "p:p2", "f:b", "p:p0"}),
+            SidebarKeys(space));
+  ASSERT_TRUE(SidebarOrder::Move(space, Folder("b"), "", Pin("p0")));
+  EXPECT_EQ("", SidebarOrder::Parent(space, Folder("b")));
+  EXPECT_EQ("a", SidebarOrder::Parent(space, Pin("p2")));
+  EXPECT_EQ(pages, *space.Find("tabs"));
+  EXPECT_EQ(extra, *space.Find("extension"));
+  EXPECT_EQ("kept",
+            *space.FindList("pins")->front().GetDict().FindString("home"));
+  EXPECT_EQ(
+      3u, space.FindList("pins")->back().GetDict().FindList("history")->size());
+  ASSERT_TRUE(base::WriteJson(space));
+  auto restored = Space(*base::WriteJson(space));
+  EXPECT_EQ(space, restored);
+  EXPECT_EQ(SidebarKeys(space, true), SidebarKeys(restored, true));
+}
+
+TEST(CoveSidebarOrderTest, InvalidAndCyclicDropsAreAtomic) {
+  auto space = Space(R"({"folders":[{"id":"a"},{"id":"b","parent":"a"}],
+    "pins":[{"id":"p","folder":"a","url":"https://kept.test/"}]})");
+  const auto before = space.Clone();
+  EXPECT_FALSE(SidebarOrder::Move(space, Folder("a"), "b"));
+  EXPECT_FALSE(SidebarOrder::Move(space, Folder("a"), "a"));
+  EXPECT_FALSE(SidebarOrder::Move(space, Pin("p"), "missing"));
+  EXPECT_FALSE(SidebarOrder::Move(space, Pin("missing"), ""));
+  EXPECT_FALSE(SidebarOrder::Move(space, Pin("p"), "", Pin("p")));
+  EXPECT_FALSE(SidebarOrder::Move(space, Folder("b"), "", Pin("p")));
+  EXPECT_FALSE(
+      SidebarOrder::Move(space, {static_cast<SidebarItemKind>(99), "a"}, ""));
+  EXPECT_EQ(before, space);
+}
+
+TEST(CoveSidebarOrderTest, AmbiguousIdentitiesDoNotMutateSavedCollections) {
+  auto space = Space(R"({"folders":[{"id":"dup"},{"id":"dup"},{"id":"ok"}],
+    "pins":[{"id":"p","url":"https://one.test/"},
+            {"id":"p","url":"https://two.test/"},{"id":"q"}]})");
+  const auto before = space.Clone();
+  EXPECT_FALSE(SidebarOrder::Move(space, Pin("p"), "ok"));
+  EXPECT_FALSE(SidebarOrder::Move(space, Pin("q"), "dup"));
+  EXPECT_FALSE(SidebarOrder::Move(space, Folder("dup"), "ok"));
+  EXPECT_FALSE(SidebarOrder::Move(space, Folder("ok"), "", Folder("dup")));
+  EXPECT_EQ(before, space);
+  EXPECT_EQ((std::vector<std::string>{"p:p", "p:p", "p:q", "f:dup", "f:ok"}),
+            SidebarKeys(space));
+}
+
+TEST(CoveSidebarOrderTest, CollapsedDescendantsAndOrphansStaySaved) {
+  auto space = Space(R"({"folders":[{"id":"a","collapsed":true},
+    {"id":"b","parent":"a"}],"pins":[{"id":"p","folder":"a"},
+    {"id":"orphan","folder":"removed"}]})");
+  EXPECT_EQ((std::vector<std::string>{"p:orphan", "f:a"}), SidebarKeys(space));
+  EXPECT_EQ((std::vector<std::string>{"p:orphan", "f:a", "p:p", "f:b"}),
+            SidebarKeys(space, true));
+  ASSERT_TRUE(SidebarOrder::Move(space, Pin("orphan"), "a"));
+  EXPECT_EQ((std::vector<std::string>{"f:a"}), SidebarKeys(space));
+  EXPECT_EQ(4u, SidebarOrder::Rows(space, true).size());
+  EXPECT_EQ(2u, space.FindList("pins")->size());
+  EXPECT_TRUE(space.FindList("folders")
+                  ->front()
+                  .GetDict()
+                  .FindBool("collapsed")
+                  .value());
+}
+
+TEST(CoveSidebarOrderTest, DeletedTargetAndCanceledPreviewDoNotChangeData) {
+  auto space = Space(R"({"folders":[],"pins":[{"id":"p"},{"id":"q"}]})");
+  const auto before_preview = space.Clone();
+  EXPECT_TRUE(SidebarOrder::CanMove(space, Pin("p"), "", Pin("q")));
+  EXPECT_EQ(before_preview, space);
+  space.FindList("pins")->erase(space.FindList("pins")->begin() + 1);
+  const auto after_removal = space.Clone();
+  EXPECT_FALSE(SidebarOrder::Move(space, Pin("p"), "", Pin("q")));
+  EXPECT_EQ(after_removal, space);
+}
+
+TEST(CoveSidebarOrderTest, PinAndFolderIdsUseSeparateNamespaces) {
+  auto space = Space(R"({"folders":[{"id":"same"},{"id":"other"}],
+    "pins":[{"id":"same","url":"https://same.test/"}]})");
+  ASSERT_TRUE(SidebarOrder::Move(space, Folder("other"), "", Pin("same")));
+  EXPECT_EQ((std::vector<std::string>{"f:other", "p:same", "f:same"}),
+            SidebarKeys(space));
+  ASSERT_TRUE(SidebarOrder::Move(space, Pin("same"), "same"));
+  EXPECT_EQ((std::vector<std::string>{"f:other", "f:same", "p:same"}),
+            SidebarKeys(space));
+  EXPECT_EQ("same", SidebarOrder::Parent(space, Pin("same")));
+  EXPECT_EQ("", SidebarOrder::Parent(space, Folder("same")));
+}
+
+TEST(CoveSidebarOrderTest, DeepTreesAndMalformedOrderRemainReadable) {
+  base::DictValue space;
+  base::ListValue folders;
+  for (int i = 0; i < 10000; ++i) {
+    base::DictValue folder;
+    folder.Set("id", std::to_string(i));
+    if (i)
+      folder.Set("parent", std::to_string(i - 1));
+    folders.Append(std::move(folder));
+  }
+  space.Set("folders", std::move(folders));
+  base::DictValue pin;
+  pin.Set("id", "p");
+  pin.Set("folder", "9999");
+  base::ListValue pins;
+  pins.Append(std::move(pin));
+  space.Set("pins", std::move(pins));
+  base::ListValue order;
+  order.Append(7);
+  order.Append("unknown:item");
+  order.Append("folder:0");
+  order.Append("folder:0");
+  space.Set("sidebar_order", std::move(order));
+  const auto before = space.Clone();
+  auto rows = SidebarOrder::Rows(space);
+  ASSERT_EQ(10001u, rows.size());
+  EXPECT_EQ(Pin("p"), rows.back().item);
+  EXPECT_EQ(10000u, rows.back().depth);
+  EXPECT_EQ(before, space);
+  ASSERT_TRUE(SidebarOrder::Move(space, Pin("p"), "", Folder("0")));
+  EXPECT_EQ(Pin("p"), SidebarOrder::Rows(space).front().item);
+  EXPECT_EQ(10000u, space.FindList("folders")->size());
+}
+
+TEST(CoveSidebarOrderTest, RepeatedMovesConserveEveryIdentityAndSavedURL) {
+  base::DictValue space;
+  base::ListValue pins;
+  base::ListValue folders;
+  for (int i = 0; i < 4; ++i) {
+    base::DictValue f;
+    f.Set("id", "f" + std::to_string(i));
+    folders.Append(std::move(f));
+  }
+  for (int i = 0; i < 32; ++i) {
+    base::DictValue p;
+    p.Set("id", "p" + std::to_string(i));
+    p.Set("url", "https://kept.test/" + std::to_string(i));
+    pins.Append(std::move(p));
+  }
+  space.Set("pins", std::move(pins));
+  space.Set("folders", std::move(folders));
+  for (int i = 0; i < 160; ++i) {
+    ASSERT_TRUE(SidebarOrder::Move(
+        space, Pin("p" + std::to_string(i % 32)),
+        i % 5 == 4 ? std::string() : "f" + std::to_string(i % 4)));
+    EXPECT_EQ(36u, SidebarOrder::Rows(space, true).size());
+    EXPECT_EQ(32u, space.FindList("pins")->size());
+    for (size_t j = 0; j < space.FindList("pins")->size(); ++j)
+      EXPECT_EQ("https://kept.test/" + std::to_string(j),
+                *(*space.FindList("pins"))[j].GetDict().FindString("url"));
+  }
+  const auto restored = Space(*base::WriteJson(space));
+  EXPECT_EQ(SidebarKeys(space, true), SidebarKeys(restored, true));
+}
