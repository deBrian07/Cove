+namespace {
+std::string OrderKey(const SidebarItem& item) {
+  return (item.kind == SidebarItemKind::kPin ? "pin:" : "folder:") + item.id;
+}
+const base::DictValue* UniqueItem(const base::DictValue& space,
+                                  const SidebarItem& item) {
+  if (item.kind != SidebarItemKind::kPin &&
+      item.kind != SidebarItemKind::kFolder)
+    return nullptr;
+  const auto* list =
+      space.FindList(item.kind == SidebarItemKind::kPin ? "pins" : "folders");
+  const base::DictValue* found = nullptr;
+  if (!list || item.id.empty())
+    return nullptr;
+  for (const auto& value : *list) {
+    const auto* dict = value.GetIfDict();
+    const auto* id = dict ? dict->FindString("id") : nullptr;
+    if (id && *id == item.id) {
+      if (found)
+        return nullptr;
+      found = dict;
+    }
+  }
+  return found;
+}
+}  // namespace
+
+std::vector<SidebarRow> SidebarOrder::Rows(const base::DictValue& space,
+                                           bool include_collapsed) {
+  const FolderTree folders(space.FindList("folders"));
+  std::vector<SidebarRow> items;
+  if (const auto* pins = space.FindList("pins")) {
+    for (const auto& value : *pins) {
+      const auto* pin = value.GetIfDict();
+      const auto* id = pin ? pin->FindString("id") : nullptr;
+      if (!id || id->empty())
+        continue;
+      SidebarRow row;
+      row.item = {SidebarItemKind::kPin, *id};
+      const auto* parent = pin->FindString("folder");
+      row.parent = parent && folders.Contains(*parent) ? *parent : "";
+      const auto* name = pin->FindString("title");
+      if (!name || name->empty())
+        name = pin->FindString("url");
+      if (name)
+        row.name = base::UTF8ToUTF16(*name);
+      items.push_back(std::move(row));
+    }
+  }
+  for (const auto& folder : folders.Rows(true)) {
+    items.push_back({{SidebarItemKind::kFolder, folder.id},
+                     folder.parent,
+                     folder.name,
+                     folder.collapsed,
+                     0});
+  }
+  std::map<std::string, size_t, std::less<>> ranks;
+  if (const auto* saved = space.FindList("sidebar_order")) {
+    for (size_t i = 0; i < saved->size(); ++i) {
+      if (const auto* key = (*saved)[i].GetIfString())
+        ranks.try_emplace(*key, i);
+    }
+  }
+  std::map<std::string, std::vector<size_t>, std::less<>> children;
+  for (size_t i = 0; i < items.size(); ++i)
+    children[items[i].parent].push_back(i);
+  const auto rank = [&](size_t index) {
+    const auto it = ranks.find(OrderKey(items[index].item));
+    return it == ranks.end() ? kNone : it->second;
+  };
+  for (auto& [parent, rows] : children) {
+    std::stable_sort(rows.begin(), rows.end(),
+                     [&](size_t a, size_t b) { return rank(a) < rank(b); });
+  }
+  std::vector<std::pair<size_t, size_t>> pending;
+  for (auto it = children[""].rbegin(); it != children[""].rend(); ++it)
+    pending.emplace_back(*it, 0);
+  std::vector<SidebarRow> rows;
+  while (!pending.empty()) {
+    const auto [index, depth] = pending.back();
+    pending.pop_back();
+    auto row = items[index];
+    row.depth = depth;
+    rows.push_back(row);
+    if (row.item.kind != SidebarItemKind::kFolder ||
+        (!include_collapsed && row.collapsed))
+      continue;
+    const auto found = children.find(row.item.id);
+    if (found == children.end())
+      continue;
+    for (auto it = found->second.rbegin(); it != found->second.rend(); ++it)
+      pending.emplace_back(*it, depth + 1);
+  }
+  return rows;
+}
+
+std::optional<std::string> SidebarOrder::Parent(const base::DictValue& space,
+                                                const SidebarItem& item) {
+  const auto* value = UniqueItem(space, item);
+  if (!value)
+    return std::nullopt;
+  const FolderTree folders(space.FindList("folders"));
+  if (item.kind == SidebarItemKind::kFolder)
+    return folders.Parent(item.id);
+  const auto* parent = value->FindString("folder");
+  return parent && folders.Contains(*parent) ? *parent : std::string();
+}
+
+bool SidebarOrder::CanMove(const base::DictValue& space,
+                           const SidebarItem& item,
+                           std::string_view parent,
+                           const std::optional<SidebarItem>& before) {
+  const auto old_parent = Parent(space, item);
+  if (!old_parent)
+    return false;
+  const FolderTree folders(space.FindList("folders"));
+  if (!parent.empty() && !folders.CanAddChild(parent))
+    return false;
+  if (item.kind == SidebarItemKind::kFolder &&
+      (!folders.CanAddChild(item.id) ||
+       (*old_parent != parent && !folders.CanMove(item.id, parent))))
+    return false;
+  if (before) {
+    if (*before == item)
+      return false;
+    const auto target_parent = Parent(space, *before);
+    if (!target_parent || *target_parent != parent)
+      return false;
+    if (before->kind == SidebarItemKind::kFolder &&
+        !folders.CanAddChild(before->id))
+      return false;
+  }
+  return true;
+}
+
+bool SidebarOrder::Move(base::DictValue& space,
+                        const SidebarItem& item,
+                        std::string_view parent,
+                        const std::optional<SidebarItem>& before) {
+  if (!CanMove(space, item, parent, before))
+    return false;
+  // Build the complete order first. The public item/parent may alias a value
+  // in the space; copy them before mutating any collections.
+  const auto source = item;
+  const std::string destination(parent);
+  const auto insertion = before;
+  std::vector<std::string> order;
+  std::set<std::string> seen;
+  const auto key = OrderKey(source);
+  for (const auto& row : Rows(space, true)) {
+    const auto token = OrderKey(row.item);
+    if (token != key && seen.insert(token).second)
+      order.push_back(token);
+  }
+  auto position = order.end();
+  if (insertion)
+    position = std::find(order.begin(), order.end(), OrderKey(*insertion));
+  order.insert(position, key);
+  if (source.kind == SidebarItemKind::kFolder) {
+    if (FolderTree(space.FindList("folders")).Parent(source.id) != destination)
+      FolderTree::Move(space, source.id, destination);
+  } else {
+    // Validation established a unique ID; retain every other saved field.
+    for (auto& value : *space.FindList("pins")) {
+      auto* pin = value.GetIfDict();
+      if (pin && pin->FindString("id") && *pin->FindString("id") == source.id) {
+        pin->Set("folder", destination);
+        break;
+      }
+    }
+  }
+  base::ListValue saved;
+  for (auto& token : order)
+    saved.Append(std::move(token));
+  space.Set("sidebar_order", std::move(saved));
+  return true;
+}
+
 }  // namespace cove
