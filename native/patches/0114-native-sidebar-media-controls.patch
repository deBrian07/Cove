+std::vector<tabs::TabHandle> CoveSidebarLibraryView::GetMediaTabs() const {
+  std::vector<tabs::TabHandle> result;
+  for (auto* tab : *browser_->GetTabStripModel()) result.push_back(tab->GetHandle());
+  for (const auto& [id, space] : inactive_spaces_) {
+    for (const auto& item : space->items) {
+      if (const auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&item)) {
+        if (*tab) result.push_back((*tab)->tab->GetHandle());
+      } else {
+        const auto& owned = std::get<std::unique_ptr<DetachedTabCollection>>(item);
+        if (owned) std::visit([&](const auto& root) {
+          for (auto* tab : *root) result.push_back(tab->GetHandle());
+        }, owned->collection_);
+      }
+    }
+  }
+  return result;
+}
+
+void CoveSidebarLibraryView::ActivateMediaTab(tabs::TabHandle handle) {
+  if (switching_space_ || restoring_session_ || closing_active_space_ ||
+      !std::ranges::contains(GetMediaTabs(), handle)) return;
+  auto* tab = handle.Get();
+  if (!tab) return;
+  auto* model = browser_->GetTabStripModel();
+  if (model->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+    const auto* state = GetCoveTabSessionState(tab->GetContents());
+    if (!state) return;
+    const auto space = state->space;
+    SwitchSpace(space);
+  }
+  tab = handle.Get();
+  if (tab && model->GetIndexOfTab(tab) != TabStripModel::kNoTab)
+    model->ActivateTab(tab);
+}
+
 void CoveSidebarLibraryView::FocusSpace(std::string space_id) {
   SwitchSpace(std::move(space_id));
 }
