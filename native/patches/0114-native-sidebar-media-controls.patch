+namespace {
+using State = media_session::mojom::MediaPlaybackState;
+using Action = media_session::mojom::MediaSessionAction;
+using Suspend = media_session::mojom::MediaSession::SuspendType;
+}
+CoveMiniMediaView::CoveMiniMediaView(BrowserWindowInterface* browser) : browser_(browser) {
+  SetBackground(views::CreateRoundedRectBackground(ui::kColorButtonBackground, 10));
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 8)));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 0));
+  title_ = AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(&CoveMiniMediaView::ReturnToTab, base::Unretained(this)),
+      u"Return to media tab"));
+  title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  title_->SetPreferredSize(gfx::Size(100, 28));
+  title_->SetTooltipText(u"Return to media tab");
+  auto* controls = AddChildView(std::make_unique<views::View>());
+  auto* layout = controls->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 4));
+  layout->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kCenter);
+  previous_ = controls->AddChildView(views::ImageButton::CreateIconButton(
+      base::BindRepeating(&CoveMiniMediaView::SkipTrack, base::Unretained(this), false),
+      vector_icons::kSkipPreviousIcon, u"Previous track"));
+  play_ = controls->AddChildView(views::ImageButton::CreateIconButton(
+      base::BindRepeating(&CoveMiniMediaView::TogglePlayback, base::Unretained(this)),
+      vector_icons::kPauseIcon, u"Pause"));
+  next_ = controls->AddChildView(views::ImageButton::CreateIconButton(
+      base::BindRepeating(&CoveMiniMediaView::SkipTrack, base::Unretained(this), true),
+      vector_icons::kSkipNextIcon, u"Next track"));
+  stop_ = controls->AddChildView(views::ImageButton::CreateIconButton(
+      base::BindRepeating(&CoveMiniMediaView::StopPlayback, base::Unretained(this)),
+      vector_icons::kCloseIcon, u"Stop playback"));
+  for (auto* button : {previous_.get(), play_.get(), next_.get(), stop_.get()})
+    button->SetPreferredSize(gfx::Size(28, 28));
+}
+CoveMiniMediaView::~CoveMiniMediaView() = default;
+void CoveMiniMediaView::AddedToWidget() {
+  views::View::AddedToWidget();
+  Refresh();
+  refresh_timer_.Start(FROM_HERE, base::Milliseconds(250),
+      base::BindRepeating(&CoveMiniMediaView::Refresh, base::Unretained(this)));
+}
+void CoveMiniMediaView::RemovedFromWidget() {
+  refresh_timer_.Stop();
+  views::View::RemovedFromWidget();
+}
+std::vector<tabs::TabHandle> CoveMiniMediaView::OwnedTabs() const {
+  if (auto* bridge = CoveSpaceCloseHandler::Get(browser_->GetUnownedUserDataHost()))
+    return bridge->GetMediaTabs();
+  std::vector<tabs::TabHandle> result;
+  for (auto* tab : *browser_->GetTabStripModel()) result.push_back(tab->GetHandle());
+  return result;
+}
+content::MediaSession* CoveMiniMediaView::SelectedSession() const {
+  if (!selected_ || !std::ranges::contains(OwnedTabs(), *selected_)) return nullptr;
+  auto* tab = selected_->Get();
+  return tab ? content::MediaSession::GetIfExists(tab->GetContents()) : nullptr;
+}
+void CoveMiniMediaView::Refresh() {
+  std::optional<tabs::TabHandle> playing;
+  std::optional<tabs::TabHandle> paused;
+  for (const auto& handle : OwnedTabs()) {
+    auto* tab = handle.Get();
+    auto* session = tab ? content::MediaSession::GetIfExists(tab->GetContents()) : nullptr;
+    const auto info = session ? session->GetMediaSessionInfoSync() : nullptr;
+    if (!info || !info->is_controllable) continue;
+    if (info->playback_state == State::kPlaying) {
+      if (!playing || selected_ == handle) playing = handle;
+    } else if (!paused || selected_ == handle) paused = handle;
+  }
+  const auto selected = playing ? playing : paused;
+  selected_ = selected;
+  const auto* active = browser_->GetTabStripModel()->GetActiveTab();
+  const bool show = selected_ && (!active || active->GetHandle() != *selected_);
+  const bool changed = show != show_media_;
+  show_media_ = show;
+  if (auto* session = SelectedSession()) {
+    const auto info = session->GetMediaSessionInfoSync();
+    auto title = session->GetMediaSessionMetadata().title;
+    if (title.empty()) title = selected_->Get()->GetContents()->GetTitle();
+    if (title.empty()) title = u"Playing media";
+    if (title_->GetText() != title) title_->SetText(title);
+    title_->SetTooltipText(title + u" — Return to tab");
+    const bool is_playing = info && info->playback_state == State::kPlaying;
+    if (displayed_playing_ != is_playing) {
+      displayed_playing_ = is_playing;
+      play_->SetImageModel(views::Button::STATE_NORMAL,
+          ui::ImageModel::FromVectorIcon(is_playing ? vector_icons::kPauseIcon
+                                                : vector_icons::kPlayArrowIcon,
+                                        ui::kColorIcon, 20));
+      play_->SetTooltipText(is_playing ? u"Pause" : u"Play");
+      play_->GetViewAccessibility().SetName(is_playing ? u"Pause" : u"Play");
+    }
+    const auto actions = session->GetMediaSessionActionsSync();
+    previous_->SetVisible(std::ranges::contains(actions, Action::kPreviousTrack));
+    next_->SetVisible(std::ranges::contains(actions, Action::kNextTrack));
+  }
+  if (changed) PreferredSizeChanged();
+}
+void CoveMiniMediaView::TogglePlayback() {
+  if (auto* session = SelectedSession()) {
+    const auto info = session->GetMediaSessionInfoSync();
+    if (!info || !info->is_controllable) { Refresh(); return; }
+    if (info->playback_state == State::kPlaying)
+      session->Suspend(Suspend::kUI);
+    else session->Resume(Suspend::kUI);
+  }
+  Refresh();
+}
+void CoveMiniMediaView::SkipTrack(bool forward) {
+  if (auto* session = SelectedSession()) {
+    const auto action = forward ? Action::kNextTrack : Action::kPreviousTrack;
+    if (std::ranges::contains(session->GetMediaSessionActionsSync(), action)) {
+      if (forward) session->NextTrack(); else session->PreviousTrack();
+    }
+  }
+}
+void CoveMiniMediaView::StopPlayback() {
+  if (auto* session = SelectedSession()) session->Stop(Suspend::kUI);
+  Refresh();
+}
+void CoveMiniMediaView::ReturnToTab() {
+  if (!SelectedSession()) return;
+  if (auto* bridge = CoveSpaceCloseHandler::Get(browser_->GetUnownedUserDataHost()))
+    bridge->ActivateMediaTab(*selected_);
+  else if (auto* tab = selected_->Get()) {
+    const int index = browser_->GetTabStripModel()->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) browser_->GetTabStripModel()->ActivateTabAt(index);
+  }
+}
+BEGIN_METADATA(CoveMiniMediaView)
+END_METADATA
