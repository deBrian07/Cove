+IN_PROC_BROWSER_TEST_F(CoveMiniPlayerBrowserTest,
+                       SidebarAudioControlsOperateAcrossSpacesWithoutReload) {
+  ASSERT_TRUE(Spaces());
+  const auto home = Spaces()->GetActiveSpaceId();
+  const auto other = OtherSpaceId();
+  ASSERT_FALSE(other.empty());
+  const GURL url = chrome_test_utils::GetTestUrl(
+      base::FilePath(base::FilePath::kCurrentDirectory),
+      base::FilePath(FILE_PATH_LITERAL("media/picture-in-picture/autopip-no-register.html")));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(contents, R"(
+    window.audio = new Audio('../bigbuck.webm'); audio.loop = true;
+    window.keepDraft = 'unsent'; window.nextCount = 0;
+    navigator.mediaSession.metadata = new MediaMetadata({title: 'Cove audio test'});
+    navigator.mediaSession.setActionHandler('nexttrack', () => ++nextCount);
+    audio.play();
+  )"));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    auto* session = content::MediaSession::GetIfExists(contents);
+    const auto info = session ? session->GetMediaSessionInfoSync() : nullptr;
+    return info && info->is_controllable &&
+           content::EvalJs(contents, "!audio.paused && audio.currentTime > 0").ExtractBool();
+  }));
+  const int entries = contents->GetController().GetEntryCount();
+  CoveMiniMediaView controls(browser());
+  controls.Refresh();
+  EXPECT_FALSE(controls.has_media());  // Current page already exposes its controls.
+  chrome::AddTabAt(browser(), GURL("about:blank"), -1, true);
+  controls.Refresh();
+  ASSERT_TRUE(controls.has_media());
+  const auto handle = controls.selected_for_testing();
+  controls.TogglePlayback();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return content::EvalJs(contents, "audio.paused").ExtractBool();
+  }));
+  controls.TogglePlayback();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return content::EvalJs(contents, "!audio.paused").ExtractBool();
+  }));
+  controls.SkipTrack(true);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return content::EvalJs(contents, "nextCount").ExtractInt() == 1;
+  }));
+  Spaces()->FocusSpace(other);
+  EXPECT_EQ(TabStripModel::kNoTab, browser()->GetTabStripModel()->GetIndexOfWebContents(contents));
+  controls.Refresh();
+  EXPECT_EQ(handle, controls.selected_for_testing());
+  EXPECT_TRUE(controls.has_media());
+  controls.TogglePlayback();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return content::EvalJs(contents, "audio.paused").ExtractBool();
+  }));
+  controls.Refresh();
+  EXPECT_TRUE(controls.has_media());  // Paused audio remains resumable while parked.
+  controls.ReturnToTab();
+  controls.Refresh();
+  EXPECT_FALSE(controls.has_media());
+  EXPECT_EQ(home, Spaces()->GetActiveSpaceId());
+  EXPECT_EQ(contents, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(entries, contents->GetController().GetEntryCount());
+  EXPECT_EQ("unsent", content::EvalJs(contents, "keepDraft"));
+  controls.StopPlayback();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    controls.Refresh();
+    auto* session = content::MediaSession::GetIfExists(contents);
+    const auto info = session ? session->GetMediaSessionInfoSync() : nullptr;
+    return (!info || !info->is_controllable) &&
+           content::EvalJs(contents, "audio.paused").ExtractBool();
+  }));
+}
