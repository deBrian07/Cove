+void CoveSidebarLibraryView::ShowLibraryMenu() {
+  auto* footer = space_footer_.view();
+  if (!footer || !footer->GetWidget()) {
+    return;
+  }
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(kPinCurrentPageCommand, u"Pin this page");
+  menu_model_->AddItem(kNewFolderCommand, u"New folder");
+  menu_model_->AddItem(kNewSpaceCommand, u"New Space");
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(
+      footer->GetWidget(), nullptr, footer->GetBoundsInScreen(),
+      views::MenuAnchorPosition::kTopLeft, ui::mojom::MenuSourceType::kNone);
 }
 
