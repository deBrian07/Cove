+
+// Pages parked in a Space unused for two hours give back their renderer
+// memory, keep their history and reload when the Space is shown again.
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       LongParkedSpacePagesAreDiscardedAndReloadOnReturn) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Parked</title>")));
+  auto* parked = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Parked two</title>")));
+  const int entries = parked->GetController().GetEntryCount();
+  SwitchSpaceForIconTest("work");
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(TabStripModel::kNoTab,
+            browser()->GetTabStripModel()->GetIndexOfWebContents(parked));
+  EXPECT_EQ(0u, DiscardParked(base::TimeTicks::Now()));
+  EXPECT_FALSE(parked->WasDiscarded());
+
+  browser()->GetProfile()->GetPrefs()->SetBoolean("cove.discard_parked_spaces",
+                                                  false);
+  EXPECT_EQ(0u, DiscardParked(base::TimeTicks::Now() + base::Hours(3)));
+  browser()->GetProfile()->GetPrefs()->SetBoolean("cove.discard_parked_spaces",
+                                                  true);
+  EXPECT_EQ(1u, DiscardParked(base::TimeTicks::Now() + base::Hours(3)));
+  ASSERT_TRUE(base::test::RunUntil([&] { return parked->WasDiscarded(); }));
+
+  SwitchSpaceForIconTest("personal");
+  ASSERT_EQ(parked, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_TRUE(content::WaitForLoadStop(parked));
+  EXPECT_EQ(u"Parked two", parked->GetTitle());
+  EXPECT_EQ(entries, parked->GetController().GetEntryCount());
+}
