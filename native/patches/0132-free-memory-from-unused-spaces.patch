+size_t CoveSidebarLibraryView::DiscardLongParkedPages(base::TimeTicks now) {
+  if (!browser_ || browser_->GetProfile()->IsOffTheRecord() ||
+      switching_space_ || restoring_session_ || closing_active_space_ ||
+      !base::FeatureList::IsEnabled(features::kWebContentsDiscard)) {
+    return 0;
+  }
+  const PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  if (!prefs->FindPreference("cove.discard_parked_spaces") ||
+      !prefs->GetBoolean("cove.discard_parked_spaces")) {
+    return 0;
+  }
+  size_t discarded = 0;
+  for (const auto& [id, space] : inactive_spaces_) {
+    if (!space || now - space->parked_at < base::Hours(2)) {
+      continue;
+    }
+    for (const tabs::TabHandle& handle : GetMediaTabs()) {
+      if (!std::ranges::contains(space->handles, handle)) {
+        continue;
+      }
+      tabs::TabInterface* tab = handle.Get();
+      content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+      // Keep anything still doing work for the person, and pages that would
+      // ask before leaving (unsaved input).
+      if (!contents || contents->WasDiscarded() ||
+          contents->IsCurrentlyAudible() ||
+          contents->HasPictureInPictureVideo() ||
+          contents->IsBeingCaptured() ||
+          contents->NeedToFireBeforeUnloadOrUnloadEvents() ||
+          IsCoveEmptyCanvas(contents)) {
+        continue;
+      }
+      // Showing the page again reloads it from its kept history.
+      contents->GetController().SetNeedsReload();
+      contents->Discard(base::DoNothing());
+      ++discarded;
+    }
+  }
+  return discarded;
+}
