+bool CoveSidebarLibraryView::CanMovePinToFolder(std::string_view destination) const {
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+                                   ->GetDict(kCoveSidebarPref), active_space_id_);
+  if (!space || (!destination.empty() &&
+      !cove::FolderTree(space->FindList("folders")).CanAddChild(destination))) return false;
+  const auto* pins = space->FindList("pins");
+  if (!pins) return false;
+  for (const auto& value : *pins) {
+    const auto* pin = value.GetIfDict();
+    const auto* id = pin ? pin->FindString("id") : nullptr;
+    if (id && *id == context_pin_id_) {
+      const auto* folder = pin->FindString("folder");
+      return (folder ? *folder : "") != destination;
+    }
+  }
+  return false;
+}
+
+void CoveSidebarLibraryView::AppendFolderDestinations(bool moving_folder) {
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+                                   ->GetDict(kCoveSidebarPref), active_space_id_);
+  if (!space) return;
+  const cove::FolderTree tree(space->FindList("folders"));
+  std::map<std::string, std::u16string> paths;
+  for (const auto& row : tree.Rows(true)) {
+    auto path = row.name.empty() ? std::u16string(u"Folder") : row.name;
+    if (!row.parent.empty()) path = paths[row.parent] + u" / " + path;
+    paths[row.id] = path;
+    if (moving_folder) {
+      if (!tree.CanMove(context_folder_id_, row.id)) continue;
+      const int command = kMoveFolderCommandBase + static_cast<int>(menu_folder_moves_.size());
+      menu_folder_moves_[command] = row.id;
+      menu_model_->AddItem(command, u"Move to " + path);
+    } else {
+      menu_folder_ids_.push_back(row.id);
+      menu_model_->AddItem(kMovePinCommandBase +
+          static_cast<int>(menu_folder_ids_.size()) - 1, u"Move to " + path);
+    }
+  }
 }
 
