+++ b/chrome/browser/ui/views/cove/cove_folder_model.cc
@@ -0,0 +1,240 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/cove/cove_folder_model.h"
+
+#include <algorithm>
+#include <limits>
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+
+namespace cove {
+namespace {
+constexpr size_t kNone = std::numeric_limits<size_t>::max();
+}  // namespace
+
+FolderTree::FolderTree(const base::ListValue* folders) {
+  if (!folders) {
+    return;
+  }
+  for (size_t i = 0; i < folders->size(); ++i) {
+    const base::DictValue* dict = (*folders)[i].GetIfDict();
+    const std::string* id = dict ? dict->FindString("id") : nullptr;
+    if (!id || id->empty()) {
+      continue;
+    }
+    auto [entry, inserted] = indices_.emplace(*id, nodes_.size());
+    if (!inserted) {
+      nodes_[entry->second].duplicate = true;
+      continue;
+    }
+    Node node;
+    node.item.id = *id;
+    if (const std::string* name = dict->FindString("name")) {
+      node.item.name = base::UTF8ToUTF16(*name);
+    }
+    if (const std::string* parent = dict->FindString("parent")) {
+      node.item.parent = *parent;
+    }
+    node.item.collapsed = dict->FindBool("collapsed").value_or(false);
+    node.list_index = i;
+    nodes_.push_back(std::move(node));
+  }
+  // Walk each edge once. Positions identify cycles without recursion, including
+  // trees deep enough to overflow a UI thread's stack.
+  std::vector<size_t> parents(nodes_.size(), kNone);
+  for (size_t i = 0; i < nodes_.size(); ++i) {
+    auto parent = indices_.find(nodes_[i].item.parent);
+    if (parent == indices_.end()) {
+      nodes_[i].item.parent.clear();
+    } else {
+      parents[i] = parent->second;
+    }
+  }
+  std::vector<bool> finished(nodes_.size(), false);
+  std::vector<size_t> positions(nodes_.size(), kNone);
+  for (size_t i = 0; i < nodes_.size(); ++i) {
+    if (finished[i]) {
+      continue;
+    }
+    std::vector<size_t> path;
+    size_t current = i;
+    while (current != kNone && !finished[current] &&
+           positions[current] == kNone) {
+      positions[current] = path.size();
+      path.push_back(current);
+      current = parents[current];
+    }
+    bool cyclic = current != kNone &&
+                  (!finished[current] || nodes_[current].cyclic_ancestry);
+    if (current != kNone && !finished[current]) {
+      for (size_t j = positions[current]; j < path.size(); ++j) {
+        nodes_[path[j]].item.parent.clear();
+      }
+    }
+    for (size_t index : path) {
+      nodes_[index].cyclic_ancestry = cyclic;
+      finished[index] = true;
+      positions[index] = kNone;
+    }
+  }
+}
+
+FolderTree::~FolderTree() = default;
+
+bool FolderTree::Contains(std::string_view id) const {
+  return indices_.contains(id);
+}
+
+bool FolderTree::CanAddChild(std::string_view id) const {
+  const auto entry = indices_.find(id);
+  return entry != indices_.end() && !nodes_[entry->second].duplicate &&
+         !nodes_[entry->second].cyclic_ancestry;
+}
+
+bool FolderTree::CanRemove(std::string_view id) const {
+  const auto entry = indices_.find(id);
+  return entry != indices_.end() && !nodes_[entry->second].duplicate;
+}
+
+std::string FolderTree::Parent(std::string_view id) const {
+  auto entry = indices_.find(id);
+  return entry == indices_.end() ? std::string()
+                                 : nodes_[entry->second].item.parent;
+}
+
+std::vector<FolderItem> FolderTree::Rows(bool include_collapsed) const {
+  std::vector<std::vector<size_t>> children(nodes_.size() + 1);
+  for (size_t i = 0; i < nodes_.size(); ++i) {
+    auto parent = indices_.find(nodes_[i].item.parent);
+    children[parent == indices_.end() ? nodes_.size() : parent->second]
+        .push_back(i);
+  }
+  std::vector<std::pair<size_t, size_t>> pending;
+  for (auto it = children.back().rbegin(); it != children.back().rend(); ++it) {
+    pending.emplace_back(*it, 0);
+  }
+  std::vector<FolderItem> rows;
+  while (!pending.empty()) {
+    auto [index, depth] = pending.back();
+    pending.pop_back();
+    FolderItem row = nodes_[index].item;
+    row.depth = depth;
+    rows.push_back(std::move(row));
+    if (!include_collapsed && nodes_[index].item.collapsed) {
+      continue;
+    }
+    for (auto it = children[index].rbegin(); it != children[index].rend(); ++it) {
+      pending.emplace_back(*it, depth + 1);
+    }
+  }
+  return rows;
+}
+
+bool FolderTree::CanMove(std::string_view id, std::string_view parent) const {
+  auto source = indices_.find(id);
+  if (source == indices_.end() || nodes_[source->second].duplicate ||
+      nodes_[source->second].cyclic_ancestry || id == parent ||
+      Parent(id) == parent) {
+    return false;
+  }
+  if (!parent.empty() && !Contains(parent)) {
+    return false;
+  }
+  while (!parent.empty()) {
+    const Node& node = nodes_[indices_.find(parent)->second];
+    if (node.duplicate || node.cyclic_ancestry || node.item.id == id) {
+      return false;
+    }
+    parent = node.item.parent;
+  }
+  return true;
+}
+
+size_t FolderTree::Sibling(std::string_view id, bool down) const {
+  auto source = indices_.find(id);
+  if (source == indices_.end() || nodes_[source->second].duplicate ||
+      nodes_[source->second].cyclic_ancestry) {
+    return kNone;
+  }
+  const Node& node = nodes_[source->second];
+  size_t previous = kNone;
+  for (size_t i = 0; i < nodes_.size(); ++i) {
+    if (nodes_[i].item.parent != node.item.parent) {
+      continue;
+    }
+    if (i == source->second && !down) {
+      return previous;
+    }
+    if (i > source->second && down) {
+      return nodes_[i].duplicate || nodes_[i].cyclic_ancestry ? kNone : i;
+    }
+    previous = nodes_[i].duplicate || nodes_[i].cyclic_ancestry ? kNone : i;
+  }
+  return kNone;
+}
+
+bool FolderTree::CanReorder(std::string_view id, bool down) const {
+  return Sibling(id, down) != kNone;
+}
+
+bool FolderTree::Move(base::DictValue& space,
+                      std::string_view id,
+                      std::string_view parent) {
+  base::ListValue* folders = space.FindList("folders");
+  FolderTree tree(folders);
+  if (!tree.CanMove(id, parent)) {
+    return false;
+  }
+  (*folders)[tree.nodes_[tree.indices_.find(id)->second].list_index]
+      .GetDict()
+      .Set("parent", std::string(parent));
+  return true;
+}
+
+bool FolderTree::Reorder(base::DictValue& space, std::string_view id, bool down) {
+  base::ListValue* folders = space.FindList("folders");
+  FolderTree tree(folders);
+  size_t sibling = tree.Sibling(id, down);
+  if (sibling == kNone) {
+    return false;
+  }
+  size_t source = tree.nodes_[tree.indices_.find(id)->second].list_index;
+  std::swap((*folders)[source], (*folders)[tree.nodes_[sibling].list_index]);
+  return true;
+}
+
+bool FolderTree::Remove(base::DictValue& space, std::string_view id) {
+  base::ListValue* folders = space.FindList("folders");
+  FolderTree tree(folders);
+  auto source = tree.indices_.find(id);
+  if (!tree.CanRemove(id)) {
+    return false;
+  }
+  // Copy before mutating: callers may pass a string_view into the prefs.
+  const std::string removed_id(id);
+  const std::string parent = tree.Parent(id);
+  const size_t index = tree.nodes_[source->second].list_index;
+  for (base::Value& value : *folders) {
+    base::DictValue* folder = value.GetIfDict();
+    const std::string* old_parent = folder ? folder->FindString("parent") : nullptr;
+    if (old_parent && *old_parent == removed_id) {
+      folder->Set("parent", parent);
+    }
+  }
+  if (base::ListValue* pins = space.FindList("pins")) {
+    for (base::Value& value : *pins) {
+      base::DictValue* pin = value.GetIfDict();
+      const std::string* folder = pin ? pin->FindString("folder") : nullptr;
+      if (folder && *folder == removed_id) {
+        pin->Set("folder", parent);
+      }
+    }
+  }
+  folders->erase(folders->begin() + index);
+  return true;
+}
+
+}  // namespace cove
