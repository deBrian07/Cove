+void ExpandFolderPath(base::DictValue& space, std::string id) {
+  const cove::FolderTree tree(space.FindList("folders"));
+  auto* folders = space.FindList("folders");
+  if (!folders) return;
+  while (!id.empty() && tree.Contains(id)) {
+    for (auto& value : *folders) {
+      auto* folder = value.GetIfDict();
+      const auto* current = folder ? folder->FindString("id") : nullptr;
+      if (current && *current == id) folder->Set("collapsed", false);
+    }
+    id = tree.Parent(id);
+  }
+}
 
