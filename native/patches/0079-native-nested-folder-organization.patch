+++ b/chrome/browser/ui/views/cove/cove_folder_model_unittest.cc
@@ -0,0 +1,187 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/cove/cove_folder_model.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace cove {
+namespace {
+
+base::DictValue Space(std::string_view json) {
+  return base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC).value();
+}
+
+std::vector<std::string> Ids(const FolderTree& tree, bool all = false) {
+  std::vector<std::string> ids;
+  for (const FolderItem& row : tree.Rows(all)) {
+    ids.push_back(row.id);
+  }
+  return ids;
+}
+
+TEST(CoveFolderModelTest, CompoundEditsPreservePagesAndRoundTrip) {
+  base::DictValue space = Space(R"({
+    "folders":[{"id":"a","name":"A"},{"id":"b","name":"B"},
+               {"id":"c","name":"C"},{"id":"d","name":"D"}],
+    "pins":[{"id":"pin","folder":"b","url":"https://example.test/",
+             "pages":[{"url":"https://example.test/kept"}]}],
+    "pages":[{"id":"live","history":["one","two"],"draft":"kept"}]
+  })");
+  const base::Value pages = space.Find("pages")->Clone();
+  const base::Value pin_pages =
+      space.FindList("pins")->front().GetDict().Find("pages")->Clone();
+  EXPECT_TRUE(FolderTree::Move(space, "b", "a"));
+  EXPECT_TRUE(FolderTree::Move(space, "c", "b"));
+  EXPECT_TRUE(FolderTree::Move(space, "d", "a"));
+  EXPECT_FALSE(FolderTree::Move(space, "a", "c"));
+  EXPECT_FALSE(FolderTree::Move(space, "b", "b"));
+  EXPECT_FALSE(FolderTree::Move(space, "b", "a"));
+  EXPECT_FALSE(FolderTree::Move(space, "b", "missing"));
+  EXPECT_FALSE(FolderTree::Move(space, "missing", ""));
+  EXPECT_TRUE(FolderTree::Reorder(space, "d", false));
+  EXPECT_EQ((std::vector<std::string>{"a", "d", "b", "c"}),
+            Ids(FolderTree(space.FindList("folders"))));
+  EXPECT_FALSE(FolderTree::Reorder(space, "d", false));
+  EXPECT_TRUE(FolderTree::Reorder(space, "d", true));
+  EXPECT_TRUE(FolderTree::Remove(space, "b"));
+  FolderTree tree(space.FindList("folders"));
+  EXPECT_FALSE(tree.Contains("b"));
+  EXPECT_EQ("a", tree.Parent("c"));
+  EXPECT_EQ("a", *space.FindList("pins")->front().GetDict().FindString("folder"));
+  EXPECT_EQ(pages, *space.Find("pages"));
+  EXPECT_EQ(pin_pages,
+            *space.FindList("pins")->front().GetDict().Find("pages"));
+  EXPECT_TRUE(FolderTree::Move(space, "c", ""));
+  EXPECT_FALSE(FolderTree::Remove(space, "missing"));
+
+  std::optional<std::string> serialized = base::WriteJson(space);
+  ASSERT_TRUE(serialized);
+  base::DictValue reloaded = Space(*serialized);
+  EXPECT_EQ(space, reloaded);
+  EXPECT_EQ(Ids(FolderTree(space.FindList("folders"))),
+            Ids(FolderTree(reloaded.FindList("folders"))));
+}
+
+TEST(CoveFolderModelTest, CollapseOnlyHidesDescendantsAndPreservesSiblingOrder) {
+  base::DictValue space = Space(R"({"folders":[
+    {"id":"child","name":"Child","parent":"root"},
+    {"id":"root","name":"Root","collapsed":true},
+    {"id":"grandchild","parent":"child"},
+    {"id":"second","parent":"root"},{"id":"other"}]})");
+  const base::DictValue before = space.Clone();
+  FolderTree tree(space.FindList("folders"));
+  EXPECT_EQ((std::vector<std::string>{"root", "other"}), Ids(tree));
+  EXPECT_EQ((std::vector<std::string>{"root", "child", "grandchild",
+                                    "second", "other"}),
+            Ids(tree, true));
+  const std::vector<FolderItem> rows = tree.Rows(true);
+  ASSERT_EQ(5u, rows.size());
+  EXPECT_EQ(0u, rows[0].depth);
+  EXPECT_EQ(1u, rows[1].depth);
+  EXPECT_EQ(2u, rows[2].depth);
+  EXPECT_EQ(1u, rows[3].depth);
+  EXPECT_EQ(u"Child", rows[1].name);
+  EXPECT_EQ(before, space);
+}
+
+TEST(CoveFolderModelTest, CyclesAndOrphansRemainVisibleWithoutMutatingPrefs) {
+  base::DictValue space = Space(R"({"folders":[
+    {"id":"tail","parent":"a"},{"id":"a","parent":"b"},
+    {"id":"b","parent":"a"},{"id":"self","parent":"self"},
+    {"id":"orphan","parent":"missing"},{"id":"normal"}],
+    "pins":[{"id":"orphan-pin","folder":"missing"},
+            {"id":"owned","folder":"orphan"}]})");
+  const base::DictValue before = space.Clone();
+  FolderTree tree(space.FindList("folders"));
+  EXPECT_EQ((std::vector<std::string>{"a", "tail", "b", "self", "orphan",
+                                    "normal"}),
+            Ids(tree));
+  EXPECT_EQ("", tree.Parent("a"));
+  EXPECT_EQ("", tree.Parent("b"));
+  EXPECT_EQ("", tree.Parent("orphan"));
+  EXPECT_EQ("a", tree.Parent("tail"));
+  EXPECT_FALSE(tree.CanAddChild("a"));
+  EXPECT_FALSE(tree.CanAddChild("tail"));
+  EXPECT_TRUE(tree.CanRemove("a"));
+  EXPECT_FALSE(tree.CanMove("normal", "tail"));
+  EXPECT_FALSE(tree.CanMove("tail", "normal"));
+  EXPECT_FALSE(FolderTree::Move(space, "a", "normal"));
+  EXPECT_FALSE(FolderTree::Reorder(space, "b", true));
+  EXPECT_EQ(before, space);
+  EXPECT_TRUE(FolderTree::Remove(space, "orphan"));
+  EXPECT_EQ("missing",
+            *space.FindList("pins")->front().GetDict().FindString("folder"));
+  EXPECT_EQ("", *(*space.FindList("pins"))[1].GetDict().FindString("folder"));
+  EXPECT_TRUE(FolderTree::Remove(space, "a"));
+  EXPECT_EQ("", FolderTree(space.FindList("folders")).Parent("tail"));
+  EXPECT_EQ("", FolderTree(space.FindList("folders")).Parent("b"));
+}
+
+TEST(CoveFolderModelTest, MalformedAndDuplicateEntriesArePreserved) {
+  base::DictValue space = Space(R"({"folders":[
+    null,4,{"name":"No ID"},{"id":""},{"id":false},
+    {"id":"a","name":"First","parent":5},
+    {"id":"a","name":"Duplicate","extra":"kept"},
+    {"id":"b","name":7,"collapsed":"wrong"},
+    {"id":"c","parent":"b"}],
+    "pins":[false,{"folder":5},{"folder":"b","extra":"kept"}]})");
+  const base::DictValue before = space.Clone();
+  FolderTree tree(space.FindList("folders"));
+  EXPECT_EQ((std::vector<std::string>{"a", "b", "c"}), Ids(tree));
+  ASSERT_EQ(3u, tree.Rows().size());
+  EXPECT_EQ(u"First", tree.Rows()[0].name);
+  EXPECT_TRUE(tree.Rows()[1].name.empty());
+  EXPECT_FALSE(FolderTree::Move(space, "a", "b"));
+  EXPECT_FALSE(FolderTree::Reorder(space, "a", true));
+  EXPECT_FALSE(FolderTree::Remove(space, "a"));
+  EXPECT_EQ(before, space);
+  EXPECT_TRUE(FolderTree::Remove(space, "b"));
+  ASSERT_EQ(8u, space.FindList("folders")->size());
+  EXPECT_EQ((*before.FindList("folders"))[6],
+            (*space.FindList("folders"))[6]);
+  EXPECT_EQ("", FolderTree(space.FindList("folders")).Parent("c"));
+  EXPECT_EQ("kept", *(*space.FindList("pins"))[2].GetDict().FindString("extra"));
+}
+
+TEST(CoveFolderModelTest, EmptyOrMalformedListsAreNoOps) {
+  FolderTree empty(nullptr);
+  EXPECT_TRUE(empty.Rows().empty());
+  EXPECT_FALSE(empty.Contains(""));
+  EXPECT_FALSE(empty.CanReorder("missing", true));
+  base::DictValue space = Space(R"({"folders":false,"pins":[{"folder":"a"}]})");
+  const base::DictValue before = space.Clone();
+  EXPECT_FALSE(FolderTree::Move(space, "a", ""));
+  EXPECT_FALSE(FolderTree::Reorder(space, "a", true));
+  EXPECT_FALSE(FolderTree::Remove(space, "a"));
+  EXPECT_EQ(before, space);
+}
+
+TEST(CoveFolderModelTest, DeepTreeUsesIterativeTraversal) {
+  base::ListValue folders;
+  constexpr size_t kDepth = 10000;
+  for (size_t i = 0; i < kDepth; ++i) {
+    base::DictValue folder;
+    folder.Set("id", std::to_string(i));
+    if (i > 0) {
+      folder.Set("parent", std::to_string(i - 1));
+    }
+    folders.Append(std::move(folder));
+  }
+  FolderTree tree(&folders);
+  const std::vector<FolderItem> rows = tree.Rows();
+  ASSERT_EQ(kDepth, rows.size());
+  EXPECT_EQ(kDepth - 1, rows.back().depth);
+  EXPECT_FALSE(tree.CanMove("0", std::to_string(kDepth - 1)));
+}
+
+}  // namespace
+}  // namespace cove
