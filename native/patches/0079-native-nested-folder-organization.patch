+  std::string id;
+  std::u16string name;
+  std::string parent;
+  bool collapsed = false;
+  size_t depth = 0;
+};
+
+// A snapshot of saved folder topology. Reads never repair or mutate prefs.
+// The first nonempty occurrence of an ID wins; malformed names become empty.
+// Missing parents and cycle edges are presented as roots. Mutations refuse
+// ambiguous IDs and moves involving cyclic ancestry.
+class FolderTree {
+ public:
+  explicit FolderTree(const base::ListValue* folders);
+  ~FolderTree();
+  bool Contains(std::string_view id) const;
+  bool CanAddChild(std::string_view id) const;
+  bool CanRemove(std::string_view id) const;
+  std::string Parent(std::string_view id) const;
+  std::vector<FolderItem> Rows(bool include_collapsed = false) const;
+  bool CanMove(std::string_view id, std::string_view parent) const;
+  bool CanReorder(std::string_view id, bool down) const;
+
+  static bool Move(base::DictValue& space,
+                   std::string_view id,
+                   std::string_view parent);
+  static bool Reorder(base::DictValue& space, std::string_view id, bool down);
+  static bool Remove(base::DictValue& space, std::string_view id);
+
+ private:
+  struct Node {
+    FolderItem item;
+    size_t list_index = 0;
+    bool duplicate = false;
+    bool cyclic_ancestry = false;
+  };
+
+  size_t Sibling(std::string_view id, bool down) const;
+
+  std::vector<Node> nodes_;
+  std::map<std::string, size_t, std::less<>> indices_;
+};
+
+}  // namespace cove
+
+#endif  // CHROME_BROWSER_UI_VIEWS_COVE_COVE_FOLDER_MODEL_H_
