+void CoveSidebarLibraryView::BeginRename(int kind, std::string id) {
+  const auto& root =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+  const base::ListValue* items = root.FindList("spaces");
+  if (kind != kRenameSpaceCommand) {
+    const auto* space = FindSpace(root, active_space_id_);
+    items =
+        space ? space->FindList(kind == kRenamePinCommand ? "pins" : "folders")
+              : nullptr;
+  }
+  if (!items) {
+    return;
+  }
+  for (const auto& value : *items) {
+    const auto* item = value.GetIfDict();
+    if (!item || !item->FindString("id") || *item->FindString("id") != id) {
+      continue;
+    }
+    const auto* current =
+        item->FindString(kind == kRenamePinCommand ? "title" : "name");
+    ShowCoveNameDialog(this,
+                       kind == kRenameSpaceCommand    ? u"Rename Space"
+                       : kind == kRenameFolderCommand ? u"Rename Folder"
+                                                      : u"Rename Pin",
+                       current ? base::UTF8ToUTF16(*current) : std::u16string(),
+                       base::BindOnce(&CoveSidebarLibraryView::RenameItem,
+                                      weak_factory_.GetWeakPtr(), kind,
+                                      active_space_id_, std::move(id)));
+    return;
+  }
+}
+
+void CoveSidebarLibraryView::RenameItem(int kind,
+                                        std::string space_id,
+                                        std::string id,
+                                        std::u16string name) {
+  std::u16string trimmed;
+  base::TrimWhitespace(name, base::TRIM_ALL, &trimmed);
+  if (trimmed.empty()) {
+    return;
+  }
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              kCoveSidebarPref);
+  base::ListValue* items = update->FindList("spaces");
+  if (kind != kRenameSpaceCommand) {
+    auto* space = FindSpace(*update, space_id);
+    items =
+        space ? space->FindList(kind == kRenamePinCommand ? "pins" : "folders")
+              : nullptr;
+  }
+  if (!items) {
+    return;
+  }
+  for (auto& value : *items) {
+    auto* item = value.GetIfDict();
+    if (item && item->FindString("id") && *item->FindString("id") == id) {
+      item->Set(kind == kRenamePinCommand ? "title" : "name",
+                base::UTF16ToUTF8(trimmed));
+      return;
+    }
+  }
+}
+
+void CoveSidebarLibraryView::RemoveFolder(std::string id) {
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              kCoveSidebarPref);
+  auto* space = FindSpace(*update, active_space_id_);
+  auto* folders = space ? space->FindList("folders") : nullptr;
+  if (!folders) {
+    return;
+  }
+  if (auto* pins = space->FindList("pins")) {
+    for (auto& value : *pins) {
+      auto* pin = value.GetIfDict();
+      if (pin && pin->FindString("folder") &&
+          *pin->FindString("folder") == id) {
+        pin->Set("folder", "");
+      }
+    }
+  }
+  folders->EraseIf([&id](const base::Value& value) {
+    const auto* folder = value.GetIfDict();
+    return folder && folder->FindString("id") &&
+           *folder->FindString("id") == id;
+  });
+}
+
+void CoveSidebarLibraryView::RunContextMenu(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(source->GetWidget(), nullptr,
+                          gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
