+void CoveSidebarLibraryView::ArchiveToday() {
+  TabStripModel* model = browser_->GetTabStripModel();
+  const std::vector<tabs::TabHandle> handles = GetArchivableTabHandles(model);
+  if (handles.empty()) {
+    return;
+  }
+
+  // Insert a native blank tab before closing the final page so the browser
+  // window remains open. Normal close handling still runs for every archived
+  // tab, including beforeunload and recently-closed history.
+  if (handles.size() == static_cast<size_t>(model->count())) {
+    NavigateParams params(browser_, GURL("about:blank"),
+                          ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+  }
+
+  for (const tabs::TabHandle& handle : handles) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab || tab->IsPinned() || !model->IsTabClosable(tab)) {
+      continue;
+    }
+    const int index = model->GetIndexOfTab(tab);
+    if (index == TabStripModel::kNoTab) {
+      continue;
+    }
+    model->CloseWebContentsAt(index,
+                              TabCloseTypes::CLOSE_USER_GESTURE |
+                                  TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
