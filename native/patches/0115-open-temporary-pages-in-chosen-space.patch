+std::vector<CoveSpaceInfo> ProfileSpaces(Profile* profile) {
+  std::vector<CoveSpaceInfo> spaces;
+  if (!profile || profile->IsOffTheRecord()) return spaces;
+  const auto* saved = profile->GetPrefs()->GetDict("cove.sidebar").FindList("spaces");
+  // A profile first opened by an external link has no normal-window library
+  // yet. Offer its normal default without writing preferences or making a
+  // hidden window; creation on activation initializes that Space normally.
+  if (!saved) {
+    if (!ProfileBrowserCollection::GetForProfile(profile)->FindTabbedBrowser(false))
+      return {{"personal", u"Personal"}};
+    return spaces;
+  }
+  std::set<std::string> seen;
+  std::set<std::string> duplicates;
+  for (const auto& value : *saved) {
+    const auto* record = value.GetIfDict();
+    const auto* id = record ? record->FindString("id") : nullptr;
+    const auto* name = record ? record->FindString("name") : nullptr;
+    if (!id || id->empty()) continue;
+    if (!seen.insert(*id).second) duplicates.insert(*id);
+    spaces.push_back({*id, name ? base::UTF8ToUTF16(*name) : u"Untitled Space"});
+  }
+  std::erase_if(spaces, [&](const auto& space) { return duplicates.contains(space.id); });
+  return spaces;
+}
