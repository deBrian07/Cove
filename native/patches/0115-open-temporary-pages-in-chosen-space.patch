+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       ChosenInactiveSpaceKeepsTheExactPageAndSourceSpace) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* bridge = CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  ASSERT_TRUE(bridge);
+  const auto original_space = bridge->GetActiveSpaceId();
+  std::string chosen;
+  for (const auto& space : bridge->GetSpaces())
+    if (space.id != original_space) { chosen = space.id; break; }
+  ASSERT_FALSE(chosen.empty());
+  auto* original_page = browser()->GetTabStripModel()->GetActiveWebContents();
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(),
+      embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(popup,
+      embedded_test_server()->GetURL("/title2.html")));
+  ASSERT_TRUE(content::ExecJs(page, "window.destinationDraft = 'same page'"));
+  const int history = page->GetController().GetEntryCount();
+  ASSERT_TRUE(MoveCoveTemporaryWindowToSpace(popup->GetWeakPtr(),
+      browser()->GetWeakPtr(), chosen));
+  EXPECT_EQ(chosen, bridge->GetActiveSpaceId());
+  EXPECT_EQ(page, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(history, page->GetController().GetEntryCount());
+  EXPECT_EQ("same page", content::EvalJs(page, "window.destinationDraft"));
+  base::RunLoop().RunUntilIdle();
+  bridge->FocusSpace(original_space);
+  EXPECT_EQ(original_page, browser()->GetTabStripModel()->GetActiveWebContents());
+  bridge->FocusSpace(chosen);
+  EXPECT_EQ(page, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ("same page", content::EvalJs(page, "window.destinationDraft"));
+}
