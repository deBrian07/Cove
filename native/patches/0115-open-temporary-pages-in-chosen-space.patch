+      if (window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+          window->GetProfile() == profile &&
+          window->GetTabStripModel()->GetActiveWebContents() == page)
+        destination = window;
+      return true;
+    });
+    return destination != nullptr;
+  }));
+  auto* bridge = CoveSpaceCloseHandler::Get(destination->GetUnownedUserDataHost());
+  ASSERT_TRUE(bridge);
+  EXPECT_EQ("personal", bridge->GetActiveSpaceId());
+  EXPECT_EQ("untouched", content::EvalJs(page, "window.firstLinkDraft"));
+}
+
+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       NewlyOpenedMainWindowIsReusedWhenNoWindowWasCaptured) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* bridge = CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  ASSERT_TRUE(bridge);
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(),
+      embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  const auto count = GlobalBrowserCollection::GetInstance()->GetSize();
+  // A chooser created with no destination must reuse a main window that
+  // appeared before its posted action runs, rather than making another one.
+  ASSERT_TRUE(MoveCoveTemporaryWindowToSpace(popup->GetWeakPtr(), {},
+      bridge->GetActiveSpaceId(), true));
+  EXPECT_EQ(page, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_LE(GlobalBrowserCollection::GetInstance()->GetSize(), count);
+}
+
+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       DifferentProfileCannotReceiveTemporaryPage) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* bridge = CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  ASSERT_TRUE(bridge);
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(),
+      embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  auto* other = CreateIncognitoBrowser(browser()->GetProfile());
+  ASSERT_TRUE(other);
+  EXPECT_NE(other->GetProfile(), popup->GetProfile());
+  const int original_count = other->GetTabStripModel()->count();
+  EXPECT_FALSE(MoveCoveTemporaryWindowToSpace(popup->GetWeakPtr(),
+      other->GetWeakPtr(), bridge->GetActiveSpaceId()));
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(original_count, other->GetTabStripModel()->count());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       DeletionDuringSpaceSwitchKeepsPopupPage) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* bridge = CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  ASSERT_TRUE(bridge);
+  const auto original_space = bridge->GetActiveSpaceId();
+  std::string chosen;
+  for (const auto& space : bridge->GetSpaces())
+    if (space.id != original_space) { chosen = space.id; break; }
+  ASSERT_FALSE(chosen.empty());
+  auto* original = browser()->GetTabStripModel()->GetActiveWebContents();
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(),
+      embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  ASSERT_TRUE(content::ExecJs(page, "window.interruptedDraft='keep me'"));
+  auto* prefs = browser()->GetProfile()->GetPrefs();
+  bool deleted = false;
+  PrefChangeRegistrar observer;
+  observer.Init(prefs);
+  observer.Add("cove.sidebar", base::BindLambdaForTesting([&] {
+    const auto* active = prefs->GetDict("cove.sidebar").FindString("active");
+    if (deleted || !active || *active != chosen) return;
+    deleted = true;
+    ScopedDictPrefUpdate update(prefs, "cove.sidebar");
+    update->FindList("spaces")->EraseIf([&](const base::Value& value) {
+      const auto* record = value.GetIfDict();
+      const auto* id = record ? record->FindString("id") : nullptr;
+      return id && *id == chosen;
+    });
+  }));
+  EXPECT_FALSE(MoveCoveTemporaryWindowToSpace(popup->GetWeakPtr(),
+      browser()->GetWeakPtr(), chosen));
+  EXPECT_TRUE(deleted);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ("keep me", content::EvalJs(page, "window.interruptedDraft"));
+  EXPECT_NE(TabStripModel::kNoTab,
+      browser()->GetTabStripModel()->GetIndexOfWebContents(original));
+}
