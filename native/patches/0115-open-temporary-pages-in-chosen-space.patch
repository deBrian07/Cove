+namespace {
+void CaptureTemporaryWindowIfRequested(views::Widget* widget) {
+  const auto path = base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+      "cove-temporary-snapshot");
+  if (path.empty()) return;
+  widget->Activate();
+  widget->GetRootView()->SchedulePaint();
+  base::test::TestFuture<gfx::Image> captured;
+  // Snapshot this fixture's native view only. Root compositor copy requests
+  // can stall for layer-backed popup controls on Mac.
+  ui::GrabViewSnapshot(widget->GetNativeView(),
+      widget->GetRootView()->GetLocalBounds(), captured.GetCallback());
+  ASSERT_TRUE(captured.Wait());
+  auto result = captured.Take();
+  ASSERT_FALSE(result.IsEmpty());
+  auto png = gfx::PNGCodec::EncodeBGRASkBitmap(*result.ToSkBitmap(), false);
+  ASSERT_TRUE(png);
+  base::ScopedAllowBlockingForTesting allow_capture;
+  ASSERT_TRUE(base::WriteFile(path, *png));
+}
