+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       DeletedSpaceOrClosedDestinationCannotLoseThePopupPage) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* bridge = CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  ASSERT_TRUE(bridge);
+  const auto current_space = bridge->GetActiveSpaceId();
+  std::string removed;
+  for (const auto& space : bridge->GetSpaces())
+    if (space.id != current_space) { removed = space.id; break; }
+  ASSERT_FALSE(removed.empty());
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(),
+      embedded_test_server()->GetURL("/title1.html"));
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), "cove.sidebar");
+    auto* spaces = update->FindList("spaces");
+    ASSERT_TRUE(spaces);
+    spaces->EraseIf([&](const base::Value& value) {
+      const auto* record = value.GetIfDict();
+      const auto* id = record ? record->FindString("id") : nullptr;
+      return id && *id == removed;
+    });
+  }
+  EXPECT_FALSE(MoveCoveTemporaryWindowToSpace(popup->GetWeakPtr(),
+      browser()->GetWeakPtr(), removed));
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(current_space, bridge->GetActiveSpaceId());
+  auto* other = CreateBrowser(browser()->GetProfile());
+  const auto captured = other->GetWeakPtr();
+  CloseBrowserSynchronously(other);
+  EXPECT_FALSE(captured);
+  EXPECT_FALSE(MoveCoveTemporaryWindowToSpace(popup->GetWeakPtr(),
+      captured, current_space));
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+}
