+bool MoveCoveTemporaryWindowToSpace(
+    base::WeakPtr<BrowserWindowInterface> popup,
+    base::WeakPtr<BrowserWindowInterface> destination,
+    const std::string& space_id, bool create_if_missing) {
+  if (!popup || popup->GetType() != BrowserWindowInterface::TYPE_POPUP ||
+      popup->GetTabStripModel()->count() != 1 ||
+      popup->GetTabStripModel()->closing_all()) return false;
+  Profile* profile = popup->GetProfile();
+  const auto choices = ProfileSpaces(profile);
+  if (std::ranges::none_of(choices, [&](const auto& item) { return item.id == space_id; }))
+    return false;
+  if (!destination) {
+    if (!create_if_missing || GetBrowserWindowCreationStatusForProfile(*profile) !=
+        BrowserWindowInterface::CreationStatus::kOk) return false;
+    // Another main window may have appeared since the chooser was built.
+    // Reuse it when no existing window was originally captured.
+    auto* target = ProfileBrowserCollection::GetForProfile(profile)
+                       ->FindTabbedBrowser(false);
+    if (!target)
+      target = CreateBrowserWindow(BrowserWindowCreateParams(*profile, true));
+    destination = target->GetWeakPtr();
+  }
+  if (destination->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      destination->GetProfile() != profile ||
+      destination->GetTabStripModel()->closing_all()) return false;
+  auto* bridge = CoveSpaceCloseHandler::Get(destination->GetUnownedUserDataHost());
+  if (!bridge || bridge->IsSessionMutationInProgress()) return false;
+  bridge->FocusSpace(space_id);
+  if (!popup || !destination ||
+      popup->GetTabStripModel()->count() != 1 ||
+      popup->GetTabStripModel()->closing_all() ||
+      destination->GetTabStripModel()->closing_all()) return false;
+  bridge = CoveSpaceCloseHandler::Get(destination->GetUnownedUserDataHost());
+  if (!bridge || bridge->IsSessionMutationInProgress() ||
+      bridge->GetActiveSpaceId() != space_id) return false;
+  // Space activation synchronously notifies preference observers. A Space
+  // deleted by one of them must not receive the popup's page.
+  const auto remaining = ProfileSpaces(profile);
+  if (std::ranges::none_of(remaining,
+      [&](const auto& item) { return item.id == space_id; })) return false;
+  // The destination exists and owns the requested Space before releasing the
+  // popup's page. Moving the WebContents retains history, draft and identity.
+  auto contents = popup->GetTabStripModel()->DetachWebContentsAtForInsertion(0);
+  destination->GetTabStripModel()->AppendWebContents(std::move(contents), true);
+  destination->GetWindow()->Show();
+  return true;
+}
 
