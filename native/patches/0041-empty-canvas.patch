+void CoveSidebarLibraryView::ScheduleCleanupForInsertedTabs(
+    std::vector<tabs::TabHandle> handles,
+    int generation) {
+  if (generation != empty_canvas_cleanup_generation_ || switching_space_ ||
+      closing_active_space_) {
+    return;
+  }
+  for (const tabs::TabHandle& handle : handles) {
+    tabs::TabInterface* tab = handle.Get();
+    if (tab && tab->GetContents() &&
+        !IsCoveEmptyCanvas(tab->GetContents())) {
+      ScheduleEmptyCanvasCleanup();
+      return;
+    }
+  }
+}
+
+void CoveSidebarLibraryView::ScheduleEmptyCanvasCleanup() {
+  if (switching_space_ || closing_active_space_) {
+    return;
+  }
+  QueueEmptyCanvasCleanup();
+}
+
+void CoveSidebarLibraryView::QueueEmptyCanvasCleanup() {
+  if (empty_canvas_cleanup_posted_) {
+    return;
+  }
+  empty_canvas_cleanup_posted_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&CoveSidebarLibraryView::CleanupEmptyCanvases,
+                     weak_factory_.GetWeakPtr(),
+                     empty_canvas_cleanup_generation_));
+}
+
+void CoveSidebarLibraryView::InvalidateEmptyCanvasCleanup() {
+  ++empty_canvas_cleanup_generation_;
+  empty_canvas_cleanup_posted_ = false;
+}
+
+void CoveSidebarLibraryView::CleanupEmptyCanvases(int generation) {
+  if (generation != empty_canvas_cleanup_generation_) {
+    return;
+  }
+  empty_canvas_cleanup_posted_ = false;
+  if (switching_space_ || closing_active_space_) {
+    return;
+  }
+
+  TabStripModel* model = browser_->GetTabStripModel();
+  bool has_real_tab = false;
+  std::vector<tabs::TabHandle> canvases;
+  for (int index = 0; index < model->count(); ++index) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(index);
+    if (!tab || !tab->GetContents()) {
+      continue;
+    }
+    if (IsCoveEmptyCanvas(tab->GetContents())) {
+      canvases.push_back(tab->GetHandle());
+    } else {
+      has_real_tab = true;
+    }
+  }
+  if (!has_real_tab) {
+    return;
+  }
+  for (const tabs::TabHandle& handle : canvases) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab || !tab->GetContents() || !IsCoveEmptyCanvas(tab->GetContents()) ||
+        !model->IsTabClosable(tab) || model->count() <= 1) {
+      continue;
+    }
+    const int index = model->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
   }
 }
 
