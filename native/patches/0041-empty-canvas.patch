+namespace {
+
+class CoveEmptyCanvasMarker : public base::SupportsUserData::Data {};
+
+const void* CoveEmptyCanvasUserDataKey() {
+  static int key;
+  return &key;
+}
+
+bool IsBareAboutBlank(content::WebContents* contents) {
+  return contents && contents->GetVisibleURL() == GURL("about:blank") &&
+         contents->GetController().GetEntryCount() <= 1;
+}
+
+}  // namespace
+
 DEFINE_USER_DATA(CoveSpaceCloseHandler);
+
+void MarkCoveEmptyCanvas(content::WebContents* contents) {
+  if (!IsBareAboutBlank(contents)) {
+    return;
+  }
+  contents->SetUserData(CoveEmptyCanvasUserDataKey(),
+                        std::make_unique<CoveEmptyCanvasMarker>());
+}
+
+bool IsCoveEmptyCanvas(content::WebContents* contents) {
+  return IsBareAboutBlank(contents) &&
+         contents->GetUserData(CoveEmptyCanvasUserDataKey());
+}
