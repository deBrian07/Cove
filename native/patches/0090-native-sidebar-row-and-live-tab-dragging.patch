+std::optional<CoveSidebarLibraryView::RowDragData>
+CoveSidebarLibraryView::ReadRowDrag(const ui::OSExchangeData& data) const {
+  auto pickle = data.GetPickledData(SidebarDragFormat());
+  if (!pickle || pickle->size() > 8192) return std::nullopt;
+  base::PickleIterator reader(*pickle);
+  std::string profile;
+  int kind = -1;
+  RowDragData source;
+  if (!reader.ReadString(&profile) || !reader.ReadString(&source.space) ||
+      !reader.ReadInt(&kind) || !reader.ReadString(&source.item.id) ||
+      !reader.ReachedEnd() || (kind != 0 && kind != 1) ||
+      source.space != active_space_id_ ||
+      profile != SidebarProfileIdentity(browser_->GetProfile()) ||
+      !IsValidCoveSessionId(source.item.id)) return std::nullopt;
+  source.item.kind = kind == 0 ? cove::SidebarItemKind::kPin
+                               : cove::SidebarItemKind::kFolder;
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+      ->GetDict(kCoveSidebarPref), active_space_id_);
+  return space && cove::SidebarOrder::Parent(*space, source.item)
+      ? std::make_optional(source) : std::nullopt;
+}
