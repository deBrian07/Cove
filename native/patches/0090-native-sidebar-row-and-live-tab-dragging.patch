+bool CoveSidebarLibraryView::CanDrop(const ui::OSExchangeData& data) {
+  if (!GetVisible() || IsSessionMutationInProgress()) return false;
+  if (data.HasCustomFormat(SidebarDragFormat())) return ReadRowDrag(data).has_value();
+  const auto urls = data.GetURLs(ui::FilenameToURLPolicy::DO_NOT_CONVERT_FILENAMES);
+  return urls.size() == 1 && urls.front().url.SchemeIsHTTPOrHTTPS();
+}
+
+std::optional<CoveSidebarLibraryView::DragLocation>
+CoveSidebarLibraryView::LocateDrop(const gfx::Point& point) const {
+  if (!GetVisibleBounds().Contains(point) || IsSessionMutationInProgress())
+    return std::nullopt;
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+      ->GetDict(kCoveSidebarPref), active_space_id_);
+  if (!space) return std::nullopt;
+  const auto all_rows = cove::SidebarOrder::Rows(*space, true);
+  DragLocation destination;
+  destination.space = active_space_id_;
+  int last_bottom = 0;
+  for (const auto& child : children()) {
+    const auto found = row_items_.find(child.get());
+    if (found == row_items_.end() || !child->GetVisible()) continue;
+    const auto bounds = child->bounds();
+    last_bottom = std::max(last_bottom, bounds.bottom());
+    if (point.y() > bounds.bottom()) continue;
+    const auto parent = cove::SidebarOrder::Parent(*space, found->second);
+    if (!parent) return std::nullopt;
+    const bool in_middle = point.y() >= bounds.y() + bounds.height() / 4 &&
+        point.y() < bounds.bottom() - bounds.height() / 4;
+    if (found->second.kind == cove::SidebarItemKind::kFolder && in_middle) {
+      destination.parent = found->second.id;
+      destination.inside = true;
+      destination.indicator = bounds;
+    } else {
+      destination.parent = *parent;
+      const bool after = point.y() >= bounds.CenterPoint().y();
+      if (!after) destination.before = found->second;
+      else {
+        auto it = std::find_if(all_rows.begin(), all_rows.end(),
+            [&](const auto& row) { return row.item == found->second; });
+        if (it != all_rows.end()) for (++it; it != all_rows.end(); ++it) {
+          if (it->parent == *parent) { destination.before = it->item; break; }
+        }
+      }
+      int line = after ? bounds.bottom() - 1 : bounds.y();
+      if (after && found->second.kind == cove::SidebarItemKind::kFolder) {
+        bool following = false;
+        size_t depth = 0;
+        for (const auto& row : cove::SidebarOrder::Rows(*space)) {
+          if (row.item == found->second) { following = true; depth = row.depth; continue; }
+          if (!following) continue;
+          if (row.depth <= depth) break;
+          for (const auto& [view, item] : row_items_) {
+            if (item == row.item) line = std::max(line, view->bounds().bottom() - 1);
+          }
+        }
+      }
+      destination.indicator = gfx::Rect(
+          8, line, std::max(0, width() - 16), 2);
+    }
+    return IsDropLocationValid(destination) ? std::make_optional(destination)
+                                             : std::nullopt;
+  }
+  destination.indicator = gfx::Rect(8, std::max(0, last_bottom - 1),
+                                     std::max(0, width() - 16), 2);
+  if (row_items_.empty()) {
+    destination.inside = true;
+    destination.indicator = GetLocalBounds();
+    destination.indicator.Inset(2);
+  }
+  return IsDropLocationValid(destination) ? std::make_optional(destination)
+                                         : std::nullopt;
+}
+
+bool CoveSidebarLibraryView::IsDropLocationValid(const DragLocation& destination) const {
+  if (destination.space != active_space_id_ || IsSessionMutationInProgress()) return false;
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+      ->GetDict(kCoveSidebarPref), active_space_id_);
+  if (!space) return false;
+  if (!destination.parent.empty() &&
+      !cove::FolderTree(space->FindList("folders")).CanAddChild(destination.parent))
+    return false;
+  if (destination.before) {
+    const auto parent = cove::SidebarOrder::Parent(*space, *destination.before);
+    if (!parent || *parent != destination.parent) return false;
+  }
+  return true;
+}
+
+void CoveSidebarLibraryView::ShowDropIndicator(const DragLocation& destination) {
+  if (!drop_indicator_) {
+    drop_indicator_ = AddChildView(std::make_unique<views::View>());
+    drop_indicator_->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    drop_indicator_->SetCanProcessEventsWithinSubtree(false);
+    drop_indicator_->SetPaintToLayer();
+    drop_indicator_->layer()->SetFillsBoundsOpaquely(false);
+  }
+  drop_indicator_->SetBoundsRect(destination.indicator);
+  if (destination.inside) {
+    drop_indicator_->SetBackground(nullptr);
+    drop_indicator_->SetBorder(views::CreateRoundedRectBorder(2, 6, ui::kColorSysPrimary));
+  } else {
+    drop_indicator_->SetBorder(nullptr);
+    drop_indicator_->SetBackground(views::CreateSolidBackground(ui::kColorSysPrimary));
+  }
+  drop_indicator_->SetVisible(true);
+}
+
+void CoveSidebarLibraryView::ClearDropIndicator() {
+  if (drop_indicator_) drop_indicator_->SetVisible(false);
+}
+
+int CoveSidebarLibraryView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  auto destination = LocateDrop(event.location());
+  if (!destination || !CanDrop(event.data())) { ClearDropIndicator(); return 0; }
+  const bool moving = event.data().HasCustomFormat(SidebarDragFormat());
+  if (moving) {
+    const auto source = ReadRowDrag(event.data());
+    const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+        ->GetDict(kCoveSidebarPref), active_space_id_);
+    if (!source || !space || !cove::SidebarOrder::CanMove(*space, source->item,
+        destination->parent, destination->before)) { ClearDropIndicator(); return 0; }
+  }
+  const int operation = moving ? ui::DragDropTypes::DRAG_MOVE : ui::DragDropTypes::DRAG_COPY;
+  if (!(event.source_operations() & operation)) { ClearDropIndicator(); return 0; }
+  ShowDropIndicator(*destination);
+  return operation;
+}
+
+void CoveSidebarLibraryView::OnDragExited() { ClearDropIndicator(); }
+
+views::View::DropCallback CoveSidebarLibraryView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  auto destination = LocateDrop(event.location());
+  if (!destination || !OnDragUpdated(event)) return base::NullCallback();
+  ClearDropIndicator();
+  if (event.data().HasCustomFormat(SidebarDragFormat())) {
+    auto source = ReadRowDrag(event.data());
+    if (!source) return base::NullCallback();
+    return base::BindOnce(&CoveSidebarLibraryView::PerformRowDrop,
+        weak_factory_.GetWeakPtr(), *source, *destination);
+  }
+  const auto urls = event.data().GetURLs(ui::FilenameToURLPolicy::DO_NOT_CONVERT_FILENAMES);
+  if (urls.size() != 1) return base::NullCallback();
+  return base::BindOnce(&CoveSidebarLibraryView::PerformUrlDrop,
+      weak_factory_.GetWeakPtr(), urls[0].url, urls[0].title, *destination);
+}
+
+void CoveSidebarLibraryView::PerformRowDrop(
+    RowDragData source, DragLocation destination, const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& operation, std::unique_ptr<ui::LayerTreeOwner> image) {
+  operation = ui::mojom::DragOperation::kNone;
+  if (source.space != active_space_id_ || !IsDropLocationValid(destination) ||
+      !(event.source_operations() & ui::DragDropTypes::DRAG_MOVE)) return;
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(), kCoveSidebarPref);
+  if (auto* space = FindSpace(*update, active_space_id_);
+      space && cove::SidebarOrder::Move(*space, source.item,
+          destination.parent, destination.before)) {
+    ExpandFolderPath(*space, destination.parent);
+    operation = ui::mojom::DragOperation::kMove;
+  }
+}
+
+void CoveSidebarLibraryView::PerformUrlDrop(
+    GURL url, std::u16string title, DragLocation destination,
+    const ui::DropTargetEvent& event, ui::mojom::DragOperation& operation,
+    std::unique_ptr<ui::LayerTreeOwner> image) {
+  operation = ui::mojom::DragOperation::kNone;
+  if (!url.SchemeIsHTTPOrHTTPS() || !IsDropLocationValid(destination) ||
+      !(event.source_operations() & ui::DragDropTypes::DRAG_COPY)) return;
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(), kCoveSidebarPref);
+  auto* space = FindSpace(*update, active_space_id_);
+  if (!space) return;
+  if (const auto* pins = space->FindList("pins")) for (const auto& value : *pins) {
+    const auto* pin = value.GetIfDict();
+    if (pin && pin->FindString("url") && *pin->FindString("url") == url.spec()) return;
+  }
+  auto candidate = space->Clone();
+  const auto id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::DictValue pin;
+  pin.Set("id", id);
+  pin.Set("url", url.spec());
+  pin.Set("title", base::UTF16ToUTF8(title.empty() ? base::UTF8ToUTF16(url.host()) : title));
+  pin.Set("folder", "");
+  candidate.EnsureList("pins")->Append(std::move(pin));
+  if (cove::SidebarOrder::Move(candidate, {cove::SidebarItemKind::kPin, id},
+      destination.parent, destination.before)) {
+    ExpandFolderPath(candidate, destination.parent);
+    *space = std::move(candidate);
+    operation = ui::mojom::DragOperation::kCopy;
+  }
+}
+
+void CoveSidebarLibraryView::WriteDragDataForView(
+    views::View* sender, const gfx::Point& press, ui::OSExchangeData* data) {
+  const auto found = row_items_.find(sender);
+  if (found == row_items_.end() || !GetDragOperationsForView(sender, press)) return;
+  base::Pickle pickle;
+  pickle.WriteString(SidebarProfileIdentity(browser_->GetProfile()));
+  pickle.WriteString(active_space_id_);
+  pickle.WriteInt(found->second.kind == cove::SidebarItemKind::kPin ? 0 : 1);
+  pickle.WriteString(found->second.id);
+  data->SetPickledData(SidebarDragFormat(), pickle);
+  if (found->second.kind == cove::SidebarItemKind::kPin) {
+    const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+        ->GetDict(kCoveSidebarPref), active_space_id_);
+    if (const auto* pins = space ? space->FindList("pins") : nullptr)
+      for (const auto& value : *pins) {
+        const auto* pin = value.GetIfDict();
+        if (pin && pin->FindString("id") && *pin->FindString("id") == found->second.id &&
+            pin->FindString("url")) {
+          const GURL url(*pin->FindString("url"));
+          if (url.SchemeIsHTTPOrHTTPS()) data->SetURL(url, sender->GetViewAccessibility().GetCachedName());
+          break;
+        }
+      }
+  }
+}
+
+int CoveSidebarLibraryView::GetDragOperationsForView(views::View* sender,
+                                                     const gfx::Point& point) {
+  const auto found = row_items_.find(sender);
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+      ->GetDict(kCoveSidebarPref), active_space_id_);
+  if (found == row_items_.end() || !space || IsSessionMutationInProgress() ||
+      !cove::SidebarOrder::Parent(*space, found->second)) return 0;
+  return ui::DragDropTypes::DRAG_MOVE | (found->second.kind == cove::SidebarItemKind::kPin
+      ? ui::DragDropTypes::DRAG_COPY : 0);
+}
