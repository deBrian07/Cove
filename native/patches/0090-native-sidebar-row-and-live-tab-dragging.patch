+namespace {
+constexpr char kSidebarPref[] = "cove.sidebar";
+constexpr int kMoveFolderUpCommand = 13;
+constexpr int kMoveFolderDownCommand = 14;
+
+base::DictValue* FindSpace(base::DictValue& root, const std::string& id) {
+  auto* spaces = root.FindList("spaces");
+  if (!spaces) {
+    return nullptr;
+  }
+  for (auto& value : *spaces) {
+    auto* space = value.GetIfDict();
+    const auto* found = space ? space->FindString("id") : nullptr;
+    if (found && *found == id) {
+      return space;
+    }
+  }
+  return nullptr;
+}
+
+views::LabelButton* FindRow(views::View* root, std::u16string_view text) {
+  if (auto* row = views::AsViewClass<views::LabelButton>(root);
+      row && row->GetText().find(text) != std::u16string::npos) {
+    return row;
+  }
+  for (const auto& child : root->children()) {
+    if (auto* row = FindRow(child.get(), text)) {
+      return row;
+    }
+  }
+  return nullptr;
+}
+
+base::DictValue Pin(const char* id, const char* title, const char* url) {
+  return base::DictValue()
+      .Set("id", id)
+      .Set("title", title)
+      .Set("url", url)
+      .Set("folder", "")
+      .Set("kept", id);
+}
+
+base::DictValue Folder(const char* id, const char* name, const char* parent) {
+  return base::DictValue()
+      .Set("id", id)
+      .Set("name", name)
+      .Set("parent", parent)
+      .Set("collapsed", false);
+}
+}  // namespace
+
+// The friend fixture only selects the context row for the existing menu
+// delegate. No public test-only browser control is added, and no native menu
+// tracking loop or OS input injection is needed to exercise its commands.
+class CoveSidebarDragBrowserTest : public InProcessBrowserTest {
+ protected:
+  CoveSidebarLibraryView* library() {
+    return static_cast<CoveSidebarLibraryView*>(
+        CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost()));
+  }
+
+  void Layout() {
+    base::RunLoop().RunUntilIdle();
+    BrowserView::GetBrowserViewForBrowser(browser())
+        ->GetWidget()
+        ->LayoutRootViewIfNecessary();
+  }
+
+  void Seed() {
+    auto* controller = tabs::VerticalTabStripStateController::From(browser());
+    ASSERT_TRUE(controller);
+    controller->RequestCollapse(false);
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return !controller->IsCollapsed(); }));
+    {
+      ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(),
+                                  kSidebarPref);
+      auto* personal = FindSpace(*update, "personal");
+      ASSERT_TRUE(personal);
+      base::ListValue pins;
+      pins.Append(Pin("p", "Pin P", "https://pin-p.example/"));
+      pins.Append(Pin("q", "Pin Q", "https://pin-q.example/"));
+      personal->Set("pins", std::move(pins));
+      base::ListValue folders;
+      folders.Append(Folder("a", "Folder A", ""));
+      folders.Append(Folder("b", "Folder B", ""));
+      folders.Append(Folder("child", "Child folder", "a"));
+      personal->Set("folders", std::move(folders));
+      personal->Remove("sidebar_order");
+    }
+    Layout();
+    ASSERT_TRUE(library());
+    ASSERT_TRUE(library()->GetVisible());
+    ASSERT_TRUE(FindRow(library(), u"Pin P"));
+    ASSERT_TRUE(FindRow(library(), u"Child folder"));
+  }
+
+  const base::DictValue& SavedSpace() {
+    const auto& root =
+        browser()->GetProfile()->GetPrefs()->GetDict(kSidebarPref);
+    for (const auto& value : *root.FindList("spaces")) {
+      const auto& space = value.GetDict();
+      if (space.FindString("id") && *space.FindString("id") == "personal") {
+        return space;
+      }
+    }
+    ADD_FAILURE() << "Personal Space missing";
+    return root;
+  }
+
+  std::vector<std::string> Keys() {
+    std::vector<std::string> keys;
+    for (const auto& row : cove::SidebarOrder::Rows(SavedSpace(), true)) {
+      keys.push_back(
+          (row.item.kind == cove::SidebarItemKind::kPin ? "p:" : "f:") +
+          row.item.id);
+    }
+    return keys;
+  }
+
+  gfx::Point Before(views::View* row) {
+    const auto bounds = row->bounds();
+    return gfx::Point(bounds.CenterPoint().x(), bounds.y() + 1);
+  }
+
+  gfx::Point Inside(views::View* row) { return row->bounds().CenterPoint(); }
+
+  void Write(views::View* source, ui::OSExchangeData* data) {
+    library()->WriteDragDataForView(source, gfx::Point(), data);
+  }
+
+  ui::mojom::DragOperation Drop(views::View* source, const gfx::Point& point) {
+    if (!source) {
+      ADD_FAILURE() << "Drag source row missing";
+      return ui::mojom::DragOperation::kNone;
+    }
+    ui::OSExchangeData data;
+    Write(source, &data);
+    views::ViewTracker source_tracker(source);
+    library()->OnWillStartDragForView(source);
+    ui::DropTargetEvent event(data, gfx::PointF(point), gfx::PointF(point),
+                              ui::DragDropTypes::DRAG_MOVE);
+    EXPECT_TRUE(library()->CanDrop(data));
+    EXPECT_EQ(ui::DragDropTypes::DRAG_MOVE, library()->OnDragUpdated(event));
+    auto callback = library()->GetDropCallback(event);
+    EXPECT_TRUE(callback);
+    auto operation = ui::mojom::DragOperation::kNone;
+    if (callback) {
+      std::move(callback).Run(event, operation, nullptr);
+    }
+    // Committing preferences must not destroy the native source before
+    // Views delivers OnDragDone at the end of the OS drag session.
+    EXPECT_EQ(source, source_tracker.view());
+    if (source_tracker.view()) {
+      source_tracker.view()->OnDragDone();
+    }
+    Layout();
+    return operation;
+  }
+
+  void SelectFolderMenu(const std::string& id) {
+    library()->context_folder_id_ = id;
+    library()->menu_space_id_ = "personal";
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       SavedRowsReorderAndNestWithoutNavigatingLivePage) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(),
+      GURL("data:text/html,<input id=draft><title>Live drag page</title>")));
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(
+      contents,
+      "window.coveSavedDragIdentity = 91; "
+      "document.getElementById('draft').value = 'unsent sidebar draft'; "
+      "history.pushState({}, '', '#kept');"));
+  const int history = contents->GetController().GetEntryCount();
+  const int tabs = browser()->GetTabStripModel()->count();
+  const GURL url = contents->GetVisibleURL();
+  Seed();
+  ASSERT_EQ(
+      ui::mojom::DragOperation::kMove,
+      Drop(FindRow(library(), u"Pin Q"), Before(FindRow(library(), u"Pin P"))));
+  EXPECT_EQ((std::vector<std::string>{"p:q", "p:p", "f:a", "f:child", "f:b"}),
+            Keys());
+  ASSERT_EQ(ui::mojom::DragOperation::kMove,
+            Drop(FindRow(library(), u"Pin P"),
+                 Inside(FindRow(library(), u"Folder A"))));
+  EXPECT_EQ("a", cove::SidebarOrder::Parent(
+                     SavedSpace(), {cove::SidebarItemKind::kPin, "p"}));
+  ASSERT_EQ(ui::mojom::DragOperation::kMove,
+            Drop(FindRow(library(), u"Folder A"),
+                 Inside(FindRow(library(), u"Folder B"))));
+  EXPECT_EQ("b", cove::SidebarOrder::Parent(
+                     SavedSpace(), {cove::SidebarItemKind::kFolder, "a"}));
+  EXPECT_EQ("a", cove::SidebarOrder::Parent(
+                     SavedSpace(), {cove::SidebarItemKind::kFolder, "child"}));
+  ASSERT_EQ(2u, SavedSpace().FindList("pins")->size());
+  EXPECT_EQ("p", *SavedSpace().FindList("pins")->front().GetDict().FindString(
+                     "kept"));
+  EXPECT_EQ(
+      "https://pin-p.example/",
+      *SavedSpace().FindList("pins")->front().GetDict().FindString("url"));
+  EXPECT_EQ(contents, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(tabs, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(url, contents->GetVisibleURL());
+  EXPECT_EQ(history, contents->GetController().GetEntryCount());
+  EXPECT_EQ(91, content::EvalJs(contents, "window.coveSavedDragIdentity"));
+  EXPECT_EQ(
+      "unsent sidebar draft",
+      content::EvalJs(contents, "document.getElementById('draft').value"));
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       CanceledPreviewAndDescendantFolderDropDoNotMutatePrefs) {
+  Seed();
+  const auto saved = SavedSpace().Clone();
+  ui::OSExchangeData folder_data;
+  Write(FindRow(library(), u"Folder A"), &folder_data);
+  const auto child_point = Inside(FindRow(library(), u"Child folder"));
+  ui::DropTargetEvent cycle(folder_data, gfx::PointF(child_point),
+                            gfx::PointF(child_point),
+                            ui::DragDropTypes::DRAG_MOVE);
+  EXPECT_EQ(0, library()->OnDragUpdated(cycle));
+  EXPECT_FALSE(library()->GetDropCallback(cycle));
+  EXPECT_EQ(saved, SavedSpace());
+
+  auto* source = FindRow(library(), u"Pin P");
+  views::ViewTracker source_tracker(source);
+  ui::OSExchangeData pin_data;
+  Write(source, &pin_data);
+  library()->OnWillStartDragForView(source);
+  const auto destination = Inside(FindRow(library(), u"Folder A"));
+  ui::DropTargetEvent preview(pin_data, gfx::PointF(destination),
+                              gfx::PointF(destination),
+                              ui::DragDropTypes::DRAG_MOVE);
+  EXPECT_EQ(ui::DragDropTypes::DRAG_MOVE, library()->OnDragUpdated(preview));
+  EXPECT_EQ(saved, SavedSpace());
+  library()->OnDragExited();
+  EXPECT_EQ(saved, SavedSpace());
+  ASSERT_TRUE(source_tracker.view());
+  source_tracker.view()->OnDragDone();
+  Layout();
+  EXPECT_EQ(saved, SavedSpace());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       DropCallbacksRevalidateRemovedSourceAndDestination) {
+  Seed();
+  ui::OSExchangeData source_data;
+  Write(FindRow(library(), u"Pin P"), &source_data);
+  auto point = Inside(FindRow(library(), u"Folder A"));
+  ui::DropTargetEvent source_event(source_data, gfx::PointF(point),
+                                   gfx::PointF(point),
+                                   ui::DragDropTypes::DRAG_MOVE);
+  auto source_callback = library()->GetDropCallback(source_event);
+  ASSERT_TRUE(source_callback);
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(),
+                                kSidebarPref);
+    auto* space = FindSpace(*update, "personal");
+    ASSERT_TRUE(space);
