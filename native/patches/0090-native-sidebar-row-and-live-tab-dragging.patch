+bool CoveSidebarLibraryView::GetDropFormats(
+    int* formats, std::set<ui::ClipboardFormatType>* types) {
+  *formats = ui::OSExchangeData::URL;
+  types->insert(SidebarDragFormat());
+  return true;
+}
