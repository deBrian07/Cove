+namespace {
+constexpr char kFolderId[] = "live-tab-drop-folder";
+constexpr char16_t kFolderName[] = u"Live drag destination";
+
+views::View* FindFolderRow(views::View* root) {
+  if (auto* button = views::AsViewClass<views::LabelButton>(root);
+      button && button->GetText().find(kFolderName) != std::u16string::npos) {
+    return button;
+  }
+  for (const auto& child : root->children()) {
+    if (auto* result = FindFolderRow(child.get())) {
+      return result;
+    }
+  }
+  return nullptr;
+}
+
+const base::DictValue* PersonalSpace(Profile* profile) {
+  const auto* spaces = profile->GetPrefs()->GetDict("cove.sidebar").FindList("spaces");
+  if (!spaces) {
+    return nullptr;
+  }
+  for (const auto& value : *spaces) {
+    const auto* space = value.GetIfDict();
+    const auto* id = space ? space->FindString("id") : nullptr;
+    if (id && *id == "personal") {
+      return space;
+    }
+  }
+  return nullptr;
+}
+
+class CoveLiveTabDragBrowserTest : public InProcessBrowserTest {
+ protected:
+  void TearDownOnMainThread() override {
+    // A failed assertion must not leave an owned drag/capture session alive
+    // while the browser test harness tears its native window down.
+    if (browser()) {
+      if (auto* view = BrowserView::GetBrowserViewForBrowser(browser())) {
+        if (auto* context = view->tab_strip_view()->GetDragContext();
+            context && context->GetDragController()) {
+          context->GetDragController()->EndDrag(EndDragReason::kCancel);
+        }
+      }
+    }
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  CoveSidebarLibraryView* library() {
+    return static_cast<CoveSidebarLibraryView*>(
+        CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost()));
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  void PreparePageAndFolder() {
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("/title1.html")));
+    ASSERT_TRUE(library());
+    ASSERT_TRUE(content::ExecJs(
+        browser()->GetTabStripModel()->GetActiveWebContents(),
+        "window.coveLiveDragDraft = 'unsent live drag draft'; "
+        "history.pushState({}, '', '#same-page-instance');"));
+    {
+      ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(),
+                                  "cove.sidebar");
+      auto* spaces = update->FindList("spaces");
+      ASSERT_TRUE(spaces);
+      bool inserted = false;
+      for (auto& value : *spaces) {
+        auto* space = value.GetIfDict();
+        const auto* id = space ? space->FindString("id") : nullptr;
+        if (id && *id == "personal") {
+          base::DictValue folder;
+          folder.Set("id", kFolderId);
+          folder.Set("name", "Live drag destination");
+          folder.Set("parent", "");
+          folder.Set("collapsed", false);
+          space->EnsureList("folders")->Append(std::move(folder));
+          inserted = true;
+          break;
+        }
+      }
+      ASSERT_TRUE(inserted);
+    }
+    base::RunLoop().RunUntilIdle();
+    browser_view()->GetWidget()->Show();
+    browser_view()->GetWidget()->Activate();
+    browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+    ASSERT_TRUE(FindFolderRow(library()));
+    ASSERT_TRUE(browser_view()->ShouldDrawVerticalTabStrip());
+    ASSERT_EQ(1, browser()->GetTabStripModel()->count());
+  }
+
+  void BeginRealDrag(TabDragContext* context,
+                     TabSlotView* source,
+                     const gfx::Point& destination) {
+    ASSERT_FALSE(context->GetDragController());
+    auto controller = std::make_unique<TabDragController>();
+    auto* raw = controller.get();
+    context->OwnDragController(std::move(controller));
+    ASSERT_EQ(TabDragController::Liveness::kAlive,
+              raw->Init(context, source, {source}, gfx::Point(4, 4),
+                        browser()->GetTabStripModel()
+                            ->selection_model().GetListSelectionModel(),
+                        ui::mojom::DragEventSource::kMouse));
+    ASSERT_EQ(TabDragController::Liveness::kAlive, raw->Drag(destination));
+    ASSERT_TRUE(context->GetDragController());
+    ASSERT_TRUE(raw->started_drag());
+    ASSERT_EQ(context, raw->GetAttachedContext());
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(CoveLiveTabDragBrowserTest,
+                       OnlyTabFolderDropKeepsPageAndWindow) {
+  ASSERT_NO_FATAL_FAILURE(PreparePageAndFolder());
+  auto* model = browser()->GetTabStripModel();
+  auto* contents = model->GetActiveWebContents();
+  const auto handle = model->GetActiveTab()->GetHandle();
+  const int entries = contents->GetController().GetEntryCount();
+  const GURL original_url = contents->GetVisibleURL();
+  auto* widget = browser_view()->GetWidget();
+  const gfx::Rect original_bounds = widget->GetWindowBoundsInScreen();
+  auto* context = browser_view()->tab_strip_view()->GetDragContext();
+  ASSERT_TRUE(context);
+  auto* source = context->GetTabForContents(contents);
+  ASSERT_TRUE(source);
+  const auto point = FindFolderRow(library())->GetBoundsInScreen().CenterPoint();
+  ASSERT_EQ(static_cast<TabDragTarget*>(library()),
+            browser_view()->GetTabDragTarget(point));
+
+  ASSERT_NO_FATAL_FAILURE(BeginRealDrag(context, source, point));
+  EXPECT_EQ(original_bounds, widget->GetWindowBoundsInScreen());
+  EXPECT_TRUE(library()->CanDropTab());
+  context->GetDragController()->EndDrag(EndDragReason::kComplete);
+  base::RunLoop().RunUntilIdle();
+
+  ASSERT_EQ(1, model->count());
+  ASSERT_TRUE(handle.Get());
+  EXPECT_EQ(handle.Get(), model->GetActiveTab());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_TRUE(model->GetActiveTab()->IsPinned());
+  EXPECT_EQ(original_bounds, widget->GetWindowBoundsInScreen());
+  EXPECT_EQ(entries, contents->GetController().GetEntryCount());
+  EXPECT_EQ(original_url, contents->GetVisibleURL());
+  EXPECT_EQ("unsent live drag draft", content::EvalJs(contents, "window.coveLiveDragDraft"));
+  const auto* space = PersonalSpace(browser()->GetProfile());
+  ASSERT_TRUE(space);
+  const auto* pins = space->FindList("pins");
+  ASSERT_TRUE(pins);
+  ASSERT_EQ(1u, pins->size());
+  const auto* folder = pins->front().GetDict().FindString("folder");
+  const auto* saved_url = pins->front().GetDict().FindString("url");
+  ASSERT_TRUE(folder);
+  ASSERT_TRUE(saved_url);
+  EXPECT_EQ(kFolderId, *folder);
+  EXPECT_EQ(original_url.spec(), *saved_url);
+}
+
+IN_PROC_BROWSER_TEST_F(CoveLiveTabDragBrowserTest,
+                       CancelOnlyTabFolderDragLeavesPinsAndPageUntouched) {
+  ASSERT_NO_FATAL_FAILURE(PreparePageAndFolder());
+  auto* model = browser()->GetTabStripModel();
+  auto* contents = model->GetActiveWebContents();
+  const auto handle = model->GetActiveTab()->GetHandle();
+  const int entries = contents->GetController().GetEntryCount();
+  const auto before = browser()->GetProfile()->GetPrefs()->GetDict("cove.sidebar").Clone();
+  auto* widget = browser_view()->GetWidget();
+  const gfx::Rect original_bounds = widget->GetWindowBoundsInScreen();
+  auto* context = browser_view()->tab_strip_view()->GetDragContext();
+  ASSERT_TRUE(context);
+  auto* source = context->GetTabForContents(contents);
+  ASSERT_TRUE(source);
+  const auto point = FindFolderRow(library())->GetBoundsInScreen().CenterPoint();
+
+  ASSERT_NO_FATAL_FAILURE(BeginRealDrag(context, source, point));
+  EXPECT_EQ(before, browser()->GetProfile()->GetPrefs()->GetDict("cove.sidebar"));
+  EXPECT_EQ(original_bounds, widget->GetWindowBoundsInScreen());
+  context->GetDragController()->EndDrag(EndDragReason::kCancel);
+  base::RunLoop().RunUntilIdle();
+
+  ASSERT_EQ(1, model->count());
+  ASSERT_TRUE(handle.Get());
+  EXPECT_EQ(handle.Get(), model->GetActiveTab());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_FALSE(model->GetActiveTab()->IsPinned());
+  EXPECT_EQ(before, browser()->GetProfile()->GetPrefs()->GetDict("cove.sidebar"));
+  EXPECT_EQ(entries, contents->GetController().GetEntryCount());
+  EXPECT_EQ("unsent live drag draft", content::EvalJs(contents, "window.coveLiveDragDraft"));
+  EXPECT_EQ(original_bounds, widget->GetWindowBoundsInScreen());
+}
+}  // namespace
