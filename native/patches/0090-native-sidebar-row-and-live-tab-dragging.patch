+bool CoveSidebarLibraryView::FolderReorderTarget(
+    std::string_view id, bool down,
+    std::optional<cove::SidebarItem>* before) const {
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+      ->GetDict(kCoveSidebarPref), active_space_id_);
+  if (!space) return false;
+  const cove::SidebarItem item{cove::SidebarItemKind::kFolder, std::string(id)};
+  const auto parent = cove::SidebarOrder::Parent(*space, item);
+  if (!parent) return false;
+  std::vector<cove::SidebarItem> siblings;
+  for (const auto& row : cove::SidebarOrder::Rows(*space, true))
+    if (row.parent == *parent) siblings.push_back(row.item);
+  auto found = std::find(siblings.begin(), siblings.end(), item);
+  if (found == siblings.end()) return false;
+  const size_t index = found - siblings.begin();
+  if ((!down && !index) || (down && index + 1 >= siblings.size())) return false;
+  *before = down ? (index + 2 < siblings.size()
+      ? std::make_optional(siblings[index + 2]) : std::nullopt)
+      : std::make_optional(siblings[index - 1]);
+  return cove::SidebarOrder::CanMove(*space, item, *parent, *before);
+}
