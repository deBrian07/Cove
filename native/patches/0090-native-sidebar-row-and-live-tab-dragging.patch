+    const gfx::Point& point_in_screen) {
+  // Saved folders are outside the native tab container, but live tabs must
+  // remain in Chromium's drag session rather than becoming URL-copy drags.
+  if (library_view_) {
+    if (auto* target = library_view_->GetTabDragTarget(point_in_screen)) {
+      return target;
+    }
+  }
+  return BaseTabStripRegionView::GetTabDragTarget(point_in_screen);
+}
