+bool CoveSidebarLibraryView::CanDropTab() {
+  auto* tab = live_drag_handle_ ? live_drag_handle_->Get() : nullptr;
+  return tab && live_drop_ && tab->GetBrowserWindowInterface() == browser_ &&
+      !tab->GetGroup() && !tab->GetSplit() && IsDropLocationValid(*live_drop_);
+}
+void CoveSidebarLibraryView::HandleTabDrop(TabDragTarget::DragController& controller) {
+  if (CanDropTab()) base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&CoveSidebarLibraryView::CommitLiveTabDrop,
+          weak_factory_.GetWeakPtr(), *live_drag_handle_, *live_drop_));
+  OnTabDragEnded();
+}
+void CoveSidebarLibraryView::CommitLiveTabDrop(tabs::TabHandle handle,
+                                               DragLocation destination) {
+  auto* tab = handle.Get();
+  if (!tab || tab->GetBrowserWindowInterface() != browser_ || tab->GetGroup() ||
+      tab->GetSplit() || !IsDropLocationValid(destination)) return;
+  auto* model = browser_->GetTabStripModel();
+  int index = model->GetIndexOfTab(tab);
+  if (index == TabStripModel::kNoTab) return;
+  const auto& url = tab->GetContents()->GetVisibleURL();
+  if (!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIsFile()) return;
+  if (!tab->IsPinned()) model->SetTabPinned(index, true);
+  tab = handle.Get();
+  if (!tab || !tab->IsPinned() || !IsDropLocationValid(destination)) return;
+  const auto binding = tab_pin_ids_.find(handle.raw_value());
+  if (binding == tab_pin_ids_.end() || binding->second.first != active_space_id_) return;
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(), kCoveSidebarPref);
+  if (auto* space = FindSpace(*update, active_space_id_);
+      space && cove::SidebarOrder::Move(*space,
+          {cove::SidebarItemKind::kPin, binding->second.second},
+          destination.parent, destination.before)) ExpandFolderPath(*space, destination.parent);
+  QueueSessionSync();
+}
+base::CallbackListSubscription CoveSidebarLibraryView::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return tab_drag_destroy_callbacks_.Add(std::move(callback));
+}
