+
+TabDragContext* CoveSidebarLibraryView::OnTabDragUpdated(
+    TabDragTarget::DragController& controller, const gfx::Point& point_in_screen) {
+  live_drag_handle_.reset();
+  live_drop_.reset();
+  ClearDropIndicator();
+  const auto* attached = controller.GetAttachedContext();
+  if (!attached || attached->GetWidget() != GetWidget()) return nullptr;
+  auto* context = const_cast<TabDragContext*>(attached);
+  const auto& data = controller.GetSessionData();
+  if (data.num_dragging_tabs() != 1 || !data.dragging_groups.empty() ||
+      data.group_header_drag_data_) return context;
+  content::WebContents* contents = nullptr;
+  for (const auto& entry : data.tab_drag_data_)
+    if (entry.contents) contents = entry.contents;
+  auto* tab = contents ? tabs::TabInterface::GetFromContents(contents) : nullptr;
+  if (!tab || tab->GetBrowserWindowInterface() != browser_ || tab->GetGroup() ||
+      tab->GetSplit() || !contents->GetVisibleURL().is_valid() ||
+      (!contents->GetVisibleURL().SchemeIsHTTPOrHTTPS() &&
+       !contents->GetVisibleURL().SchemeIsFile())) return context;
+  auto destination = LocateDrop(views::View::ConvertPointFromScreen(this, point_in_screen));
+  if (!destination) return context;
+  live_drag_handle_ = tab->GetHandle();
+  live_drop_ = destination;
+  ShowDropIndicator(*destination);
+  return context;
+}
