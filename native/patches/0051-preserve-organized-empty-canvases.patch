 IN_PROC_BROWSER_TEST_F(CoveSidebarLibraryBrowserTest,
+                       SplitPreservesMarkedEmptyCanvasTab) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  auto* model = browser()->GetTabStripModel();
+  ASSERT_EQ(1, model->count());
+  content::WebContents* canvas = model->GetActiveWebContents();
+  MarkCoveEmptyCanvas(canvas);
+
+  content::WebContents* right = chrome::AddAndReturnTabAt(
+      browser(), GURL("data:text/html,<title>Right pane</title>"), -1,
+      /*foreground=*/true);
+  ASSERT_TRUE(right);
+  ASSERT_EQ(2, model->count());
+  const auto split =
+      model->AddToNewSplit({0, 1}, split_tabs::SplitTabVisualData(),
+                           split_tabs::SplitTabCreatedSource::kExtensionsApi);
+
+  base::RunLoop().RunUntilIdle();
+
+  ASSERT_EQ(2, model->count());
+  EXPECT_EQ(split, model->GetTabAtIndex(0)->GetSplit());
+  EXPECT_EQ(split, model->GetTabAtIndex(1)->GetSplit());
+  EXPECT_TRUE(IsCoveEmptyCanvas(model->GetWebContentsAt(0)) ||
+              IsCoveEmptyCanvas(model->GetWebContentsAt(1)));
+}
