+void VerticalTabStripRegionView::UpdateCovePinnedTabsVisibility() {
+  if (!tab_strip_view() || !library_view_) {
+    return;
+  }
+  TabStripModel* model = browser_view()->browser()->GetTabStripModel();
+  const int pinned_count = model->IndexOfFirstNonPinnedTab();
+  bool all_covered = pinned_count > 0;
+  for (int index = 0; index < pinned_count && all_covered; ++index) {
+    all_covered = library_view_->RetainsPinForTab(model->GetTabAtIndex(index));
+  }
+  tab_strip_view()->SetCovePinnedTabsCovered(all_covered);
+}
