+    return;
+  }
+  base::AutoReset<bool> switching(&switching_space_, true);
+  SaveActiveSnapshot();
+  closing_active_space_ = CaptureCurrentTabs();
+  for (auto& [id, space] : inactive_spaces_) {
+    InsertSpaceTabs(*space);
+  }
+  RestoreSelection(*closing_active_space_);
+  // All pages are now visible to Chromium's beforeunload, session persistence,
+  // crash handling and normal window teardown. No cached page is destroyed by
+  // the sidebar destructor behind the unload controller's back.
+}
