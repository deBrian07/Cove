+#ifndef CHROME_BROWSER_UI_COVE_SPACE_CLOSE_HANDLER_H_
+#define CHROME_BROWSER_UI_COVE_SPACE_CLOSE_HANDLER_H_
+
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+// Window-scoped bridge between Spaces and the native browser unload pipeline.
+// Inactive pages must rejoin the tab strip before beforeunload/session
+// shutdown.
+class CoveSpaceCloseHandler {
+ public:
+  DECLARE_USER_DATA(CoveSpaceCloseHandler);
+  virtual ~CoveSpaceCloseHandler() = default;
+  virtual bool HasPendingTabs() const = 0;
+  virtual void PrepareForClose() = 0;
+  virtual void CancelClose() = 0;
+};
+
+#endif  // CHROME_BROWSER_UI_COVE_SPACE_CLOSE_HANDLER_H_
