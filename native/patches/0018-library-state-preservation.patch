+IN_PROC_BROWSER_TEST_F(
+    CoveSidebarLibraryBrowserTest,
+    SwitchingPreservesLivePageHistoryAndPinWithoutArchiving) {
+  const GURL page("data:text/html,<input id=draft><title>Space draft</title>");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page));
+  auto* model = browser()->GetTabStripModel();
+  auto* contents = model->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(contents, R"(
+    window.spaceValue = 37;
+    document.getElementById('draft').value = 'unsent draft';
+    window.beforeUnloadCount = 0;
+    window.addEventListener('beforeunload', () => ++window.beforeUnloadCount);
+    history.pushState({}, '', '#kept');
+  )"));
+  const int history_count = contents->GetController().GetEntryCount();
+  model->SetTabPinned(0, true);
+  auto* restore = TabRestoreServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(restore);
+  const size_t archived_count = restore->entries().size();
+
+  Switch(browser(), u"Work");
+  EXPECT_EQ(1, model->count());
+  EXPECT_EQ(37, content::EvalJs(contents, "window.spaceValue"));
+  EXPECT_EQ(
+      "unsent draft",
+      content::EvalJs(contents, "document.getElementById('draft').value"));
+  EXPECT_EQ(0, content::EvalJs(contents, "window.beforeUnloadCount"));
+  Switch(browser(), u"Personal");
+  ASSERT_EQ(1, model->count());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_TRUE(model->IsTabPinned(0));
+  EXPECT_EQ(history_count, contents->GetController().GetEntryCount());
+  EXPECT_EQ(archived_count, restore->entries().size());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSidebarLibraryBrowserTest,
+                       SwitchingRetainsGroupSplitAndActivePane) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Left</title>")));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("data:text/html,<title>Right</title>"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  auto* model = browser()->GetTabStripModel();
+  const auto group = model->AddToNewGroup({0, 1});
+  const auto split =
+      model->AddToNewSplit({0, 1}, split_tabs::SplitTabVisualData(),
+                           split_tabs::SplitTabCreatedSource::kExtensionsApi);
+  model->ActivateTabAt(1);
+  auto* active = model->GetActiveWebContents();
+  Switch(browser(), u"Work");
+  Switch(browser(), u"Personal");
+  ASSERT_EQ(2, model->count());
+  EXPECT_EQ(group, model->GetTabAtIndex(0)->GetGroup());
+  EXPECT_EQ(group, model->GetTabAtIndex(1)->GetGroup());
+  EXPECT_EQ(split, model->GetTabAtIndex(0)->GetSplit());
+  EXPECT_EQ(split, model->GetTabAtIndex(1)->GetSplit());
+  EXPECT_EQ(active, model->GetActiveWebContents());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSidebarLibraryBrowserTest,
+                       InactivePagesParticipateInUnloadAndCanceledShutdown) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Inactive form</title>")));
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(contents, R"(
+    window.beforeUnloadCount = 0;
+    window.addEventListener('beforeunload', () => ++window.beforeUnloadCount);
+  )"));
+  Switch(browser(), u"Work");
+  auto* library = Library(browser());
+  ASSERT_TRUE(library->HasPendingTabs());
+  auto* unload = UnloadController::From(browser());
+  EXPECT_EQ(
+      BrowserWindowInterface::ClosingStatus::kDeniedUnloadHandlersNeedTime,
+      unload->GetBrowserClosingStatus());
+  base::test::TestFuture<bool> confirmed;
+  ASSERT_TRUE(unload->RunBeforeUnloadForShutdown(
+      false, confirmed.GetRepeatingCallback()));
+  ASSERT_TRUE(confirmed.Get());
+  EXPECT_FALSE(library->HasPendingTabs());
+  EXPECT_EQ(2, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(1, content::EvalJs(contents, "window.beforeUnloadCount"));
+  unload->ResetBeforeUnloadForShutdown();
+  EXPECT_TRUE(library->HasPendingTabs());
+  EXPECT_EQ(1, browser()->GetTabStripModel()->count());
+  Switch(browser(), u"Personal");
+  EXPECT_EQ(contents, browser()->GetTabStripModel()->GetActiveWebContents());
+}
