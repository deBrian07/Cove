+views::LabelButton* FindButton(views::View* view, std::u16string_view text) {
+  if (auto* button = views::AsViewClass<views::LabelButton>(view);
+      button && button->GetText() == text) {
+    return button;
+  }
+  for (auto* child : view->children()) {
+    if (auto* button = FindButton(child, text)) {
+      return button;
+    }
+  }
+  return nullptr;
+}
