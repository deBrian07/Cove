+class CoveSidebarLibraryBrowserTest : public InProcessBrowserTest {
+ protected:
+  CoveSidebarLibraryView* Library(BrowserWindowInterface* window) {
+    return static_cast<CoveSidebarLibraryView*>(
+        CoveSpaceCloseHandler::Get(window->GetUnownedUserDataHost()));
+  }
+
+  void Switch(BrowserWindowInterface* window, std::u16string_view name) {
+    auto* library = Library(window);
+    ASSERT_TRUE(library);
+    auto* button = FindButton(library, name);
+    ASSERT_TRUE(button);
+    views::test::ButtonTestApi(button).NotifyDefaultMouseClick();
+  }
+};
