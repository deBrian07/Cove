-void CoveSidebarLibraryView::SwitchSpace(const std::string& space_id) {
+std::unique_ptr<CoveSidebarLibraryView::SpaceTabs>
+CoveSidebarLibraryView::CaptureCurrentTabs() const {
+  auto space = std::make_unique<SpaceTabs>();
+  TabStripModel* model = browser_->GetTabStripModel();
+  space->selection = model->selection_model().GetListSelectionModel();
+  for (int i = 0; i < model->count(); ++i) {
+    space->handles.push_back(model->GetTabAtIndex(i)->GetHandle());
+  }
+  return space;
+}
+
+void CoveSidebarLibraryView::DetachSpaceTabs(SpaceTabs& space) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  std::vector<int> indices;
+  for (const auto& handle : space.handles) {
+    if (auto* tab = handle.Get()) {
+      const int index = model->GetIndexOfTab(tab);
+      if (index != TabStripModel::kNoTab) {
+        indices.push_back(index);
+      }
+    }
+  }
+  std::ranges::sort(indices);
+  if (!indices.empty()) {
+    space.items = model->DetachTabsAndCollectionsForInsertion(indices);
+  }
+}
+
+void CoveSidebarLibraryView::InsertSpaceTabs(SpaceTabs& space) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  for (auto& entry : space.items) {
+    if (auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&entry)) {
+      const int add_types =
+          (*tab)->was_pinned_at_time_of_removal ? AddTabTypes::ADD_PINNED : 0;
+      model->InsertDetachedTabAt(model->count(), std::move((*tab)->tab),
+                                 add_types);
+    } else if (auto* collection =
+                   std::get_if<std::unique_ptr<DetachedTabCollection>>(
+                       &entry)) {
+      if (std::holds_alternative<std::unique_ptr<tabs::TabGroupTabCollection>>(
+              (*collection)->collection_)) {
+        model->InsertDetachedTabGroupAt(std::move(*collection), model->count());
+      } else {
+        const bool pinned = (*collection)->pinned_;
+        model->InsertDetachedSplitTabAt(
+            std::move(*collection),
+            pinned ? model->IndexOfFirstNonPinnedTab() : model->count(),
+            pinned);
+      }
+    }
+  }
+  space.items.clear();
+}
+
+void CoveSidebarLibraryView::RestoreSelection(const SpaceTabs& space) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  const auto index_for =
+      [&](std::optional<size_t> saved) -> std::optional<size_t> {
+    if (!saved || *saved >= space.handles.size()) {
+      return std::nullopt;
+    }
+    auto* tab = space.handles[*saved].Get();
+    const int index = tab ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    return index == TabStripModel::kNoTab ? std::nullopt
+                                          : std::make_optional<size_t>(index);
+  };
+  ui::ListSelectionModel restored;
+  for (size_t selected : space.selection.selected_indices()) {
+    if (const auto index = index_for(selected)) {
+      restored.AddIndexToSelection(*index);
+    }
+  }
+  restored.set_active(index_for(space.selection.active()));
+  restored.set_anchor(index_for(space.selection.anchor()));
+  if (restored.active()) {
+    model->SetSelectionFromModel(restored);
+  } else if (!model->empty()) {
+    model->ActivateTabAt(0);
+  }
+}
+
+void CoveSidebarLibraryView::SaveActiveSnapshot() {
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              kCoveSidebarPref);
+  base::DictValue* space = FindSpace(*update, active_space_id_);
+  if (!space) {
+    return;
+  }
+  base::ListValue tabs;
+  TabStripModel* model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    base::DictValue tab;
+    tab.Set("url", contents->GetVisibleURL().spec());
+    tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+    tab.Set("pinned", model->IsTabPinned(i));
+    tab.Set("active", model->active_index() == i);
+    tabs.Append(std::move(tab));
+  }
+  // This is a compatibility fallback for first load/restart, never the runtime
+  // representation of a Space. Live WebContents stay owned in inactive_spaces_.
+  space->Set("tabs", std::move(tabs));
+}
