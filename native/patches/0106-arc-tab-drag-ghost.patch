+class CoveRealMouseTabDragBrowserTest : public CoveLiveTabDragBrowserTest {
+ protected:
+  int BrowserCount() {
+    int count = 0;
+    GlobalBrowserCollection::GetInstance()->ForEach(
+        [&](BrowserWindowInterface*) {
+          ++count;
+          return true;
+        });
+    return count;
+  }
+
+  void SetUpOnMainThread() override {
+    CoveLiveTabDragBrowserTest::SetUpOnMainThread();
+    ui_controls::EnableUIControls();
+  }
+
+  void MoveMouse(const gfx::Point& point) {
+    base::RunLoop loop;
+    ASSERT_TRUE(ui_controls::SendMouseMoveNotifyWhenDone(
+        point.x(), point.y(), loop.QuitClosure()));
+    loop.Run();
+  }
+
+  void Button(ui_controls::MouseButtonState state) {
+    base::RunLoop loop;
+    ASSERT_TRUE(ui_controls::SendMouseEventsNotifyWhenDone(
+        ui_controls::LEFT, state, loop.QuitClosure()));
+    loop.Run();
+  }
+
+  // Presses on `from`, moves in small steps the way a hand does, re-resolving
+  // the destination as the sidebar reflows, then releases there.
+  void MouseDrag(const gfx::Point& from,
+                 base::RepeatingCallback<gfx::Point()> to) {
+    ASSERT_NO_FATAL_FAILURE(MoveMouse(from));
+    ASSERT_NO_FATAL_FAILURE(Button(ui_controls::DOWN));
+    gfx::Point at = from;
+    for (int step = 0; step < 400 && at != to.Run(); ++step) {
+      const gfx::Point target = to.Run();
+      const gfx::Vector2d delta = target - at;
+      at += gfx::Vector2d(std::clamp(delta.x(), -6, 6),
+                          std::clamp(delta.y(), -6, 6));
+      ASSERT_NO_FATAL_FAILURE(MoveMouse(at));
+      browser_view()->GetWidget()->LayoutRootViewIfNecessary();
+    }
+    ASSERT_NO_FATAL_FAILURE(Button(ui_controls::UP));
+    base::RunLoop().RunUntilIdle();
+  }
+};
