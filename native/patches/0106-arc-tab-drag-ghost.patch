+void VerticalTabStripRegionView::ShowCoveDragGhost(
+    content::WebContents* contents,
+    const gfx::Point& screen_point) {
+  if (!contents || !GetWidget() || !content_area_view_) {
+    HideCoveDragGhost();
+    return;
+  }
+  const gfx::Point point = views::View::ConvertPointFromScreen(this, screen_point);
+  if (favorites_view_ && space_clip_view_) {
+    // An empty Favorites box opens only once the pointer reaches the top of
+    // the sidebar, so starting a drag never shifts the rows under it. The
+    // threshold follows the clip as it moves, which keeps the box open while
+    // the pointer is over it.
+    const gfx::Rect clip = views::View::ConvertRectToTarget(
+        space_clip_view_->parent(), this, space_clip_view_->bounds());
+    favorites_view_->SetEmptyDropZoneRevealed(point.y() < clip.y() + 40);
+  }
+  if (!cove_drag_ghost_) {
+    auto ghost = std::make_unique<views::View>();
+    ghost->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    ghost->SetCanProcessEventsWithinSubtree(false);
+    ghost->SetPaintToLayer();
+    ghost->layer()->SetFillsBoundsOpaquely(false);
+    ghost->layer()->SetOpacity(0.85f);
+    ghost->SetBackground(views::CreateRoundedRectBackground(
+        kColorTabBackgroundActiveFrameActive, 8));
+    auto* layout = ghost->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 10), 8));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    cove_drag_ghost_icon_ =
+        ghost->AddChildView(std::make_unique<views::ImageView>());
+    cove_drag_ghost_icon_->SetImageSize(gfx::Size(16, 16));
+    cove_drag_ghost_title_ = ghost->AddChildView(std::make_unique<views::Label>());
+    cove_drag_ghost_title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    cove_drag_ghost_title_->SetElideBehavior(gfx::ELIDE_TAIL);
+    cove_drag_ghost_title_->SetSubpixelRenderingEnabled(false);
+    layout->SetFlexForView(cove_drag_ghost_title_, 1);
+    auto* close = ghost->AddChildView(std::make_unique<views::ImageView>());
+    close->SetImage(ui::ImageModel::FromVectorIcon(
+        vector_icons::kCloseIcon, ui::kColorIconSecondary, 14));
+    cove_drag_ghost_ = AddChildView(std::move(ghost));
+  }
+  auto* driver = favicon::ContentFaviconDriver::FromWebContents(contents);
+  if (driver && driver->FaviconIsValid() && !driver->GetFavicon().IsEmpty()) {
+    cove_drag_ghost_icon_->SetImage(
+        ui::ImageModel::FromImage(driver->GetFavicon()));
+  } else {
+    cove_drag_ghost_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+        vector_icons::kGlobeIcon, ui::kColorIcon, 16));
+  }
+  std::u16string title = contents->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+  }
+  cove_drag_ghost_title_->SetText(title);
+
+  constexpr int kGhostHeight = 36;
+  const gfx::Rect lane = views::View::ConvertRectToTarget(
+      content_area_view_->parent(), this, content_area_view_->bounds());
+  const int ghost_width = std::max(0, lane.width() - 16);
+  const int x = lane.x() + 8 + point.x() - cove_drag_start_x_.value_or(point.x());
+  const int y = point.y() - kGhostHeight / 2;
+  cove_drag_ghost_->SetBounds(
+      std::clamp(x, 0, std::max(0, width() - ghost_width)),
+      std::clamp(y, 0, std::max(0, height() - kGhostHeight)), ghost_width,
+      kGhostHeight);
+  cove_drag_ghost_->SetVisible(true);
+  ReorderChildView(cove_drag_ghost_, children().size());
+}
+
+void VerticalTabStripRegionView::HideCoveDragGhost() {
+  if (cove_drag_ghost_) {
+    cove_drag_ghost_->SetVisible(false);
+  }
+}
