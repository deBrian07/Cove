+
+// Like Arc, Cmd+T finds pages parked in another Space and switching to one
+// shows that Space.
+IN_PROC_BROWSER_TEST_F(CoveCaptionButtonsBrowserTest,
+                       CommandBarFindsAndOpensTabInAnotherSpace) {
+  auto* library =
+      CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  ASSERT_TRUE(library);
+  ASSERT_TRUE(content::NavigateToURL(
+      browser()->GetTabStripModel()->GetActiveWebContents(),
+      GURL("data:text/html,<title>ParkedNeedle</title>")));
+  auto* parked = browser()->GetTabStripModel()->GetActiveWebContents();
+  const std::string home = library->GetActiveSpaceId();
+  std::string other;
+  for (const auto& space : library->GetSpaces()) {
+    if (space.id != home) {
+      other = space.id;
+      break;
+    }
+  }
+  ASSERT_FALSE(other.empty());
+  library->FocusSpace(other);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return library->GetActiveSpaceId() == other; }));
+  ASSERT_EQ(TabStripModel::kNoTab,
+            browser()->GetTabStripModel()->GetIndexOfWebContents(parked));
+
+  auto* host =
+      BrowserView::GetBrowserViewForBrowser(browser())->GetTabSearchBubbleHost();
+  host->ShowTabSearchBubble(true);
+  auto* palette = host->native_palette_widget_for_testing();
+  ASSERT_TRUE(palette);
+  auto* bar = views::AsViewClass<CoveCommandBarView>(
+      palette->widget_delegate()->GetContentsView());
+  ASSERT_TRUE(bar);
+  bar->search_field_for_testing()->SetText(u"ParkedNeedle");
+  bar->ContentsChanged(bar->search_field_for_testing(), u"ParkedNeedle");
+  std::optional<size_t> row;
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    if (bar->row_action_for_testing(i).starts_with(u"In ")) {
+      row = i;
+    }
+  }
+  ASSERT_TRUE(row);
+  bar->RunRowForTesting(*row);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return library->GetActiveSpaceId() == home; }));
+  EXPECT_EQ(parked, browser()->GetTabStripModel()->GetActiveWebContents());
+}
