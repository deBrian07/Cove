 bool BrowserView::IsLocationBarVisible() const {
+  // The hidden toolbar retains logical child visibility in Views. Its address
+  // field must not receive focus while Cove owns the sidebar address host.
+  if (vertical_tab_strip_region_view_ && !IsToolbarVisible()) {
+    return false;
+  }
   return WindowFeatureController::From(browser_)->SupportsWindowFeature(
              WindowFeatureController::WindowFeature::kFeatureLocationBar) &&
          GetLocationBar()->IsVisible();
