+bool CoveSidebarLibraryView::RetainsPinForTab(
+    const tabs::TabInterface* tab) const {
+  if (!browser_ || browser_->GetProfile()->IsOffTheRecord() || !tab ||
+      !tab->IsPinned() || !tab->GetContents() ||
+      tab->GetBrowserWindowInterface() != browser_.get()) {
+    return false;
+  }
+  const auto& root =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+  const auto binding = tab_pin_ids_.find(tab->GetHandle().raw_value());
+  const std::string& space_id =
+      binding != tab_pin_ids_.end() ? binding->second.first : active_space_id_;
+  const auto* space = FindSpace(root, space_id);
+  const auto* pins = space ? space->FindList("pins") : nullptr;
+  if (!pins) {
+    return false;
+  }
+  for (const base::Value& value : *pins) {
+    const auto* pin = value.GetIfDict();
+    const auto* id = pin ? pin->FindString("id") : nullptr;
+    const auto* text = pin ? pin->FindString("url") : nullptr;
+    const GURL home(text ? *text : "");
+    if (!id || id->empty() || !home.is_valid() || home.SchemeIs("javascript")) {
+      continue;
+    }
+    if (binding != tab_pin_ids_.end() && binding->second.second == *id) {
+      return true;
+    }
+    // Existing native pins may predate live handle bindings. Restrict the URL
+    // fallback to this window's current Space and actual persisted records.
+    if (space_id == active_space_id_ &&
+        home == tab->GetContents()->GetVisibleURL()) {
+      return true;
+    }
+  }
+  return false;
+}
