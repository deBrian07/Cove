+// The right half of a step: a gradient with a small sidebar preview painted
+// in the chosen Space color, so the choice is visible before browsing.
+class PreviewView : public views::View {
+  METADATA_HEADER(PreviewView, views::View)
+
+ public:
+  // With |cycle|, the preview tours the Space colors, as Arc's welcome does.
+  PreviewView(const Palette* palette, bool cycle) : palette_(palette) {
+    if (cycle) {
+      timer_.Start(FROM_HERE, base::Milliseconds(2600),
+                   base::BindRepeating(&PreviewView::Advance,
+                                       base::Unretained(this)));
+    }
+  }
+
+  void Advance() {
+    index_ = (index_ + 1) % kPalettes.size();
+    palette_ = &kPalettes[index_];
+    SchedulePaint();
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const SkColor accent = palette_ ? ParseHex(palette_->accent) : kOcean;
+    PaintGradient(canvas, GetLocalBounds(), kDeep, accent);
+    // A floating sidebar card, like the browser beside it.
+    const int width = std::min(260, GetLocalBounds().width() - 80);
+    const int height = std::min(430, GetLocalBounds().height() - 120);
+    gfx::Rect card((GetLocalBounds().width() - width) / 2,
+                   (GetLocalBounds().height() - height) / 2, width, height);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(palette_ ? ParseHex(palette_->sidebar)
+                            : SkColorSetRGB(0x12, 0x1b, 0x30));
+    canvas->DrawRoundRect(card, 14, flags);
+    const SkColor highlight = palette_ ? ParseHex(palette_->highlight)
+                                       : SkColorSetRGB(0x1f, 0x32, 0x60);
+    flags.setColor(highlight);
+    gfx::Rect row(card.x() + 14, card.y() + 18, card.width() - 28, 26);
+    canvas->DrawRoundRect(row, 8, flags);  // Address field.
+    for (int i = 0; i < 3; ++i) {         // Favorites.
+      const int size = (card.width() - 28 - 20) / 3;
+      canvas->DrawRoundRect(
+          gfx::Rect(card.x() + 14 + i * (size + 10), card.y() + 58, size, 34),
+          8, flags);
+    }
+    flags.setColor(SkColorSetA(kText, 0x2a));
+    for (int i = 0; i < 5; ++i) {  // Pinned and today tabs.
+      canvas->DrawRoundRect(gfx::Rect(card.x() + 14, card.y() + 112 + i * 34,
+                                      card.width() - 28 - (i % 2) * 40, 22),
+                            6, flags);
+    }
+    flags.setColor(accent);
+    canvas->DrawRoundRect(gfx::Rect(card.x() + 14, card.y() + 112,
+                                    card.width() - 28, 22),
+                          6, flags);  // The selected tab.
+    for (int i = 0; i < 3; ++i) {     // Space dots.
+      flags.setColor(i == 0 ? kText : SkColorSetA(kText, 0x55));
+      canvas->DrawCircle(
+          gfx::Point(card.CenterPoint().x() - 14 + i * 14, card.bottom() - 18),
+          3, flags);
+    }
+  }
+
+ private:
+  raw_ptr<const Palette> palette_;
+  size_t index_ = 0;
+  base::RepeatingTimer timer_;
+};
