+END_METADATA
+
+CoveWelcomeView* FindWelcome(BrowserView* browser_view) {
+  for (views::View* child : browser_view->children()) {
+    if (auto* welcome = views::AsViewClass<CoveWelcomeView>(child)) {
+      return welcome;
+    }
+  }
+  return nullptr;
+}
+
+void ShowWhenVisible(base::WeakPtr<BrowserWindowInterface> browser,
+                     int attempts_left) {
+  auto* view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser.get()) : nullptr;
+  if (!view || !view->GetWidget()) {
+    return;
+  }
+  if (!view->GetWidget()->IsVisible()) {
+    if (attempts_left > 0) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&ShowWhenVisible, browser, attempts_left - 1),
+          base::Milliseconds(100));
+    }
+    return;
+  }
+  ShowCoveWelcome(browser.get());
+}
+
+}  // namespace
+
+views::View* ShowCoveWelcome(BrowserWindowInterface* browser) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return nullptr;
+  }
+  if (auto* existing = FindWelcome(browser_view)) {
+    return existing;
+  }
+  // Full-window, above the sidebar and the page, like Arc's welcome.
+  auto* welcome =
+      browser_view->AddChildView(std::make_unique<CoveWelcomeView>(browser));
+  welcome->Attach(browser_view);
+  return welcome;
+}
+
+void FinishCoveWelcome(BrowserWindowInterface* browser) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (auto* welcome = browser_view ? FindWelcome(browser_view) : nullptr) {
+    welcome->Finish();
+  }
+}
+
+void MaybeShowCoveWelcome(BrowserWindowInterface* browser) {
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  Profile* profile = browser->GetProfile();
+  PrefService* prefs = profile->GetPrefs();
+  if (profile->IsOffTheRecord() || profile->IsGuestSession() ||
+      !prefs->FindPreference(kCoveOnboardingCompletePref) ||
+      prefs->GetBoolean(kCoveOnboardingCompletePref)) {
+    return;
+  }
+  // Only for a brand-new profile: people who already use Cove keep browsing.
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(switches::kForceFirstRun) &&
+      !first_run::IsChromeFirstRun()) {
+    prefs->SetBoolean(kCoveOnboardingCompletePref, true);
+    return;
+  }
+  // Show once, after the first window appears on screen.
+  static bool scheduled = false;
+  if (scheduled) {
+    return;
+  }
+  scheduled = true;
+  ShowWhenVisible(browser->GetWeakPtr(), 100);
+}
diff --git a/chrome/browser/ui/views/cove/cove_welcome_browsertest.cc b/chrome/browser/ui/views/cove/cove_welcome_browsertest.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/views/cove/cove_welcome_browsertest.cc
@@ -0,0 +1,40 @@
+// Copyright 2026 The Cove Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/cove/cove_welcome_view.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/browser_test.h"
+#include "ui/views/view.h"
+
+using CoveWelcomeBrowserTest = InProcessBrowserTest;
+
+// An existing profile (not first run) never sees the welcome, and is marked
+// done so it never appears later.
+IN_PROC_BROWSER_TEST_F(CoveWelcomeBrowserTest, ExistingProfileSkipsWelcome) {
+  PrefService* prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(kCoveOnboardingCompletePref, false);
+  MaybeShowCoveWelcome(browser());
+  EXPECT_TRUE(prefs->GetBoolean(kCoveOnboardingCompletePref));
+}
+
+// The welcome covers the whole window, like Arc's, and finishing it records
+// completion and removes it.
+IN_PROC_BROWSER_TEST_F(CoveWelcomeBrowserTest, WelcomeCoversWindowUntilDone) {
+  PrefService* prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(kCoveOnboardingCompletePref, false);
+  views::View* welcome = ShowCoveWelcome(browser());
+  ASSERT_TRUE(welcome);
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  EXPECT_EQ(browser_view->GetLocalBounds(), welcome->bounds());
+  EXPECT_TRUE(welcome->GetVisible());
+  const size_t children = browser_view->children().size();
+  FinishCoveWelcome(browser());
+  EXPECT_EQ(children - 1, browser_view->children().size());
+  EXPECT_TRUE(prefs->GetBoolean(kCoveOnboardingCompletePref));
+}
