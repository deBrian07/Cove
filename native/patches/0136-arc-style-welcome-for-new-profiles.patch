+class CoveWelcomeView : public views::View, public views::ViewObserver {
+  METADATA_HEADER(CoveWelcomeView, views::View)
+
+ public:
+  explicit CoveWelcomeView(BrowserWindowInterface* browser)
+      : browser_(browser->GetWeakPtr()) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(true);
+    ShowStep(0);
+  }
+
+  void Attach(views::View* host) {
+    observation_.Observe(host);
+    SetBoundsRect(host->GetLocalBounds());
+  }
+
+  void Finish() {
+    if (browser_) {
+      browser_->GetProfile()->GetPrefs()->SetBoolean(
+          kCoveOnboardingCompletePref, true);
+    }
+    observation_.Reset();
+    if (parent()) {
+      parent()->RemoveChildViewT(this);  // Deletes this.
+    }
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    if (children().size() == 2) {
+      // Split screen: content on the left, preview on the right.
+      const int half = width() / 2;
+      children()[0]->SetBounds(0, 0, half, height());
+      children()[1]->SetBounds(half, 0, width() - half, height());
+    } else if (!children().empty()) {
+      children()[0]->SetBoundsRect(GetLocalBounds());
+    }
+  }
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (step_ == 0) {
+      PaintGradient(canvas, GetLocalBounds(), kOcean, kDeep);
+      PaintGradient(canvas,
+                    gfx::Rect(width() / 3, 0, width() * 2 / 3, height() / 2),
+                    SkColorSetA(kSky, 0x00), SkColorSetA(kSky, 0x40));
+    } else {
+      canvas->DrawColor(kPanel);
+    }
+  }
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    return true;  // The page underneath waits until setup is done.
+  }
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override {
+    SetBoundsRect(observed_view->GetLocalBounds());
+  }
+
+ private:
+  static constexpr int kSteps = 5;
+
+  void ShowStep(int step) {
+    step_ = step;
+    RemoveAllChildViews();
+    default_button_ = nullptr;
+    if (step == 0) {
+      Intro();
+    } else {
+      auto* column = Column();
+      switch (step) {
+        case 1:
+          Heading(column, u"Bring your stuff",
+                  u"Import bookmarks, history and passwords from Chrome, "
+                  u"Safari, Arc or another browser.");
+          Primary(column, u"Import from a Browser…",
+                  base::BindRepeating(&CoveWelcomeView::Import,
+                                      base::Unretained(this)));
+          Secondary(column, u"Start fresh");
+          break;
+        case 2:
+          Heading(column, u"Make it yours",
+                  u"Pick a color for your sidebar. Every Space can have its "
+                  u"own.");
+          Swatches(column);
+          Primary(column, u"Continue",
+                  base::BindRepeating(&CoveWelcomeView::Next,
+                                      base::Unretained(this)));
+          break;
+        case 3:
+          Heading(column, u"Make Cove your default browser",
+                  u"Links from Mail, Messages and other apps open in Little "
+                  u"Cove, a small window you can keep with ⌘O.");
+          default_button_ = Primary(
+              column, u"Set as Default Browser",
+              base::BindRepeating(&CoveWelcomeView::MakeDefault,
+                                  base::Unretained(this)));
+          Secondary(column, u"Not now");
+          break;
+        default:
+          Heading(column, u"You're all set",
+                  u"A few things that make Cove calm and quick:");
+          Tips(column);
+          Primary(column, u"Start Browsing",
+                  base::BindRepeating(&CoveWelcomeView::Next,
+                                      base::Unretained(this)));
+          break;
+      }
+      Progress(column);
+      AddChildView(std::make_unique<PreviewView>(&kPalettes[chosen_],
+                                                 /*cycle=*/step != 2));
+    }
+    InvalidateLayout();
+    SchedulePaint();
+  }
+
+  void Intro() {
+    auto* content = AddChildView(std::make_unique<views::View>());
+    auto* layout = content->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 28));
+    layout->set_main_axis_alignment(
+        views::BoxLayout::MainAxisAlignment::kCenter);
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    AddLabel(content, u"A calmer way to browse.", kText, 34,
+             gfx::Font::Weight::BOLD, 900);
+    auto* next = AddButton(content, u"→", kLightButton, kOcean,
+                           base::BindRepeating(&CoveWelcomeView::Next,
+                                               base::Unretained(this)));
+    next->SetMinSize(gfx::Size(68, 40));
+    next->GetViewAccessibility().SetName(u"Get started");
+  }
+
+  views::View* Column() {
+    auto* column = AddChildView(std::make_unique<views::View>());
+    auto* layout = column->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(0, 48), 18));
+    layout->set_main_axis_alignment(
+        views::BoxLayout::MainAxisAlignment::kCenter);
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    AddLabel(column, u"Cove", kSky, 6, gfx::Font::Weight::BOLD);
+    return column;
+  }
+
+  void Heading(views::View* column, std::u16string title,
+               std::u16string subtitle) {
+    AddLabel(column, std::move(title), kText, 18, gfx::Font::Weight::BOLD);
+    AddLabel(column, std::move(subtitle), kMuted, 3);
+  }
+
+  views::LabelButton* Primary(views::View* column, std::u16string text,
+                              views::Button::PressedCallback callback) {
+    return AddButton(column, std::move(text), kButton, kText,
+                     std::move(callback));
+  }
+
+  void Secondary(views::View* column, std::u16string text) {
+    auto* link = AddButton(column, std::move(text), SK_ColorTRANSPARENT,
+                           kMuted,
+                           base::BindRepeating(&CoveWelcomeView::Next,
+                                               base::Unretained(this)));
+    link->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 8)));
+  }
+
+  void Swatches(views::View* column) {
+    auto* row = column->AddChildView(std::make_unique<views::View>());
+    row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 10));
+    for (size_t i = 0; i < kPalettes.size(); ++i) {
+      auto* swatch = AddButton(
+          row, std::u16string(), ParseHex(kPalettes[i].accent), kText,
+          base::BindRepeating(&CoveWelcomeView::ChooseColor,
+                              base::Unretained(this), i));
+      swatch->SetMinSize(gfx::Size(36, 36));
+      swatch->SetTooltipText(kPalettes[i].name);
+      swatch->GetViewAccessibility().SetName(kPalettes[i].name);
+      if (i == chosen_) {
+        swatch->SetBorder(views::CreateRoundedRectBorder(3, 10, kText));
+      }
+    }
+  }
+
+  void Tips(views::View* column) {
+    for (const auto& [keys, text] :
+         std::array<std::pair<const char16_t*, const char16_t*>, 5>{{
+             {u"⌘T", u"Search, open a site or jump to any tab"},
+             {u"⌘S", u"Hide the sidebar for more room"},
+             {u"⌘D", u"Pin a tab so it stays in this Space"},
+             {u"⇧ Click", u"Peek at a link without leaving the page"},
+             {u"12 h", u"Unpinned tabs tidy themselves away"},
+         }}) {
+      auto* row = column->AddChildView(std::make_unique<views::View>());
+      row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 12));
+      auto* key = row->AddChildView(std::make_unique<views::Label>(keys));
+      key->SetEnabledColor(kText);
+      key->SetBackground(views::CreateRoundedRectBackground(kButton, 6));
+      key->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 8)));
+      key->SetPreferredSize(gfx::Size(70, 26));
+      key->SetAutoColorReadabilityEnabled(false);
+      auto* label = row->AddChildView(std::make_unique<views::Label>(text));
+      label->SetEnabledColor(kMuted);
+      label->SetAutoColorReadabilityEnabled(false);
+    }
+  }
+
+  void Progress(views::View* column) {
+    std::u16string dots;
+    for (int i = 1; i < kSteps; ++i) {
+      dots += i == step_ ? u"●  " : u"○  ";
+    }
+    AddLabel(column, dots, kMuted, 0);
+  }
+
+  void ChooseColor(size_t index) {
+    chosen_ = index;
+    if (browser_) {
+      ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                                  kSidebarPref);
+      base::ListValue* spaces = update->FindList("spaces");
+      const std::string* active = update->FindString("active");
+      base::ListValue none;
+      for (base::Value& value : spaces ? *spaces : none) {
+        base::DictValue* space = value.GetIfDict();
+        const std::string* id = space ? space->FindString("id") : nullptr;
+        if (!space || (active && id && *id != *active)) {
+          continue;
+        }
+        const Palette& palette = kPalettes[index];
+        base::DictValue theme;
+        theme.Set("sidebar", palette.sidebar);
+        theme.Set("accent", palette.accent);
+        theme.Set("highlight", palette.highlight);
+        space->Set("theme", std::move(theme));
+        space->Set("color", palette.accent);
+        break;
+      }
+    }
+    Rerun(step_);
+  }
+
+  void Import() {
+    if (browser_) {
+      chrome::ShowImportDialog(browser_.get());
+    }
+    Next();
+  }
+
+  void MakeDefault() {
+    auto worker =
+        base::MakeRefCounted<shell_integration::DefaultBrowserWorker>();
+    worker->StartSetAsDefault(base::BindOnce(
+        [](base::WeakPtr<CoveWelcomeView> view,
+           shell_integration::DefaultWebClientState state) {
+          if (view) {
+            view->Next();
+          }
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+
+  void Next() {
+    if (step_ + 1 < kSteps) {
+      Rerun(step_ + 1);
+      return;
+    }
+    // Leave after the press finishes; this view is about to go away.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CoveWelcomeView::Finish,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  // Rebuild after the current press; the pressed button is about to go away.
+  void Rerun(int step) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CoveWelcomeView::ShowStep,
+                                  weak_factory_.GetWeakPtr(), step));
+  }
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  int step_ = 0;
+  size_t chosen_ = 0;
+  raw_ptr<views::LabelButton> default_button_ = nullptr;
+  base::ScopedObservation<views::View, views::ViewObserver> observation_{this};
+  base::WeakPtrFactory<CoveWelcomeView> weak_factory_{this};
+};
