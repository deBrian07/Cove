+constexpr char kSidebarPref[] = "cove.sidebar";
+// Cove brand: Ocean and Slate, with the logo's blues.
+constexpr SkColor kOcean = SkColorSetRGB(0x25, 0x63, 0xeb);
+constexpr SkColor kDeep = SkColorSetRGB(0x1e, 0x2f, 0x7a);
+constexpr SkColor kSky = SkColorSetRGB(0x5b, 0x9a, 0xf2);
+constexpr SkColor kPanel = SkColorSetRGB(0x14, 0x15, 0x19);
+constexpr SkColor kText = SkColorSetRGB(0xf5, 0xf6, 0xf8);
+constexpr SkColor kMuted = SkColorSetRGB(0xa1, 0xa6, 0xb3);
+constexpr SkColor kButton = SkColorSetRGB(0x2a, 0x2c, 0x33);
+constexpr SkColor kLightButton = SkColorSetARGB(0xd8, 0xf5, 0xf6, 0xff);
+
+struct Palette {
+  const char16_t* name;
+  const char* sidebar;
+  const char* accent;
+  const char* highlight;
+};
+// Matches the Space theme presets offered in the sidebar's theme menu.
+constexpr std::array<Palette, 6> kPalettes = {{
+    {u"Cove", "#121b30", "#2563eb", "#1f3260"},
+    {u"Dusk", "#241f33", "#8b7ec8", "#3c3458"},
+    {u"Harbor", "#17262e", "#5ea0c0", "#2c4654"},
+    {u"Grove", "#1a2820", "#6eaa78", "#2c4634"},
+    {u"Ember", "#2a201c", "#d08a68", "#4a342c"},
+    {u"Slate", "#1e1f24", "#a8b0bc", "#34363e"},
+}};
+
+SkColor ParseHex(const char* hex) {
+  uint32_t value = 0;
+  base::HexStringToUInt(std::string_view(hex).substr(1), &value);
+  return SkColorSetA(static_cast<SkColor>(value), 0xff);
+}
+
+void PaintGradient(gfx::Canvas* canvas,
+                   const gfx::Rect& bounds,
+                   SkColor from,
+                   SkColor to) {
+  const SkPoint points[] = {gfx::PointToSkPoint(bounds.origin()),
+                            gfx::PointToSkPoint(bounds.bottom_right())};
+  const SkColor4f colors[] = {SkColor4f::FromColor(from),
+                              SkColor4f::FromColor(to)};
+  cc::PaintFlags flags;
+  flags.setShader(cc::PaintShader::MakeLinearGradient(
+      points, colors, nullptr, 2, SkTileMode::kClamp));
+  canvas->DrawRect(bounds, flags);
+}
+
+views::Label* AddLabel(views::View* parent,
+                       std::u16string text,
+                       SkColor color,
+                       int size_delta,
+                       gfx::Font::Weight weight = gfx::Font::Weight::NORMAL,
+                       int max_width = 420) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetEnabledColor(color);
+  label->SetFontList(
+      gfx::FontList().Derive(size_delta, gfx::Font::NORMAL, weight));
+  label->SetMultiLine(true);
+  label->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  label->SetMaximumWidth(max_width);
+  label->SetBackgroundColor(SK_ColorTRANSPARENT);
+  label->SetAutoColorReadabilityEnabled(false);
+  return label;
+}
+
+views::LabelButton* AddButton(views::View* parent,
+                              std::u16string text,
+                              SkColor background,
+                              SkColor foreground,
+                              views::Button::PressedCallback callback) {
+  auto* button = parent->AddChildView(
+      std::make_unique<views::LabelButton>(std::move(callback), text));
+  button->SetEnabledTextColors(foreground);
+  button->SetTextColor(views::Button::STATE_HOVERED, foreground);
+  button->SetBackground(views::CreateRoundedRectBackground(background, 10));
+  button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(10, 22)));
+  button->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  return button;
+}
