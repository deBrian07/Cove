 void CoveCommandBarView::RemovedFromWidget() {
   outside_click_monitor_.reset();
   views::View::RemovedFromWidget();
+}
+void CoveCommandBarView::VisibilityChanged(views::View* starting_from,
+                                           bool is_visible) {
+  views::View::VisibilityChanged(starting_from, is_visible);
+  if (is_visible || !outside_click_monitor_) {
+    return;
+  }
+  // A hidden bar needs no application-wide event monitor: every event would
+  // otherwise be converted and inspected while the bar is closed. Release it
+  // after the current event, since hiding can happen inside OnEvent();
+  // ShowExisting() creates a new one on the next opening.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<CoveCommandBarView> bar) {
+                       if (bar && !(bar->GetWidget() &&
+                                    bar->GetWidget()->IsVisible())) {
+                         bar->outside_click_monitor_.reset();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
 }
