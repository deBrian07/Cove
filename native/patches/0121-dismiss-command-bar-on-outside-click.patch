 CoveCommandBarView::~CoveCommandBarView() = default;
+void CoveCommandBarView::RemovedFromWidget() {
+  outside_click_monitor_.reset();
+  views::View::RemovedFromWidget();
+}
+void CoveCommandBarView::OnEvent(const ui::Event& event) {
+  if (event.type() != ui::EventType::kMousePressed || !GetWidget() ||
+      !GetWidget()->IsVisible() || !outside_click_monitor_) return;
+  if (!GetWidget()->GetWindowBoundsInScreen().Contains(
+          outside_click_monitor_->GetLastMouseLocation())) {
+    // Do not restore focus or consume the click: the intended target owns it.
+    // Keep the cached widget alive for the next command-bar opening.
+    GetWidget()->Hide();
+  }
+}
+
 views::View* CoveCommandBarView::GetAnchorView() const {
   return browser_ ? BrowserView::GetBrowserViewForBrowser(browser_.get()) : nullptr;
 }
