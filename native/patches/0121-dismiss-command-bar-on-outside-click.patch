+IN_PROC_BROWSER_TEST_F(CoveCaptionButtonsBrowserTest,
+                       OutsideClickDismissesPaletteAndStillReachesPage) {
+  auto* page = browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::NavigateToURL(page, GURL(
+      "data:text/html,<title>Outside click</title><textarea>draft</textarea>"
+      "<button style='position:fixed;right:0;bottom:0;width:200px;height:100px' "
+      "onclick='window.clicks=(window.clicks||0)+1'>Target</button>")));
+  ASSERT_TRUE(content::ExecJs(page, "window.clicks=0"));
+  const auto url = page->GetVisibleURL();
+  const int tabs = browser()->GetTabStripModel()->count();
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* host = view->GetTabSearchBubbleHost();
+  ASSERT_TRUE(host);
+  for (int iteration = 0; iteration < 3; ++iteration) {
+    host->ShowTabSearchBubble(true);
+    auto* palette = host->native_palette_widget_for_testing();
+    ASSERT_TRUE(palette);
+    ASSERT_TRUE(base::test::RunUntil([&] { return palette->IsActive(); }));
+    auto* bar = views::AsViewClass<CoveCommandBarView>(
+        palette->widget_delegate()->GetContentsView());
+    ASSERT_TRUE(bar);
+    const auto inside = bar->search_field_for_testing()->GetBoundsInScreen().CenterPoint();
+    base::test::TestFuture<void> inside_move;
+    ASSERT_TRUE(ui_controls::SendMouseMoveNotifyWhenDone(
+        inside.x(), inside.y(), inside_move.GetCallback(), palette->GetNativeWindow()));
+    ASSERT_TRUE(inside_move.Wait());
+    base::test::TestFuture<void> inside_click;
+    ASSERT_TRUE(ui_controls::SendMouseEventsNotifyWhenDone(
+        ui_controls::LEFT, ui_controls::DOWN | ui_controls::UP,
+        inside_click.GetCallback(), ui_controls::kNoAccelerator, palette->GetNativeWindow()));
+    ASSERT_TRUE(inside_click.Wait());
+    ASSERT_TRUE(palette->IsVisible());
+    const auto bounds = page->GetRenderWidgetHostView()->GetViewBounds();
+    const gfx::Point outside(bounds.right() - 100, bounds.bottom() - 50);
+    ASSERT_FALSE(palette->GetWindowBoundsInScreen().Contains(outside));
+    base::test::TestFuture<void> moved;
+    ASSERT_TRUE(ui_controls::SendMouseMoveNotifyWhenDone(
+        outside.x(), outside.y(), moved.GetCallback(), view->GetWidget()->GetNativeWindow()));
+    ASSERT_TRUE(moved.Wait());
+    base::test::TestFuture<void> clicked;
+    ASSERT_TRUE(ui_controls::SendMouseEventsNotifyWhenDone(
+        ui_controls::LEFT, ui_controls::DOWN | ui_controls::UP,
+        clicked.GetCallback(), ui_controls::kNoAccelerator,
+        view->GetWidget()->GetNativeWindow()));
+    ASSERT_TRUE(clicked.Wait());
+    ASSERT_TRUE(base::test::RunUntil([&] { return !palette->IsVisible(); }));
+    EXPECT_EQ(palette, host->native_palette_widget_for_testing());
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return content::EvalJs(page, "window.clicks").ExtractInt() == iteration + 1;
+    }));
+    EXPECT_EQ(url, page->GetVisibleURL());
+    EXPECT_EQ(tabs, browser()->GetTabStripModel()->count());
+    EXPECT_EQ("draft", content::EvalJs(page, "document.querySelector('textarea').value"));
+  }
+}
