+IN_PROC_BROWSER_TEST_F(CoveCaptionButtonsBrowserTest,
+                       CollapseReleasesAddressFocusWithoutDelayedReveal) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* region = view->vertical_tab_strip_region_view_for_testing();
+  auto* controller = tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(region);
+  ASSERT_TRUE(controller);
+  controller->RequestCollapse(false);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return controller->GetCollapseState() ==
+           tabs::VerticalTabStripCollapseState::kExpanded;
+  }));
+  region->FocusLocation();
+  ASSERT_TRUE(region->Contains(view->GetFocusManager()->GetFocusedView()));
+  chrome::ToggleCollapseVerticalTabs(browser());
+  ASSERT_TRUE(base::test::RunUntil([&] { return controller->IsCollapsed(); }));
+  EXPECT_FALSE(region->Contains(view->GetFocusManager()->GetFocusedView()));
+  ExpectHidden(true);
+  // Wait well beyond the 120ms hover delay and the collapse animation.
+  base::test::TestFuture<void> settled;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, settled.GetCallback(), base::Milliseconds(750));
+  ASSERT_TRUE(settled.Wait());
+  EXPECT_TRUE(controller->IsCollapsed());
+  EXPECT_FALSE(region->is_expanded_on_hover());
+  ExpectHidden(true);
+
+  // Cmd+L/accessibility focus remains a deliberate way to reveal the field.
+  region->FocusLocation();
+  EXPECT_FALSE(controller->IsCollapsed());
+  EXPECT_TRUE(region->Contains(view->GetFocusManager()->GetFocusedView()));
+  ExpectHidden(false);
+}
