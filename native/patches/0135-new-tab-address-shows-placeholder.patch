+namespace {
+// Like Arc, a new tab or blank page leaves the field empty so its "Search or
+// Enter URL" placeholder shows, instead of an internal chrome:// address.
+bool IsBlankDestination(const GURL& url) {
+  return url.IsAboutBlank() ||
+         (url.SchemeIs("chrome") &&
+          (url.host() == "newtab" || url.host() == "new-tab-page")) ||
+         url.SchemeIs("chrome-search");
+}
+std::u16string EditableText(const GURL& url) {
+  return IsBlankDestination(url) ? std::u16string()
+                                 : base::UTF8ToUTF16(url.spec());
+}
+}  // namespace
 
