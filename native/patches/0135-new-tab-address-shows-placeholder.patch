+
+// Like Arc, a new tab leaves the address empty for its placeholder instead of
+// showing chrome://newtab, both idle and while editing.
+IN_PROC_BROWSER_TEST_F(CoveSidebarLibraryBrowserTest,
+                       NewTabAddressShowsPlaceholderNotInternalURL) {
+  auto* region = BrowserView::GetBrowserViewForBrowser(browser())
+                     ->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(region);
+  auto* location = region->cove_location_view_for_testing();
+  ASSERT_TRUE(location);
+  auto* address = location->address_for_testing();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://newtab/")));
+  location->Refresh();
+  EXPECT_EQ(u"", address->GetText());
+  location->FocusLocation();
+  EXPECT_EQ(u"", address->GetText());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Page</title>")));
+  location->FocusLocation();
+  EXPECT_EQ(u"data:text/html,<title>Page</title>", address->GetText());
+}
