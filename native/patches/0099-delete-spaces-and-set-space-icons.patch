+  if (!anchor || !anchor->GetWidget() || !accept) {
+    return;
+  }
+  views::Widget* parent = anchor->GetWidget()->GetPrimaryWindowWidget();
+  if (!parent || !parent->GetNativeWindow()) {
+    return;
+  }
+  auto delegate = std::make_unique<CoveIconDialogDelegate>(std::move(accept));
+  auto* const delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetInternalName("CoveIconDialog")
+          .SetTitle(u"Change Space Icon")
+          .SetAccessibleTitle(u"Change Space Icon")
+          .AddParagraph(ui::DialogModelLabel(
+              u"Type an emoji or a short symbol. Press Control-Command-Space "
+              u"for the emoji picker. Leave it empty to use a dot."))
+          .AddTextfield(kCoveIconField, u"Icon", std::move(initial_icon),
+                        ui::DialogModelTextfield::Params().SetAccessibleName(
+                            u"Space icon"))
+          .SetInitiallyFocusedField(kCoveIconField)
+          .AddOkButton(
+              base::BindRepeating(&CoveIconDialogDelegate::Accept,
+                                  base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params()
+                  .SetId(kCoveIconSaveButton)
+                  .SetLabel(l10n_util::GetStringUTF16(IDS_SAVE)))
+          .AddCancelButton(base::DoNothing())
+          .Build();
+  delegate_ptr->Initialize();
