+
+void CoveSidebarLibraryView::CommitDeleteSpace(std::string space_id) {
+  if (!browser_ || browser_->GetProfile()->IsOffTheRecord() ||
+      switching_space_ || closing_active_space_ || restoring_session_) {
+    return;
+  }
+  const auto spaces = GetSpaces();
+  const auto doomed = std::ranges::find(spaces, space_id, &CoveSpaceInfo::id);
+  if (spaces.size() < 2 || doomed == spaces.end()) {
+    return;
+  }
+  if (space_id == active_space_id_) {
+    // Arc lands on the neighbor before the deleted Space; the first Space
+    // falls forward instead.
+    const auto neighbor = doomed == spaces.begin() ? doomed + 1 : doomed - 1;
+    SwitchSpace(neighbor->id);
+    if (active_space_id_ == space_id) {
+      return;
+    }
+  }
+  {
+    ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                                kCoveSidebarPref);
+    if (auto* list = update->FindList("spaces")) {
+      list->EraseIf([&](const base::Value& value) {
+        const auto* item = value.GetIfDict();
+        const auto* id = item ? item->FindString("id") : nullptr;
+        return id && *id == space_id;
+      });
+    }
+    if (const auto* active = update->FindString("active");
+        active && *active == space_id) {
+      update->Set("active", active_space_id_);
+    }
+  }
+  ReconcileDeletedSpaces();
+}
+
+void CoveSidebarLibraryView::ReconcileDeletedSpaces() {
+  reconcile_posted_ = false;
+  if (!browser_ || restoring_session_ || switching_space_ ||
+      closing_active_space_) {
+    return;
+  }
+  const auto& root =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+  if (!FindSpace(root, active_space_id_)) {
+    // Another window deleted the Space this window shows.
+    const auto spaces = GetSpaces();
+    if (spaces.empty()) {
+      return;
+    }
+    SwitchSpace(spaces.front().id);
+    if (!FindSpace(browser_->GetProfile()->GetPrefs()->GetDict(
+                       kCoveSidebarPref),
+                   active_space_id_)) {
+      return;
+    }
+  }
+  std::vector<std::string> deleted;
+  const auto& current =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+  for (const auto& [id, space] : inactive_spaces_) {
+    if (!FindSpace(current, id)) {
+      deleted.push_back(id);
+    }
+  }
+  std::erase_if(tab_pin_ids_, [&](const auto& binding) {
+    return !FindSpace(current, binding.second.first);
+  });
+  if (deleted.empty()) {
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  std::vector<tabs::TabHandle> before;
+  for (auto* tab : *model) {
+    before.push_back(tab->GetHandle());
+  }
+  {
+    // Parked pages rejoin the strip only to run Chromium's normal close path:
+    // beforeunload, unload handlers and recently-closed history.
+    base::AutoReset<bool> switching(&switching_space_, true);
+    for (const auto& id : deleted) {
+      auto found = inactive_spaces_.find(id);
+      auto space = std::move(found->second);
+      inactive_spaces_.erase(found);
+      InsertSpaceTabs(*space);
+    }
+  }
+  std::vector<tabs::TabHandle> closing;
+  for (auto* tab : *model) {
+    if (!std::ranges::contains(before, tab->GetHandle())) {
+      closing.push_back(tab->GetHandle());
+    }
+  }
+  for (const auto& handle : closing) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab || !model->IsTabClosable(tab)) {
+      continue;
+    }
+    const int index = model->GetIndexOfTab(tab);
+    if (index == TabStripModel::kNoTab) {
+      continue;
+    }
+    model->CloseWebContentsAt(index,
+                              TabCloseTypes::CLOSE_USER_GESTURE |
+                                  TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+  UpdateArchiveButtonState();
+  QueueSessionSync();
 }
 
