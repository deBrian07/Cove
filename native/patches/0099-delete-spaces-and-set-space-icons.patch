+bool IsValidCoveSpaceIcon(const std::u16string& icon) {
+  if (icon.size() > kCoveSpaceIconMaxLength) {
+    return false;
+  }
+  for (char16_t c : icon) {
+    if (base::IsUnicodeWhitespace(c)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+namespace {
+
+class CoveIconDialogDelegate final : public ui::DialogModelDelegate {
+ public:
+  explicit CoveIconDialogDelegate(
+      base::OnceCallback<void(std::u16string)> accept)
+      : accept_(std::move(accept)) {}
+  ~CoveIconDialogDelegate() override = default;
+
+  void Initialize() {
+    text_changed_subscription_ =
+        dialog_model()->GetTextfieldByUniqueId(kCoveIconField)
+            ->AddOnFieldChangedCallback(base::BindRepeating(
+                &CoveIconDialogDelegate::UpdateSaveEnabled,
+                base::Unretained(this)));
+    UpdateSaveEnabled();
+  }
+
+  bool Accept() {
+    std::u16string icon = TrimmedIcon();
+    if (!accept_ || !IsValidCoveSpaceIcon(icon)) {
+      return false;
+    }
+    auto accept = std::move(accept_);
+    std::move(accept).Run(std::move(icon));
+    return true;
+  }
+
+ private:
+  std::u16string TrimmedIcon() {
+    std::u16string icon;
+    base::TrimWhitespace(
+        dialog_model()->GetTextfieldByUniqueId(kCoveIconField)->text(),
+        base::TRIM_ALL, &icon);
+    return icon;
+  }
+
+  void UpdateSaveEnabled() {
+    dialog_model()->SetButtonEnabled(
+        dialog_model()->GetButtonByUniqueId(kCoveIconSaveButton),
+        IsValidCoveSpaceIcon(TrimmedIcon()));
+  }
+
+  base::OnceCallback<void(std::u16string)> accept_;
+  base::CallbackListSubscription text_changed_subscription_;
+};
+
+}  // namespace
+
+void ShowCoveIconDialog(views::View* anchor,
+                        std::u16string initial_icon,
