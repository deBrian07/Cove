+
+// Shows a browser-window-modal native editor. The initial name is focused and
+// selected. Acceptance supplies a trimmed, nonempty name; cancellation never
+// runs `accept`. Callers should bind a weak callback if its owner may disappear.
+// `anchor` is used only to find the browser parent and is not retained.
+void ShowCoveNameDialog(
+    views::View* anchor,
+    std::u16string title,
+    std::u16string initial_name,
+    base::OnceCallback<void(std::u16string)> accept);
