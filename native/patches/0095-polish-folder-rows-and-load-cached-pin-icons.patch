+void CoveSidebarLibraryView::LoadSavedPinFavicons() {
+  auto* service = FaviconServiceFactory::GetForProfile(
+      browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+      ->GetDict(kCoveSidebarPref), active_space_id_);
+  const auto* pins = space ? space->FindList("pins") : nullptr;
+  if (!service || !pins || row_pin_ids_.empty()) return;
+  std::map<std::string, base::WeakPtr<SidebarDragRow>> visible;
+  for (const auto& [row, id] : row_pin_ids_)
+    visible[id] = static_cast<SidebarDragRow*>(row)->GetWeakPtr();
+  std::map<std::string, size_t> occurrences;
+  for (const auto& value : *pins) {
+    const auto* pin = value.GetIfDict();
+    if (const auto* id = pin ? pin->FindString("id") : nullptr) ++occurrences[*id];
+  }
+  using Binding = std::tuple<size_t, std::string, base::WeakPtr<SidebarDragRow>>;
+  std::map<GURL, std::vector<Binding>> requests;
+  for (size_t index = 0; index < pins->size(); ++index) {
+    const auto* pin = (*pins)[index].GetIfDict();
+    const auto* id = pin ? pin->FindString("id") : nullptr;
+    const auto* home = pin ? pin->FindString("url") : nullptr;
+    if (!id || !home || occurrences[*id] != 1 || !visible.contains(*id)) continue;
+    const GURL url(*home);
+    if (url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile())
+      requests[url].emplace_back(index, *id, visible.at(*id));
+  }
+  // Only rendered rows request cached icons. Shared URLs use one cache read;
+  // each result touches its own live row, never the entire saved list.
+  for (auto& [url, bindings] : requests) {
+    service->GetFaviconImageForPageURL(url,
+        base::BindOnce([](base::WeakPtr<CoveSidebarLibraryView> library,
+                         GURL home, std::vector<Binding> rows,
+                         const favicon_base::FaviconImageResult& result) {
+          if (!library) return;
+          for (const auto& [index, id, row] : rows)
+            if (row) library->OnPinFaviconLoaded(index, id, home, row.get(), result);
+        }, weak_factory_.GetWeakPtr(), url, std::move(bindings)),
+        &pin_favicon_tasks_);
+  }
+}
+
+void CoveSidebarLibraryView::OnPinFaviconLoaded(
+    size_t pin_index, std::string pin_id, GURL home_url, views::LabelButton* row,
+    const favicon_base::FaviconImageResult& result) {
+  if (result.image.IsEmpty()) return;
+  const auto row_id = row_pin_ids_.find(row);
+  if (row_id == row_pin_ids_.end() || row_id->second != pin_id) return;
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+      ->GetDict(kCoveSidebarPref), active_space_id_);
+  const auto* pins = space ? space->FindList("pins") : nullptr;
+  if (!pins || pin_index >= pins->size()) return;
+  const auto* pin = (*pins)[pin_index].GetIfDict();
+  if (!pin || !pin->FindString("id") || *pin->FindString("id") != pin_id ||
+      !pin->FindString("url") || GURL(*pin->FindString("url")) != home_url) return;
+  cached_pin_icons_[pin_id] = ui::ImageModel::FromImage(result.image);
+  // The current live-page icon remains authoritative, including if it arrived
+  // while the saved-home cache read was in flight.
+  row->SetImageModel(views::Button::STATE_NORMAL, PinIconForId(pin_id));
 }
 
