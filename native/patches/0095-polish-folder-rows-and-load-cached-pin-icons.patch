+  EXPECT_TRUE(RowHasIconColor(row, SK_ColorBLUE));
+  // A queued result also cannot use a stale index belonging to another pin.
+  DeliverPinIcon(1, "p", new_home, row, SK_ColorGREEN);
+  EXPECT_TRUE(RowHasIconColor(row, SK_ColorBLUE));
+  EXPECT_EQ(new_home.spec(),
+      *SavedSpace().FindList("pins")->front().GetDict().FindString("url"));
+  EXPECT_EQ(1, model->count());
