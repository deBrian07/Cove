+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       LivePinFaviconWinsOverCachedSavedHomeIcon) {
+  // Data pages keep this test entirely local while exercising a real pin
+  // binding and navigation away from its saved home in the same WebContents.
+  const GURL home("data:text/html,<title>Pin home</title>");
+  const GURL away("data:text/html,<title>Live pin page</title>");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  auto* model = browser()->GetTabStripModel();
+  auto* contents = model->GetActiveWebContents();
+  Seed();
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kSidebarPref);
+    auto* space = FindSpace(*update, "personal");
+    ASSERT_TRUE(space);
+    space->FindList("pins")->front().GetDict().Set("url", home.spec());
+  }
+  model->SetTabPinned(model->active_index(), true);
+  const auto handle = model->GetActiveTab()->GetHandle();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), away));
+  ASSERT_EQ(contents, model->GetActiveWebContents());
+  ASSERT_TRUE(content::ExecJs(contents, "window.iconDraft='live pin draft'"));
+  const int history_count = contents->GetController().GetEntryCount();
+  Layout();
+  auto* row = PinRow("p");
+  ASSERT_TRUE(row);
+  auto* entry = contents->GetController().GetLastCommittedEntry();
+  ASSERT_TRUE(entry);
+  // ContentFaviconDriver reads the committed entry's favicon. A completed
+  // live-page result must outrank a later saved-home cache callback.
+  auto& favicon = entry->GetFavicon();
+  favicon.valid = true;
+  favicon.image = SolidPinIcon(SK_ColorGREEN);
+  library()->OnTabChangedAt(model->GetActiveTab(), TabChangeType::kAll);
+  EXPECT_TRUE(RowHasIconColor(row, SK_ColorGREEN));
+  DeliverPinIcon(0, "p", home, row, SK_ColorRED);
+  EXPECT_TRUE(RowHasIconColor(row, SK_ColorGREEN));
+  // If the live entry has no valid favicon, the same saved icon is available
+  // as the fallback without navigation or recreating the pinned page.
+  favicon.valid = false;
+  favicon.image = gfx::Image();
+  library()->OnTabChangedAt(model->GetActiveTab(), TabChangeType::kAll);
+  EXPECT_TRUE(RowHasIconColor(row, SK_ColorRED));
+  EXPECT_EQ(handle, model->GetActiveTab()->GetHandle());
+  EXPECT_TRUE(model->GetActiveTab()->IsPinned());
+  EXPECT_EQ(1, model->count());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_EQ(away, contents->GetLastCommittedURL());
+  EXPECT_EQ(history_count, contents->GetController().GetEntryCount());
+  EXPECT_EQ(2u, SavedSpace().FindList("pins")->size());
+  EXPECT_EQ(home.spec(),
+      *SavedSpace().FindList("pins")->front().GetDict().FindString("url"));
+  EXPECT_EQ("live pin draft", content::EvalJs(contents, "window.iconDraft"));
+}
