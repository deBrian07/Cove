+  const GURL new_home("https://replacement-pin.example/");
+  service->SetFavicons({old_home}, old_home.Resolve("favicon.ico"),
+      favicon_base::IconType::kFavicon, SolidPinIcon(SK_ColorRED));
+  service->SetFavicons({new_home}, new_home.Resolve("favicon.ico"),
+      favicon_base::IconType::kFavicon, SolidPinIcon(SK_ColorBLUE));
