+ui::ImageModel CoveSidebarLibraryView::PinIconForId(const std::string& pin_id) const {
+  ui::ImageModel icon = ui::ImageModel::FromVectorIcon(
+      vector_icons::kGlobeIcon, ui::kColorIcon, 16);
+  if (const auto cached = cached_pin_icons_.find(pin_id);
+      cached != cached_pin_icons_.end()) icon = cached->second;
+  if (const auto bound = bound_pin_handles_.find(pin_id);
+      bound != bound_pin_handles_.end()) {
+    auto* tab = bound->second.Get();
+    auto* driver = tab && tab->IsPinned() && tab->GetBrowserWindowInterface() == browser_
+        ? favicon::ContentFaviconDriver::FromWebContents(tab->GetContents()) : nullptr;
+    if (driver && driver->FaviconIsValid() && !driver->GetFavicon().IsEmpty())
+      icon = ui::ImageModel::FromImage(driver->GetFavicon());
+  }
+  return icon;
+}
