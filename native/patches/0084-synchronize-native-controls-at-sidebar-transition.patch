+class CoveCaptionButtonsBrowserTest : public InProcessBrowserTest {
+ protected:
+  void ExpectHidden(bool hidden) {
+    NSWindow* window = BrowserView::GetBrowserViewForBrowser(browser())
+                           ->GetWidget()
+                           ->GetNativeWindow()
+                           .GetNativeNSWindow();
+    ASSERT_TRUE(window);
+    for (NSWindowButton button :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      EXPECT_EQ(hidden,
+                static_cast<bool>([window standardWindowButton:button].hidden));
+    }
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(CoveCaptionButtonsBrowserTest,
+                       ControlsFollowShortcutBeforeAnimationCompletes) {
+  gfx::ScopedAnimationDurationScaleMode animations(
+      gfx::ScopedAnimationDurationScaleMode::NORMAL_DURATION);
+  auto* controller = tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(controller);
+  controller->RequestCollapse(false);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return controller->GetCollapseState() ==
+           tabs::VerticalTabStripCollapseState::kExpanded;
+  }));
+  ExpectHidden(false);
+  for (int i = 0; i < 3; ++i) {
+    // Exercise the same native command as Cmd+S. Do not run a layout or pump
+    // events before checking AppKit: the bug is the intermediate visible frame.
+    chrome::ToggleCollapseVerticalTabs(browser());
+    ExpectHidden(true);
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return controller->IsCollapsed(); }));
+    ExpectHidden(true);
+    chrome::ToggleCollapseVerticalTabs(browser());
+    ExpectHidden(false);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return controller->GetCollapseState() ==
+             tabs::VerticalTabStripCollapseState::kExpanded;
+    }));
+    ExpectHidden(false);
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(CoveCaptionButtonsBrowserTest,
+                       PaletteDismissalKeepsSidebarState) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* controller = tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(controller);
+  controller->RequestCollapse(false);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return controller->GetCollapseState() ==
+           tabs::VerticalTabStripCollapseState::kExpanded;
+  }));
+  for (const char* title : {"Project notes", "Calendar", "Documentation",
+                            "Research", "Design reference"}) {
+    auto* contents = chrome::AddAndReturnTabAt(
+        browser(),
+        GURL(std::string("data:text/html,<title>") + title + "</title>"), -1,
+        false);
+    ASSERT_TRUE(contents);
+    ASSERT_TRUE(content::WaitForLoadStop(contents));
+  }
+  auto* host = view->GetTabSearchBubbleHost();
+  ASSERT_TRUE(host);
+  host->ShowTabSearchBubble(true);
+  auto* palette = host->native_palette_widget_for_testing();
+  ASSERT_TRUE(palette);
+  ASSERT_TRUE(palette->IsVisible());
+
+  // Optional rendered artifact from this test's isolated browser, for visual
+  // inspection alongside the user's reference. Normal test runs write nothing.
+  const base::FilePath image =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          "cove-palette-snapshot");
+  if (!image.empty()) {
+    base::test::TestFuture<scoped_refptr<base::RefCountedMemory>> snapshot;
+    ui::GrabWindowSnapshotAsPNG(
+        palette->GetNativeWindow(),
+        gfx::Rect(palette->GetWindowBoundsInScreen().size()),
+        snapshot.GetCallback());
+    auto data = snapshot.Take();
+    ASSERT_TRUE(data);
+    ASSERT_FALSE(base::span(*data).empty());
+    ASSERT_TRUE(base::WriteFile(image, base::span(*data)));
+  }
+
+  chrome::ToggleCollapseVerticalTabs(browser());
+  EXPECT_FALSE(palette->IsVisible());
+  EXPECT_EQ(tabs::VerticalTabStripCollapseState::kExpanded,
+            controller->GetCollapseState());
+  ExpectHidden(false);
+}
