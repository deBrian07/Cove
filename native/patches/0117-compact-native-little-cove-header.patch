+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       CompactHeaderSharesNativeCaptionRowAtDifferentWidths) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* popup = OpenCoveTemporaryWindow(
+      browser()->GetProfile(), embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  ASSERT_TRUE(content::WaitForLoadStop(
+      popup->GetTabStripModel()->GetActiveWebContents()));
+  auto* view = BrowserView::GetBrowserViewForBrowser(popup);
+  auto* widget = view->GetWidget();
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  ASSERT_TRUE(window);
+  EXPECT_TRUE(window.styleMask & NSWindowStyleMaskFullSizeContentView);
+  EXPECT_EQ(NSWindowTitleHidden, window.titleVisibility);
+  EXPECT_TRUE(IsCoveTemporaryWindow(popup));
+  EXPECT_FALSE(IsCoveTemporaryWindow(browser()));
+  for (int width : {420, 720, 1100}) {
+    widget->SetBounds(gfx::Rect(100, 100, width, 600));
+    widget->LayoutRootViewIfNecessary();
+    const auto bounds = view->toolbar()->GetBoundsInScreen();
+    const auto root = widget->GetRootView()->GetBoundsInScreen();
+    EXPECT_LE(bounds.y() - root.y(), 4);
+    EXPECT_GE(bounds.x() - root.x(), 74);
+    auto* action =
+        view->toolbar()->GetViewByElementId(kCoveTemporaryPromoteElementId);
+    ASSERT_TRUE(action);
+    EXPECT_TRUE(action->IsDrawn());
+    EXPECT_TRUE(bounds.Contains(action->GetBoundsInScreen()));
+    auto* address = view->toolbar()->location_bar_view();
+    ASSERT_TRUE(address);
+    EXPECT_GE(address->width(), 40);
+    EXPECT_TRUE(bounds.Contains(address->GetBoundsInScreen()));
+  }
+  widget->SetBounds(gfx::Rect(100, 100, 720, 600));
+  widget->LayoutRootViewIfNecessary();
+  CaptureTemporaryWindowIfRequested(widget, "cove-compact-header-snapshot");
+  BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_POPUP,
+                                   *browser()->GetProfile(), true);
+  auto* ordinary = CreateBrowserWindow(std::move(params));
+  chrome::AddTabAt(ordinary, embedded_test_server()->GetURL("/title2.html"), -1,
+                   true);
+  EXPECT_FALSE(IsCoveTemporaryWindow(ordinary));
+  EXPECT_FALSE(ActivateCoveTemporaryDestination(ordinary));
+  NSWindow* plain_window = BrowserView::GetBrowserViewForBrowser(ordinary)
+                               ->GetWidget()
+                               ->GetNativeWindow()
+                               .GetNativeNSWindow();
+  EXPECT_FALSE(plain_window.styleMask & NSWindowStyleMaskFullSizeContentView);
+}
