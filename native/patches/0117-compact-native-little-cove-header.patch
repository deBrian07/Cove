+    return browser()->GetTabStripModel()->GetActiveWebContents() == page;
+  }));
+  auto* bridge =
+      CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  EXPECT_EQ("work", bridge->GetActiveSpaceId());
+  EXPECT_EQ("preserved", content::EvalJs(page, "window.mouseDraft"));
+}
