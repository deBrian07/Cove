 namespace {
+struct TemporarySpacePalette {
+  SkColor surface = SkColorSetRGB(0x12, 0x1b, 0x30);
+  SkColor selected = SkColorSetRGB(0x26, 0x3a, 0x51);
+  SkColor text = SK_ColorWHITE;
+  SkColor secondary = SkColorSetRGB(0xb0, 0xbb, 0xcc);
+};
+TemporarySpacePalette SpacePalette(Profile* profile, const std::string& id) {
+  TemporarySpacePalette palette;
+  const auto* spaces =
+      profile->GetPrefs()->GetDict("cove.sidebar").FindList("spaces");
+  if (spaces)
+    for (const auto& value : *spaces) {
+      const auto* space = value.GetIfDict();
+      if (!space || !space->FindString("id") || *space->FindString("id") != id)
+        continue;
+      if (const auto* theme = space->FindDict("theme")) {
+        auto read = [&](const char* key, SkColor* output) {
+          const auto* color = theme->FindString(key);
+          uint32_t rgb = 0;
+          if (color && color->size() == 7 && color->front() == '#' &&
+              base::HexStringToUInt(color->substr(1), &rgb))
+            *output = SK_ColorBLACK | rgb;
+        };
+        read("sidebar", &palette.surface);
+        read("highlight", &palette.selected);
+      }
+      break;
+    }
+  palette.text = color_utils::GetColorWithMaxContrast(palette.surface);
+  palette.secondary =
+      color_utils::AlphaBlend(palette.text, palette.surface, 0.68f);
+  // Custom themes can choose arbitrary highlight colors. Selection text must
+  // stay legible independently of the panel surface.
+  return palette;
+}
