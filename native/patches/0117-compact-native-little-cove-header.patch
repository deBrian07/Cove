+// Cove's temporary windows share one native row for traffic lights and page
+// controls. Ordinary website popups retain their system titlebar.
+void ConfigureCoveTemporaryWindowFrame(BrowserWindowInterface* browser) {
+  if (!IsCoveTemporaryWindow(browser))
+    return;
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser);
+  NSWindow* window = view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  if (!window)
+    return;
+  const NSRect frame = window.frame;
+  window.styleMask |= NSWindowStyleMaskFullSizeContentView;
+  window.titlebarAppearsTransparent = YES;
+  window.titleVisibility = NSWindowTitleHidden;
+  const SkColor surface =
+      view->GetColorProvider()->GetColor(kColorLocationBarBackground);
+  window.appearance = [NSAppearance
+      appearanceNamed:color_utils::IsDark(surface) ? NSAppearanceNameDarkAqua
+                                                   : NSAppearanceNameAqua];
+  [window setFrame:frame display:YES];
+  view->GetWidget()->GetRootView()->InvalidateLayout();
+  view->GetWidget()->LayoutRootViewIfNecessary();
+}
