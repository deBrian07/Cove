+                      ->toolbar()
+                      ->GetViewByElementId(kCoveTemporaryPromoteElementId);
+  auto* controls =
+      views::AsViewClass<TemporarySpaceControls>(primary->parent());
+  return controls && controls->ActivatePrimary();
+}
 
