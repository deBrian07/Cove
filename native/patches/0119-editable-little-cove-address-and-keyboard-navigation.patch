+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* popup = OpenCoveTemporaryWindow(
+      browser()->GetProfile(), embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  ASSERT_TRUE(content::ExecJs(page, "window.keyboardChooserDraft='preserved'"));
+  popup->GetWindow()->Activate();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return BrowserView::GetBrowserViewForBrowser(popup)->GetWidget()->IsActive();
+  }));
+  page->Focus();
+  views::NamedWidgetShownWaiter shown(views::test::AnyWidgetTestPasskey{},
+                                     "CoveTemporarySpaceChooser");
+  base::test::TestFuture<void> shortcut_sent;
+  ASSERT_TRUE(ui_controls::SendKeyPressNotifyWhenDone(
+      popup->GetWindow()->GetNativeWindow(), ui::VKEY_O, false, true, false,
+      true, shortcut_sent.GetCallback(), ui_controls::kKeyPress));
+  auto* picker = shown.WaitIfNeededAndGet();
+  ASSERT_TRUE(picker);
+  ASSERT_TRUE(base::test::RunUntil([&] { return picker->IsActive(); }));
+  auto picker_weak = picker->GetWeakPtr();
+  TraceNativeInput("chooser-before-escape", picker);
+  TraceNativeInput("chooser-source-before-escape",
+                   BrowserView::GetBrowserViewForBrowser(popup)->GetWidget());
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+  base::test::TestFuture<void> escaped;
+  ASSERT_TRUE(ui_controls::SendKeyPressNotifyWhenDone(
+      picker->GetNativeWindow(), ui::VKEY_ESCAPE, false, false, false, false,
+      escaped.GetCallback()));
+  NSLog(@"CoveNativeInput chooser-after-escape alive=%d closed=%d",
+        !!picker_weak, picker_weak ? picker_weak->IsClosed() : true);
+  TraceNativeInput("chooser-source-after-escape",
+                   BrowserView::GetBrowserViewForBrowser(popup)->GetWidget());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return BrowserView::GetBrowserViewForBrowser(popup)->GetWidget()->IsActive();
+  }));
+  EXPECT_EQ("preserved", content::EvalJs(page, "window.keyboardChooserDraft"));
+}
