+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowNativeInputBrowserTest,
+                       EditableAddressKeepsNavigationInTheTemporaryPage) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const auto first = embedded_test_server()->GetURL("/title1.html");
+  const auto second = embedded_test_server()->GetURL("/title2.html");
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(), first);
+  ASSERT_TRUE(popup);
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  const auto windows = GlobalBrowserCollection::GetInstance()->GetSize();
+  const int history = page->GetController().GetEntryCount();
+  auto* view = BrowserView::GetBrowserViewForBrowser(popup);
+  auto* omnibox = view->toolbar()->location_bar_view()->omnibox_view();
+  ASSERT_TRUE(IsCoveTemporaryWindow(popup));
+  ASSERT_TRUE(view->IsToolbarVisible());
+  ASSERT_TRUE(view->IsLocationBarVisible());
+  ASSERT_FALSE(omnibox->GetReadOnly());
+  EXPECT_TRUE(chrome::BrowserCommandController::From(popup)
+                  ->IsCommandEnabled(IDC_OPEN_CURRENT_URL));
+  popup->GetWindow()->Activate();
+  ASSERT_TRUE(base::test::RunUntil([&] { return view->GetWidget()->IsActive(); }));
+  view->GetWidget()->LayoutRootViewIfNecessary();
+  EXPECT_EQ(views::View::FocusBehavior::ALWAYS, omnibox->GetFocusBehavior());
+  ASSERT_TRUE(omnibox->GetEnabledInViewsSubtree());
+  ASSERT_TRUE(omnibox->IsDrawn());
+  ASSERT_FALSE(omnibox->GetBoundsInScreen().IsEmpty());
+  ASSERT_TRUE(omnibox->IsFocusable());
+  page->Focus();
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_L, true));
+  ASSERT_TRUE(base::test::RunUntil([&] { return omnibox->HasFocus(); }));
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_ESCAPE));
+  page->Focus();
+  ASSERT_TRUE(base::test::RunUntil([&] { return !omnibox->HasFocus(); }));
+  const auto address_point = omnibox->GetBoundsInScreen().CenterPoint();
+  auto* root = view->GetWidget()->GetRootView();
+  const auto root_point = views::View::ConvertPointFromScreen(root, address_point);
+  auto* handler = root->GetEventHandlerForPoint(root_point);
+  ASSERT_TRUE(handler);
+  EXPECT_TRUE(handler == omnibox || handler == view->toolbar()->location_bar_view())
+      << "Mouse handler: " << handler->GetClassName();
+  EXPECT_EQ(HTCLIENT, view->GetWidget()->non_client_view()->NonClientHitTest(root_point));
+  base::test::TestFuture<void> moved;
+  ASSERT_TRUE(ui_controls::SendMouseMoveNotifyWhenDone(
+      address_point.x(), address_point.y(), moved.GetCallback(),
+      view->GetWidget()->GetNativeWindow()));
+  ASSERT_TRUE(moved.Wait());
+  base::test::TestFuture<void> clicked;
+  ASSERT_TRUE(ui_controls::SendMouseEventsNotifyWhenDone(
+      ui_controls::LEFT, ui_controls::DOWN | ui_controls::UP,
+      clicked.GetCallback(), ui_controls::kNoAccelerator,
+      view->GetWidget()->GetNativeWindow()));
+  ASSERT_TRUE(clicked.Wait());
+  ASSERT_TRUE(base::test::RunUntil([&] { return omnibox->HasFocus(); }));
+  page->Focus();
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_L, true));
+  ASSERT_TRUE(base::test::RunUntil([&] { return omnibox->HasFocus(); }));
+  TraceNativeInput("address-before-edit", view->GetWidget(), omnibox);
+  omnibox->SetUserText(u"discard this edit");
+  TraceNativeInput("address-before-escape", view->GetWidget(), omnibox);
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_ESCAPE));
+  TraceNativeInput("address-after-first-escape", view->GetWidget(), omnibox);
+  EXPECT_EQ(first, page->GetVisibleURL());
+  EXPECT_EQ(history, page->GetController().GetEntryCount());
+  // Chromium closes autocomplete first; a second Escape reverts the edit.
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_ESCAPE));
+  TraceNativeInput("address-after-second-escape", view->GetWidget(), omnibox);
+  EXPECT_NE(u"discard this edit", omnibox->GetText());
+
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_L, true));
+  ASSERT_TRUE(base::test::RunUntil([&] { return omnibox->HasFocus(); }));
+  omnibox->SetUserText(base::UTF8ToUTF16(second.spec()));
+  TraceNativeInput("address-before-enter", view->GetWidget(), omnibox);
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_RETURN));
+  TraceNativeInput("address-after-enter", view->GetWidget(), omnibox);
+  ASSERT_TRUE(base::test::RunUntil([&] { return page->GetVisibleURL() == second; }));
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(1, popup->GetTabStripModel()->count());
+  EXPECT_EQ(windows, GlobalBrowserCollection::GetInstance()->GetSize());
+  EXPECT_EQ(history + 1, page->GetController().GetEntryCount());
+
+  page->Focus();
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_OEM_4, true));
+  ASSERT_TRUE(base::test::RunUntil([&] { return page->GetVisibleURL() == first; }));
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  ASSERT_NO_FATAL_FAILURE(SendKey(popup, ui::VKEY_OEM_6, true));
+  ASSERT_TRUE(base::test::RunUntil([&] { return page->GetVisibleURL() == second; }));
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(windows, GlobalBrowserCollection::GetInstance()->GetSize());
+
+  BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_POPUP,
+                                   *browser()->GetProfile(), true);
+  auto* ordinary = CreateBrowserWindow(std::move(params));
+  chrome::AddTabAt(ordinary, first, -1, true);
+  EXPECT_TRUE(BrowserView::GetBrowserViewForBrowser(ordinary)->toolbar()
+                  ->location_bar_view()->omnibox_view()->GetReadOnly());
+}
