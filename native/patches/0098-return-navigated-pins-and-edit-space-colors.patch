+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       SpaceThemesKeepSeparateSidebarAccentAndHighlight) {
+  Seed();
+  const SkColor before = library()->ActiveSidebarColorForTesting();
+  library()->SetSpacePaletteForTesting("personal", 2);
+  Layout();
+  const SkColor grove = library()->ActiveSidebarColorForTesting();
+  EXPECT_NE(before, grove);
+  const auto* theme = SavedSpace().FindDict("theme");
+  ASSERT_TRUE(theme);
+  const auto* sidebar = theme->FindString("sidebar");
+  const auto* accent = theme->FindString("accent");
+  const auto* highlight = theme->FindString("highlight");
+  ASSERT_TRUE(sidebar);
+  ASSERT_TRUE(accent);
+  ASSERT_TRUE(highlight);
+  EXPECT_NE(*sidebar, *accent);
+  EXPECT_NE(*accent, *highlight);
+  EXPECT_NE(*sidebar, *highlight);
+  library()->SetSpacePaletteForTesting("personal", 3);
+  Layout();
+  EXPECT_NE(grove, library()->ActiveSidebarColorForTesting());
+  const auto* next = SavedSpace().FindDict("theme")->FindString("sidebar");
+  ASSERT_TRUE(next);
+  EXPECT_NE(*next, *sidebar);
+  library()->CommitSpaceThemeForTesting("personal", u"#112233", u"#445566",
