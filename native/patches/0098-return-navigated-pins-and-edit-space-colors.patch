+bool CoveHexColor(std::u16string text, std::u16string* normalized) {
+  base::TrimWhitespace(text, base::TRIM_ALL, &text);
+  std::string hex = base::UTF16ToUTF8(text);
+  if (!hex.empty() && hex.front() == '#') {
+    hex.erase(hex.begin());
+  }
+  uint32_t rgb = 0;
+  if (hex.size() != 6 || !base::HexStringToUInt(hex, &rgb)) {
+    return false;
+  }
+  *normalized = u"#" + base::UTF8ToUTF16(hex);
+  return true;
+}
+
+class CoveThemeDialogDelegate final : public ui::DialogModelDelegate {
+ public:
+  explicit CoveThemeDialogDelegate(
+      base::OnceCallback<void(std::u16string, std::u16string, std::u16string)>
+          accept)
+      : accept_(std::move(accept)) {}
+  ~CoveThemeDialogDelegate() override = default;
+
+  void Initialize() { UpdateSaveEnabled(); }
+
+  bool Accept() {
+    std::u16string sidebar;
+    std::u16string accent;
+    std::u16string highlight;
+    if (!accept_ || !ReadColors(&sidebar, &accent, &highlight)) {
+      return false;
+    }
+    auto accept = std::move(accept_);
+    std::move(accept).Run(std::move(sidebar), std::move(accent),
+                          std::move(highlight));
+    return true;
+  }
+
+ private:
+  bool ReadColors(std::u16string* sidebar, std::u16string* accent,
+                  std::u16string* highlight) {
+    return CoveHexColor(Field(kCoveThemeSidebarField), sidebar) &&
+           CoveHexColor(Field(kCoveThemeAccentField), accent) &&
+           CoveHexColor(Field(kCoveThemeHighlightField), highlight);
+  }
+
+  std::u16string Field(ui::ElementIdentifier id) {
+    return dialog_model()->GetTextfieldByUniqueId(id)->text();
+  }
+
+  void UpdateSaveEnabled() {
+    std::u16string sidebar;
+    std::u16string accent;
+    std::u16string highlight;
+    dialog_model()->SetButtonEnabled(
+        dialog_model()->GetButtonByUniqueId(kCoveThemeSaveButton),
+        ReadColors(&sidebar, &accent, &highlight));
+  }
+
+  base::OnceCallback<void(std::u16string, std::u16string, std::u16string)>
+      accept_;
+};
+
+void ShowCoveThemeDialog(
+    views::View* anchor,
+    std::u16string sidebar,
+    std::u16string accent,
+    std::u16string highlight,
+    base::OnceCallback<void(std::u16string, std::u16string, std::u16string)>
+        accept) {
+  if (!anchor || !anchor->GetWidget() || !accept) {
+    return;
+  }
+  views::Widget* parent = anchor->GetWidget()->GetPrimaryWindowWidget();
+  if (!parent || !parent->GetNativeWindow()) {
+    return;
+  }
+  auto delegate = std::make_unique<CoveThemeDialogDelegate>(std::move(accept));
+  auto* const delegate_ptr = delegate.get();
+  auto model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetInternalName("CoveThemeDialog")
+          .SetTitle(u"Edit theme colors")
+          .SetAccessibleTitle(u"Edit theme colors")
+          .AddParagraph(ui::DialogModelLabel(u"Sidebar, accent, and highlight are separate colors. Use a 6-digit hex value for each."))
+          .AddTextfield(kCoveThemeSidebarField, u"Sidebar", std::move(sidebar))
+          .AddTextfield(kCoveThemeAccentField, u"Accent", std::move(accent))
+          .AddTextfield(kCoveThemeHighlightField, u"Highlight",
+                        std::move(highlight))
+          .SetInitiallyFocusedField(kCoveThemeSidebarField)
+          .AddOkButton(
+              base::BindRepeating(&CoveThemeDialogDelegate::Accept,
+                                  base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params()
+                  .SetId(kCoveThemeSaveButton)
+                  .SetLabel(l10n_util::GetStringUTF16(IDS_SAVE)))
+          .AddCancelButton(base::DoNothing())
+          .Build();
+  delegate_ptr->Initialize();
+  constrained_window::ShowBrowserModal(std::move(model),
+                                      parent->GetNativeWindow());
+}
