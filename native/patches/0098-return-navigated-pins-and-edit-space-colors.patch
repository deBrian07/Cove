+  EXPECT_EQ("still here", content::EvalJs(contents, "window.pinDraft"));
+  EXPECT_EQ(away, contents->GetVisibleURL());
+  Layout();
+  auto* control = ReturnControl(PinRow("p"));
+  ASSERT_TRUE(control);
+  ASSERT_FALSE(control->GetLocalBounds().IsEmpty());
+  const gfx::PointF inside(control->GetLocalBounds().CenterPoint());
+  ui::MouseEvent press(ui::EventType::kMousePressed, inside, inside,
+                       base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+                       ui::EF_LEFT_MOUSE_BUTTON);
+  ui::MouseEvent release(ui::EventType::kMouseReleased, inside, inside,
+                         base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+                         ui::EF_LEFT_MOUSE_BUTTON);
+  control->OnMousePressed(press);
+  control->OnMouseReleased(release);
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_EQ(home, contents->GetLastCommittedURL());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_EQ(handle, model->GetActiveTab()->GetHandle());
+  EXPECT_TRUE(model->GetActiveTab()->IsPinned());
+  EXPECT_EQ(1, model->count());
