+  Layout();
+  EXPECT_EQ(SkColorSetRGB(0x11, 0x22, 0x33),
+            library()->ActiveSidebarColorForTesting());
+  const auto* custom = SavedSpace().FindDict("theme");
+  ASSERT_TRUE(custom);
+  EXPECT_EQ("#112233", *custom->FindString("sidebar"));
+  EXPECT_EQ("#445566", *custom->FindString("accent"));
+  EXPECT_EQ("#778899", *custom->FindString("highlight"));
+}
