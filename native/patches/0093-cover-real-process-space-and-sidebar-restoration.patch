+IN_PROC_BROWSER_TEST_F(CoveSessionRestartBrowserTest,
+                       RestartKeepsParkedHistoryPinHomeAndFolderOrder) {
+  if (SessionRestore::IsRestoring(browser()->GetProfile())) {
+    SessionRestoreTestHelper restore_observer;
+    restore_observer.Wait();
+  }
+  base::RunLoop().RunUntilIdle();
+  auto snapshot = Library(browser())->GetSessionSnapshot();
+  ASSERT_TRUE(snapshot);
+  LOG(INFO) << "Restart fixture: windows=" << GlobalBrowserCollection::GetInstance()->GetSize()
+             << " active=" << snapshot->active_space
+             << " snapshot_tabs=" << snapshot->tabs.size()
+             << " attached=" << browser()->GetTabStripModel()->count();
+  for (const auto& entry : snapshot->tabs) {
+    auto* contents = entry.tab->GetContents();
+    const auto* owner = GetCoveTabSessionState(contents);
+    LOG(INFO) << "Restart fixture page: url=" << contents->GetVisibleURL()
+               << " owner=" << (owner ? owner->space : "missing")
+               << " entries=" << contents->GetController().GetEntryCount();
+  }
+  ASSERT_EQ("work", snapshot->active_space);
+  ASSERT_EQ(3u, snapshot->tabs.size());
+  const auto root = browser()->GetProfile()->GetPrefs()->GetDict("cove.sidebar").Clone();
+  const auto* expected = root.FindDict("restart_test_expected");
+  ASSERT_TRUE(expected);
+  ASSERT_TRUE(expected->FindInt("process"));
+  EXPECT_NE(*expected->FindInt("process"), static_cast<int>(base::GetCurrentProcId()));
+  ASSERT_TRUE(root.FindList("favorites"));
+  EXPECT_EQ(*expected->FindList("favorites"), *root.FindList("favorites"));
+  auto* model = browser()->GetTabStripModel();
+  ASSERT_EQ(1, model->count());
+  ASSERT_NO_FATAL_FAILURE(ExpectHistory(model->GetActiveWebContents(),
+                                        *expected->FindDict("work_history")));
+  Switch("personal");
+  ASSERT_EQ(2, model->count());
+  ASSERT_TRUE(model->GetTabAtIndex(0)->IsPinned());
+  EXPECT_EQ("restart-personal-selected", model->GetActiveWebContents()->GetVisibleURL().ref());
+  ASSERT_NO_FATAL_FAILURE(ExpectHistory(model->GetWebContentsAt(0),
+                                        *expected->FindDict("pin_history")));
+  ASSERT_NO_FATAL_FAILURE(ExpectHistory(model->GetWebContentsAt(1),
+                                        *expected->FindDict("personal_history")));
+  const base::DictValue* personal = nullptr;
+  for (const auto& value : *root.FindList("spaces"))
+    if (*value.GetDict().FindString("id") == "personal") personal = &value.GetDict();
+  ASSERT_TRUE(personal);
+  ASSERT_TRUE(personal->FindList("sidebar_order"));
+  EXPECT_EQ(*expected->FindList("order"), *personal->FindList("sidebar_order"));
+  const auto* pins = personal->FindList("pins");
+  ASSERT_TRUE(pins);
+  ASSERT_EQ(1u, pins->size());
+  const auto& pin = pins->front().GetDict();
+  EXPECT_EQ(*expected->FindString("pin_id"), *pin.FindString("id"));
+  EXPECT_EQ(*expected->FindString("home"), *pin.FindString("url"));
+  EXPECT_EQ("restart-child", *pin.FindString("folder"));
+  ASSERT_EQ(3u, personal->FindList("folders")->size());
+  EXPECT_EQ(true, personal->FindList("folders")->front().GetDict().FindBool("collapsed"));
+  Switch("work");
+  ASSERT_EQ(1, model->count());
+  ASSERT_NO_FATAL_FAILURE(ExpectHistory(model->GetActiveWebContents(),
+                                        *expected->FindDict("work_history")));
+}
