+IN_PROC_BROWSER_TEST_F(CoveSettingsBrowserTest,
+                       ExternalLinksFollowTheNativeLittleCoveSetting) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_TRUE(prefs->GetBoolean("cove.external_links_in_temporary_windows"));
+  auto* settings = ShowCoveSettings(browser());
+  auto* links = SettingsButton(settings->GetContentsView(), u"Links");
+  ASSERT_TRUE(links);
+  views::test::ButtonTestApi(links).NotifyDefaultMouseClick();
+  auto* toggle = SettingsToggle(settings->GetContentsView(),
+                               u"Open links from other apps in Little Cove");
+  ASSERT_TRUE(toggle);
+  views::test::ButtonTestApi(toggle).NotifyDefaultMouseClick();
+  EXPECT_FALSE(prefs->GetBoolean("cove.external_links_in_temporary_windows"));
+  settings->CloseNow();
+  const int count = browser()->GetTabStripModel()->count();
+  const GURL first = embedded_test_server()->GetURL("/title1.html");
+  id<NSApplicationDelegate> app = NSApp.delegate;
+  ASSERT_TRUE([app respondsToSelector:@selector(application:openURLs:)]);
+  [app application:NSApp openURLs:@[[NSURL URLWithString:
+      [NSString stringWithUTF8String:first.spec().c_str()]]]];
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    auto* page = browser()->GetTabStripModel()->GetActiveWebContents();
+    return browser()->GetTabStripModel()->count() == count + 1 &&
+           page && page->GetVisibleURL() == first;
+  }));
+  auto* reopened = ShowCoveSettings(browser());
+  links = SettingsButton(reopened->GetContentsView(), u"Links");
+  ASSERT_TRUE(links);
+  views::test::ButtonTestApi(links).NotifyDefaultMouseClick();
+  toggle = SettingsToggle(reopened->GetContentsView(),
+                          u"Open links from other apps in Little Cove");
+  ASSERT_TRUE(toggle);
+  EXPECT_FALSE(toggle->GetIsOn());
+  views::test::ButtonTestApi(toggle).NotifyDefaultMouseClick();
+  reopened->CloseNow();
+  const GURL second = embedded_test_server()->GetURL("/title2.html");
+  [app application:NSApp openURLs:@[[NSURL URLWithString:
+      [NSString stringWithUTF8String:second.spec().c_str()]]]];
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    bool found = false;
+    GlobalBrowserCollection::GetInstance()->ForEach([&](BrowserWindowInterface* window) {
+      auto* page = window->GetTabStripModel()->GetActiveWebContents();
+      if (window->GetType() == BrowserWindowInterface::TYPE_POPUP &&
+          window->GetProfile() == browser()->GetProfile() && page &&
+          page->GetVisibleURL() == second) found = true;
+      return true;
+    });
+    return found;
+  }));
+  EXPECT_EQ(count + 1, browser()->GetTabStripModel()->count());
+}
