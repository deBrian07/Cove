+// Profile selection and policy checks have completed before external URLs arrive.
+void OpenCoveExternalTabs(StartupTabs external, Profile* profile) {
+  if (!profile) return;
+  BrowserWindowInterface* main = nullptr;
+  for (const auto& tab : external) {
+    if (profile->GetPrefs()->GetBoolean("cove.external_links_in_temporary_windows")) {
+      OpenCoveTemporaryWindow(profile, tab.url);
+    } else {
+      if (!main) {
+        main = ProfileBrowserCollection::GetForProfile(profile)->FindTabbedBrowser(false);
+        if (!main) main = CreateBrowser(profile);
+      }
+      chrome::AddTabAt(main, tab.url, -1, true);
+      main->GetWindow()->Show();
+    }
+  }
+}
