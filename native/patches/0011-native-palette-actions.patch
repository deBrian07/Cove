+void TabSearchPageHandler::ExecuteAction(const std::string& action) {
+  if (!browser_ || browser_->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  // The renderer chooses an action name, never an arbitrary browser command ID.
+  int command;
+  if (action == "pin-tab" || action == "unpin-tab") {
+    auto* const model = browser_->GetTabStripModel();
+    auto* const active_tab = model ? model->GetActiveTab() : nullptr;
+    if (!active_tab || active_tab->IsPinned() == (action == "pin-tab")) {
+      return;
+    }
+    command = IDC_WINDOW_PIN_TAB;
+  } else if (action == "toggle-sidebar") {
+    command = IDC_TOGGLE_VERTICAL_TABS_COLLAPSE;
+  } else if (action == "add-split") {
+    command = IDC_NEW_SPLIT_TAB;
+  } else if (action == "remove-split") {
+    command = IDC_COVE_REMOVE_SPLIT;
+  } else if (action == "focus-left") {
+    command = IDC_COVE_FOCUS_SPLIT_LEFT;
+  } else if (action == "focus-right") {
+    command = IDC_COVE_FOCUS_SPLIT_RIGHT;
+  } else if (action == "duplicate-tab") {
+    command = IDC_DUPLICATE_TAB;
+  } else if (action == "reopen-tab") {
+    command = IDC_RESTORE_TAB;
+  } else if (action == "copy-url") {
+    command = IDC_COPY_URL;
+  } else {
+    return;
+  }
+  if (!chrome::IsCommandEnabled(browser_, command)) {
+    return;
+  }
+  // A command can activate another tab and destroy this WebUI. Keep only a
+  // weak embedder and browser pointer on the stack across dispatch.
+  auto embedder = webui_controller_->embedder();
+  auto browser = browser_->GetWeakPtr();
+  if (embedder) {
+    embedder->CloseUI();
+  }
+  if (browser) {
+    chrome::ExecuteCommand(browser.get(), command);
+  }
+}
