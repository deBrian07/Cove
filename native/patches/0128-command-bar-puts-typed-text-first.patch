+
+// Like Arc, the typed text is always the first result; commands follow it,
+// and only "/" lists commands alone.
+IN_PROC_BROWSER_TEST_F(CoveCaptionButtonsBrowserTest,
+                       CommandBarPutsTypedTextFirst) {
+  auto* host =
+      BrowserView::GetBrowserViewForBrowser(browser())->GetTabSearchBubbleHost();
+  host->ShowTabSearchBubble(true);
+  auto* palette = host->native_palette_widget_for_testing();
+  ASSERT_TRUE(palette);
+  auto* bar = views::AsViewClass<CoveCommandBarView>(
+      palette->widget_delegate()->GetContentsView());
+  ASSERT_TRUE(bar);
+  const auto type = [&](const std::u16string& text) {
+    bar->search_field_for_testing()->SetText(text);
+    bar->ContentsChanged(bar->search_field_for_testing(), text);
+  };
+  type(u"c");
+  ASSERT_LT(0u, bar->row_count_for_testing());
+  EXPECT_EQ(u"Search ↩", bar->row_action_for_testing(0));
+  type(u"work");
+  ASSERT_LT(1u, bar->row_count_for_testing());
+  EXPECT_EQ(u"Search ↩", bar->row_action_for_testing(0));
+  EXPECT_EQ(u"Switch ↩", bar->row_action_for_testing(1));
+  type(u"/copy");
+  ASSERT_LT(0u, bar->row_count_for_testing());
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    EXPECT_NE(u"Search ↩", bar->row_action_for_testing(i));
+  }
+}
