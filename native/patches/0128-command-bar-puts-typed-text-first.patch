+// True when every word of |query| starts some word of |text| (ASCII case-
+// insensitive), e.g. "co ur" matches "Copy Current URL" but "c" does not
+// match "Focus".
+bool MatchesWordPrefixes(const std::u16string& text,
+                         const std::u16string& query) {
+  const std::u16string lower_text = base::ToLowerASCII(text);
+  const std::u16string lower_query = base::ToLowerASCII(query);
+  const auto words = base::SplitString(lower_text, u" ", base::TRIM_WHITESPACE,
+                                       base::SPLIT_WANT_NONEMPTY);
+  const auto terms = base::SplitString(lower_query, u" ", base::TRIM_WHITESPACE,
+                                       base::SPLIT_WANT_NONEMPTY);
+  if (terms.empty()) {
+    return false;
+  }
+  for (const auto& term : terms) {
+    if (std::ranges::none_of(words, [&](const std::u16string& word) {
+          return word.starts_with(term);
+        })) {
+      return false;
+    }
+  }
+  return true;
+}
