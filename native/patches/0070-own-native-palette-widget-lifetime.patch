+IN_PROC_BROWSER_TEST_F(CoveNativeCommandBarBrowserTest,
+                       ClosedPaletteDetachesBeforeThemeChange) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* host = view->GetTabSearchBubbleHost();
+  ASSERT_TRUE(host->ShowTabSearchBubble());
+  ASSERT_TRUE(host->DismissIfOpen());
+  view->GetWidget()->ThemeChanged();
+  auto* widget = host->native_palette_widget_for_testing();
+  ASSERT_TRUE(widget);
+  widget->Close();
+  EXPECT_EQ(nullptr, host->native_palette_widget_for_testing());
+  // Previously a leaked delegate still observed this window's theme and
+  // called ThemeChanged() on its now-null Widget.
+  view->GetWidget()->ThemeChanged();
+  ASSERT_TRUE(host->ShowTabSearchBubble());
+  EXPECT_TRUE(host->native_palette_widget_for_testing()->IsVisible());
+}
