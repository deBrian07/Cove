+
+void TabSearchBubbleHost::ResetNativePalette() {
+  if (native_palette_open_) {
+    native_palette_open_ = false;
+    for (auto& observer : observers_) {
+      observer.OnBubbleDestroying();
+    }
+  }
+  bubble_widget_observation_.Reset();
+  auto widget = std::move(native_palette_widget_);
+  auto delegate = std::move(native_palette_delegate_);
+  if (delegate) {
+    delegate->SetAnchorView(nullptr);
+  }
+  // CLIENT_OWNS_WIDGET: destroy the widget before its delegate and unlink
+  // the anchor observer before either can receive another theme update.
+  widget.reset();
 }
 
