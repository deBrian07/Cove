+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_COVE_COVE_TEMPORARY_WINDOW_H_
+#define CHROME_BROWSER_UI_COVE_COVE_TEMPORARY_WINDOW_H_
+
+#include "ui/base/interaction/element_identifier.h"
+
+DECLARE_ELEMENT_IDENTIFIER_VALUE(kCoveTemporaryPromoteElementId);
+
+class Profile;
+class BrowserWindowInterface;
+class GURL;
+// For OS external-link dispatch only. Returns null for unsupported URLs or
+// profiles that cannot create a window. Never changes the selected profile.
+BrowserWindowInterface* OpenCoveTemporaryWindow(Profile* profile, const GURL& url);
+#endif
diff --git a/chrome/browser/ui/cove/cove_temporary_window_browsertest.mm b/chrome/browser/ui/cove/cove_temporary_window_browsertest.mm
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/cove/cove_temporary_window_browsertest.mm
@@ -0,0 +1,131 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#import <AppKit/AppKit.h>
+
+#include "chrome/browser/ui/cove/cove_temporary_window.h"
+#include "chrome/browser/ui/browser.h"
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "ui/base/base_window.h"
+#include "ui/views/controls/button/md_text_button.h"
+#include "ui/views/test/button_test_api.h"
+#include "ui/views/widget/widget.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+
+class CoveTemporaryWindowBrowserTest : public InProcessBrowserTest {};
+
+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       PromotionPreservesPageHistoryAndDraft) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(),
+      embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  EXPECT_EQ(BrowserWindowInterface::TYPE_POPUP, popup->GetType());
+  EXPECT_EQ(browser()->GetProfile(), popup->GetProfile());
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  const auto first = page->GetVisibleURL();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(popup,
+      embedded_test_server()->GetURL("/title2.html")));
+  ASSERT_TRUE(content::ExecJs(page, "window.coveDraft = 'keep this exact page'"));
+  const int history = page->GetController().GetEntryCount();
+  auto* view = BrowserView::GetBrowserViewForBrowser(popup);
+  auto* button = static_cast<views::MdTextButton*>(
+      view->toolbar()->GetViewByElementId(kCoveTemporaryPromoteElementId));
+  ASSERT_TRUE(button);
+  EXPECT_EQ(u"Open in Cove", button->GetText());
+  popup->GetWindow()->SetBounds(gfx::Rect(100, 100, 420, 360));
+  view->GetWidget()->LayoutRootViewIfNecessary();
+  EXPECT_TRUE(button->IsDrawn());
+  EXPECT_GT(button->width(), 0);
+  EXPECT_TRUE(view->toolbar()->GetBoundsInScreen().Contains(
+      button->GetBoundsInScreen()));
+  views::test::ButtonTestApi(button).NotifyDefaultMouseClick();
+  BrowserWindowInterface* promoted = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    GlobalBrowserCollection::GetInstance()->ForEach([&](BrowserWindowInterface* candidate) {
+      if (candidate->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+          candidate->GetTabStripModel()->GetActiveWebContents() == page)
+        promoted = candidate;
+      return true;
+    });
+    return promoted != nullptr;
+  }));
+  EXPECT_EQ(browser()->GetProfile(), promoted->GetProfile());
+  EXPECT_EQ(history, page->GetController().GetEntryCount());
+  EXPECT_EQ("keep this exact page", content::EvalJs(page, "window.coveDraft"));
+  EXPECT_TRUE(page->GetController().CanGoBack());
+  EXPECT_EQ(first, page->GetController().GetEntryAtIndex(history - 2)->GetURL());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest, RejectsNonWebDestinations) {
+  const auto before = GlobalBrowserCollection::GetInstance()->GetSize();
+  EXPECT_FALSE(OpenCoveTemporaryWindow(browser()->GetProfile(), GURL("chrome://settings")));
+  EXPECT_FALSE(OpenCoveTemporaryWindow(browser()->GetProfile(), GURL("file:///tmp/example")));
+  EXPECT_FALSE(OpenCoveTemporaryWindow(browser()->GetProfile(), GURL("javascript:alert(1)")));
+  EXPECT_FALSE(OpenCoveTemporaryWindow(nullptr, GURL("https://example.com")));
+  EXPECT_EQ(before, GlobalBrowserCollection::GetInstance()->GetSize());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       ExternalAppLinksOpenSeparateTemporaryWindows) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const auto first = embedded_test_server()->GetURL("/title1.html");
+  const auto second = embedded_test_server()->GetURL("/title2.html");
+  const int original_tabs = browser()->GetTabStripModel()->count();
+  id<NSApplicationDelegate> delegate = NSApp.delegate;
+  ASSERT_TRUE([delegate respondsToSelector:@selector(application:openURLs:)]);
+  [delegate application:NSApp openURLs:@[
+    [NSURL URLWithString:[NSString stringWithUTF8String:first.spec().c_str()]],
+    [NSURL URLWithString:[NSString stringWithUTF8String:second.spec().c_str()]]
+  ]];
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    bool found_first = false;
+    bool found_second = false;
+    GlobalBrowserCollection::GetInstance()->ForEach([&](BrowserWindowInterface* window) {
+      if (window->GetType() != BrowserWindowInterface::TYPE_POPUP ||
+          window->GetProfile() != browser()->GetProfile()) return true;
+      auto* page = window->GetTabStripModel()->GetActiveWebContents();
+      if (page) {
+        found_first |= page->GetVisibleURL() == first;
+        found_second |= page->GetVisibleURL() == second;
+      }
+      return true;
+    });
+    return found_first && found_second;
+  }));
+  EXPECT_EQ(original_tabs, browser()->GetTabStripModel()->count());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       ClosingPageBeforePostedPromotionDoesNotReopenIt) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const auto before = GlobalBrowserCollection::GetInstance()->GetSize();
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(),
+      embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  ASSERT_TRUE(content::WaitForLoadStop(
+      popup->GetTabStripModel()->GetActiveWebContents()));
+  auto* button = static_cast<views::MdTextButton*>(
+      BrowserView::GetBrowserViewForBrowser(popup)->toolbar()->GetViewByElementId(
+          kCoveTemporaryPromoteElementId));
+  ASSERT_TRUE(button);
+  views::test::ButtonTestApi(button).NotifyDefaultMouseClick();
+  popup->GetTabStripModel()->CloseAllTabs();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    return GlobalBrowserCollection::GetInstance()->GetSize() == before;
+  }));
+}
