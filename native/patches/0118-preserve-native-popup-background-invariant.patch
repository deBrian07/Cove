+void BrowserViewPopupLayoutImpl::ConfigureTopContainerBackground(
+    const BrowserLayoutParams& params, CustomCornersBackground* background) {
+  if (views().toolbar && views().toolbar->GetViewByElementId(
+                             kCoveTemporaryPromoteElementId)) {
+    background->SetVisible(true);
+    background->SetPrimaryColor(kColorLocationBarBackground);
+    background->SetCorners(CustomCornersBackground::Corners());
+    return;
+  }
+  BrowserViewLayoutImpl::ConfigureTopContainerBackground(params, background);
+}
