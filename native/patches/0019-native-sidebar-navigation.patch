+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_VIEWS_COVE_COVE_LOCATION_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_COVE_COVE_LOCATION_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/view.h"
+
+class BrowserWindowInterface;
+namespace views {
+class ImageButton;
+class Textfield;
+}  // namespace views
+
+// Native sidebar navigation. Editing always targets the focused page/pane.
+class CoveLocationView final : public views::View,
+                               public views::TextfieldController,
+                               public views::FocusChangeListener,
+                               public TabStripModelObserver,
+                               public content::WebContentsObserver {
+  METADATA_HEADER(CoveLocationView, views::View)
+ public:
+  explicit CoveLocationView(BrowserWindowInterface* browser);
+  ~CoveLocationView() override;
+  void FocusLocation();
+  void Refresh();
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+  bool HandleKeyEvent(views::Textfield*, const ui::KeyEvent&) override;
+  void OnWillChangeFocus(views::View*, views::View*) override {}
+  void OnDidChangeFocus(views::View*, views::View*) override;
+  void OnTabStripModelChanged(TabStripModel*,
+                              const TabStripModelChange&,
+                              const TabStripSelectionChange&) override;
+  void OnTabStripModelDestroyed(TabStripModel*) override;
+  void DidFinishNavigation(content::NavigationHandle*) override;
+  void DidStopLoading() override;
+
+ private:
+  void ObserveActiveTab();
+  void RunNavigationCommand(int command);
+  void ShowSiteInformation();
+  void FocusPage();
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Textfield> address_ = nullptr;
+  raw_ptr<views::ImageButton> back_ = nullptr;
+  raw_ptr<views::ImageButton> forward_ = nullptr;
+  base::ScopedObservation<views::FocusManager, views::FocusChangeListener>
+      focus_{this};
+  base::WeakPtrFactory<CoveLocationView> weak_factory_{this};
+};
+#endif  // CHROME_BROWSER_UI_VIEWS_COVE_COVE_LOCATION_VIEW_H_
