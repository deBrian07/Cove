+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/views/cove/cove_location_view.h"
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/autocomplete/autocomplete_classifier_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/bubble_anchor_util.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/page_info/page_info_dialog.h"
+#include "components/omnibox/browser/autocomplete_classifier.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/button/image_button.h"
+#include "ui/views/controls/button/image_button_factory.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/layout/box_layout.h"
+#include "url/url_constants.h"
+
+CoveLocationView::CoveLocationView(BrowserWindowInterface* browser)
+    : browser_(browser->GetWeakPtr()) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 4));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  auto* navigation = AddChildView(std::make_unique<views::View>());
+  navigation->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 4));
+  auto add_button = [this, navigation](const gfx::VectorIcon& icon, int command,
+                                       const std::u16string& name) {
+    auto button = views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(&CoveLocationView::RunNavigationCommand,
+                            weak_factory_.GetWeakPtr(), command),
+        icon, 16);
+    button->SetPreferredSize(gfx::Size(28, 28));
+    button->SetTooltipText(name);
+    button->GetViewAccessibility().SetName(name);
+    return navigation->AddChildView(std::move(button));
+  };
+  back_ = add_button(vector_icons::kArrowBackIcon, IDC_BACK, u"Back");
+  forward_ =
+      add_button(vector_icons::kArrowForwardIcon, IDC_FORWARD, u"Forward");
+  add_button(vector_icons::kRefreshIcon, IDC_RELOAD, u"Reload");
+  auto info = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&CoveLocationView::ShowSiteInformation,
+                          weak_factory_.GetWeakPtr()),
+      vector_icons::kInfoIcon, 16);
+  info->SetPreferredSize(gfx::Size(28, 28));
+  info->SetTooltipText(u"Site information and permissions");
+  info->GetViewAccessibility().SetName(u"Site information and permissions");
+  navigation->AddChildView(std::move(info));
+
+  address_ = AddChildView(std::make_unique<views::Textfield>());
+  address_->set_controller(this);
+  address_->SetTextInputType(ui::TEXT_INPUT_TYPE_URL);
+  address_->SetPlaceholderText(u"Search or Enter URL");
+  address_->SetDefaultWidthInChars(1);
+  address_->SetPreferredSize(gfx::Size(100, 32));
+  address_->SetTextColorId(kColorOmniboxText);
+  address_->SetBackgroundColor(kColorLocationBarBackground);
+  address_->GetViewAccessibility().SetName(u"Address and search bar");
+  browser->GetTabStripModel()->AddObserver(this);
+  ObserveActiveTab();
+}
+
+CoveLocationView::~CoveLocationView() = default;
+void CoveLocationView::AddedToWidget() {
+  views::View::AddedToWidget();
+  if (GetFocusManager()) {
+    focus_.Observe(GetFocusManager());
+  }
+}
+void CoveLocationView::RemovedFromWidget() {
+  focus_.Reset();
+  views::View::RemovedFromWidget();
+}
+void CoveLocationView::ObserveActiveTab() {
+  Observe(browser_ ? browser_->GetTabStripModel()->GetActiveWebContents()
+                   : nullptr);
+  Refresh();
+}
+void CoveLocationView::OnTabStripModelChanged(TabStripModel*,
+                                              const TabStripModelChange&,
+                                              const TabStripSelectionChange&) {
+  ObserveActiveTab();
+}
+void CoveLocationView::OnTabStripModelDestroyed(TabStripModel*) {
+  Observe(nullptr);
+}
+void CoveLocationView::DidFinishNavigation(content::NavigationHandle*) {
+  Refresh();
+}
+void CoveLocationView::DidStopLoading() {
+  Refresh();
+}
+void CoveLocationView::Refresh() {
+  content::WebContents* contents = web_contents();
+  back_->SetEnabled(contents && contents->GetController().CanGoBack());
+  forward_->SetEnabled(contents && contents->GetController().CanGoForward());
+  if (!contents || address_->HasFocus()) {
+    return;
+  }
+  const GURL& url = contents->GetVisibleURL();
+  const std::string_view display =
+      url == GURL("about:blank") ? ""
+                                 : (url.has_host() ? url.host() : url.spec());
+  address_->SetText(base::UTF8ToUTF16(display));
+  address_->SetTooltipText(base::UTF8ToUTF16(url.spec()));
+}
+void CoveLocationView::FocusLocation() {
+  address_->RequestFocus();
+  if (web_contents()) {
+    address_->SetText(
+        base::UTF8ToUTF16(web_contents()->GetVisibleURL().spec()));
+    address_->SelectAll(false);
+  }
+}
+void CoveLocationView::OnDidChangeFocus(views::View* before, views::View* now) {
+  if (now == address_) {
+    if (web_contents()) {
+      address_->SetText(
+          base::UTF8ToUTF16(web_contents()->GetVisibleURL().spec()));
+      address_->SelectAll(false);
+    }
+  } else if (before == address_) {
+    Refresh();
+  }
+}
+void CoveLocationView::FocusPage() {
+  if (browser_) {
+    if (auto* page = browser_->GetTabStripModel()->GetActiveWebContents()) {
+      page->Focus();
+    }
+  }
+}
+void CoveLocationView::RunNavigationCommand(int command) {
+  if (browser_) {
+    chrome::ExecuteCommand(browser_.get(), command);
+  }
+}
+void CoveLocationView::ShowSiteInformation() {
+  if (web_contents()) {
+    ShowPageInfoDialog(web_contents(), base::DoNothing(),
+                       bubble_anchor_util::Anchor::kLocationBar);
+  }
+}
+bool CoveLocationView::HandleKeyEvent(views::Textfield*,
+                                      const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed ||
+      address_->IsIMEComposing()) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    FocusPage();
+    Refresh();
+    return true;
+  }
+  if (event.key_code() != ui::VKEY_RETURN || !browser_) {
+    return false;
+  }
+  std::u16string input(address_->GetText());
+  base::TrimWhitespace(input, base::TRIM_ALL, &input);
+  if (input.empty()) {
+    return true;
+  }
+  auto* classifier =
+      AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile());
+  if (!classifier) {
+    return true;
+  }
+  AutocompleteMatch match;
+  classifier->Classify(input, false, false, metrics::OmniboxEventProto::BLANK,
+                       &match, nullptr);
+  if (!match.destination_url.is_valid() ||
+      match.destination_url.SchemeIs(url::kJavaScriptScheme)) {
+    return true;
+  }
+  NavigateParams params(browser_.get(), match.destination_url,
+                        ui::PAGE_TRANSITION_TYPED);
+  params.disposition = event.IsCommandDown()
+                           ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                           : WindowOpenDisposition::CURRENT_TAB;
+  params.user_gesture = true;
+  Navigate(&params);
+  FocusPage();
+  return true;
+}
+BEGIN_METADATA(CoveLocationView)
+END_METADATA
