 void CoveLocationView::OnDidChangeFocus(views::View* before, views::View* now) {
   if (now == address_) {
+    UpdateAddressFocusStyle();
     if (web_contents()) {
       address_->SetText(
           base::UTF8ToUTF16(web_contents()->GetVisibleURL().spec()));
       address_->SelectAll(false);
     }
   } else if (before == address_) {
+    UpdateAddressFocusStyle();
     Refresh();
   }
 }
+void CoveLocationView::UpdateAddressFocusStyle() {
+  if (!address_) {
+    return;
+  }
+  if (address_->HasFocus()) {
+    auto border = views::CreateRoundedRectBorder(
+        2, address_->GetCornerRadius(), ui::kColorSysStateFocusRing);
+    address_->SetBorder(views::CreatePaddedBorder(
+        std::move(border), gfx::Insets::VH(0, 11)));
+    address_->SetBackgroundColor(kColorLocationBarBackgroundHovered);
+  } else {
+    address_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 12)));
+    address_->SetBackgroundColor(kColorLocationBarBackground);
+  }
+}
