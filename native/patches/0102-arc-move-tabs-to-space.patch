+  EXPECT_EQ("work", library()->ActiveSpaceIdForTesting());
+  EXPECT_EQ(mover, model->GetActiveWebContents());
+  EXPECT_EQ(TabStripModel::kNoTab, model->GetIndexOfWebContents(stay));
+  EXPECT_EQ("mover", content::EvalJs(mover, "window.draft"));
+  ASSERT_TRUE(library()->HasParkedSpaceForTesting("personal"));
+
+  library()->FocusSpace("personal");
+  Layout();
+  EXPECT_EQ(stay, model->GetActiveWebContents());
+  EXPECT_EQ(TabStripModel::kNoTab, model->GetIndexOfWebContents(mover));
+  library()->FocusSpace("work");
+  Layout();
+  EXPECT_EQ(mover, model->GetActiveWebContents());
+  EXPECT_EQ("mover", content::EvalJs(mover, "window.draft"));
 }
