+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       MoveToSpaceCarriesPinAndLeavesBlankCanvas) {
+  Seed();
+  auto* model = browser()->GetTabStripModel();
+  library()->FocusSpace("work");
+  Layout();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Work page</title>")));
+  auto* work_page = model->GetActiveWebContents();
+  library()->FocusSpace("personal");
+  Layout();
+  ASSERT_TRUE(library()->HasParkedSpaceForTesting("work"));
+
+  const GURL url("data:text/html,<title>Pinned</title>");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* pinned = model->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(pinned, "window.draft='pinned'"));
+  model->SetTabPinned(model->active_index(), true);
+  ASSERT_EQ(1, model->count());
+  ASSERT_TRUE(SpaceHasPinUrl(browser(), "personal", url));
+
+  ASSERT_TRUE(MoveTabWithMenu(browser(), model->GetIndexOfWebContents(pinned),
+                              u"Work"));
+  Layout();
+  EXPECT_EQ("work", library()->ActiveSpaceIdForTesting());
+  EXPECT_EQ(pinned, model->GetActiveWebContents());
+  EXPECT_TRUE(model->IsTabPinned(model->active_index()));
+  EXPECT_NE(TabStripModel::kNoTab, model->GetIndexOfWebContents(work_page));
+  EXPECT_EQ("pinned", content::EvalJs(pinned, "window.draft"));
+  EXPECT_FALSE(SpaceHasPinUrl(browser(), "personal", url));
+  EXPECT_TRUE(SpaceHasPinUrl(browser(), "work", url));
+  EXPECT_FALSE(library()->ActivePinIdForTesting().empty());
+
+  // The source Space keeps a blank canvas instead of an empty strip.
+  library()->FocusSpace("personal");
+  Layout();
+  EXPECT_EQ(1, model->count());
+  EXPECT_EQ(GURL("about:blank"), model->GetActiveWebContents()->GetVisibleURL());
+  EXPECT_EQ(TabStripModel::kNoTab, model->GetIndexOfWebContents(pinned));
+}
