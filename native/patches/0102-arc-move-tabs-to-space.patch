+
+bool CoveSidebarLibraryView::MoveTabsToSpace(
+    const std::vector<tabs::TabHandle>& tabs, const std::string& space_id) {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  if (restoring_session_ || switching_space_ || closing_active_space_ ||
+      browser_->GetProfile()->IsOffTheRecord() ||
+      space_id == active_space_id_ ||
+      !FindSpace(prefs->GetDict(kCoveSidebarPref), space_id)) {
+    return false;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  std::vector<tabs::TabHandle> moving;
+  const auto add = [&](tabs::TabInterface* tab) {
+    if (tab && model->GetIndexOfTab(tab) != TabStripModel::kNoTab &&
+        !IsCoveEmptyCanvas(tab->GetContents()) &&
+        !std::ranges::contains(moving, tab->GetHandle())) {
+      moving.push_back(tab->GetHandle());
+    }
+  };
+  for (const auto& handle : tabs) {
+    auto* tab = handle.Get();
+    add(tab);
+    // A split moves as a unit; a half-parked split cannot be restored.
+    if (tab && tab->GetSplit()) {
+      for (auto* other : *model) {
+        if (other->GetSplit() == tab->GetSplit()) {
+          add(other);
+        }
+      }
+    }
+  }
+  if (moving.empty()) {
+    return false;
+  }
+  CloseRecentTabSwitcher();
+  // Groups stay with the Space they were made in.
+  std::vector<int> grouped;
+  for (const auto& handle : moving) {
+    if (handle.Get()->GetGroup()) {
+      grouped.push_back(model->GetIndexOfTab(handle.Get()));
+    }
+  }
+  if (!grouped.empty()) {
+    std::ranges::sort(grouped);
+    model->RemoveFromGroup(grouped);
+  }
+  // Unpinning drops the source Space's pin record; the tab is pinned again in
+  // the target so it becomes that Space's pin.
+  std::vector<tabs::TabHandle> repin;
+  for (const auto& handle : moving) {
+    auto* tab = handle.Get();
+    if (tab && tab->IsPinned()) {
+      repin.push_back(handle);
+      model->SetTabPinned(model->GetIndexOfTab(tab), false);
+    }
+  }
+  bool leaves_space_empty = true;
+  for (auto* tab : *model) {
+    if (!std::ranges::contains(moving, tab->GetHandle())) {
+      leaves_space_empty = false;
+      break;
+    }
+  }
+  if (leaves_space_empty) {
+    NavigateParams params(browser_, GURL("about:blank"),
+                          ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    Navigate(&params);
+    MarkCoveEmptyCanvas(params.navigated_or_inserted_contents.get());
+    OnEmptyCanvasMarked();
+  }
+  moving_tabs_ = moving;
+  SwitchSpace(space_id);
+  moving_tabs_.clear();
+  if (active_space_id_ != space_id) {
+    return false;
+  }
+  for (const auto& handle : moving) {
+    auto* tab = handle.Get();
+    if (!tab || !HasRestoredCoveTabSessionState(tab->GetContents())) {
+      continue;
+    }
+    CoveTabSessionState state = *GetCoveTabSessionState(tab->GetContents());
+    state.space = space_id;
+    state.pin.clear();
+    SetCoveTabSessionState(tab->GetContents(), std::move(state));
+  }
+  for (const auto& handle : repin) {
+    auto* tab = handle.Get();
+    const int index = tab ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    if (index != TabStripModel::kNoTab && !tab->IsPinned()) {
+      model->SetTabPinned(index, true);
+    }
+  }
+  if (auto* first = moving.front().Get()) {
+    const int index = model->GetIndexOfTab(first);
+    if (index != TabStripModel::kNoTab) {
+      model->ActivateTabAt(index);
+    }
+  }
+  QueueSessionSync();
+  return true;
 }
 
