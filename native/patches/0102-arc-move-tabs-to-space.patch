+class NoopMenuDelegate : public ui::SimpleMenuModel::Delegate {
+ public:
+  void ExecuteCommand(int command_id, int event_flags) override {}
+};
+
+// Chooses `space` from the tab context menu's Move to Space submenu.
+bool MoveTabWithMenu(BrowserWindowInterface* browser,
+                     int index,
+                     const std::u16string& space) {
+  NoopMenuDelegate delegate;
+  TabMenuModel menu(&delegate, TabMenuModelDelegate::From(browser),
+                    browser->GetTabStripModel(), index);
+  for (size_t i = 0; i < menu.GetItemCount(); ++i) {
+    if (menu.GetLabelAt(i) != u"Move to Space") {
+      continue;
+    }
+    ui::MenuModel* spaces = menu.GetSubmenuModelAt(i);
+    for (size_t j = 0; spaces && j < spaces->GetItemCount(); ++j) {
+      if (spaces->GetLabelAt(j) == space) {
+        spaces->ActivatedAt(j);
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool SpaceHasPinUrl(BrowserWindowInterface* browser,
+                    const std::string& space_id,
+                    const GURL& url) {
+  const auto* spaces = browser->GetProfile()
+                           ->GetPrefs()
+                           ->GetDict(kSidebarPref)
+                           .FindList("spaces");
+  for (const auto& value : *spaces) {
+    const auto& space = value.GetDict();
+    if (*space.FindString("id") != space_id || !space.FindList("pins")) {
+      continue;
+    }
+    for (const auto& pin : *space.FindList("pins")) {
+      if (*pin.GetDict().FindString("url") == url.spec()) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
