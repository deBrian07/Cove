+IN_PROC_BROWSER_TEST_F(TabCreationMetricsTest, DetachedTabAtDelayedRecord) {
+  base::HistogramTester histogram_tester;
+  AppendTab();
+  auto parked = tab_strip_model()->DetachTabAtForInsertion(TabCount() - 1);
+  ASSERT_TRUE(parked);
+  EXPECT_EQ(nullptr, parked->GetBrowserWindowInterface());
+
+  // Reproduces parking a newly created tab in an inactive Space for longer
+  // than the grouping metric's ten-second delay.
+  FastForwardPastDelay();
+  histogram_tester.ExpectTotalCount(kHistogramName, 0);
+  tab_strip_model()->InsertDetachedTabAt(TabCount(), std::move(parked),
+                                         AddTabTypes::ADD_ACTIVE);
+}
