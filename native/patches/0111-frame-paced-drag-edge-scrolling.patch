+
+float VerticalTabStripRegionView::DragEdgeScrollDistanceForTesting(
+    float depth, base::TimeDelta elapsed) {
+  // Smoothstep gives precise placement at the inner edge and progressively
+  // faster travel toward the boundary. Cap stalls to avoid a large jump.
+  depth = std::clamp(depth, 0.0f, 1.0f);
+  const float speed = 60.0f + 240.0f * depth * depth * (3.0f - 2.0f * depth);
+  return speed * std::clamp(elapsed, base::TimeDelta(), base::Milliseconds(50))
+                     .InSecondsF();
+}
