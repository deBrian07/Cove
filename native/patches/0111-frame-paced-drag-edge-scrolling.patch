 IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       DragEdgeScrollSpeedIsIndependentOfFrameCadence) {
+  const auto distance = [](float depth, int frames, base::TimeDelta interval) {
+    float total = 0;
+    for (int i = 0; i < frames; ++i)
+      total += VerticalTabStripRegionView::DragEdgeScrollDistanceForTesting(
+          depth, interval);
+    return total;
+  };
+  // Equal wall time at 125, 62.5 and 50 Hz must cover the same distance.
+  EXPECT_NEAR(distance(1, 40, base::Milliseconds(8)),
+              distance(1, 20, base::Milliseconds(16)), 0.001f);
+  EXPECT_NEAR(distance(1, 40, base::Milliseconds(8)),
+              distance(1, 16, base::Milliseconds(20)), 0.001f);
+  EXPECT_LT(distance(0, 1, base::Milliseconds(16)),
+            distance(0.5f, 1, base::Milliseconds(16)));
+  EXPECT_LT(distance(0.5f, 1, base::Milliseconds(16)),
+            distance(1, 1, base::Milliseconds(16)));
+  EXPECT_FLOAT_EQ(15.0f, distance(1, 1, base::Seconds(5)));
+  EXPECT_FLOAT_EQ(0.0f, distance(1, 1, -base::Milliseconds(1)));
+}
