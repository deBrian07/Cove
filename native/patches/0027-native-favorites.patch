+CoveFavoritesView::CoveFavoritesView(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  auto layout = std::make_unique<views::TableLayout>();
+  layout->AddColumn(views::LayoutAlignment::kStretch,
+                    views::LayoutAlignment::kStretch,
+                    views::TableLayout::kFixedSize,
+                    views::TableLayout::ColumnSize::kFixed, kTileWidth,
+                    kTileWidth)
+      .AddPaddingColumn(views::TableLayout::kFixedSize, kColumnGap)
+      .AddColumn(views::LayoutAlignment::kStretch,
+                 views::LayoutAlignment::kStretch,
+                 views::TableLayout::kFixedSize,
+                 views::TableLayout::ColumnSize::kFixed, kTileWidth,
+                 kTileWidth)
+      .AddPaddingColumn(views::TableLayout::kFixedSize, kColumnGap)
+      .AddColumn(views::LayoutAlignment::kStretch,
+                 views::LayoutAlignment::kStretch,
+                 views::TableLayout::kFixedSize,
+                 views::TableLayout::ColumnSize::kFixed, kTileWidth,
+                 kTileWidth);
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(2, 4)));
+  SetLayoutManager(std::move(layout));
+  Rebuild();
+  pref_change_registrar_.Init(browser_->GetProfile()->GetPrefs());
+  pref_change_registrar_.Add(
+      kCoveSidebarPref,
+      base::BindRepeating(&CoveFavoritesView::Rebuild,
+                          weak_factory_.GetWeakPtr()));
+}
+
+CoveFavoritesView::~CoveFavoritesView() = default;
+
+base::WeakPtr<CoveFavoritesView> CoveFavoritesView::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void CoveFavoritesView::SetCollapsed(bool collapsed) {
+  collapsed_ = collapsed;
+  Rebuild();
+}
+
+bool CoveFavoritesView::IsCurrentPageFavorite() const {
+  auto* tab = browser_->GetTabStripModel()->GetActiveTab();
+  if (!tab || !tab->GetContents()) {
+    return false;
+  }
+  const std::string current_url = tab->GetContents()->GetVisibleURL().spec();
+  const base::ListValue* favorites =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref)
+          .FindList("favorites");
+  if (!favorites) {
+    return false;
+  }
+  for (const base::Value& value : *favorites) {
+    const base::DictValue* favorite = value.GetIfDict();
+    const std::string* url = favorite ? favorite->FindString("url") : nullptr;
+    if (url && *url == current_url) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void CoveFavoritesView::ToggleCurrentPage() {
+  auto* tab = browser_->GetTabStripModel()->GetActiveTab();
+  if (!tab || !tab->GetContents()) {
+    return;
+  }
+  content::WebContents* contents = tab->GetContents();
+  const GURL url = contents->GetVisibleURL();
+  if (!IsFavoriteUrl(url)) {
+    return;
+  }
+  const std::string spec = url.spec();
+  if (IsCurrentPageFavorite()) {
+    RemoveFavorite(spec);
+    return;
+  }
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              kCoveSidebarPref);
+  base::ListValue* favorites = update->EnsureList("favorites");
+  base::DictValue favorite;
+  favorite.Set("url", spec);
+  favorite.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  favorites->Append(std::move(favorite));
+}
+
+void CoveFavoritesView::Rebuild() {
+  favicon_task_tracker_.TryCancelAll();
+  row_urls_.clear();
+  RemoveAllChildViews();
+  const base::ListValue* favorites =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref)
+          .FindList("favorites");
+  if (collapsed_ || !favorites || favorites->empty()) {
+    SetVisible(false);
+    return;
+  }
+  SetVisible(true);
+
+  auto* layout = static_cast<views::TableLayout*>(GetLayoutManager());
+  layout->RemoveRows(layout->NumRows());
+  const size_t count = std::count_if(
+      favorites->begin(), favorites->end(), [](const base::Value& value) {
+        const base::DictValue* favorite = value.GetIfDict();
+        const std::string* url = favorite ? favorite->FindString("url") : nullptr;
+        return url && IsFavoriteUrl(GURL(*url));
+      });
+  if (count == 0) {
+    SetVisible(false);
+    return;
+  }
+  const size_t rows = (count + kColumns - 1) / kColumns;
+  for (size_t row = 0; row < rows; ++row) {
+    layout->AddRows(1, views::TableLayout::kFixedSize, kTileHeight);
+    if (row + 1 < rows) {
+      layout->AddPaddingRow(views::TableLayout::kFixedSize, kRowGap);
+    }
+  }
+
+  for (const base::Value& value : *favorites) {
+    const base::DictValue* favorite = value.GetIfDict();
+    const std::string* url_string =
+        favorite ? favorite->FindString("url") : nullptr;
+    if (!url_string || !IsFavoriteUrl(GURL(*url_string))) {
+      continue;
+    }
+    const GURL url(*url_string);
+    auto* tile = AddChildView(std::make_unique<FavoriteTile>(
+        base::BindRepeating(&CoveFavoritesView::OpenFavorite,
+                            weak_factory_.GetWeakPtr(), url)));
+    tile->SetTooltipText(FavoriteTitle(*favorite) + u" — " +
+                         base::UTF8ToUTF16(*url_string));
+    tile->GetViewAccessibility().SetName(
+        FavoriteTitle(*favorite) + u", " + base::UTF8ToUTF16(*url_string));
+    tile->set_context_menu_controller(this);
+    row_urls_[tile] = *url_string;
+
+    bool has_open_favicon = false;
+    TabStripModel* model = browser_->GetTabStripModel();
+    for (int tab_index = 0; tab_index < model->count(); ++tab_index) {
+      content::WebContents* contents = model->GetWebContentsAt(tab_index);
+      if (!contents || contents->GetVisibleURL() != url) {
+        continue;
+      }
+      auto* driver = favicon::ContentFaviconDriver::FromWebContents(contents);
+      if (driver && driver->FaviconIsValid()) {
+        const gfx::Image image = driver->GetFavicon();
+        if (!image.IsEmpty()) {
+          tile->SetImageModel(
+              views::Button::STATE_NORMAL,
+              ui::ImageModel::FromImage(image));
+          has_open_favicon = true;
+        }
+      }
+      break;
+    }
+    if (!has_open_favicon) {
+      favicon::FaviconService* favicon_service =
+          FaviconServiceFactory::GetForProfile(
+              browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+      if (favicon_service) {
+        favicon_service->GetFaviconImageForPageURL(
+            url,
+            base::BindOnce(&CoveFavoritesView::OnFaviconLoaded,
+                           weak_factory_.GetWeakPtr(), url),
+            &favicon_task_tracker_);
+      }
+    }
+  }
+  InvalidateLayout();
+}
+
+
+void CoveFavoritesView::OnFaviconLoaded(
+    const GURL& url,
+    const favicon_base::FaviconImageResult& result) {
+  if (result.image.IsEmpty()) {
+    return;
+  }
+  for (const auto& [view, favorite_url] : row_urls_) {
+    if (favorite_url == url.spec()) {
+      static_cast<views::LabelButton*>(view)->SetImageModel(
+          views::Button::STATE_NORMAL, ui::ImageModel::FromImage(result.image));
+      return;
+    }
+  }
+}
+
+void CoveFavoritesView::OpenFavorite(const GURL& url) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    if (contents && contents->GetVisibleURL() == url) {
+      model->ActivateTabAt(i);
+      return;
+    }
+  }
+  NavigateParams params(browser_, url, ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+}
+
+void CoveFavoritesView::RemoveFavorite(const std::string& url) {
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              kCoveSidebarPref);
+  base::ListValue* favorites = update->FindList("favorites");
+  if (!favorites) {
+    return;
+  }
+  favorites->EraseIf([&url](const base::Value& value) {
+    const base::DictValue* favorite = value.GetIfDict();
+    const std::string* existing =
+        favorite ? favorite->FindString("url") : nullptr;
+    return existing && *existing == url;
+  });
+}
+
+void CoveFavoritesView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  const auto it = row_urls_.find(source);
+  if (it == row_urls_.end() || !source->GetWidget()) {
+    return;
+  }
+  context_favorite_url_ = it->second;
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(kRemoveFavoriteCommand, u"Remove favorite");
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(source->GetWidget(), nullptr,
+                          gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void CoveFavoritesView::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id == kRemoveFavoriteCommand && !context_favorite_url_.empty()) {
+    RemoveFavorite(context_favorite_url_);
+  }
+}
+
+BEGIN_METADATA(CoveFavoritesView)
+END_METADATA
