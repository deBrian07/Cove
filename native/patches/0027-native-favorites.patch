+namespace {
+
+constexpr char kCoveSidebarPref[] = "cove.sidebar";
+constexpr int kRemoveFavoriteCommand = 1;
+constexpr int kColumns = 3;
+constexpr int kTileWidth = 72;
+constexpr int kTileHeight = 48;
+constexpr int kColumnGap = 4;
+constexpr int kRowGap = 4;
+constexpr int kIconSize = 20;
+
+bool IsFavoriteUrl(const GURL& url) {
+  return url.is_valid() && (url.SchemeIsHTTPOrHTTPS());
+}
+
+std::u16string FavoriteTitle(const base::DictValue& favorite) {
+  const std::string* title = favorite.FindString("title");
+  const std::string* url = favorite.FindString("url");
+  if (title && !title->empty()) {
+    return base::UTF8ToUTF16(*title);
+  }
+  return url ? base::UTF8ToUTF16(GURL(*url).host()) : std::u16string();
+}
+
+class FavoriteTile : public views::LabelButton {
+  METADATA_HEADER(FavoriteTile, views::LabelButton)
+
+ public:
+  explicit FavoriteTile(PressedCallback callback)
+      : views::LabelButton(std::move(callback)) {
+    SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    SetImageLabelSpacing(4);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 5)));
+    SetFocusRingCornerRadius(12);
+    SetPreferredSize(gfx::Size(kTileWidth, kTileHeight));
+    SetImageModel(STATE_NORMAL,
+                  ui::ImageModel::FromVectorIcon(vector_icons::kGlobeIcon,
+                                                 ui::kColorIcon, kIconSize));
+    SetBackground(views::CreateRoundedRectBackground(
+        kColorLocationBarBackground, 12));
+  }
+
+ protected:
+  void StateChanged(ButtonState old_state) override {
+    views::LabelButton::StateChanged(old_state);
+    if (GetState() == STATE_HOVERED || GetState() == STATE_PRESSED) {
+      SetBackground(views::CreateRoundedRectBackground(
+          kColorLocationBarBackgroundHovered, 12));
+    } else {
+      SetBackground(views::CreateRoundedRectBackground(
+          kColorLocationBarBackground, 12));
+    }
+  }
+};
+
+BEGIN_METADATA(FavoriteTile)
+END_METADATA
+
+}  // namespace
