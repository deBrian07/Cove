+// Profile-wide favorite pages shown in the Cove sidebar.
+class CoveFavoritesView : public views::View,
+                          public views::ContextMenuController,
+                          public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(CoveFavoritesView, views::View)
+
+ public:
+  explicit CoveFavoritesView(BrowserWindowInterface* browser);
+  CoveFavoritesView(const CoveFavoritesView&) = delete;
+  CoveFavoritesView& operator=(const CoveFavoritesView&) = delete;
+  ~CoveFavoritesView() override;
+
+  void SetCollapsed(bool collapsed);
+  void ToggleCurrentPage();
+  bool IsCurrentPageFavorite() const;
+  base::WeakPtr<CoveFavoritesView> GetWeakPtr();
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  void Rebuild();
+  void OpenFavorite(const GURL& url);
+  void RemoveFavorite(const std::string& url);
+  void OnFaviconLoaded(const GURL& url,
+                       const favicon_base::FaviconImageResult& result);
+
+  raw_ptr<BrowserWindowInterface> browser_ = nullptr;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::CancelableTaskTracker favicon_task_tracker_;
+  bool collapsed_ = false;
+  std::map<views::View*, std::string> row_urls_;
+  std::string context_favorite_url_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  base::WeakPtrFactory<CoveFavoritesView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_COVE_COVE_FAVORITES_VIEW_H_
