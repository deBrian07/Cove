+void CoveSidebarLibraryView::SwitchSpace(const std::string& space_id) {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  const std::string* active =
+      prefs->GetDict(kCoveSidebarPref).FindString("active");
+  if (active && *active == space_id) {
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  {
+    ScopedDictPrefUpdate update(prefs, kCoveSidebarPref);
+    const std::string* current = update->FindString("active");
+    base::DictValue* from = current ? FindSpace(*update, *current) : nullptr;
+    if (from) {
+      base::ListValue tabs;
+      for (int i = 0; i < model->count(); ++i) {
+        content::WebContents* contents = model->GetWebContentsAt(i);
+        if (!contents) {
+          continue;
+        }
+        base::DictValue tab;
+        tab.Set("url", contents->GetVisibleURL().spec());
+        tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+        tabs.Append(std::move(tab));
+      }
+      from->Set("tabs", std::move(tabs));
+    }
+    update->Set("active", space_id);
+  }
+
+  const base::ListValue* tabs =
+      FindSpace(prefs->GetDict(kCoveSidebarPref), space_id)
+          ? FindSpace(prefs->GetDict(kCoveSidebarPref), space_id)->FindList("tabs")
+          : nullptr;
+  const int old_count = model->count();
+  int added = 0;
+  if (tabs) {
+    for (const base::Value& tab_value : *tabs) {
+      const base::DictValue* tab = tab_value.GetIfDict();
+      const std::string* url_text = tab ? tab->FindString("url") : nullptr;
+      if (!url_text) {
+        continue;
+      }
+      GURL url(*url_text);
+      if (!url.is_valid()) {
+        continue;
+      }
+      NavigateParams params(browser_, url, ui::PAGE_TRANSITION_TYPED);
+      params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+      Navigate(&params);
+      ++added;
+    }
+  }
+  if (added == 0) {
+    NavigateParams params(browser_, GURL("chrome://newtab/"),
+                          ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    Navigate(&params);
+    ++added;
+  }
+  for (int i = old_count - 1; i >= 0; --i) {
+    model->CloseWebContentsAt(
+        i, CLOSE_USER_GESTURE | CLOSE_CREATE_HISTORICAL_TAB);
+  }
+  if (model->count() > 0) {
+    model->ActivateTabAt(0);
+  }
+  Rebuild();
+}
+
+void CoveSidebarLibraryView::OpenPin(const GURL& url) {
+  if (!url.is_valid()) {
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    if (contents && contents->GetVisibleURL() == url) {
+      model->ActivateTabAt(i);
+      return;
+    }
+  }
+  NavigateParams params(browser_, url, ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+}
+
+void CoveSidebarLibraryView::RemovePin(const std::string& pin_id) {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  ScopedDictPrefUpdate update(prefs, kCoveSidebarPref);
+  const std::string* active = update->FindString("active");
+  base::DictValue* space = active ? FindSpace(*update, *active) : nullptr;
+  base::ListValue* pins = space ? space->FindList("pins") : nullptr;
+  if (!pins) {
+    return;
+  }
+  for (size_t i = 0; i < pins->size(); ++i) {
+    const base::DictValue* pin = (*pins)[i].GetIfDict();
+    const std::string* id = pin ? pin->FindString("id") : nullptr;
+    if (id && *id == pin_id) {
+      pins->erase(pins->begin() + static_cast<ptrdiff_t>(i));
+      break;
+    }
+  }
+  Rebuild();
+}
