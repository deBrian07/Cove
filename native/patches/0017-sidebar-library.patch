+void CoveSidebarLibraryView::MovePinToFolder(const std::string& pin_id,
+                                             const std::string& folder_id) {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  ScopedDictPrefUpdate update(prefs, kCoveSidebarPref);
+  const std::string* active = update->FindString("active");
+  base::DictValue* space = active ? FindSpace(*update, *active) : nullptr;
+  base::ListValue* pins = space ? space->FindList("pins") : nullptr;
+  if (!pins) {
+    return;
+  }
+  for (base::Value& pin_value : *pins) {
+    base::DictValue* pin = pin_value.GetIfDict();
+    const std::string* id = pin ? pin->FindString("id") : nullptr;
+    if (id && *id == pin_id) {
+      pin->Set("folder", folder_id);
+      break;
+    }
+  }
+  Rebuild();
+}
+
+void CoveSidebarLibraryView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  context_pin_id_ = base::UTF16ToUTF8(source->GetAccessibleName());
+  if (context_pin_id_.empty()) {
+    return;
+  }
+  menu_folder_ids_.clear();
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(kRemovePinCommand, u"Remove pin");
+  const base::DictValue& root =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+  const std::string* active = root.FindString("active");
+  const base::DictValue* space = active ? FindSpace(root, *active) : nullptr;
+  const base::ListValue* folders = space ? space->FindList("folders") : nullptr;
+  if (folders) {
+    for (const base::Value& folder_value : *folders) {
+      const base::DictValue* folder = folder_value.GetIfDict();
+      if (!folder || !folder->FindString("id") || !folder->FindString("name")) {
+        continue;
+      }
+      menu_folder_ids_.push_back(*folder->FindString("id"));
+      menu_model_->AddItem(
+          kMovePinCommandBase + static_cast<int>(menu_folder_ids_.size()) - 1,
+          u"Move to " + base::UTF8ToUTF16(*folder->FindString("name")));
+    }
+  }
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(source->GetWidget(), nullptr,
+                          gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+BEGIN_METADATA(CoveSidebarLibraryView)
+END_METADATA
+
+void CoveSidebarLibraryView::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id == kRemovePinCommand) {
+    RemovePin(context_pin_id_);
+    return;
+  }
+  const int folder_index = command_id - kMovePinCommandBase;
+  if (folder_index >= 0 &&
+      folder_index < static_cast<int>(menu_folder_ids_.size())) {
+    MovePinToFolder(context_pin_id_, menu_folder_ids_[folder_index]);
+  }
+}

