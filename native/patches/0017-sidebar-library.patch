+void CoveSidebarLibraryView::Rebuild() {
+  RemoveAllChildViews();
+  const base::DictValue& root =
+      browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref);
+  const std::string* active_id = root.FindString("active");
+  const base::DictValue* space =
+      active_id ? FindSpace(root, *active_id) : nullptr;
+  if (!space) {
+    return;
+  }
+
+  MakeHeader(this, u"Pinned");
+  const base::ListValue* pins = space->FindList("pins");
+  bool any_loose_pin = false;
+  if (pins) {
+    for (const base::Value& pin_value : *pins) {
+      const base::DictValue* pin = pin_value.GetIfDict();
+      if (!pin) {
+        continue;
+      }
+      const std::string* folder = pin->FindString("folder");
+      if (folder && !folder->empty()) {
+        continue;
+      }
+      const std::string* url = pin->FindString("url");
+      const std::string* title = pin->FindString("title");
+      const std::string* id = pin->FindString("id");
+      if (!url || !id) {
+        continue;
+      }
+      any_loose_pin = true;
+      auto* row = MakeRow(
+          this, base::UTF8ToUTF16(title && !title->empty() ? *title : *url),
+          base::BindRepeating(&CoveSidebarLibraryView::OpenPin,
+                              weak_factory_.GetWeakPtr(), GURL(*url)));
+      row->set_context_menu_controller(this);
+      row->SetTooltipText(base::UTF8ToUTF16(*url));
+      row->SetAccessibleName(base::UTF8ToUTF16(*id));
+    }
+  }
+  MakeRow(this, any_loose_pin ? u"Pin this page" : u"Pin this page",
+          base::BindRepeating(&CoveSidebarLibraryView::PinActivePage,
+                              weak_factory_.GetWeakPtr()));
+
+  MakeHeader(this, u"Folders");
+  MakeRow(this, u"New folder",
+          base::BindRepeating(&CoveSidebarLibraryView::AddFolder,
+                              weak_factory_.GetWeakPtr()));
+  const base::ListValue* folders = space->FindList("folders");
+  if (folders) {
+    for (const base::Value& folder_value : *folders) {
+      const base::DictValue* folder = folder_value.GetIfDict();
+      if (!folder || !folder->FindString("name") || !folder->FindString("id")) {
+        continue;
+      }
+      const std::string& folder_id = *folder->FindString("id");
+      MakeRow(this, base::UTF8ToUTF16(*folder->FindString("name")),
+              base::BindRepeating([](const ui::Event&) {}));
+      if (!pins) {
+        continue;
+      }
+      for (const base::Value& pin_value : *pins) {
+        const base::DictValue* pin = pin_value.GetIfDict();
+        const std::string* pin_folder = pin ? pin->FindString("folder") : nullptr;
+        if (!pin || !pin_folder || *pin_folder != folder_id) {
+          continue;
+        }
+        const std::string* url = pin->FindString("url");
+        const std::string* title = pin->FindString("title");
+        const std::string* id = pin->FindString("id");
+        if (!url || !id) {
+          continue;
+        }
+        auto* row = MakeRow(
+            this,
+            u"    " + base::UTF8ToUTF16(title && !title->empty() ? *title : *url),
+            base::BindRepeating(&CoveSidebarLibraryView::OpenPin,
+                                weak_factory_.GetWeakPtr(), GURL(*url)));
+        row->set_context_menu_controller(this);
+        row->SetAccessibleName(base::UTF8ToUTF16(*id));
+        row->SetTooltipText(base::UTF8ToUTF16(*url));
+      }
+    }
+  }
+
+  MakeHeader(this, u"Spaces");
+  auto* chips = AddChildView(std::make_unique<views::View>());
+  chips->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 6));
+  const base::ListValue* spaces = root.FindList("spaces");
+  if (spaces) {
+    for (const base::Value& space_value : *spaces) {
+      const base::DictValue* item = space_value.GetIfDict();
+      if (!item || !item->FindString("id") || !item->FindString("name")) {
+        continue;
+      }
+      const std::string id = *item->FindString("id");
+      auto* chip = MakeRow(
+          chips, base::UTF8ToUTF16(*item->FindString("name")),
+          base::BindRepeating(&CoveSidebarLibraryView::SwitchSpace,
+                              weak_factory_.GetWeakPtr(), id));
+      if (active_id && id == *active_id) {
+        chip->SetEnabledTextColors(ui::kColorButtonForegroundProminent);
+      }
+    }
+  }
+  MakeRow(chips, u"+",
+          base::BindRepeating(&CoveSidebarLibraryView::AddSpace,
+                              weak_factory_.GetWeakPtr()));
+  InvalidateLayout();
+}
