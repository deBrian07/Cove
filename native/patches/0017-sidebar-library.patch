+CoveSidebarLibraryView::CoveSidebarLibraryView(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(0, 8), 1));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  // The sidebar paints on a non-opaque layer. An opaque background keeps text
+  // rendering checks from failing in that layer.
+  SetBackground(views::CreateSolidBackground(SkColorSetRGB(0x3a, 0x36, 0x4a)));
+  EnsureDefaultLibrary();
+  Rebuild();
+}
