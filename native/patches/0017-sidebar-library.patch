+// Sidebar library for the active Cove space: pinned pages, folders, and the
+// space switcher. Pins persist after their tab is closed. Each space keeps
+// its own pins, folders, and open tabs.
+class CoveSidebarLibraryView : public views::View,
+                               public TabStripModelObserver,
+                               public views::ContextMenuController,
+                               public ui::SimpleMenuModel::Delegate {
+ public:
+  METADATA_HEADER(CoveSidebarLibraryView, views::View)
+
+ public:
+  explicit CoveSidebarLibraryView(BrowserWindowInterface* browser);
+  CoveSidebarLibraryView(const CoveSidebarLibraryView&) = delete;
+  CoveSidebarLibraryView& operator=(const CoveSidebarLibraryView&) = delete;
+  ~CoveSidebarLibraryView() override;
+
+  void SetCollapsed(bool collapsed);
+
+  // views::View:
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+  // TabStripModelObserver:
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  void EnsureDefaultLibrary();
+  void Rebuild();
+  void PinActivePage();
+  void AddFolder();
+  void AddSpace();
+  void SwitchSpace(const std::string& space_id);
+  void OpenPin(const GURL& url);
+  void RemovePin(const std::string& pin_id);
+  void MovePinToFolder(const std::string& pin_id, const std::string& folder_id);
+
+  raw_ptr<BrowserWindowInterface> browser_ = nullptr;
+  std::string context_pin_id_;
+  std::vector<std::string> menu_folder_ids_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  base::WeakPtrFactory<CoveSidebarLibraryView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_COVE_COVE_SIDEBAR_LIBRARY_VIEW_H_
