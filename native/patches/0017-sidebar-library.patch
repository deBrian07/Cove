+void CoveSidebarLibraryView::AddFolder() {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  ScopedDictPrefUpdate update(prefs, kCoveSidebarPref);
+  const std::string* active = update->FindString("active");
+  base::DictValue* space = active ? FindSpace(*update, *active) : nullptr;
+  if (!space) {
+    return;
+  }
+  base::ListValue* folders = space->EnsureList("folders");
+  base::DictValue folder;
+  folder.Set("id", base::Uuid::GenerateRandomV4().AsLowercaseString());
+  folder.Set("name", "Folder " + base::NumberToString(folders->size() + 1));
+  folders->Append(std::move(folder));
