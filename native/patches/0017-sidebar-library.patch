+}
+
+void CoveSidebarLibraryView::AddSpace() {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  ScopedDictPrefUpdate update(prefs, kCoveSidebarPref);
+  base::ListValue* spaces = update->EnsureList("spaces");
+  base::DictValue space;
+  std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  space.Set("id", id);
+  space.Set("name", "Space " + base::NumberToString(spaces->size() + 1));
+  space.Set("color", "#6d6784");
+  space.Set("tabs", base::ListValue());
+  space.Set("pins", base::ListValue());
+  space.Set("folders", base::ListValue());
+  spaces->Append(std::move(space));
+  Rebuild();
+  SwitchSpace(id);
+}
