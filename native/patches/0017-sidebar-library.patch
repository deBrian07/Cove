+void CoveSidebarLibraryView::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                     int index) {
+  if (!tab || !tab->IsPinned() || !tab->GetContents()) {
+    return;
+  }
+  content::WebContents* contents = tab->GetContents();
+  const GURL url = contents->GetVisibleURL();
+  if (!url.is_valid() || url.SchemeIs("chrome") || url.SchemeIs("cove") ||
+      url.SchemeIs("devtools")) {
+    return;
+  }
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  ScopedDictPrefUpdate update(prefs, kCoveSidebarPref);
+  const std::string* active = update->FindString("active");
+  base::DictValue* space =
+      active ? FindSpace(*update, *active) : nullptr;
+  if (!space) {
+    return;
+  }
+  base::ListValue* pins = space->EnsureList("pins");
+  for (const base::Value& pin : *pins) {
+    const base::DictValue* dict = pin.GetIfDict();
+    const std::string* existing = dict ? dict->FindString("url") : nullptr;
+    if (existing && *existing == url.spec()) {
+      return;
+    }
+  }
+  base::DictValue pin;
+  pin.Set("id", base::Uuid::GenerateRandomV4().AsLowercaseString());
+  pin.Set("url", url.spec());
+  pin.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  pin.Set("folder", "");
+  pins->Append(std::move(pin));
+  Rebuild();
+}
+
+void CoveSidebarLibraryView::EnsureDefaultLibrary() {
+  PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  if (prefs->GetDict(kCoveSidebarPref).FindList("spaces")) {
+    return;
+  }
+  base::DictValue personal;
+  personal.Set("id", "personal");
+  personal.Set("name", "Personal");
+  personal.Set("color", "#6d6784");
+  personal.Set("tabs", base::ListValue());
+  personal.Set("pins", base::ListValue());
+  personal.Set("folders", base::ListValue());
+
+  base::DictValue work;
+  work.Set("id", "work");
+  work.Set("name", "Work");
+  work.Set("color", "#3d6f8f");
+  work.Set("tabs", base::ListValue());
+  work.Set("pins", base::ListValue());
+  work.Set("folders", base::ListValue());
+
+  base::ListValue spaces;
+  spaces.Append(std::move(personal));
+  spaces.Append(std::move(work));
+  base::DictValue root;
+  root.Set("active", "personal");
+  root.Set("spaces", std::move(spaces));
+  prefs->SetDict(kCoveSidebarPref, std::move(root));
+}
