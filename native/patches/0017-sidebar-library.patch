+
+base::DictValue* FindSpace(base::DictValue& root, std::string_view id) {
+  base::ListValue* spaces = root.FindList("spaces");
+  if (!spaces) {
+    return nullptr;
+  }
+  for (base::Value& space : *spaces) {
+    base::DictValue* dict = space.GetIfDict();
+    if (dict && dict->FindString("id") && *dict->FindString("id") == id) {
+      return dict;
+    }
+  }
+  return nullptr;
+}
+
+const base::DictValue* FindSpace(const base::DictValue& root,
+                                   std::string_view id) {
+  const base::ListValue* spaces = root.FindList("spaces");
+  if (!spaces) {
+    return nullptr;
+  }
+  for (const base::Value& space : *spaces) {
+    const base::DictValue* dict = space.GetIfDict();
+    if (dict && dict->FindString("id") && *dict->FindString("id") == id) {
+      return dict;
+    }
+  }
+  return nullptr;
+}
+
+views::Label* MakeHeader(views::View* parent, const std::u16string& text) {
+  auto* label = parent->AddChildView(std::make_unique<views::Label>(text));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetSkipSubpixelRenderingOpacityCheck(true);
+  label->SetEnabledColor(ui::kColorLabelForegroundSecondary);
+  label->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(8, 2, 2, 2));
+  return label;
+}
+
+views::LabelButton* MakeRow(views::View* parent,
+                            const std::u16string& text,
+                            views::Button::PressedCallback callback) {
+  auto* button = parent->AddChildView(
+      std::make_unique<views::LabelButton>(std::move(callback), text));
+  button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  button->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 8)));
+  return button;
+}
