+
+void TabSearchPageHandler::OpenSearch(const std::string& text) {
+  // Reuse the omnibox classifier so URL fixing and the user's chosen search
+  // engine stay consistent with normal address-bar navigation.
+  if (!browser_ || browser_->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  std::u16string input;
+  base::TrimWhitespace(base::UTF8ToUTF16(text), base::TRIM_ALL, &input);
+  if (input.empty()) {
+    return;
+  }
+  auto* classifier = AutocompleteClassifierFactory::GetForProfile(profile_);
+  if (!classifier) {
+    return;
+  }
+  AutocompleteMatch match;
+  classifier->Classify(input, false, false, metrics::OmniboxEventProto::BLANK,
+                       &match, nullptr);
+  if (!match.destination_url.is_valid() ||
+      match.destination_url.SchemeIs(url::kJavaScriptScheme)) {
+    return;
+  }
+
+  NavigateParams params(browser_, match.destination_url,
+                        ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.user_gesture = true;
+  // Tab activation can close the bubble. Retain only its weak embedder across
+  // navigation so no handler-owned state is accessed after that activation.
+  auto embedder = webui_controller_->embedder();
+  Navigate(&params);
+
+  // Closing the native bubble also returns keyboard focus to the new page.
+  if (embedder) {
+    embedder->CloseUI();
+  }
 }
 
