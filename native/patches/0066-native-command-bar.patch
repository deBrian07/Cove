+// Keep the old fixture's WebUI tests separate from Cove's primary native path.
+class CoveNativeCommandBarBrowserTest : public InProcessBrowserTest {};
+
+IN_PROC_BROWSER_TEST_F(
+    CoveNativeCommandBarBrowserTest,
+    FirstInputHasNativeFocusAndSidebarShortcutOnlyDismisses) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* host = view->GetTabSearchBubbleHost();
+  auto* controller = tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(controller);
+  const auto collapse_state = controller->GetCollapseState();
+  ASSERT_TRUE(host->ShowTabSearchBubble());
+  auto* widget = host->native_palette_widget_for_testing();
+  ASSERT_TRUE(widget);
+  auto* bar = static_cast<CoveCommandBarView*>(widget->GetContentsView());
+  ASSERT_EQ(bar->search_field_for_testing(),
+            widget->GetFocusManager()->GetFocusedView());
+  // Directly dispatch through the native input controller, without a renderer
+  // load or a Mojo readiness event. The shortcut must close only the widget.
+  ui::KeyEvent shortcut(ui::EventType::kKeyPressed, ui::VKEY_S,
+                        ui::EF_COMMAND_DOWN);
+  EXPECT_TRUE(bar->HandleKeyEvent(bar->search_field_for_testing(), shortcut));
+  EXPECT_TRUE(widget->IsClosed());
+  EXPECT_EQ(collapse_state, controller->GetCollapseState());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(nullptr, host->native_palette_widget_for_testing());
+}
