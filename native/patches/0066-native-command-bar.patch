+class CommandRow : public views::Button {
+  METADATA_HEADER(CommandRow, views::Button)
+ public:
+  CommandRow(PressedCallback callback,
+             const std::u16string& title,
+             const std::u16string& detail,
+             const std::u16string& action,
+             const ui::ImageModel& icon)
+      : Button(std::move(callback)) {
+    SetFocusBehavior(FocusBehavior::NEVER);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(9, 12)));
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 12));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto* image = AddChildView(std::make_unique<views::ImageView>());
+    image->SetImage(icon);
+    image->SetImageSize(gfx::Size(20, 20));
+    auto* text = AddChildView(std::make_unique<views::View>());
+    auto* lines = text->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 3));
+    lines->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStretch);
+    layout->SetFlexForView(text, 1);
+    title_ = text->AddChildView(std::make_unique<views::Label>(title));
+    title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_->SetEnabledColor(kText);
+    title_->SetAutoColorReadabilityEnabled(false);
+    detail_ = text->AddChildView(std::make_unique<views::Label>(detail));
+    detail_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    detail_->SetEnabledColor(kMuted);
+    detail_->SetAutoColorReadabilityEnabled(false);
+    detail_->SetVisible(!detail.empty());
+    auto* hint = AddChildView(std::make_unique<views::Label>(action));
+    hint->SetEnabledColor(kMuted);
+    hint->SetAutoColorReadabilityEnabled(false);
+    GetViewAccessibility().SetName(title + u" " + detail + u" " + action);
+    SetPreferredSize(gfx::Size(100, 58));
+  }
+  void SetSelected(bool selected) {
+    SetBackground(selected ? views::CreateRoundedRectBackground(kSelection, 8)
+                           : nullptr);
+    detail_->SetEnabledColor(selected ? kText : kMuted);
+    GetViewAccessibility().SetIsSelected(selected);
+    SchedulePaint();
+  }
+
+ private:
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> detail_ = nullptr;
+};
