+// Keep dialog/window ownership separate from the native content view.
+class CommandBarDelegate : public views::BubbleDialogDelegate {
+ public:
+  explicit CommandBarDelegate(views::View* anchor)
+      : BubbleDialogDelegate(anchor, views::BubbleBorder::FLOAT) {
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    SetTitle(u"Search or Enter URL");
+    SetShowTitle(false);
+    SetBackgroundColor(kGround);
+    set_corner_radius(14);
+    set_margins(gfx::Insets(10));
+  }
+  gfx::Rect GetAnchorRect() const override {
+    if (GetAnchorView() && GetAnchorView()->GetWidget()) {
+      return gfx::Rect(GetAnchorView()->GetWidget()
+                           ->GetWindowBoundsInScreen().CenterPoint(),
+                       gfx::Size());
+    }
+    return BubbleDialogDelegate::GetAnchorRect();
+  }
+};
