+// The primary input surface is native: input never waits on a renderer or Mojo.
+class CoveCommandBarView : public views::View,
+                           public views::TextfieldController {
+  METADATA_HEADER(CoveCommandBarView, views::View)
+ public:
+  static views::Widget* Show(BrowserWindowInterface* browser);
+  explicit CoveCommandBarView(BrowserWindowInterface* browser);
+  ~CoveCommandBarView() override;
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override;
+  views::Textfield* search_field_for_testing() { return input_; }
+
+ private:
+  enum class Kind { kTab, kRestore, kNavigate, kCommand };
+  struct Row {
+    Kind kind;
+    std::u16string title;
+    std::u16string detail;
+    std::u16string action;
+    ui::ImageModel icon;
+    int id = 0;
+  };
+  views::View* GetAnchorView() const;
+  void Rebuild();
+  void Select(int selection);
+  void RunRow(size_t index, bool force_new_tab = false);
+  void Dismiss();
+  void RunTypedText(bool force_new_tab);
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Textfield> input_ = nullptr;
+  raw_ptr<views::View> rows_view_ = nullptr;
+  std::vector<Row> rows_;
+  std::vector<raw_ptr<views::View>> row_views_;
+  int selected_ = 0;
+  int width_ = 760;
+  base::WeakPtrFactory<CoveCommandBarView> weak_factory_{this};
+};
+#endif
