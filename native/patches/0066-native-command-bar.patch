+views::Widget* CoveCommandBarView::Show(BrowserWindowInterface* browser) {
+  const auto started = base::TimeTicks::Now();
+  auto contents = std::make_unique<CoveCommandBarView>(browser);
+  auto* bar = contents.get();
+  auto delegate = std::make_unique<CommandBarDelegate>(
+      BrowserView::GetBrowserViewForBrowser(browser));
+  delegate->SetInitiallyFocusedView(bar->input_);
+  delegate->SetContentsView(std::move(contents));
+  auto* widget = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(delegate), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  widget->Show();
+  widget->Activate();
+  bar->input_->RequestFocus();
+  VLOG(1) << "Cove native palette show_call_ms="
+          << (base::TimeTicks::Now() - started).InMillisecondsF()
+          << " input_focused=" << bar->input_->HasFocus();
+  widget->GetCompositor()->RequestSuccessfulPresentationTimeForNextFrame(
+      base::BindOnce(
+          [](base::TimeTicks start, const viz::FrameTimingDetails& timing) {
+            VLOG(1) << "Cove native palette presentation_ms="
+                    << (timing.presentation_feedback.timestamp - start)
+                           .InMillisecondsF();
+          },
+          started));
+  return widget;
+}
+
+CoveCommandBarView::CoveCommandBarView(BrowserWindowInterface* browser)
+    : browser_(browser->GetWeakPtr()) {
+  SetBackground(views::CreateRoundedRectBackground(kGround, 14));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 6));
+  if (GetAnchorView()) {
+    width_ = std::clamp(GetAnchorView()->width() - 48, 280, 760);
+  }
+  input_ = AddChildView(std::make_unique<views::Textfield>());
+  input_->set_controller(this);
+  input_->SetTextInputType(ui::TEXT_INPUT_TYPE_SEARCH);
+  input_->SetPlaceholderText(u"Search or Enter URL…");
+  input_->GetViewAccessibility().SetName(u"Search or Enter URL");
+  input_->SetDefaultWidthInChars(1);
+  input_->SetPreferredSize(gfx::Size(width_ - 20, 52));
+  input_->SetBackgroundColor(kGround);
+  input_->SetColor(kText);
+  input_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(8, 14)));
+  input_->SetFontList(gfx::FontList().DeriveWithSizeDelta(5));
+  rows_view_ = AddChildView(std::make_unique<views::View>());
+  rows_view_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 4));
+  auto* footer = AddChildView(std::make_unique<views::Label>(
+      u"↑ ↓ navigate    ↩ open    ⌘↩ search    / commands    esc close"));
+  footer->SetEnabledColor(kMuted);
+  footer->SetAutoColorReadabilityEnabled(false);
+  footer->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(8, 12)));
+  footer->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  Rebuild();
+}
+
+CoveCommandBarView::~CoveCommandBarView() = default;
+views::View* CoveCommandBarView::GetAnchorView() const {
+  return browser_ ? BrowserView::GetBrowserViewForBrowser(browser_.get()) : nullptr;
+}
+
+void CoveCommandBarView::ContentsChanged(views::Textfield*,
+                                         const std::u16string&) {
+  input_->SetColor(kText);
+  selected_ = 0;
+  Rebuild();
+}
+
+bool CoveCommandBarView::HandleKeyEvent(views::Textfield*,
+                                        const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed || event.is_char() ||
+      input_->IsIMEComposing()) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_ESCAPE ||
+      (event.key_code() == ui::VKEY_S && event.IsCommandDown() &&
+       !event.IsShiftDown() && !event.IsAltDown() && !event.IsControlDown())) {
+    Dismiss();
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_DOWN || event.key_code() == ui::VKEY_UP) {
+    if (!rows_.empty()) {
+      const int count = static_cast<int>(rows_.size());
+      Select(
+          (selected_ + (event.key_code() == ui::VKEY_DOWN ? 1 : -1) + count) %
+          count);
+    }
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    if (event.IsCommandDown() && !input_->GetText().empty()) {
+      RunTypedText(true);
+    } else if (!rows_.empty()) {
+      RunRow(selected_);
+    }
+    return true;
+  }
+  return false;
+}
+
+void CoveCommandBarView::Rebuild() {
+  rows_.clear();
+  const size_t max_rows = static_cast<size_t>(std::clamp(
+      ((GetAnchorView() ? GetAnchorView()->height() : 700) - 154) / 62, 1,
+      static_cast<int>(kMaxRows)));
+  std::u16string query;
+  base::TrimWhitespace(input_->GetText(), base::TRIM_ALL, &query);
+  query = base::ToLowerASCII(query);
+  const auto globe =
+      ui::ImageModel::FromVectorIcon(vector_icons::kGlobeIcon, kMuted, 20);
+  const bool explicit_actions = query.starts_with(u"/") || query.starts_with(u">");
+  const auto* active_tab = browser_ ? browser_->GetTabStripModel()->GetActiveTab() : nullptr;
+  const bool pinned = active_tab && active_tab->IsPinned();
+  const bool is_split = active_tab && active_tab->IsSplit();
+  struct Action {
+    int id;
+    const char16_t* title;
+    bool enabled;
+  };
+  const Action commands[] = {
+      {IDC_WINDOW_PIN_TAB, pinned ? u"Unpin Tab" : u"Pin Tab", true},
+      {IDC_TOGGLE_VERTICAL_TABS_COLLAPSE, u"Toggle Sidebar", true},
+      {IDC_NEW_SPLIT_TAB, u"Add Split View", !is_split},
+      {IDC_COVE_REMOVE_SPLIT, u"Separate Split View", is_split},
+      {IDC_COVE_FOCUS_SPLIT_LEFT, u"Focus Left Pane", is_split},
+      {IDC_COVE_FOCUS_SPLIT_RIGHT, u"Focus Right Pane", is_split},
+      {IDC_DUPLICATE_TAB, u"Duplicate Tab", true},
+      {IDC_RESTORE_TAB, u"Reopen Closed Tab", true},
+      {IDC_COPY_URL, u"Copy Current URL", true},
+  };
+  bool actions = explicit_actions;
+  if (!actions && query.size() >= 2 && browser_) {
+    for (const auto& command : commands) {
+      if (command.enabled &&
+          chrome::IsCommandEnabled(browser_.get(), command.id) &&
+          Matches(command.title, query)) {
+        actions = true;
+        break;
+      }
+    }
+  }
+  if (actions && browser_) {
+    const auto words = explicit_actions ? query.substr(1) : query;
+    std::u16string action_query;
+    base::TrimWhitespace(words, base::TRIM_ALL, &action_query);
+    for (const auto& command : commands) {
+      if (rows_.size() == max_rows) {
+        break;
+      }
+      if (command.enabled &&
+          chrome::IsCommandEnabled(browser_.get(), command.id) &&
+          Matches(command.title, action_query)) {
+        rows_.push_back({Kind::kCommand, command.title, u"Browser command",
+                         u"Run ↩", globe, command.id});
+      }
+    }
+  } else if (browser_) {
+    if (!query.empty()) {
+      AutocompleteMatch match;
+      if (auto* classifier = AutocompleteClassifierFactory::GetForProfile(
+              browser_->GetProfile())) {
+        classifier->Classify(std::u16string(input_->GetText()), false, false,
+                             metrics::OmniboxEventProto::BLANK, &match,
+                             nullptr);
+      }
+      const bool search = !match.destination_url.is_valid() ||
+                          AutocompleteMatch::IsSearchType(match.type);
+      rows_.push_back(
+          {Kind::kNavigate,
+           std::u16string(search ? u"Search for “" : u"Open “") +
+               std::u16string(input_->GetText()) + u"”",
+           search ? u"Your default search engine"
+                  : base::UTF8ToUTF16(match.destination_url.spec()),
+           search ? u"Search ↩" : u"Open ↩", globe});
+    }
+    ProfileBrowserCollection::GetForProfile(browser_->GetProfile())
+        ->ForEach([&](BrowserWindowInterface* window) {
+          if (window->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+            return true;
+          }
+          auto* model = window->GetTabStripModel();
+          for (int i = 0; i < model->count() && rows_.size() < max_rows; ++i) {
+            auto* tab = model->GetTabAtIndex(i);
+            auto* contents = tab->GetContents();
+            if (IsCoveEmptyCanvas(contents)) {
+              continue;
+            }
+            std::u16string title = contents->GetTitle();
+            if (title.empty()) {
+              title = base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+            }
+            const auto url =
+                base::UTF8ToUTF16(contents->GetVisibleURL().spec());
+            if (!Matches(title + u" " + url, query)) {
+              continue;
+            }
+            auto icon = globe;
+            if (auto* driver =
+                    favicon::ContentFaviconDriver::FromWebContents(contents)) {
+              const auto image = driver->GetFavicon();
+              if (!image.IsEmpty()) {
+                icon = ui::ImageModel::FromImage(image);
+              }
+            }
+            rows_.push_back({Kind::kTab, title, url, u"Switch to Tab →", icon,
+                             tab->GetHandle().raw_value()});
+          }
+          return rows_.size() < max_rows;
+        });
+    if (auto* service =
+            TabRestoreServiceFactory::GetForProfile(browser_->GetProfile())) {
+      for (const auto& entry : service->entries()) {
+        if (rows_.size() >= max_rows) {
+          break;
+        }
+        const sessions::tab_restore::Tab* tab = nullptr;
+        std::u16string prefix;
+        size_t count = 1;
+        switch (entry->type) {
+          case sessions::tab_restore::TAB:
+            tab = static_cast<const sessions::tab_restore::Tab*>(entry.get());
+            break;
+          case sessions::tab_restore::GROUP: {
+            const auto& group =
+                static_cast<const sessions::tab_restore::Group&>(*entry);
+            if (!group.tabs.empty()) {
+              tab = group.tabs.front().get();
+            }
+            prefix = group.visual_data.title().empty()
+                         ? u"Folder: "
+                         : group.visual_data.title() + u": ";
+            count = group.tabs.size();
+            break;
+          }
+          case sessions::tab_restore::SPLIT: {
+            const auto& split =
+                static_cast<const sessions::tab_restore::Split&>(*entry);
+            if (!split.tabs.empty()) {
+              tab = split.tabs.front().get();
+            }
+            prefix = u"Split: ";
+            count = split.tabs.size();
+            break;
+          }
+          case sessions::tab_restore::WINDOW: {
+            const auto& window =
+                static_cast<const sessions::tab_restore::Window&>(*entry);
+            if (!window.tabs.empty()) {
+              tab = window.tabs.front().get();
+            }
+            prefix = u"Window: ";
+            count = window.tabs.size();
+            break;
+          }
+        }
+        if (!tab || tab->navigations.empty()) {
+          continue;
+        }
+        const auto& navigation =
+            tab->navigations[tab->normalized_navigation_index()];
+        auto title = navigation.title();
+        const auto url = base::UTF8ToUTF16(navigation.virtual_url().spec());
+        if (title.empty()) {
+          title = url;
+        }
+        title = prefix + title;
+        if (!Matches(title + u" " + url, query)) {
+          continue;
+        }
+        rows_.push_back(
+            {Kind::kRestore, title,
+             count > 1 ? base::NumberToString16(count) + u" tabs" : url,
+             u"Recently Closed ↩", globe, entry->id.id()});
+      }
+    }
+  }
+  rows_view_->RemoveAllChildViews();
+  row_views_.clear();
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    const auto& row = rows_[i];
+    row_views_.push_back(rows_view_->AddChildView(std::make_unique<CommandRow>(
+        base::BindRepeating(&CoveCommandBarView::RunRow,
+                            weak_factory_.GetWeakPtr(), i, false),
+        row.title, row.detail, row.action, row.icon)));
+  }
+  if (rows_.empty()) {
+    auto* empty = rows_view_->AddChildView(std::make_unique<views::Label>(
+        actions ? u"No matching command" : u"Type a URL or search"));
+    empty->SetEnabledColor(kMuted);
+    empty->SetAutoColorReadabilityEnabled(false);
+    empty->SetPreferredSize(gfx::Size(100, 58));
+  }
+  selected_ =
+      std::clamp(selected_, 0, std::max(0, static_cast<int>(rows_.size()) - 1));
+  Select(selected_);
+  SetPreferredSize(
+      gfx::Size(width_, 52 + 34 + 20 + 62 * std::max(size_t{1}, rows_.size())));
+  if (GetWidget()) {
+    GetWidget()->widget_delegate()->AsBubbleDialogDelegate()->SizeToContents();
+  }
+}
+
+void CoveCommandBarView::Select(int selection) {
+  selected_ = selection;
+  for (size_t i = 0; i < row_views_.size(); ++i) {
+    static_cast<CommandRow*>(row_views_[i].get())
+        ->SetSelected(static_cast<int>(i) == selected_);
+  }
+}
+
+void CoveCommandBarView::Dismiss() {
+  auto browser = browser_;
+  if (GetWidget()) {
+    GetWidget()->CloseWithReason(views::Widget::ClosedReason::kEscKeyPressed);
+  }
+  if (browser) {
+    if (auto* contents = browser->GetTabStripModel()->GetActiveWebContents()) {
+      contents->Focus();
+    }
+  }
+}
+
+void CoveCommandBarView::RunTypedText(bool /*force_new_tab*/) {
+  if (!browser_) {
+    return;
+  }
+  std::u16string text;
+  base::TrimWhitespace(input_->GetText(), base::TRIM_ALL, &text);
+  if (text.empty()) {
+    return;
+  }
+  auto* classifier =
+      AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile());
+  if (!classifier) {
+    return;
+  }
+  AutocompleteMatch match;
+  classifier->Classify(text, false, false, metrics::OmniboxEventProto::BLANK,
+                       &match, nullptr);
+  if (!match.destination_url.is_valid() ||
+      match.destination_url.SchemeIs(url::kJavaScriptScheme)) {
+    return;
+  }
+  auto browser = browser_;
+  const auto url = match.destination_url;
+  Dismiss();
+  if (!browser) {
+    return;
+  }
+  NavigateParams params(browser.get(), url, ui::PAGE_TRANSITION_TYPED);
+  // Cmd+T creates a new tab; Cmd+Enter explicitly keeps that same convention.
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.user_gesture = true;
+  Navigate(&params);
+}
+
+void CoveCommandBarView::RunRow(size_t index, bool force_new_tab) {
+  if (index >= rows_.size() || !browser_) {
+    return;
+  }
+  const Row row = rows_[index];
+  if (row.kind == Kind::kNavigate) {
+    RunTypedText(force_new_tab);
+    return;
+  }
+  auto browser = browser_;
+  Dismiss();
+  if (!browser) {
+    return;
+  }
+  if (row.kind == Kind::kCommand) {
+    if (chrome::IsCommandEnabled(browser.get(), row.id)) {
+      chrome::ExecuteCommand(browser.get(), row.id);
+    }
+  } else if (row.kind == Kind::kTab) {
+    // Resolve the stable handle now: a closed tab never means its old
+    // neighbour.
+    auto* tab = tabs::TabHandle(row.id).Get();
+    if (!tab) {
+      return;
+    }
+    auto* owner = tab->GetBrowserWindowInterface();
+    if (!owner || owner->GetProfile() != browser->GetProfile()) {
+      return;
+    }
+    owner->GetTabStripModel()->ActivateTab(tab);
+    BrowserWindow::FromBrowser(owner)->Activate();
+    tab->GetContents()->Focus();
+  } else if (row.kind == Kind::kRestore) {
+    auto* service =
+        TabRestoreServiceFactory::GetForProfile(browser->GetProfile());
+    if (!service) {
+      return;
+    }
+    const auto id = SessionID::FromSerializedValue(row.id);
+    bool exists = false;
+    for (const auto& entry : service->entries()) {
+      exists |= entry->id == id;
+    }
+    if (!exists) {
+      return;
+    }
+    auto* contents = browser->GetTabStripModel()->GetActiveWebContents();
+    service->RestoreEntryById(
+        BrowserLiveTabContext::FindContextForWebContents(contents), id,
+        WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  }
+}
