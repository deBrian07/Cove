+
+void CoveSidebarLibraryView::ToggleFolder(std::string folder_id) {
+  ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(),
+                              kCoveSidebarPref);
+  auto* space = FindSpace(*update, active_space_id_);
+  auto* folders = space ? space->FindList("folders") : nullptr;
+  if (!folders) {
+    return;
+  }
+  for (auto& value : *folders) {
+    auto* folder = value.GetIfDict();
+    if (folder && folder->FindString("id") &&
+        *folder->FindString("id") == folder_id) {
+      folder->Set("collapsed", !folder->FindBool("collapsed").value_or(false));
+      return;  // The preference observer rebuilds every window's library.
+    }
+  }
 }
 
