+
+// Switching again while a Space slide is running must continue from what is on
+// screen: no snap to the resting position and no restart from off-screen.
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       InterruptedSpaceSlideContinuesFromScreen) {
+  Seed();
+  auto rich = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  gfx::ScopedAnimationDurationScaleMode slow(
+      gfx::ScopedAnimationDurationScaleMode::SLOW_DURATION);
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* region = view->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(region);
+  const float width = region->width();
+  ASSERT_GT(width, 0);
+
+  // Reversal: personal -> work -> personal before the first slide settles.
+  SwitchSpaceForIconTest("work");
+  ASSERT_EQ(1u, region->space_snapshot_transforms_for_testing().size());
+  const float departing =
+      region->space_snapshot_transforms_for_testing()[0].To2dTranslation().x();
+  SwitchSpaceForIconTest("personal");
+  const float incoming =
+      region->space_rows_transform_for_testing().To2dTranslation().x();
+  // The returning rows start where their departing copy was, not a full
+  // sidebar width away.
+  EXPECT_FLOAT_EQ(departing, incoming);
+  EXPECT_LT(std::abs(incoming), width);
+  EXPECT_EQ(1u, region->space_snapshot_transforms_for_testing().size());
+
+  // Settling clears every copy and leaves the rows at rest.
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return region->space_snapshot_transforms_for_testing().empty();
+  }));
+  EXPECT_TRUE(region->space_rows_transform_for_testing().IsIdentity());
+}
