+
+std::vector<gfx::Transform>
+VerticalTabStripRegionView::space_snapshot_transforms_for_testing() const {
+  std::vector<gfx::Transform> result;
+  for (const auto& departing : space_departing_snapshots_) {
+    result.push_back(departing->root()->transform());
+  }
+  if (space_snapshot_) {
+    result.push_back(space_snapshot_->root()->transform());
+  }
+  return result;
+}
