+++ b/chrome/browser/ui/views/cove/cove_event_location_mac.mm
@@ -0,0 +1,40 @@
+// Copyright 2026 The Cove Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/cove/cove_event_location.h"
+
+#import <AppKit/AppKit.h>
+
+#include "ui/events/event.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+
+std::optional<gfx::Point> CoveNativeEventScreenLocation(
+    const ui::Event& event) {
+  if (!event.IsMouseEvent() || !event.HasNativeEvent()) {
+    return std::nullopt;
+  }
+  NSEvent* native = event.native_event().Get();
+  if (!native) {
+    return std::nullopt;
+  }
+  switch (native.type) {
+    case NSEventTypeLeftMouseDown:
+    case NSEventTypeRightMouseDown:
+    case NSEventTypeOtherMouseDown:
+    case NSEventTypeLeftMouseUp:
+    case NSEventTypeRightMouseUp:
+    case NSEventTypeOtherMouseUp:
+      break;
+    default:
+      return std::nullopt;
+  }
+  // locationInWindow is window-relative for events with a window and already
+  // in Cocoa screen coordinates for window-less events. Avoid
+  // ui::EventSystemLocationFromNative: it is NOTIMPLEMENTED on macOS here.
+  NSPoint point = native.locationInWindow;
+  if (NSWindow* window = native.window) {
+    point = [window convertPointToScreen:point];
+  }
+  return gfx::ScreenPointFromNSPoint(point);
+}
