+#ifndef CHROME_BROWSER_UI_VIEWS_COVE_COVE_EVENT_LOCATION_H_
+#define CHROME_BROWSER_UI_VIEWS_COVE_COVE_EVENT_LOCATION_H_
+
+#include <optional>
+
+#include "ui/gfx/geometry/point.h"
+
+namespace ui {
+class Event;
+}
+
+// Screen location recorded in a mouse event's native platform event, i.e.
+// where the press actually happened. Returns nullopt for events without a
+// native mouse event; callers then fall back to the current cursor position.
+// The cursor may have moved since a queued press, so prefer this value.
+std::optional<gfx::Point> CoveNativeEventScreenLocation(const ui::Event& event);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_COVE_COVE_EVENT_LOCATION_H_
