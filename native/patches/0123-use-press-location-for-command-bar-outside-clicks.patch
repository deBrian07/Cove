+// The palette must judge a press by where it happened, not by where the cursor
+// is when the monitor runs. Cover both disagreements deterministically.
+IN_PROC_BROWSER_TEST_F(CoveCaptionButtonsBrowserTest,
+                       OutsideClickUsesPressLocationNotCursor) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* host = view->GetTabSearchBubbleHost();
+  ASSERT_TRUE(host);
+  auto* page = browser()->GetTabStripModel()->GetActiveWebContents();
+  const auto page_bounds = page->GetRenderWidgetHostView()->GetViewBounds();
+  const gfx::Point page_point(page_bounds.right() - 40,
+                              page_bounds.bottom() - 40);
+
+  host->ShowTabSearchBubble(true);
+  auto* palette = host->native_palette_widget_for_testing();
+  ASSERT_TRUE(palette);
+  ASSERT_TRUE(base::test::RunUntil([&] { return palette->IsVisible(); }));
+  auto* bar = views::AsViewClass<CoveCommandBarView>(
+      palette->widget_delegate()->GetContentsView());
+  ASSERT_TRUE(bar);
+  ASSERT_FALSE(palette->GetWindowBoundsInScreen().Contains(page_point));
+  const gfx::Point inside =
+      bar->search_field_for_testing()->GetBoundsInScreen().CenterPoint();
+
+  // Cursor outside, press inside: the palette stays open.
+  base::test::TestFuture<void> moved_out;
+  ASSERT_TRUE(ui_controls::SendMouseMoveNotifyWhenDone(
+      page_point.x(), page_point.y(), moved_out.GetCallback(),
+      view->GetWidget()->GetNativeWindow()));
+  ASSERT_TRUE(moved_out.Wait());
+  auto inside_press = CoveNativePressAt(
+      palette->GetNativeWindow().GetNativeNSWindow(), inside);
+  ASSERT_TRUE(inside_press);
+  bar->OnEvent(*inside_press);
+  EXPECT_TRUE(palette->IsVisible());
+
+  // Cursor inside, press outside on the page: the palette hides and stays
+  // cached for the next opening.
+  base::test::TestFuture<void> moved_in;
+  ASSERT_TRUE(ui_controls::SendMouseMoveNotifyWhenDone(
+      inside.x(), inside.y(), moved_in.GetCallback(),
+      palette->GetNativeWindow()));
+  ASSERT_TRUE(moved_in.Wait());
+  auto outside_press = CoveNativePressAt(
+      view->GetWidget()->GetNativeWindow().GetNativeNSWindow(), page_point);
+  ASSERT_TRUE(outside_press);
+  bar->OnEvent(*outside_press);
+  EXPECT_FALSE(palette->IsVisible());
+  EXPECT_EQ(palette, host->native_palette_widget_for_testing());
+}
