+std::vector<CoveSpaceInfo> CoveSidebarLibraryView::GetSpaces() const {
+  std::vector<CoveSpaceInfo> result;
+  if (browser_->GetProfile()->IsOffTheRecord()) return result;
+  const auto* spaces = browser_->GetProfile()->GetPrefs()
+                           ->GetDict(kCoveSidebarPref).FindList("spaces");
+  if (!spaces) return result;
+  for (const auto& value : *spaces) {
+    const auto* space = value.GetIfDict();
+    const auto* id = space ? space->FindString("id") : nullptr;
+    const auto* name = space ? space->FindString("name") : nullptr;
+    if (id) result.push_back({*id, name ? base::UTF8ToUTF16(*name) : u"Space"});
+  }
+  return result;
+}
+
+void CoveSidebarLibraryView::FocusSpace(std::string space_id) {
+  SwitchSpace(std::move(space_id));
+}
+
+std::string CoveSidebarLibraryView::ActivePinId() const {
+  const auto* tab = browser_->GetTabStripModel()->GetActiveTab();
+  if (!tab || !RetainsPinForTab(tab)) return {};
+  const auto found = tab_pin_ids_.find(tab->GetHandle().raw_value());
+  if (found != tab_pin_ids_.end() && found->second.first == active_space_id_)
+    return found->second.second;
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+                                   ->GetDict(kCoveSidebarPref), active_space_id_);
+  const auto* pins = space ? space->FindList("pins") : nullptr;
+  if (pins) for (const auto& value : *pins) {
+    const auto* pin = value.GetIfDict();
+    const auto* id = pin ? pin->FindString("id") : nullptr;
+    const auto* url = pin ? pin->FindString("url") : nullptr;
+    if (id && url && GURL(*url) == tab->GetContents()->GetVisibleURL()) return *id;
+  }
+  return {};
+}
+
+bool CoveSidebarLibraryView::CanExecuteArcCommand(int id) const {
+  if (!browser_ || browser_->GetProfile()->IsOffTheRecord() || switching_space_ ||
+      closing_active_space_) return false;
+  const auto spaces = GetSpaces();
+  if (id >= IDC_COVE_SPACE_FIRST && id <= IDC_COVE_SPACE_LAST)
+    return static_cast<size_t>(id - IDC_COVE_SPACE_FIRST) < spaces.size();
+  if (id == IDC_COVE_NEXT_SPACE || id == IDC_COVE_PREVIOUS_SPACE) {
+    for (size_t i = 0; i < spaces.size(); ++i) if (spaces[i].id == active_space_id_)
+      return id == IDC_COVE_NEXT_SPACE ? i + 1 < spaces.size() : i > 0;
+    return false;
+  }
+  if (id == IDC_COVE_CLEAR_TODAY) return HasArchivableTabs();
+  if (id == IDC_COVE_RESET_PIN || id == IDC_COVE_RENAME_PIN)
+    return !ActivePinId().empty();
+  if (id == IDC_COVE_REPLACE_PIN || id == IDC_COVE_TOGGLE_FAVORITE) {
+    auto* contents = browser_->GetTabStripModel()->GetActiveWebContents();
+    const bool safe = contents && (contents->GetVisibleURL().SchemeIsHTTPOrHTTPS() ||
+                                  contents->GetVisibleURL().SchemeIsFile());
+    return safe && (id == IDC_COVE_REPLACE_PIN ? !ActivePinId().empty()
+                                              : !toggle_favorite_.is_null());
+  }
+  if (id == IDC_COVE_RESET_SPACE) {
+    const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+                                     ->GetDict(kCoveSidebarPref), active_space_id_);
+    const auto* pins = space ? space->FindList("pins") : nullptr;
+    return pins && !pins->empty();
+  }
+  return id == IDC_COVE_NEW_SPACE || id == IDC_COVE_NEW_FOLDER ||
+         id == IDC_COVE_RENAME_SPACE;
+}
+
+void CoveSidebarLibraryView::ResetPinHomes(bool entire_space) {
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+                                   ->GetDict(kCoveSidebarPref), active_space_id_);
+  const auto* pins = space ? space->FindList("pins") : nullptr;
+  if (!pins) return;
+  std::map<std::string, GURL> homes;
+  for (const auto& value : *pins) {
+    const auto* pin = value.GetIfDict();
+    const auto* id = pin ? pin->FindString("id") : nullptr;
+    const auto* url = pin ? pin->FindString("url") : nullptr;
+    if (id && url && GURL(*url).is_valid() && !GURL(*url).SchemeIs("javascript"))
+      homes.emplace(*id, GURL(*url));
+  }
+  auto* model = browser_->GetTabStripModel();
+  std::vector<std::pair<tabs::TabHandle, GURL>> targets;
+  for (int i = 0; i < model->count(); ++i) {
+    auto* tab = model->GetTabAtIndex(i);
+    if (!tab->IsPinned() || (!entire_space && tab != model->GetActiveTab())) continue;
+    const auto binding = tab_pin_ids_.find(tab->GetHandle().raw_value());
+    const std::string id = binding != tab_pin_ids_.end() &&
+                          binding->second.first == active_space_id_
+                              ? binding->second.second
+                              : (tab == model->GetActiveTab() ? ActivePinId() : "");
+    const auto home = homes.find(id);
+    if (home != homes.end() && home->second != tab->GetContents()->GetVisibleURL())
+      targets.emplace_back(tab->GetHandle(), home->second);
+  }
+  auto weak = weak_factory_.GetWeakPtr();
+  for (const auto& [handle, home] : targets) {
+    if (!weak) return;
+    auto* tab = handle.Get();
+    if (tab && tab->GetBrowserWindowInterface() == browser_)
+      tab->GetContents()->GetController().LoadURL(
+          home, content::Referrer(), ui::PAGE_TRANSITION_AUTO_BOOKMARK, "");
+  }
+}
+
+void CoveSidebarLibraryView::ExecuteArcCommand(int id) {
+  if (!CanExecuteArcCommand(id)) return;
+  if (id >= IDC_COVE_SPACE_FIRST && id <= IDC_COVE_SPACE_LAST) {
+    FocusSpace(GetSpaces()[id - IDC_COVE_SPACE_FIRST].id);
+    return;
+  }
+  switch (id) {
+    case IDC_COVE_NEXT_SPACE: SelectAdjacentSpace(true); break;
+    case IDC_COVE_PREVIOUS_SPACE: SelectAdjacentSpace(false); break;
+    case IDC_COVE_NEW_SPACE:
+      AddSpace();
+      BeginRename(kRenameSpaceCommand, active_space_id_);
+      break;
+    case IDC_COVE_NEW_FOLDER: {
+      AddFolder();
+      const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+                                       ->GetDict(kCoveSidebarPref), active_space_id_);
+      const auto* folders = space ? space->FindList("folders") : nullptr;
+      if (folders && !folders->empty()) {
+        const auto* folder = folders->back().GetIfDict();
+        const auto* folder_id = folder ? folder->FindString("id") : nullptr;
+        if (folder_id) BeginRename(kRenameFolderCommand, *folder_id);
+      }
+      break;
+    }
+    case IDC_COVE_TOGGLE_FAVORITE: toggle_favorite_.Run(); break;
+    case IDC_COVE_CLEAR_TODAY: ArchiveToday(); break;
+    case IDC_COVE_RESET_PIN: ResetPinHomes(false); break;
+    case IDC_COVE_RESET_SPACE: ResetPinHomes(true); break;
+    case IDC_COVE_RENAME_PIN: BeginRename(kRenamePinCommand, ActivePinId()); break;
+    case IDC_COVE_RENAME_SPACE: BeginRename(kRenameSpaceCommand, active_space_id_); break;
+    case IDC_COVE_REPLACE_PIN: {
+      const std::string pin_id = ActivePinId();
+      const std::string url = browser_->GetTabStripModel()->GetActiveWebContents()
+                                  ->GetVisibleURL().spec();
+      ScopedDictPrefUpdate update(browser_->GetProfile()->GetPrefs(), kCoveSidebarPref);
+      auto* space = FindSpace(*update, active_space_id_);
+      auto* pins = space ? space->FindList("pins") : nullptr;
+      if (pins) for (auto& value : *pins) {
+        auto* pin = value.GetIfDict();
+        const auto* current = pin ? pin->FindString("id") : nullptr;
+        if (current && *current == pin_id) { pin->Set("url", url); break; }
+      }
+      break;
+    }
+  }
+}
