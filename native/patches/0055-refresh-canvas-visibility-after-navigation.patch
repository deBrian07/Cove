 void CoveSidebarLibraryView::OnTabChangedAt(tabs::TabInterface*,
                                             TabChangeType) {
+  // An existing placeholder can become a real page without a model insertion.
+  // Refresh its presentation coverage as navigation/title state changes.
+  if (pinned_coverage_changed_) {
+    pinned_coverage_changed_.Run();
+  }
+  if (!switching_space_ && !closing_active_space_) {
+    UpdateArchiveButtonState();
+  }
   // Favicon/title/navigation changes must not recreate buttons while a menu
   // or mouse interaction owns them.
   UpdatePinRowAppearance();
