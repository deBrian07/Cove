+IN_PROC_BROWSER_TEST_F(CoveMiniPlayerBrowserTest,
+                       LeavingPlayingTabFloatsVideoAndReturningClosesIt) {
+  auto* contents = PlayUnregisteredVideo();
+  auto* helper = AutoPictureInPictureTabHelper::FromWebContents(contents);
+
+  content::MediaStartStopObserver entered(contents, StartStop::kEnterPictureInPicture);
+  chrome::AddTabAt(browser(), GURL("about:blank"), -1, true);
+  entered.Wait();
+  EXPECT_TRUE(contents->HasPictureInPictureVideo());
+  EXPECT_TRUE(helper->IsInAutoPictureInPicture());
+  EXPECT_EQ(contents,
+            PictureInPictureWindowManager::GetInstance()->GetWebContents());
+
+  content::MediaStartStopObserver exited(contents, StartStop::kExitPictureInPicture);
+  auto* model = browser()->GetTabStripModel();
+  model->ActivateTabAt(model->GetIndexOfWebContents(contents));
+  exited.Wait();
+  EXPECT_FALSE(contents->HasPictureInPictureVideo());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveMiniPlayerBrowserTest,
+                       SwitchingAppsFloatsVideoAndComingBackClosesIt) {
+  ASSERT_TRUE(base::test::RunUntil([&] { return BrowserWidget()->IsActive(); }));
+  auto* contents = PlayUnregisteredVideo();
+
+  content::MediaStartStopObserver entered(contents, StartStop::kEnterPictureInPicture);
+  auto other_app = ShowOtherAppWindow();
+  ASSERT_TRUE(base::test::RunUntil([&] { return other_app->IsActive(); }));
+  ASSERT_FALSE(BrowserWidget()->IsActive());
+  entered.Wait();
+  EXPECT_TRUE(contents->HasPictureInPictureVideo());
+
+  content::MediaStartStopObserver exited(contents, StartStop::kExitPictureInPicture);
+  BrowserWidget()->Activate();
+  exited.Wait();
+  EXPECT_FALSE(contents->HasPictureInPictureVideo());
+}
