+// True while a normal browser window, or a bubble or menu it owns, has focus.
+// The picture-in-picture window is not owned by a browser window, so focusing
+// it does not count.
+bool IsBrowserWindowFocused() {
+  bool focused = false;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&focused](BrowserWindowInterface* browser) {
+        if (browser->GetType() ==
+            BrowserWindowInterface::TYPE_PICTURE_IN_PICTURE) {
+          return true;
+        }
+        BrowserView* browser_view =
+            BrowserView::GetBrowserViewForBrowser(browser);
+        views::Widget* widget =
+            browser_view ? browser_view->GetWidget() : nullptr;
+        if (!widget) {
+          return true;
+        }
+        views::Widget::Widgets widgets =
+            views::Widget::GetAllChildWidgets(widget->GetNativeView());
+        widgets.merge(
+            views::Widget::GetAllOwnedWidgets(widget->GetNativeView()));
+        widgets.insert(widget);
+        for (views::Widget* candidate : widgets) {
+          if (candidate->IsActive()) {
+            focused = true;
+            return false;
+          }
+        }
+        return true;
+      });
+  return focused;
+}
