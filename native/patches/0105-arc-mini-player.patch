+bool CoveSidebarLibraryView::RevealParkedContents(
+    content::WebContents* contents) {
+  if (!contents || restoring_session_ || switching_space_ ||
+      closing_active_space_) {
+    return false;
+  }
+  std::string space_id;
+  tabs::TabHandle parked;
+  for (const auto& [id, space] : inactive_spaces_) {
+    for (const auto& handle : space->handles) {
+      if (auto* tab = handle.Get(); tab && tab->GetContents() == contents) {
+        space_id = id;
+        parked = handle;
+        break;
+      }
+    }
+    if (!space_id.empty()) {
+      break;
+    }
+  }
+  if (space_id.empty()) {
+    return false;
+  }
+  SwitchSpace(space_id);
+  TabStripModel* model = browser_->GetTabStripModel();
+  auto* tab = parked.Get();
+  const int index = tab ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+  if (active_space_id_ != space_id || index == TabStripModel::kNoTab) {
+    return false;
+  }
+  model->ActivateTabAt(index);
+  if (auto* widget = GetWidget()) {
+    widget->Activate();
+  }
+  return true;
+}
