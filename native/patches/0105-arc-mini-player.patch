+IN_PROC_BROWSER_TEST_F(CoveMiniPlayerBrowserTest,
+                       SwitchingSpacesFloatsVideoAndBackToTabReturnsToIt) {
+  ASSERT_TRUE(Spaces());
+  const std::string home = Spaces()->GetActiveSpaceId();
+  const std::string other = OtherSpaceId();
+  ASSERT_FALSE(other.empty());
+  auto* contents = PlayUnregisteredVideo();
+  auto* model = browser()->GetTabStripModel();
+
+  content::MediaStartStopObserver entered(contents, StartStop::kEnterPictureInPicture);
+  Spaces()->FocusSpace(other);
+  entered.Wait();
+  EXPECT_EQ(other, Spaces()->GetActiveSpaceId());
+  EXPECT_EQ(TabStripModel::kNoTab, model->GetIndexOfWebContents(contents));
+  EXPECT_TRUE(contents->HasPictureInPictureVideo());
+
+  content::MediaStartStopObserver exited(contents, StartStop::kExitPictureInPicture);
+  EXPECT_TRUE(
+      PictureInPictureWindowManager::GetInstance()
+          ->ExitPictureInPictureViaWindowUi(
+              PictureInPictureWindowManager::UiBehavior::
+                  kCloseWindowAndFocusOpener));
+  exited.Wait();
+  EXPECT_EQ(home, Spaces()->GetActiveSpaceId());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_FALSE(contents->HasPictureInPictureVideo());
+  EXPECT_TRUE(content::EvalJs(contents, "!video.paused").ExtractBool());
+}
