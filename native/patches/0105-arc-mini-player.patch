+class CoveMiniPlayerBrowserTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    clock_.SetNowTicks(base::TimeTicks::Now());
+  }
+
+  // Plays a video on a page that never registers for picture-in-picture, as
+  // most video sites do, and waits until leaving it would float the video.
+  content::WebContents* PlayUnregisteredVideo() {
+    const GURL url = chrome_test_utils::GetTestUrl(
+        base::FilePath(base::FilePath::kCurrentDirectory),
+        base::FilePath(
+            FILE_PATH_LITERAL("media/picture-in-picture/"
+                              "autopip-no-register.html")));
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+    auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+    auto* helper = AutoPictureInPictureTabHelper::FromWebContents(contents);
+    EXPECT_TRUE(helper);
+    // Frozen time keeps the playback's user activation from expiring on slow
+    // machines between play and the tab switch.
+    helper->set_clock_for_testing(&clock_);
+    contents->GetPrimaryMainFrame()->ExecuteJavaScriptWithUserGestureForTests(
+        u"playVideo()", base::NullCallback(),
+        content::ISOLATED_WORLD_ID_GLOBAL);
+    auto* audible = RecentlyAudibleHelper::FromWebContents(contents);
+    EXPECT_TRUE(base::test::RunUntil([&] {
+      return audible->WasRecentlyAudible() &&
+             content::EvalJs(contents, "!video.paused && video.currentTime > 0")
+                 .ExtractBool();
+    }));
+    // Let audio focus and media session updates reach the tab helper.
+    content::MediaSession::FlushObserversForTesting(contents);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_FALSE(helper->IsInAutoPictureInPicture());
+    return contents;
+  }
+
+  views::Widget* BrowserWidget() {
+    return BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  }
+
+  // A focused window that the browser does not own, standing in for another
+  // app taking focus.
+  std::unique_ptr<views::Widget> ShowOtherAppWindow() {
+    auto widget = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW);
+    params.bounds = gfx::Rect(0, 0, 120, 80);
+    widget->Init(std::move(params));
+    widget->Show();
+    widget->Activate();
+    return widget;
+  }
+
+  CoveSpaceCloseHandler* Spaces() {
+    return CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  }
+
+  std::string OtherSpaceId() {
+    for (const auto& space : Spaces()->GetSpaces()) {
+      if (space.id != Spaces()->GetActiveSpaceId()) {
+        return space.id;
+      }
+    }
+    return {};
+  }
+
+  base::SimpleTestTickClock clock_;
+};
