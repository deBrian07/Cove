+IN_PROC_BROWSER_TEST_F(CoveMiniPlayerBrowserTest,
+                       BrowserOwnedPopupDoesNotFloatVideo) {
+  ASSERT_TRUE(base::test::RunUntil([&] { return BrowserWidget()->IsActive(); }));
+  auto* contents = PlayUnregisteredVideo();
+
+  views::Widget popup;
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW);
+  params.parent = BrowserWidget()->GetNativeView();
+  params.bounds = gfx::Rect(0, 0, 120, 80);
+  popup.Init(std::move(params));
+  popup.Show();
+  popup.Activate();
+  ASSERT_TRUE(base::test::RunUntil([&] { return popup.IsActive(); }));
+  // Outlast the occlusion helper's 100 ms update delay.
+  base::RunLoop run_loop;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, run_loop.QuitClosure(), base::Milliseconds(500));
+  run_loop.Run();
+  EXPECT_FALSE(contents->HasPictureInPictureVideo());
+  popup.CloseNow();
+}
