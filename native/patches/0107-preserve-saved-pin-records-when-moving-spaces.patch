+void CoveSidebarDragBrowserTest::VerifyMovedPin(bool collision) {
+  Seed();
+  const GURL home("data:text/html,<title>Saved pin home</title>");
+  const GURL away("data:text/html,<title>Navigated pin</title>");
+  auto* prefs = browser()->GetProfile()->GetPrefs();
+  base::DictValue existing;
+  {
+    ScopedDictPrefUpdate update(prefs, kSidebarPref);
+    auto* source = FindSpace(*update, "personal");
+    auto& pin = source->FindList("pins")->front().GetDict();
+    pin.Set("url", home.spec());
+    pin.Set("title", "My custom pin name");
+    pin.Set("future_metadata", base::DictValue().Set("retained", 107));
+    ASSERT_TRUE(cove::SidebarOrder::Move(
+        *source, {cove::SidebarItemKind::kPin, "p"}, "a"));
+    if (collision) {
+      // The destination pin deliberately shares both the old ID and the
+      // moving page's current URL. Neither saved identity may be merged.
+      existing = Pin("p", "Destination pin", away.spec().c_str());
+      FindSpace(*update, "work")->EnsureList("pins")->Append(existing.Clone());
+    }
+  }
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  auto* model = browser()->GetTabStripModel();
+  auto* contents = model->GetActiveWebContents();
+  model->SetTabPinned(model->active_index(), true);
+  Layout();
+  ASSERT_EQ("p", library()->ActivePinIdForTesting());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), away));
+  ASSERT_TRUE(content::ExecJs(contents, "window.pinMoveDraft='still here'"));
+  const int history_count = contents->GetController().GetEntryCount();
+  const auto* original = FindSaved(SavedSpace(), "pins", "p");
+  ASSERT_TRUE(original);
+  auto expected = original->Clone();
+  const auto folders = SavedSpace().FindList("folders")->Clone();
+  ASSERT_TRUE(MoveTabWithMenu(browser(), model->GetIndexOfWebContents(contents),
+                            u"Work"));
+  Layout();
+  ASSERT_EQ("work", library()->ActiveSpaceIdForTesting());
+  ASSERT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_TRUE(model->IsTabPinned(model->active_index()));
+  EXPECT_EQ(away, contents->GetVisibleURL());
+  EXPECT_EQ(history_count, contents->GetController().GetEntryCount());
+  EXPECT_EQ("still here", content::EvalJs(contents, "window.pinMoveDraft"));
+  const std::string moved_id = library()->ActivePinIdForTesting();
+  ASSERT_FALSE(moved_id.empty());
+  if (collision) EXPECT_NE("p", moved_id);
+  else EXPECT_EQ("p", moved_id);
+  const auto& root = prefs->GetDict(kSidebarPref);
+  // Resolve through a local snapshot: no borrowed pref value crosses a write.
+  auto saved = root.Clone();
+  const auto* destination = FindSpace(saved, "work");
+  ASSERT_TRUE(destination);
+  const auto* record = FindSaved(*destination, "pins", moved_id);
+  ASSERT_TRUE(record);
+  expected.Set("id", moved_id);
+  expected.Set("folder", "");
+  EXPECT_EQ(expected, *record);
+  EXPECT_EQ(collision ? 2u : 1u, destination->FindList("pins")->size());
+  if (collision) {
+    ASSERT_TRUE(FindSaved(*destination, "pins", "p"));
+    EXPECT_EQ(existing, *FindSaved(*destination, "pins", "p"));
+  }
+  const auto* source = FindSpace(saved, "personal");
+  ASSERT_TRUE(source);
+  EXPECT_FALSE(FindSaved(*source, "pins", "p"));
+  EXPECT_TRUE(FindSaved(*source, "pins", "q"));
+  EXPECT_EQ(folders, *source->FindList("folders"));
+  ASSERT_TRUE(library()->GetSessionSnapshot());
+  const auto* state = GetCoveTabSessionState(contents);
+  ASSERT_TRUE(state);
+  EXPECT_EQ("work", state->space);
+  EXPECT_EQ(moved_id, state->pin);
+  library()->FocusSpace("personal");
+  Layout();
+  library()->FocusSpace("work");
+  Layout();
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_EQ(moved_id, library()->ActivePinIdForTesting());
+  EXPECT_EQ("still here", content::EvalJs(contents, "window.pinMoveDraft"));
+  // Reset must use the original saved home, not the page that was displayed
+  // during the move, while keeping the same native WebContents.
+  library()->ExecuteArcCommand(IDC_COVE_RESET_PIN);
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_EQ(home, contents->GetVisibleURL());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       MoveNavigatedPinPreservesSavedHomeAndFields) {
+  ASSERT_NO_FATAL_FAILURE(VerifyMovedPin(false));
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       MoveNavigatedPinRenamesCollidingIdentityWithoutMerging) {
+  ASSERT_NO_FATAL_FAILURE(VerifyMovedPin(true));
+}
+
+IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       MoveRejectsAmbiguousPinBeforeChangingPagesOrSavedData) {
+  Seed();
+  const GURL home("data:text/html,<title>Ambiguous pin</title>");
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kSidebarPref);
+    auto* source = FindSpace(*update, "personal");
+    source->FindList("pins")->front().GetDict().Set("url", home.spec());
+  }
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  auto* model = browser()->GetTabStripModel();
+  auto* contents = model->GetActiveWebContents();
+  model->SetTabPinned(model->active_index(), true);
+  Layout();
+  ASSERT_EQ("p", library()->ActivePinIdForTesting());
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kSidebarPref);
+    auto* pins = FindSpace(*update, "personal")->FindList("pins");
+    auto duplicate = pins->front().Clone();
+    pins->Append(std::move(duplicate));
+  }
+  Layout();
+  const auto before = browser()->GetProfile()->GetPrefs()->GetDict(kSidebarPref).Clone();
+  EXPECT_FALSE(library()->MoveTabsToSpace(
+      {model->GetActiveTab()->GetHandle()}, "work"));
+  EXPECT_EQ("personal", library()->ActiveSpaceIdForTesting());
+  EXPECT_EQ(contents, model->GetActiveWebContents());
+  EXPECT_TRUE(model->IsTabPinned(model->active_index()));
+  EXPECT_EQ(before, browser()->GetProfile()->GetPrefs()->GetDict(kSidebarPref));
+}
