+void CoveSidebarLibraryView::PruneSavedPinIcons() {
+  const auto* space = FindSpace(browser_->GetProfile()->GetPrefs()
+      ->GetDict(kCoveSidebarPref), active_space_id_);
+  const auto* pins = space ? space->FindList("pins") : nullptr;
+  std::map<std::string, std::vector<GURL>> homes;
+  if (pins) {
+    for (const auto& value : *pins) {
+      const auto* pin = value.GetIfDict();
+      const auto* id = pin ? pin->FindString("id") : nullptr;
+      const auto* url = pin ? pin->FindString("url") : nullptr;
+      if (id) homes[*id].push_back(url ? GURL(*url) : GURL());
+    }
+  }
+  // Keep images through row rebuilds, but never across changed identities,
+  // ambiguous records or Space boundaries. Callbacks still refresh the cache.
+  std::erase_if(cached_pin_icons_, [&](const auto& entry) {
+    const auto found = homes.find(entry.first);
+    return entry.second.space_id != active_space_id_ || found == homes.end() ||
+           found->second.size() != 1 ||
+           found->second.front() != entry.second.home_url;
+  });
 }
 
