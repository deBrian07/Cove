 IN_PROC_BROWSER_TEST_F(CoveSidebarDragBrowserTest,
+                       SavedPinIconSurvivesRebuildWithoutStaleIdentityReuse) {
+  Seed();
+  const GURL home("https://pin-p.example/");
+  ASSERT_TRUE(PinRow("p"));
+  DeliverPinIcon(0, "p", home, PinRow("p"), SK_ColorRED);
+  ASSERT_TRUE(RowHasIconColor(PinRow("p"), SK_ColorRED));
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kSidebarPref);
+    auto* personal = FindSpace(*update, "personal");
+    personal->FindList("folders")->front().GetDict().Set("name", "Renamed");
+  }
+  // No RunUntil or task pumping: a recreated row must already have its icon.
+  ASSERT_TRUE(PinRow("p"));
+  EXPECT_TRUE(RowHasIconColor(PinRow("p"), SK_ColorRED));
+  const GURL replacement("https://replacement-pin.example/");
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kSidebarPref);
+    FindSpace(*update, "personal")->FindList("pins")->front().GetDict()
+        .Set("url", replacement.spec());
+  }
+  ASSERT_TRUE(PinRow("p"));
+  EXPECT_FALSE(RowHasIconColor(PinRow("p"), SK_ColorRED));
+  DeliverPinIcon(0, "p", replacement, PinRow("p"), SK_ColorBLUE);
+  ASSERT_TRUE(RowHasIconColor(PinRow("p"), SK_ColorBLUE));
+  {
+    ScopedDictPrefUpdate update(browser()->GetProfile()->GetPrefs(), kSidebarPref);
+    auto* work = FindSpace(*update, "work");
+    ASSERT_TRUE(work);
+    base::ListValue pins;
+    pins.Append(Pin("p", "Other Space Pin", replacement.spec().c_str()));
+    work->Set("pins", std::move(pins));
+  }
+  SwitchSpaceForIconTest("work");
+  ASSERT_TRUE(PinRow("p"));
+  EXPECT_FALSE(RowHasIconColor(PinRow("p"), SK_ColorBLUE));
+}
