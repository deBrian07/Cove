+
+#include "chrome/browser/ui/cove/cove_peek_hooks.h"
+
+namespace {
+CovePeekHooks& Hooks() {
+  static CovePeekHooks hooks;
+  return hooks;
+}
+}  // namespace
+
+void SetCovePeekHooks(const CovePeekHooks& hooks) {
+  Hooks() = hooks;
+}
+
+const CovePeekHooks& GetCovePeekHooks() {
+  return Hooks();
+}
