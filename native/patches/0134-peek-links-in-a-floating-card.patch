+// Copyright 2026 The Cove Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_COVE_COVE_PEEK_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_COVE_COVE_PEEK_VIEW_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+
+namespace content {
+struct OpenURLParams;
+class WebContents;
+}  // namespace content
+
+namespace blink::mojom {
+class WindowFeatures;
+}
+
+namespace views {
+class Label;
+class WebView;
+}  // namespace views
+
+// Arc-style Peek: a page opened with Shift+click, or a link that leaves a
+// pinned tab for another site, appears in a floating card over the current
+// page instead of a new tab. Escape or a click outside closes it; "Open as
+// Tab" moves the very same page into the current Space without reloading.
+class CovePeekView : public views::View,
+                     public views::ViewObserver,
+                     public content::WebContentsDelegate,
+                     public TabStripModelObserver {
+  METADATA_HEADER(CovePeekView, views::View)
+
+ public:
+  // Opens |params| in a Peek when it is a Shift+click (NEW_WINDOW) with a user
+  // gesture in a normal window. Returns the Peek's contents, or nullptr when
+  // the navigation should continue normally.
+  static content::WebContents* MaybeOpenURL(BrowserWindowInterface* browser,
+                                            content::WebContents* source,
+                                            const content::OpenURLParams& params);
+
+  // Adopts renderer-created contents (target=_blank, Shift+click on such a
+  // link) into a Peek. Returns |new_contents| unchanged when declined.
+  static std::unique_ptr<content::WebContents> MaybeAdopt(
+      BrowserWindowInterface* browser,
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      bool user_gesture);
+
+  static CovePeekView* GetForBrowser(BrowserWindowInterface* browser);
+  // Routes browser navigations to the Peek. Idempotent.
+  static void InstallHooks();
+
+  explicit CovePeekView(BrowserWindowInterface* browser);
+  CovePeekView(const CovePeekView&) = delete;
+  CovePeekView& operator=(const CovePeekView&) = delete;
+  ~CovePeekView() override;
+
+  void Show(std::unique_ptr<content::WebContents> contents,
+            content::WebContents* source);
+  // Closes the Peek and discards its page.
+  void Close();
+  // Moves the peeked page into the window's tab strip, next to its source.
+  void OpenAsTab();
+
+  content::WebContents* contents_for_testing() { return contents_.get(); }
+
+  // views::View:
+  void Layout(PassKey) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override;
+  void CloseContents(content::WebContents* source) override;
+  bool HandleKeyboardEvent(content::WebContents* source,
+                           const input::NativeWebKeyboardEvent& event) override;
+  void NavigationStateChanged(content::WebContents* source,
+                              content::InvalidateTypes changed_flags) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  gfx::Rect CardBounds() const;
+  void UpdateTitle();
+  void ScheduleClose();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<content::WebContents> contents_;
+  base::WeakPtr<content::WebContents> source_;
+  raw_ptr<views::View> card_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  base::ScopedObservation<views::View, views::ViewObserver> anchor_observation_{
+      this};
+  base::WeakPtrFactory<CovePeekView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_COVE_COVE_PEEK_VIEW_H_
