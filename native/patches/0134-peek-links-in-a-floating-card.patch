+// Copyright 2026 The Cove Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COVE_COVE_PEEK_HOOKS_H_
+#define CHROME_BROWSER_UI_COVE_COVE_PEEK_HOOKS_H_
+
+#include <memory>
+
+#include "ui/base/window_open_disposition.h"
+
+class BrowserWindowInterface;
+class GURL;
+
+namespace content {
+struct OpenURLParams;
+class WebContents;
+}  // namespace content
+
+// Lets low-level browser code hand navigations to Cove's Peek without
+// depending on Views. The Peek implementation installs these once.
+struct CovePeekHooks {
+  // Returns the Peek's contents when it took the navigation, else nullptr.
+  content::WebContents* (*open_url)(BrowserWindowInterface* browser,
+                                    content::WebContents* source,
+                                    const content::OpenURLParams& params) =
+      nullptr;
+  // Returns |new_contents| when declined, or nullptr after adopting it.
+  std::unique_ptr<content::WebContents> (*adopt)(
+      BrowserWindowInterface* browser,
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      bool user_gesture) = nullptr;
+};
+
+void SetCovePeekHooks(const CovePeekHooks& hooks);
+const CovePeekHooks& GetCovePeekHooks();
+
+#endif  // CHROME_BROWSER_UI_COVE_COVE_PEEK_HOOKS_H_
