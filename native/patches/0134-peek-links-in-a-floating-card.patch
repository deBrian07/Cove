+// Copyright 2026 The Cove Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/cove/cove_peek_view.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/tab_contents/tab_util.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/cove/cove_peek_hooks.h"
+#include "chrome/browser/ui/cove_space_close_handler.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "components/tabs/public/tab_interface.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "third_party/blink/public/mojom/window_features/window_features.mojom.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/canvas.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/flex_layout_view.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+constexpr int kHeaderHeight = 40;
+constexpr int kCardRadius = 12;
+constexpr int kMargin = 48;
+constexpr SkColor kBackdrop = SkColorSetARGB(0x66, 0, 0, 0);
+constexpr SkColor kCardColor = SkColorSetRGB(0x1e, 0x1f, 0x24);
+constexpr SkColor kText = SkColorSetRGB(0xe8, 0xe8, 0xec);
+
+bool IsPeekableWindow(BrowserWindowInterface* browser) {
+  return browser &&
+         browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         BrowserView::GetBrowserViewForBrowser(browser);
+}
+
+bool IsWebUrl(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+
+// A pinned tab keeps its own site; links that leave it peek, like Arc.
+bool LeavesPinnedSite(content::WebContents* source, const GURL& target) {
+  auto* tab = source ? tabs::TabInterface::MaybeGetFromContents(source)
+                     : nullptr;
+  if (!tab || !tab->IsPinned()) {
+    return false;
+  }
+  return !net::registry_controlled_domains::SameDomainOrHost(
+      source->GetLastCommittedURL(), target,
+      net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+}
+
+CovePeekView* EnsurePeek(BrowserWindowInterface* browser) {
+  if (auto* existing = CovePeekView::GetForBrowser(browser)) {
+    return existing;
+  }
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  return browser_view->AddChildView(std::make_unique<CovePeekView>(browser));
+}
+
+}  // namespace
+
+// static
+void CovePeekView::InstallHooks() {
+  CovePeekHooks hooks;
+  hooks.open_url = &CovePeekView::MaybeOpenURL;
+  hooks.adopt = &CovePeekView::MaybeAdopt;
+  SetCovePeekHooks(hooks);
+}
+
+// static
+CovePeekView* CovePeekView::GetForBrowser(BrowserWindowInterface* browser) {
+  auto* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!browser_view) {
+    return nullptr;
+  }
+  for (views::View* child : browser_view->children()) {
+    if (auto* peek = views::AsViewClass<CovePeekView>(child)) {
+      return peek;
+    }
+  }
+  return nullptr;
+}
+
+// static
+content::WebContents* CovePeekView::MaybeOpenURL(
+    BrowserWindowInterface* browser,
+    content::WebContents* source,
+    const content::OpenURLParams& params) {
+  if (!IsPeekableWindow(browser) ||
+      params.disposition != WindowOpenDisposition::NEW_WINDOW ||
+      !params.user_gesture || !IsWebUrl(params.url) || !source) {
+    return nullptr;
+  }
+  Profile* profile = browser->GetProfile();
+  content::WebContents::CreateParams create(
+      profile, tab_util::GetSiteInstanceForNewTab(profile, params.url));
+  auto contents = content::WebContents::Create(create);
+  content::NavigationController::LoadURLParams load(params);
+  contents->GetController().LoadURLWithParams(load);
+  content::WebContents* raw = contents.get();
+  EnsurePeek(browser)->Show(std::move(contents), source);
+  return raw;
+}
+
+// static
+std::unique_ptr<content::WebContents> CovePeekView::MaybeAdopt(
+    BrowserWindowInterface* browser,
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    bool user_gesture) {
+  // Never take popups: sign-in and payment flows need a real window.
+  const bool shift_click = disposition == WindowOpenDisposition::NEW_WINDOW;
+  const bool pinned_link =
+      disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB &&
+      LeavesPinnedSite(source, target_url);
+  if (!IsPeekableWindow(browser) || !user_gesture || !new_contents ||
+      !IsWebUrl(target_url) || !(shift_click || pinned_link) ||
+      browser->GetProfile() != Profile::FromBrowserContext(
+                                   new_contents->GetBrowserContext())) {
+    return new_contents;
+  }
+  EnsurePeek(browser)->Show(std::move(new_contents), source);
+  return nullptr;
+}
+
+CovePeekView::CovePeekView(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetVisible(false);
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+
+  auto* card = AddChildView(std::make_unique<views::View>());
+  card_ = card;
+  card->SetPaintToLayer();
+  card->layer()->SetFillsBoundsOpaquely(false);
+  card->layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(kCardRadius));
+  card->layer()->SetMasksToBounds(true);
+  card->SetBackground(
+      views::CreateRoundedRectBackground(kCardColor, kCardRadius));
+  card->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  auto* header = card->AddChildView(std::make_unique<views::FlexLayoutView>());
+  header->SetOrientation(views::LayoutOrientation::kHorizontal);
+  header->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  header->SetInteriorMargin(gfx::Insets::VH(0, 12));
+  header->SetPreferredSize(gfx::Size(0, kHeaderHeight));
+  auto* close = header->AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(&CovePeekView::Close, base::Unretained(this)),
+      u"Close"));
+  close->SetEnabledTextColors(kText);
+  close->SetTooltipText(u"Close Peek (Esc)");
+  title_ = header->AddChildView(std::make_unique<views::Label>());
+  title_->SetEnabledColor(kText);
+  title_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  title_->SetElideBehavior(gfx::ELIDE_MIDDLE);
+  title_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  auto* open = header->AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(&CovePeekView::OpenAsTab, base::Unretained(this)),
+      u"Open as Tab"));
+  open->SetEnabledTextColors(kText);
+  open->SetTooltipText(u"Open this page as a tab in this Space");
+
+  web_view_ = card->AddChildView(
+      std::make_unique<views::WebView>(browser->GetProfile()));
+  static_cast<views::BoxLayout*>(card->GetLayoutManager())
+      ->SetFlexForView(web_view_, 1);
+
+  AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+}
+
+CovePeekView::~CovePeekView() {
+  TabStripModelObserver::StopObservingAll(this);
+  if (web_view_) {
+    web_view_->SetWebContents(nullptr);
+  }
+  if (contents_) {
+    contents_->SetDelegate(nullptr);
+  }
+}
+
+void CovePeekView::Show(std::unique_ptr<content::WebContents> contents,
+                        content::WebContents* source) {
+  // One Peek per window: a new one replaces the old page.
+  if (contents_) {
+    web_view_->SetWebContents(nullptr);
+    contents_->SetDelegate(nullptr);
+    contents_.reset();
+  }
+  contents_ = std::move(contents);
+  contents_->SetDelegate(this);
+  source_ = source ? source->GetWeakPtr() : nullptr;
+  web_view_->SetWebContents(contents_.get());
+
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  if (!anchor_observation_.IsObserving()) {
+    anchor_observation_.Observe(browser_view->contents_container());
+  }
+  if (!TabStripModelObserver::IsObservingAny(this)) {
+    browser_->GetTabStripModel()->AddObserver(this);
+  }
+  // Paint above the page and its native view.
+  browser_view->ReorderChildView(this, browser_view->children().size());
+  SetBoundsRect(browser_view->contents_container()->bounds());
+  SetVisible(true);
+  InvalidateLayout();
+  UpdateTitle();
+  web_view_->RequestFocus();
+}
+
+void CovePeekView::Close() {
+  if (!GetVisible() && !contents_) {
+    return;
+  }
+  SetVisible(false);
+  web_view_->SetWebContents(nullptr);
+  if (contents_) {
+    contents_->SetDelegate(nullptr);
+    contents_.reset();
+  }
+  TabStripModelObserver::StopObservingAll(this);
+  if (source_) {
+    source_->Focus();
+  }
+}
+
+void CovePeekView::OpenAsTab() {
+  if (!contents_) {
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  int index = model->count();
+  if (source_) {
+    const int source_index = model->GetIndexOfWebContents(source_.get());
+    if (source_index != TabStripModel::kNoTab) {
+      index = std::max(source_index + 1, model->IndexOfFirstNonPinnedTab());
+    }
+  }
+  web_view_->SetWebContents(nullptr);
+  contents_->SetDelegate(nullptr);
+  TabStripModelObserver::StopObservingAll(this);
+  SetVisible(false);
+  // The same page moves, so history, scroll position and input survive.
+  model->InsertWebContentsAt(index, std::move(contents_),
+                             AddTabTypes::ADD_ACTIVE);
+}
+
+gfx::Rect CovePeekView::CardBounds() const {
+  gfx::Rect area = GetLocalBounds();
+  const int width = std::min(area.width() - 2 * kMargin, 1280);
+  const int height = area.height() - 2 * kMargin;
+  gfx::Rect card(0, 0, std::max(width, 320), std::max(height, 240));
+  card.set_x(area.x() + (area.width() - card.width()) / 2);
+  card.set_y(area.y() + (area.height() - card.height()) / 2);
+  return card;
+}
+
+void CovePeekView::Layout(PassKey) {
+  card_->SetBoundsRect(CardBounds());
+}
+
+void CovePeekView::OnPaint(gfx::Canvas* canvas) {
+  canvas->DrawColor(kBackdrop);
+}
+
+bool CovePeekView::OnMousePressed(const ui::MouseEvent& event) {
+  // A press on the dimmed backdrop closes the Peek, as in Arc.
+  if (!CardBounds().Contains(event.location())) {
+    ScheduleClose();
+    return true;
+  }
+  return false;
+}
+
+bool CovePeekView::AcceleratorPressed(const ui::Accelerator& accelerator) {
+  if (accelerator.key_code() == ui::VKEY_ESCAPE) {
+    ScheduleClose();
+    return true;
+  }
+  return false;
+}
+
+void CovePeekView::OnViewBoundsChanged(views::View* observed_view) {
+  if (GetVisible()) {
+    SetBoundsRect(observed_view->bounds());
+  }
+}
+
+void CovePeekView::OnViewIsDeleting(views::View* observed_view) {
+  anchor_observation_.Reset();
+}
+
+content::WebContents* CovePeekView::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  if (params.disposition == WindowOpenDisposition::CURRENT_TAB && contents_) {
+    content::NavigationController::LoadURLParams load(params);
+    contents_->GetController().LoadURLWithParams(load);
+    return contents_.get();
+  }
+  // Anything else opens normally in this window's current Space.
+  NavigateParams nav(browser_, params.url, params.transition);
+  nav.FillNavigateParamsFromOpenURLParams(params);
+  if (nav.disposition == WindowOpenDisposition::NEW_WINDOW) {
+    nav.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  }
+  Navigate(&nav);
+  return nav.navigated_or_inserted_contents.get();
+}
+
+content::WebContents* CovePeekView::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  // Popups from a peeked page become ordinary tabs or windows.
+  return chrome::AddWebContents(browser_, nullptr, std::move(new_contents),
+                                target_url, disposition, window_features);
+}
+
+void CovePeekView::CloseContents(content::WebContents* source) {
+  ScheduleClose();
+}
+
+bool CovePeekView::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  if (event.GetType() != blink::WebInputEvent::Type::kRawKeyDown) {
+    return false;
+  }
+  const bool command =
+      event.GetModifiers() & blink::WebInputEvent::kMetaKey;
+  // Escape, or Cmd+W, closes the Peek rather than the tab beneath it.
+  if (event.windows_key_code == ui::VKEY_ESCAPE ||
+      (command && event.windows_key_code == ui::VKEY_W)) {
+    ScheduleClose();
+    return true;
+  }
+  // Cmd+Return opens the page as a tab.
+  if (command && event.windows_key_code == ui::VKEY_RETURN) {
+    OpenAsTab();
+    return true;
+  }
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  return browser_view && browser_view->HandleKeyboardEvent(event);
+}
+
+void CovePeekView::NavigationStateChanged(
+    content::WebContents* source,
+    content::InvalidateTypes changed_flags) {
+  UpdateTitle();
+}
+
+void CovePeekView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // Switching tabs or Spaces, or closing the source, ends the Peek.
+  if (selection.active_tab_changed() || !source_ ||
+      tab_strip_model->GetIndexOfWebContents(source_.get()) ==
+          TabStripModel::kNoTab) {
+    ScheduleClose();
+  }
+}
+
+void CovePeekView::UpdateTitle() {
+  if (!contents_) {
+    return;
+  }
+  std::u16string title = contents_->GetTitle();
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(contents_->GetVisibleURL().host());
+  }
+  title_->SetText(title);
+}
+
+void CovePeekView::ScheduleClose() {
+  // Closing destroys the page; never do that inside its own callbacks.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&CovePeekView::Close,
+                                weak_factory_.GetWeakPtr()));
+}
+
+BEGIN_METADATA(CovePeekView)
+END_METADATA
