+#include "chrome/browser/ui/views/cove/cove_peek_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+
+namespace {
+
+class CovePeekBrowserTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* model() { return browser()->GetTabStripModel(); }
+
+  void ShowLink(content::WebContents* contents, const GURL& target,
+                bool blank) {
+    ASSERT_TRUE(content::ExecJs(
+        contents,
+        content::JsReplace(
+            "document.body.innerHTML = '';"
+            "const a = document.createElement('a');"
+            "a.href = $1; a.textContent = 'go';"
+            "a.style = 'position:fixed;inset:0;display:block';"
+            "if ($2) a.target = '_blank';"
+            "document.body.appendChild(a);"
+            "window.kept = 'draft';",
+            target.spec(), blank)));
+  }
+
+  void Click(content::WebContents* contents, int modifiers) {
+    content::SimulateMouseClickAt(contents, modifiers,
+                                  blink::WebMouseEvent::Button::kLeft,
+                                  gfx::Point(50, 50));
+  }
+
+  CovePeekView* Peek() { return CovePeekView::GetForBrowser(browser()); }
+
+  size_t WindowCount() {
+    size_t count = 0;
+    ProfileBrowserCollection::GetForProfile(browser()->GetProfile())
+        ->ForEach([&](BrowserWindowInterface*) {
+          ++count;
+          return true;
+        });
+    return count;
+  }
+};
+
+// Shift+click shows the page in a Peek over the current tab, not a window.
+IN_PROC_BROWSER_TEST_F(CovePeekBrowserTest, ShiftClickOpensPeekAndEscCloses) {
+  const GURL target = embedded_test_server()->GetURL("b.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+  auto* source = model()->GetActiveWebContents();
+  ShowLink(source, target, /*blank=*/false);
+  const int tabs = model()->count();
+  const size_t windows = WindowCount();
+
+  Click(source, blink::WebInputEvent::kShiftKey);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Peek() && Peek()->GetVisible() && Peek()->contents_for_testing();
+  }));
+  auto* peeked = Peek()->contents_for_testing();
+  EXPECT_TRUE(content::WaitForLoadStop(peeked));
+  EXPECT_EQ(target, peeked->GetLastCommittedURL());
+  EXPECT_EQ(tabs, model()->count());
+  EXPECT_EQ(windows, WindowCount());
+  EXPECT_EQ(source, model()->GetActiveWebContents());
+  EXPECT_EQ("draft", content::EvalJs(source, "window.kept"));
+
+  Peek()->Close();
+  EXPECT_FALSE(Peek()->GetVisible());
+  EXPECT_FALSE(Peek()->contents_for_testing());
+  EXPECT_EQ(tabs, model()->count());
+}
+
+// "Open as Tab" moves the same page into the strip without reloading it.
+IN_PROC_BROWSER_TEST_F(CovePeekBrowserTest, OpenAsTabKeepsTheSamePage) {
+  const GURL target = embedded_test_server()->GetURL("b.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+  auto* source = model()->GetActiveWebContents();
+  ShowLink(source, target, /*blank=*/false);
+  const int tabs = model()->count();
+  Click(source, blink::WebInputEvent::kShiftKey);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return Peek() && Peek()->contents_for_testing(); }));
+  auto* peeked = Peek()->contents_for_testing();
+  ASSERT_TRUE(content::WaitForLoadStop(peeked));
+  ASSERT_TRUE(content::ExecJs(peeked, "window.peekDraft = 'kept'"));
+  const int entries = peeked->GetController().GetEntryCount();
+
+  Peek()->OpenAsTab();
+  EXPECT_EQ(tabs + 1, model()->count());
+  EXPECT_EQ(peeked, model()->GetActiveWebContents());
+  EXPECT_EQ(entries, peeked->GetController().GetEntryCount());
+  EXPECT_EQ("kept", content::EvalJs(peeked, "window.peekDraft"));
+  EXPECT_FALSE(Peek()->GetVisible());
+}
+
+// A target=_blank link that leaves a pinned tab's site peeks, like Arc.
+// The same link from an unpinned tab opens a tab as usual.
+IN_PROC_BROWSER_TEST_F(CovePeekBrowserTest, PinnedTabCrossSiteLinkPeeks) {
+  const GURL target = embedded_test_server()->GetURL("b.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+  auto* source = model()->GetActiveWebContents();
+  ShowLink(source, target, /*blank=*/true);
+  int tabs = model()->count();
+  Click(source, 0);
+  ASSERT_TRUE(base::test::RunUntil([&] { return model()->count() == tabs + 1; }));
+  EXPECT_FALSE(Peek() && Peek()->GetVisible());
+
+  model()->ActivateTabAt(model()->GetIndexOfWebContents(source));
+  model()->SetTabPinned(model()->GetIndexOfWebContents(source), true);
+  tabs = model()->count();
+  Click(source, 0);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Peek() && Peek()->GetVisible() && Peek()->contents_for_testing();
+  }));
+  EXPECT_EQ(tabs, model()->count());
+}
+
+// Switching tabs ends the Peek.
+IN_PROC_BROWSER_TEST_F(CovePeekBrowserTest, SwitchingTabsClosesPeek) {
+  const GURL target = embedded_test_server()->GetURL("b.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+  auto* source = model()->GetActiveWebContents();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("data:text/html,other"),
+      WindowOpenDisposition::NEW_BACKGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ShowLink(source, target, /*blank=*/false);
+  Click(source, blink::WebInputEvent::kShiftKey);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return Peek() && Peek()->GetVisible(); }));
+  model()->ActivateTabAt(1 - model()->GetIndexOfWebContents(source));
+  ASSERT_TRUE(base::test::RunUntil([&] { return !Peek()->GetVisible(); }));
+  EXPECT_FALSE(Peek()->contents_for_testing());
+}
+
+}  // namespace
