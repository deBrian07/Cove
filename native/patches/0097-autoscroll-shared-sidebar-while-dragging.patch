+
+  region->NoteDragScreenPoint(screen_at(-30));
+  EXPECT_FALSE(region->IsDragEdgeAutoscrollingForTesting());
+  region->FireDragEdgeAutoscrollForTesting();
+  EXPECT_EQ(parked, scroll->CurrentOffset().y());
+
+  const gfx::Rect region_bounds = region->GetBoundsInScreen();
