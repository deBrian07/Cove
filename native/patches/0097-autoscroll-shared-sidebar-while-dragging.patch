+void CoveSidebarLibraryView::RememberOsDrag(const ui::DropTargetEvent& event) {
+  ActiveOsDrag drag;
+  drag.operations = event.source_operations();
+  if (event.data().HasCustomFormat(SidebarDragFormat())) {
+    drag.row_move = true;
+    drag.source = ReadRowDrag(event.data());
+  } else {
+    const auto urls = event.data().GetURLs(
+        ui::FilenameToURLPolicy::DO_NOT_CONVERT_FILENAMES);
+    if (urls.size() == 1 && urls[0].url.SchemeIsHTTPOrHTTPS()) {
+      drag.url_copy = true;
+      drag.url = urls[0].url;
+      drag.title = urls[0].title;
+    }
+  }
+  active_os_drag_ = std::move(drag);
+}
+
+void CoveSidebarLibraryView::NoteDragEdgeAutoscroll(
+    const gfx::Point& screen_point) {
+  if (auto* region = RegionForLibrary(browser_)) {
+    region->NoteDragScreenPoint(screen_point);
+  }
