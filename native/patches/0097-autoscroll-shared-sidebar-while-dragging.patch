+  ASSERT_FALSE(scroll->GetBoundsInScreen().Contains(footer));
+  region->NoteDragScreenPoint(footer);
+  EXPECT_FALSE(region->IsDragEdgeAutoscrollingForTesting());
+  region->FireDragEdgeAutoscrollForTesting();
+  EXPECT_EQ(parked, scroll->CurrentOffset().y());
+
+  EXPECT_EQ(ui::DragDropTypes::DRAG_MOVE, drag_at(bottom));
+  EXPECT_TRUE(region->IsDragEdgeAutoscrollingForTesting());
+  library()->OnDragExited();
+  EXPECT_FALSE(region->IsDragEdgeAutoscrollingForTesting());
+  region->FireDragEdgeAutoscrollForTesting();
+  EXPECT_EQ(parked, scroll->CurrentOffset().y());
