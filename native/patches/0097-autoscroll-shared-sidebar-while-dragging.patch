+  EXPECT_EQ(2u, SavedSpace().FindList("pins")->size());
+  EXPECT_EQ(40u, SavedSpace().FindList("folders")->size());
+
+  EXPECT_EQ(ui::DragDropTypes::DRAG_MOVE, drag_at(bottom));
