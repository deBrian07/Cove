+    for (int y = y_start; step > 0 ? y <= y_end : y >= y_end; y += step) {
+      chosen = screen_at(y);
+      operation = drag_at(chosen);
+      if (operation == ui::DragDropTypes::DRAG_MOVE) {
+        return std::make_pair(chosen, operation);
