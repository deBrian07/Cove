+void CoveSidebarLibraryView::RefreshSavedDropAtScreenPoint(
+    const gfx::Point& screen_point) {
+  const gfx::Point local =
+      views::View::ConvertPointFromScreen(this, screen_point);
+  if (live_drag_handle_) {
+    auto* tab = live_drag_handle_->Get();
+    auto* contents = tab ? tab->GetContents() : nullptr;
+    const GURL url = contents ? contents->GetVisibleURL() : GURL();
+    if (!tab || tab->GetBrowserWindowInterface() != browser_ ||
+        tab->GetGroup() || tab->GetSplit() || !url.is_valid() ||
+        (!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIsFile())) {
+      live_drop_.reset();
+      ClearDropIndicator();
+      return;
+    }
+    auto destination = LocateDrop(local);
+    if (!destination || !IsDropLocationValid(*destination)) {
+      live_drop_.reset();
+      ClearDropIndicator();
+      return;
+    }
+    live_drop_ = destination;
+    ShowDropIndicator(*destination);
+    return;
+  }
+  if (!active_os_drag_) {
+    return;
+  }
+  auto destination = LocateDrop(local);
+  if (!destination || !IsDropLocationValid(*destination)) {
+    ClearDropIndicator();
+    return;
+  }
+  if (active_os_drag_->row_move) {
+    const auto* space = FindSpace(
+        browser_->GetProfile()->GetPrefs()->GetDict(kCoveSidebarPref),
+        active_space_id_);
+    if (!active_os_drag_->source || !space ||
+        !(active_os_drag_->operations & ui::DragDropTypes::DRAG_MOVE) ||
+        !cove::SidebarOrder::CanMove(*space, active_os_drag_->source->item,
+                                     destination->parent,
+                                     destination->before)) {
+      ClearDropIndicator();
+      return;
+    }
+  } else if (!active_os_drag_->url_copy ||
+             !(active_os_drag_->operations & ui::DragDropTypes::DRAG_COPY)) {
+    ClearDropIndicator();
+    return;
+  }
+  ShowDropIndicator(*destination);
 }
 
