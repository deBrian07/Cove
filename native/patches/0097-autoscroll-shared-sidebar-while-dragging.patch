+    return DragEdge::kNone;
+  }
+  if (local.y() <= kDragEdgeBandDip) {
+    return DragEdge::kTop;
+  }
+  if (local.y() >= scroll->height() - kDragEdgeBandDip) {
+    return DragEdge::kBottom;
+  }
+  return DragEdge::kNone;
+}
+
+void VerticalTabStripRegionView::NoteDragScreenPoint(
+    const gfx::Point& screen_point) {
+  if (!CanDragEdgeAutoscroll() ||
+      DragEdgeForScreenPoint(screen_point) == DragEdge::kNone) {
+    StopDragEdgeAutoscroll();
+    return;
+  }
+  drag_edge_screen_point_ = screen_point;
+  if (drag_edge_timer_.IsRunning()) {
+    return;
+  }
+  drag_edge_timer_.Start(
+      FROM_HERE, kDragEdgeScrollInterval,
+      base::BindRepeating(
+          &VerticalTabStripRegionView::OnDragEdgeAutoscrollTick,
+          weak_factory_.GetWeakPtr()));
 }
 
+void VerticalTabStripRegionView::StopDragEdgeAutoscroll() {
+  drag_edge_timer_.Stop();
+  drag_edge_screen_point_.reset();
+}
+
+void VerticalTabStripRegionView::FireDragEdgeAutoscrollForTesting() {
+  OnDragEdgeAutoscrollTick();
+}
+
+bool VerticalTabStripRegionView::IsDragEdgeAutoscrollingForTesting() const {
+  return drag_edge_timer_.IsRunning();
+}
+
+void VerticalTabStripRegionView::OnDragEdgeAutoscrollTick() {
+  if (!drag_edge_screen_point_ || !CanDragEdgeAutoscroll()) {
+    StopDragEdgeAutoscroll();
+    return;
+  }
+  const gfx::Point screen_point = *drag_edge_screen_point_;
+  const DragEdge edge = DragEdgeForScreenPoint(screen_point);
+  views::ScrollView* scroll = SharedRowsScrollView();
+  if (edge == DragEdge::kNone || !scroll || !scroll->contents()) {
+    StopDragEdgeAutoscroll();
+    return;
+  }
+  const float max_offset = std::max(
+      0, scroll->contents()->height() - scroll->GetVisibleRect().height());
+  const float current = scroll->CurrentOffset().y();
+  const float delta = edge == DragEdge::kBottom ? kDragEdgeScrollStepDip
+                                                : -kDragEdgeScrollStepDip;
+  const float next = std::clamp(current + delta, 0.0f, max_offset);
+  if (next == current) {
+    StopDragEdgeAutoscroll();
+    return;
+  }
+  // Scrolling notifies native tab containers that observe this viewport.
+  // Saved-row and live-folder indicators then retarget the same screen point.
+  scroll->ScrollByOffset(gfx::PointF(0, next - current));
+  if (library_view_) {
+    library_view_->RefreshSavedDropAtScreenPoint(screen_point);
+  }
+}
