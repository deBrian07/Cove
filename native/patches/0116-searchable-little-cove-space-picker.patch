+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       EmptySearchAndEscapeKeepTheTemporaryPage) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* original = browser()->GetTabStripModel()->GetActiveWebContents();
+  auto* popup = OpenCoveTemporaryWindow(browser()->GetProfile(),
+      embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  auto* picker = OpenSpacePicker(popup);
+  ASSERT_TRUE(picker);
+  const auto picker_weak = picker->GetWeakPtr();
+  auto* search = views::AsViewClass<views::Textfield>(
+      picker->GetContentsView()->GetViewByElementId(kCoveTemporarySpaceSearchElementId));
+  ASSERT_TRUE(search);
+  search->InsertOrReplaceText(u"no-such-space-987654321");
+  ui::KeyEvent enter(ui::EventType::kKeyPressed, ui::VKEY_RETURN, 0);
+  picker->OnKeyEvent(&enter);
+  EXPECT_TRUE(enter.handled());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(original, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_TRUE(picker_weak);
+  ui::KeyEvent escape(ui::EventType::kKeyPressed, ui::VKEY_ESCAPE, 0);
+  picker->OnKeyEvent(&escape);
+  EXPECT_TRUE(escape.handled());
+  ASSERT_TRUE(base::test::RunUntil([&] { return !picker_weak; }));
+  EXPECT_EQ(page, popup->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ(original, browser()->GetTabStripModel()->GetActiveWebContents());
+}
