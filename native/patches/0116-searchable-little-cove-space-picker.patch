+void TemporarySpacePickerView::RevealSelection() { Select(selected_); }
+void TemporarySpacePickerView::ContentsChanged(
+    views::Textfield*, const std::u16string& contents) { Filter(contents); }
+bool TemporarySpacePickerView::HandleKeyEvent(
+    views::Textfield*, const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) return false;
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    if (GetWidget()) GetWidget()->CloseWithReason(views::Widget::ClosedReason::kEscKeyPressed);
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    if (!visible_.empty()) Choose(selected_);
+    return true;
+  }
+  if (event.key_code() != ui::VKEY_UP && event.key_code() != ui::VKEY_DOWN) return false;
+  if (!visible_.empty()) {
+    Select(event.key_code() == ui::VKEY_DOWN
+        ? (selected_ + 1) % visible_.size()
+        : (selected_ + visible_.size() - 1) % visible_.size());
+  }
+  return true;
+}
+void TemporarySpacePickerView::Filter(const std::u16string& query) {
+  rows_.clear();
+  visible_.clear();
+  rows_view_->RemoveAllChildViews();
+  const auto needle = base::i18n::ToLower(query);
+  for (size_t i = 0; i < spaces_.size(); ++i) {
+    if (base::i18n::ToLower(spaces_[i].name).find(needle) == std::u16string::npos) continue;
+    const size_t position = visible_.size();
+    visible_.push_back(i);
+    auto* row = rows_view_->AddChildView(std::make_unique<TemporarySpaceRow>(
+        spaces_[i], base::BindRepeating(&TemporarySpacePickerView::Choose,
+                                       weak_factory_.GetWeakPtr(), position),
+        base::BindRepeating(&TemporarySpacePickerView::Select,
+                            weak_factory_.GetWeakPtr(), position)));
+    row->SetProperty(views::kElementIdentifierKey, kCoveTemporarySpaceRowElementId);
+    rows_.push_back(row);
+  }
+  if (visible_.empty()) {
+    auto* empty = rows_view_->AddChildView(std::make_unique<views::Label>(u"No matching Spaces"));
+    empty->SetSubpixelRenderingEnabled(false);
+    empty->SetPreferredSize(gfx::Size(260, 44));
+  }
+  selected_ = 0;
+  if (query.empty()) {
+    for (size_t i = 0; i < visible_.size(); ++i)
+      if (spaces_[visible_[i]].id == initial_) selected_ = i;
+  }
+  Select(selected_);
+  SetPreferredSize(gfx::Size(280, 48 +
+      std::clamp(static_cast<int>(visible_.size()) * 44, 44, 352)));
+  PreferredSizeChanged();
+}
+void TemporarySpacePickerView::Select(size_t position) {
+  if (position >= rows_.size()) return;
+  selected_ = position;
+  for (size_t i = 0; i < rows_.size(); ++i) rows_[i]->SetSelected(i == selected_);
+  if (GetWidget()) rows_[selected_]->ScrollViewToVisible();
+}
+void TemporarySpacePickerView::Choose(size_t position) {
+  if (position < visible_.size()) choose_.Run(spaces_[visible_[position]].id);
+}
