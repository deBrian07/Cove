+      choices_, choices_[default_index_].id,
+      base::BindRepeating(&TemporarySpaceControls::ChooseSpace, weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&TemporarySpaceControls::ClosePicker, weak_factory_.GetWeakPtr()));
