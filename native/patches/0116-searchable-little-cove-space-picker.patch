+namespace {
+views::Widget* OpenSpacePicker(BrowserWindowInterface* popup) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(popup);
+  auto* menu = views::AsViewClass<views::MenuButton>(
+      view->toolbar()->GetViewByElementId(kCoveTemporarySpaceMenuElementId));
+  if (!menu) return nullptr;
+  views::NamedWidgetShownWaiter shown(views::test::AnyWidgetTestPasskey{},
+                                     "CoveTemporarySpaceChooser");
+  // MenuButton::Activate intentionally returns false after showing a menu
+  // so RootView releases mouse capture. It is not an activation failure.
+  menu->Activate(nullptr);
+  return shown.WaitIfNeededAndGet();
+}
