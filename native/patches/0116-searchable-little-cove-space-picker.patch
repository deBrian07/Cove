+IN_PROC_BROWSER_TEST_F(CoveTemporaryWindowBrowserTest,
+                       SearchableChooserPromotesTheExactPageWithKeyboard) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* profile = browser()->GetProfile();
+  {
+    ScopedDictPrefUpdate update(profile->GetPrefs(), "cove.sidebar");
+    auto* spaces = update->FindList("spaces");
+    ASSERT_TRUE(spaces);
+    for (const char* name : {"Study", "Projects", "Research", "Reading",
+                             "Travel", "Archive", "Tools", "Sandbox"}) {
+      spaces->Append(base::DictValue().Set("id", std::string("picker-") + name)
+          .Set("name", name).Set("color", "#2563eb")
+          .Set("icon", name == std::string("Study") ? "🪐" : "●")
+          .Set("pins", base::ListValue()).Set("folders", base::ListValue())
+          .Set("tabs", base::ListValue()));
+    }
+  }
+  auto* original = browser()->GetTabStripModel()->GetActiveWebContents();
+  auto* popup = OpenCoveTemporaryWindow(profile,
+      embedded_test_server()->GetURL("/title1.html"));
+  ASSERT_TRUE(popup);
+  auto* page = popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(popup,
+      embedded_test_server()->GetURL("/title2.html")));
+  ASSERT_TRUE(content::ExecJs(page, "window.pickerDraft='keep this page'"));
+  const int entries = page->GetController().GetEntryCount();
+  auto* popup_view = BrowserView::GetBrowserViewForBrowser(popup);
+  ASSERT_TRUE(popup_view->toolbar()->GetViewByElementId(kCoveTemporaryProfileElementId));
+  auto* picker = OpenSpacePicker(popup);
+  ASSERT_TRUE(picker);
+  auto* search = views::AsViewClass<views::Textfield>(
+      picker->GetContentsView()->GetViewByElementId(kCoveTemporarySpaceSearchElementId));
+  ASSERT_TRUE(search);
+  ASSERT_TRUE(base::test::RunUntil([&] { return search->HasFocus(); }));
+  CaptureTemporaryWindowIfRequested(picker, "cove-space-picker-snapshot");
+  // InsertOrReplaceText follows the native textfield's user-input controller
+  // path, so this exercises filtering rather than setting a test-only model.
+  search->InsertOrReplaceText(u"WOR");
+  picker->LayoutRootViewIfNecessary();
+  ui::KeyEvent enter(ui::EventType::kKeyPressed, ui::VKEY_RETURN, 0);
+  picker->OnKeyEvent(&enter);
+  EXPECT_TRUE(enter.handled());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return browser()->GetTabStripModel()->GetActiveWebContents() == page;
+  }));
+  auto* bridge = CoveSpaceCloseHandler::Get(browser()->GetUnownedUserDataHost());
+  ASSERT_TRUE(bridge);
+  EXPECT_EQ("work", bridge->GetActiveSpaceId());
+  EXPECT_EQ(entries, page->GetController().GetEntryCount());
+  EXPECT_EQ("keep this page", content::EvalJs(page, "window.pickerDraft"));
+  bridge->FocusSpace("personal");
+  EXPECT_EQ(original, browser()->GetTabStripModel()->GetActiveWebContents());
+}
