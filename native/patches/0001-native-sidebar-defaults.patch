+TEST(CoveSidebarDefaultsTest, NewProfileUsesExpandedNativeSidebar) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(tabs::kVerticalTabsExpandOnHover);
+  sync_preferences::TestingPrefServiceSyncable pref_service;
+  tabs::RegisterProfilePrefs(pref_service.registry());
+
+  EXPECT_TRUE(pref_service.GetBoolean(prefs::kVerticalTabsEnabled));
+  EXPECT_TRUE(
+      pref_service.FindPreference(prefs::kVerticalTabsEnabled)->IsDefaultValue());
+  EXPECT_FALSE(pref_service.GetBoolean(prefs::kVerticalTabsCollapsedState));
+  EXPECT_TRUE(pref_service.GetBoolean(prefs::kVerticalTabsExpandOnHoverEnabled));
+  EXPECT_EQ(260, pref_service.GetInteger(prefs::kVerticalTabsUncollapsedWidth));
+  EXPECT_EQ(base::Milliseconds(120), tabs::kVerticalTabsExpandOnHoverDelay.Get());
+  EXPECT_EQ(base::Milliseconds(120),
+            tabs::kVerticalTabsExpandOnHoverVelocityHeuristicEdgeDelay.Get());
+}
+
+TEST(CoveSidebarDefaultsTest, SavedHorizontalPreferenceOverridesDefault) {
+  sync_preferences::TestingPrefServiceSyncable pref_service;
+  tabs::RegisterProfilePrefs(pref_service.registry());
+  pref_service.SetBoolean(prefs::kVerticalTabsEnabled, false);
+
+  EXPECT_FALSE(pref_service.GetBoolean(prefs::kVerticalTabsEnabled));
+  EXPECT_FALSE(
+      pref_service.FindPreference(prefs::kVerticalTabsEnabled)->IsDefaultValue());
+}
