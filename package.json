{
  "name": "cove",
  "productName": "Cove",
  "version": "0.1.0",
  "private": true,
  "description": "A native Chromium browser with an Arc-style sidebar.",
  "scripts": {
    "start": "python3 scripts/chromium/cove_chromium.py run",
    "build": "python3 scripts/chromium/cove_chromium.py build",
    "doctor": "python3 scripts/chromium/cove_chromium.py doctor --stage run",
    "test": "python3 -m unittest discover -s scripts/chromium -p \"test_*.py\" && python3 -m unittest discover -s native/tools -p \"test_*.py\"",
    "test:ui": "python3 scripts/chromium/cove_chromium.py smoke",
    "chromium:doctor": "python3 scripts/chromium/cove_chromium.py doctor",
    "chromium:bootstrap": "python3 scripts/chromium/cove_chromium.py bootstrap",
    "chromium:sync": "python3 scripts/chromium/cove_chromium.py sync",
    "chromium:patch": "python3 scripts/chromium/cove_chromium.py patch",
    "chromium:gen": "python3 scripts/chromium/cove_chromium.py gen",
    "chromium:build": "python3 scripts/chromium/cove_chromium.py build",
    "chromium:run": "python3 scripts/chromium/cove_chromium.py run",
    "chromium:verify-patches": "python3 native/tools/verify_patches.py",
    "chromium:test": "python3 -m unittest discover -s scripts/chromium -p \"test_*.py\" && python3 -m unittest discover -s native/tools -p \"test_*.py\""
  }
}
